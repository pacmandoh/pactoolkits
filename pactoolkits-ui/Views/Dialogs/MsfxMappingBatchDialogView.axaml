<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:con="https://github.com/kikipoulet/SukiUI"
             xmlns:behaviors="clr-namespace:pactoolkits_ui.Behaviors"
             xmlns:vm="clr-namespace:pactoolkits_ui.ViewModels.Pages"
             xmlns:dialogs="clr-namespace:pactoolkits_ui.Views.Dialogs"
             x:Class="pactoolkits_ui.Views.Dialogs.MsfxMappingBatchDialogView"
             x:Name="Root"
             x:DataType="dialogs:MsfxMappingBatchDialogModel"
             Focusable="True"
             behaviors:FocusClearBehavior.Enable="True"
             behaviors:FocusClearBehavior.SuppressGridClear="True">
    <suki:GlassCard Classes="SectionCard"
                    MinWidth="920"
                    MaxWidth="1180"
                    Padding="16"
                    behaviors:FocusClearBehavior.SuppressGridClear="True">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Width="40" Height="40" CornerRadius="20">
                    <icons:MaterialIcon Kind="TableLargePlus" Width="20" Height="20"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="批量映射处理" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="先选分组，再映射或转待人工" Opacity="0.75" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="6">
                <TextBlock Text="待处理分组（按 原始药名/规格 + 归一化药名/规格）" Opacity="0.8" />
                <DataGrid Grid.Row="1"
                          x:Name="GroupGrid"
                          Height="280"
                          Classes="SectionGrid InventoryGrid LowToneGrid TraceStateGrid MsfxIndexedGrid"
                          HeadersVisibility="All"
                          GridLinesVisibility="All"
                          HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Single"
                          PointerPressed="GroupGrid_OnPointerPressed"
                          IsReadOnly="True"
                          ItemsSource="{Binding Groups}">
                    <DataGrid.Styles>
                        <Style Selector="DataGrid#GroupGrid DataGridCell TextBlock">
                            <Setter Property="TextWrapping" Value="NoWrap" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGrid.Styles>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="原始药名" Binding="{Binding SourceDrugNameRaw}" Width="180" />
                        <DataGridTextColumn Header="原始规格" Binding="{Binding SourceSpecRaw}" Width="180" />
                        <DataGridTextColumn Header="归一化药名" Binding="{Binding SourceNameNorm}" Width="180" />
                        <DataGridTextColumn Header="归一化规格" Binding="{Binding SourceSpecNorm}" Width="180" />
                        <DataGridTextColumn Header="总数" Binding="{Binding TotalCount}" Width="80" />
                        <DataGridTemplateColumn Header="状态构成" Width="520">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{DynamicResource BrushInfoBg25}"
                                                BorderBrush="{DynamicResource BrushInfoBg50}"
                                                BorderThickness="1"
                                                CornerRadius="999"
                                                Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <icons:MaterialIcon Kind="InformationOutline"
                                                                    Width="12"
                                                                    Height="12"
                                                                    Foreground="{DynamicResource BrushInfo}" />
                                                <TextBlock Text="{Binding PendingCount, StringFormat=待映射 {0}}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource BrushInfo}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BrushWarningBg25}"
                                                BorderBrush="{DynamicResource BrushWarningBg50}"
                                                BorderThickness="1"
                                                CornerRadius="999"
                                                Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <icons:MaterialIcon Kind="AlertCircleOutline"
                                                                    Width="12"
                                                                    Height="12"
                                                                    Foreground="{DynamicResource BrushWarning}" />
                                                <TextBlock Text="{Binding NeedReviewCount, StringFormat=待人工 {0}}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource BrushWarning}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BrushDangerBg25}"
                                                BorderBrush="{DynamicResource BrushDangerBg50}"
                                                BorderThickness="1"
                                                CornerRadius="999"
                                                Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <icons:MaterialIcon Kind="CloseCircleOutline"
                                                                    Width="12"
                                                                    Height="12"
                                                                    Foreground="{DynamicResource BrushDanger}" />
                                                <TextBlock Text="{Binding FailedCount, StringFormat=失败 {0}}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource BrushDanger}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <con:GlassCard Grid.Column="0" Classes="FilterFieldCard" Padding="10,8">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="Pill" Width="14" Height="14" />
                                <TextBlock Text="药品名称" Opacity="0.82" />
                            </StackPanel>
                            <Border Grid.Row="1"
                                    Height="{DynamicResource ControlHeightCompact}"
                                    Classes="AutoCompleteInputHost"
                                    Classes.DarkMode="{ReflectionBinding DataContext.IsNightMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Padding="8,0">
                                <AutoCompleteBox x:Name="DrugIdBox"
                                                 Height="{StaticResource ControlHeightCompact}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Watermark="输入院内药品信息"
                                                 MinimumPrefixLength="1"
                                                 IsTextCompletionEnabled="False"
                                                 KeyDown="DrugIdBox_OnKeyDown">
                                    <AutoCompleteBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OptionItem">
                                            <TextBlock Text="{Binding Display}" />
                                        </DataTemplate>
                                    </AutoCompleteBox.ItemTemplate>
                                </AutoCompleteBox>
                            </Border>
                        </Grid>
                    </con:GlassCard>

                    <con:GlassCard Grid.Column="1" Classes="FilterFieldCard" Padding="10,8">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="ScaleBalance" Width="14" Height="14" />
                                <TextBlock Text="规格" Opacity="0.82" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <ComboBox x:Name="SpecBox"
                                          Height="{StaticResource ControlHeightCompact}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"
                                          MinWidth="220"
                                          MaxDropDownHeight="300" />
                                <TextBlock x:Name="SpecPlaceholder"
                                           IsHitTestVisible="False"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Opacity="0.55"
                                           Text="请选择规格" />
                            </Grid>
                        </Grid>
                    </con:GlassCard>
                </Grid>

                <con:GlassCard Grid.Row="1" Classes="FilterHintCard">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <icons:MaterialIcon Kind="ChartTimelineVariant" Width="14" Height="14" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   x:Name="PreviewText"
                                   Text="请选择分组后自动预览"
                                   TextWrapping="Wrap"
                                   Opacity="0.9" />
                    </Grid>
                </con:GlassCard>
            </Grid>
        </Grid>
    </suki:GlassCard>
</UserControl>
