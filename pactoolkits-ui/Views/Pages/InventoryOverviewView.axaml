<UserControl xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
      xmlns:controls="clr-namespace:pactoolkits_ui.Controls"
      xmlns:vm="clr-namespace:pactoolkits_ui.ViewModels.Pages"
      xmlns:icons="clr-namespace:pactoolkits_ui.Controls"
      xmlns:behaviors="clr-namespace:pactoolkits_ui.Behaviors"
      mc:Ignorable="d"
      d:DesignWidth="1200" d:DesignHeight="800"
      x:Class="pactoolkits_ui.Views.Pages.InventoryOverviewView"
      x:DataType="vm:InventoryOverviewViewModel"
      Focusable="True"
      x:Name="Root">
  <UserControl.Styles>
    <Style Selector="DataGrid.InventoryContextMenuGrid DataGridRow">
      <Setter Property="ContextMenu">
        <Setter.Value>
          <ContextMenu>
            <MenuItem Header="复制" Click="OnGridRowCopy" CommandParameter="{Binding}">
              <MenuItem.Icon>
                <icons:AppIcon Kind="Copy" Width="{DynamicResource IconSizeDefault}" Height="{DynamicResource IconSizeDefault}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="全选" Click="OnGridSelectAll" CommandParameter="{Binding}">
              <MenuItem.Icon>
                <icons:AppIcon Kind="ListChecks" Width="{DynamicResource IconSizeDefault}" Height="{DynamicResource IconSizeDefault}" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Setter.Value>
      </Setter>
    </Style>

    <Style Selector="DataGrid.StockDetailContextMenuGrid DataGridRow">
      <Setter Property="ContextMenu">
        <Setter.Value>
          <ContextMenu Opened="OnStockDetailContextMenuOpened">
            <MenuItem Header="编辑" Click="OnStockEditCell">
              <MenuItem.Icon>
                <icons:AppIcon Kind="Pencil" Width="{DynamicResource IconSizeDefault}" Height="{DynamicResource IconSizeDefault}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="复制" Click="OnGridRowCopy" CommandParameter="{Binding}">
              <MenuItem.Icon>
                <icons:AppIcon Kind="Copy" Width="{DynamicResource IconSizeDefault}" Height="{DynamicResource IconSizeDefault}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="全选" Click="OnGridSelectAll" CommandParameter="{Binding}">
              <MenuItem.Icon>
                <icons:AppIcon Kind="ListChecks" Width="{DynamicResource IconSizeDefault}" Height="{DynamicResource IconSizeDefault}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="删除" Click="OnGridRowDelete" CommandParameter="{Binding}">
              <MenuItem.Icon>
                <icons:AppIcon Kind="Trash2" Width="{DynamicResource IconSizeDefault}" Height="{DynamicResource IconSizeDefault}" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Styles>

  <Grid Classes="PageRoot">

      <suki:GlassCard Classes="SectionCard">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="{DynamicResource FormRowSpacing}">

          
          <suki:GlassCard Grid.Row="0" Classes="FilterHintCard" IsVisible="{Binding IsSearchPanelVisible}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource PageColumnSpacing}" VerticalAlignment="Center">
              <TextBox Height="{StaticResource ControlHeightCompact}"
                  x:Name="InventorySearchBox"
                  IsEnabled="{Binding !IsUiBusy}"
                  Padding="10,0"
                  VerticalContentAlignment="Center"
                  TextWrapping="NoWrap"
                  AcceptsReturn="False"
                  Watermark="搜索：药品名 / 规格 / 追溯码"
                  KeyUp="InventorySearchBox_OnKeyUp"
                  Text="{Binding Keyword, Mode=TwoWay}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
              </TextBox>

              <Button Grid.Column="1" x:Name="InventorySearchButton" Classes="Action" Height="{StaticResource ControlHeightCompact}" MinWidth="{StaticResource MinWAction}"
                  IsEnabled="{Binding !IsUiBusy}"
                  Command="{Binding SearchCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:AppIcon Kind="Search" Width="{DynamicResource IconSizeDefault}" Height="{DynamicResource IconSizeDefault}" />
                  <TextBlock Text="搜索" />
                </StackPanel>
              </Button>

              <Button Grid.Column="2" Classes="Action" Height="{StaticResource ControlHeightCompact}" MinWidth="{StaticResource MinWAction}"
                  IsEnabled="{Binding !IsUiBusy}"
                  Command="{Binding ClearSearchCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:AppIcon Kind="Delete" Width="{DynamicResource IconSizeDefault}" Height="{DynamicResource IconSizeDefault}" />
                  <TextBlock Text="清空" />
                </StackPanel>
              </Button>
            </Grid>
          </suki:GlassCard>

          
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource PageColumnSpacing}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <icons:AppIcon Kind="Package" Width="18" Height="18" />
              <TextBlock Text="库存" Classes="SectionTitle" />
            </StackPanel>

            <WrapPanel Grid.Column="1"
                 VerticalAlignment="Center"
                 Opacity="{StaticResource SectionHintOpacity}"
                 ItemSpacing="{DynamicResource PageSectionSpacing}">
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDetailMode}">
                <icons:AppIcon Kind="LockKeyhole"
                          Width="16"
                          Height="16"
                          VerticalAlignment="Center"
                          Foreground="{Binding IsOperationUnlocked, Converter={StaticResource BoolToDoneDangerBrush}}" />
                <TextBlock Text="{Binding UnlockStatusText}"
                     Foreground="{Binding IsOperationUnlocked, Converter={StaticResource BoolToDoneDangerBrush}}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowEditSessionState}">
                <Border Width="10"
                    Height="10"
                    CornerRadius="999"
                    VerticalAlignment="Center"
                    Background="{Binding !HasPendingChanges, Converter={StaticResource BoolToDoneDangerBrush}}" />
                <icons:AppIcon Kind="SaveAll" Width="{DynamicResource IconSizeDefault}" Height="{DynamicResource IconSizeDefault}" />
                <TextBlock Text="{Binding EditSessionStateText}" />
              </StackPanel>
              
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Status}">
                <icons:AppIcon Kind="ListOrdered" Width="{DynamicResource IconSizeDefault}" Height="{DynamicResource IconSizeDefault}" />
                <TextBlock Text="{Binding Status}"
                     MaxWidth="460"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </WrapPanel>

            <WrapPanel Grid.Column="2" Orientation="Horizontal" ItemSpacing="8" VerticalAlignment="Center">
              <Button Classes="Action"
                  Height="{StaticResource ControlHeightCompact}"
                  Width="40"
                  MinWidth="40"
                  Padding="0"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  IsEnabled="{Binding !IsUiBusy}"
                  Command="{Binding ToggleSearchPanelCommand}"
                  ToolTip.Tip="显示/隐藏搜索">
                <Panel Width="16"
                   Height="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                  <icons:AppIcon Kind="Search"
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !IsSearchPanelVisible}" />
                  <icons:AppIcon Kind="SearchX"
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsSearchPanelVisible}" />
                </Panel>
              </Button>

              <Button Classes="Action"
                  Height="{StaticResource ControlHeightCompact}"
                  MinWidth="{StaticResource MinWAction}"
                  IsVisible="{Binding ShowRequestUnlock}"
                  Command="{Binding RequestUnlockCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:AppIcon Kind="LockKeyhole"
                            Width="16"
                            Height="16"
                            Foreground="{StaticResource BrushWarning}" />
                  <TextBlock Text="解锁" />
                </StackPanel>
              </Button>

              <Button Classes="Action"
                  Height="{StaticResource ControlHeightCompact}"
                  MinWidth="{StaticResource MinWAction}"
                  IsVisible="{Binding ShowLockOperations}"
                  Command="{Binding LockOperationsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:AppIcon Kind="LockKeyholeOpen"
                            Width="16"
                            Height="16"
                            Foreground="{StaticResource BrushDanger}" />
                  <TextBlock Text="锁定" />
                </StackPanel>
              </Button>

              <Button Classes="Action"
                  Height="{StaticResource ControlHeightCompact}"
                  MinWidth="{StaticResource MinWAction}"
                  IsVisible="{Binding CanEnableStockEdit}"
                  Command="{Binding ToggleStockEditModeCommand}">
                <TextBlock Text="编辑" />
              </Button>

              <Button Classes="Action"
                  Height="{StaticResource ControlHeightCompact}"
                  MinWidth="{StaticResource MinWAction}"
                  IsVisible="{Binding CanDisableStockEdit}"
                  Command="{Binding ToggleStockEditModeCommand}">
                <TextBlock Text="完成编辑" />
              </Button>

              <Button Classes="Action"
                  Height="{StaticResource ControlHeightCompact}"
                  MinWidth="{StaticResource MinWAction}"
                  IsEnabled="{Binding !IsUiBusy}"
                  IsVisible="{Binding IsDetailMode}"
                  Command="{Binding ToggleReassignPanelCommand}">
                <TextBlock Text="药品纠错" />
              </Button>

              <ComboBox x:Name="InventoryModeBox"
                   IsEnabled="{Binding !IsUiBusy}"
                   SelectedIndex="{Binding ModeIndex}"
                   MinWidth="180">
                <ComboBoxItem Content="库存明细" />
                <ComboBoxItem Content="按药品汇总" />
                <ComboBoxItem Content="低库存" />
                <ComboBoxItem Content="缺失" />
              </ComboBox>
            </WrapPanel>
          </Grid>

          <suki:GlassCard Grid.Row="2"
                  Padding="12,10"
                  behaviors:FocusClearBehavior.SuppressGridClear="{Binding SuppressGridClearInReassignDialog}"
                  IsVisible="{Binding IsReassignPanelVisible}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource FormRowSpacing}" ClipToBounds="True">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <ComboBox Width="160"
                       Height="{StaticResource ControlHeightCompact}"
                       IsEnabled="{Binding !IsUiBusy}"
                       SelectedIndex="{Binding ReassignScopeIndex}">
                    <ComboBoxItem Content="选中行" />
                    <ComboBoxItem Content="筛选批量" />
                  </ComboBox>
                  <TextBlock VerticalAlignment="Center"
                       Opacity="{StaticResource SectionHintOpacity}"
                       IsVisible="{Binding IsSingleReassignScope}"
                       Text="按当前选中库存行纠错" />
                  <TextBlock VerticalAlignment="Center"
                       Opacity="{StaticResource SectionHintOpacity}"
                       IsVisible="{Binding IsFilterReassignScope}"
                       Text="按顶部搜索关键字命中记录批量纠错" />
                </StackPanel>

                <Button Grid.Column="1"
                    Classes="Action"
                    Height="{StaticResource ControlHeightCompact}"
                    MinWidth="{StaticResource MinWAction}"
                    Command="{Binding PreviewReassignCommand}">
                  <TextBlock Text="预览影响" />
                </Button>
                <Button Grid.Column="2"
                    Classes="Action"
                    Height="{StaticResource ControlHeightCompact}"
                    MinWidth="{StaticResource MinWAction}"
                    Command="{Binding ApplyReassignCommand}">
                  <TextBlock Text="确认纠错" />
                </Button>
              </Grid>

              <Grid Grid.Row="1"
                 ColumnDefinitions="2.3*,1.5*,160,2*"
                 ColumnSpacing="8">
                <Border Grid.Column="0"
                    Height="{StaticResource ControlHeightCompact}"
                    Classes="AutoCompleteInputHost"
                    Classes.DarkMode="{ReflectionBinding DataContext.IsNightMode, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="8,0">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <icons:AppIcon Grid.Column="0"
                              Kind="Pill"
                              Width="15"
                              Height="15"
                              VerticalAlignment="Center"
                              Opacity="{StaticResource SectionHintOpacity}" />
                    <AutoCompleteBox Grid.Column="1"
                            Height="32"
                            x:Name="ReassignDrugBox"
                            BorderThickness="0"
                            Background="Transparent"
                            ItemsSource="{Binding ReassignDrugOptions}"
                            Text="{Binding ReassignDrugText, Mode=TwoWay, TargetNullValue='', FallbackValue=''}"
                            FilterMode="Contains"
                            IsDropDownOpen="{Binding IsReassignDrugSuggestOpen, Mode=TwoWay}"
                            Watermark="目标药品名（必填）"
                            KeyDown="ReassignDrugBox_OnKeyDown">
                      <AutoCompleteBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:OptionItem">
                          <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                      </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                  </Grid>
                </Border>

                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <icons:AppIcon Grid.Column="0"
                            Kind="SlidersHorizontal"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center"
                            Opacity="{StaticResource SectionHintOpacity}" />
                  <Grid Grid.Column="1">
                    <ComboBox x:Name="ReassignSpecBox"
                         Height="{StaticResource ControlHeightCompact}"
                         IsEnabled="{Binding !IsUiBusy}"
                         ItemsSource="{Binding ReassignSpecOptions}"
                         SelectedItem="{Binding ReassignSelectedSpec}"
                         DisplayMemberBinding="{Binding Display}" />
                    <TextBlock IsHitTestVisible="False"
                         IsVisible="{Binding !IsReassignSpecSelected}"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         Opacity="0.55"
                         Text="目标规格（必填）" />
                  </Grid>
                </Grid>

                <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <icons:AppIcon Grid.Column="0"
                            Kind="Hash"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center"
                            Opacity="{StaticResource SectionHintOpacity}" />
                  <TextBox Grid.Column="1"
                      Height="{StaticResource ControlHeightCompact}"
                      IsEnabled="False"
                      Padding="10,0"
                      VerticalContentAlignment="Center"
                      TextWrapping="NoWrap"
                      AcceptsReturn="False"
                      Watermark="纠错数量"
                      Text="{Binding ReassignQtyText, Mode=OneWay}" />
                </Grid>

                <Grid Grid.Column="3" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <icons:AppIcon Grid.Column="0"
                            Kind="FilePenLine"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center"
                            Opacity="{StaticResource SectionHintOpacity}" />
                  <TextBox Grid.Column="1"
                      Height="{StaticResource ControlHeightCompact}"
                      Padding="10,0"
                      VerticalContentAlignment="Center"
                      TextWrapping="NoWrap"
                      AcceptsReturn="False"
                      Watermark="纠错原因（必填）"
                      Text="{Binding ReassignReason, Mode=TwoWay}" />
                </Grid>
              </Grid>

              <TextBlock Grid.Row="2"
                   IsVisible="{Binding HasReassignPreviewText}"
                   Opacity="{StaticResource SectionHintOpacity}"
                   Text="{Binding ReassignPreviewText}" />

              <DataGrid Grid.Row="3"
                   IsVisible="{Binding !IsReassignPreviewEmpty}"
                   Classes="SectionGrid InventoryGrid NonInteractive"
                   ItemsSource="{Binding ReassignPreviewRows}"
                   HeadersVisibility="All"
                   GridLinesVisibility="All"
                   MinHeight="148"
                   MaxHeight="228">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="当前药品名" Binding="{Binding CurrentDrugId}" Width="1.2*" IsReadOnly="True" />
                  <DataGridTextColumn Header="当前规格" Binding="{Binding CurrentSpec}" Width="1.2*" IsReadOnly="True" />
                  <DataGridTextColumn Header="当前数量" Binding="{Binding CurrentQty}" Width="{StaticResource DgWRightSmall}" IsReadOnly="True" />
                  <DataGridTextColumn Header="目标药品名" Binding="{Binding TargetDrugId}" Width="1.2*" IsReadOnly="True" />
                  <DataGridTextColumn Header="目标规格" Binding="{Binding TargetSpec}" Width="1.2*" IsReadOnly="True" />
                  <DataGridTextColumn Header="目标数量" Binding="{Binding TargetQty}" Width="{StaticResource DgWRightSmall}" IsReadOnly="True" />
                  <DataGridTextColumn Header="追溯码" Binding="{Binding TraceCode}" Width="1.35*" IsReadOnly="True" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </suki:GlassCard>

          <Grid Grid.Row="3" ClipToBounds="True">

            
            <Grid IsVisible="{Binding IsDetailMode}">
              <suki:BusyArea IsBusy="{Binding IsDetailBusy}">
              <controls:EmptyStatePanel
                IsEmpty="{Binding IsStockEmpty}"
                EmptyText="暂无库存明细"
                EmptyHint="当前筛选条件下没有数据">
                <DataGrid Classes="SectionGrid InventoryGrid LowToneGrid EditableGrid StockDetailContextMenuGrid StickyIndexGrid StickyIndexRowNo"
                     Classes.CellTemplateHighlightGrid="{Binding IsStockEditEnabled}"
                     ItemsSource="{Binding StockRows}"
                     SelectedItem="{Binding SelectedStockRow, Mode=TwoWay}"
                     x:Name="StockDetailGrid"
                     SelectionChanged="OnStockSelectionChanged"
                     IsReadOnly="{Binding !IsStockEditEnabled}"
                     CellPointerPressed="OnStockCellPointerPressed"
                     BeginningEdit="OnStockBeginningEdit"
                     CellEditEnding="OnStockCellEditEnding"
                     HeadersVisibility="All"
                     GridLinesVisibility="All"
                     HorizontalScrollBarVisibility="Disabled"
                     MinHeight="0">

              <DataGrid.Columns>
                <DataGridTextColumn Header="药品名" Binding="{Binding DrugId}" Width="1.4*" IsReadOnly="True" />
                <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="1.4*" IsReadOnly="True" />
                <DataGridTextColumn Header="追溯码" Binding="{Binding TraceCode}" Width="1.4*" />

                <DataGridTextColumn Header="数量" Binding="{Binding Qty}" Width="{StaticResource DgWRightSmall}" IsReadOnly="True" />
                <DataGridTextColumn Header="剩余" Binding="{Binding Remain}" Width="{StaticResource DgWRightSmall}" />
              </DataGrid.Columns>
                </DataGrid>
              </controls:EmptyStatePanel>
              </suki:BusyArea>
            </Grid>

            
            <Grid IsVisible="{Binding IsAggMode}">
              <suki:BusyArea IsBusy="{Binding IsAggBusy}">
              <controls:EmptyStatePanel
                IsEmpty="{Binding IsAggEmpty}"
                EmptyText="暂无汇总数据"
                EmptyHint="当前筛选条件下没有数据">
                <DataGrid Classes="SectionGrid InventoryGrid LowToneGrid InventoryContextMenuGrid StickyIndexGrid StickyIndexRowNo"
                     ItemsSource="{Binding DrugSpecRows}"
                     x:Name="AggGrid"
                     HeadersVisibility="All"
                     GridLinesVisibility="All"
                     HorizontalScrollBarVisibility="Disabled"
                     MinHeight="0">

              <DataGrid.Columns>
                <DataGridTextColumn Header="药品名" Binding="{Binding DrugId}" Width="1.6*" />
                <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="2*" />

                <DataGridTextColumn Header="追溯码数" Binding="{Binding CodeCount}" Width="{StaticResource DgWRightSmall}" />
                <DataGridTextColumn Header="总数量" Binding="{Binding QtySum}" Width="{StaticResource DgWRightSmall}" />
                <DataGridTextColumn Header="剩余" Binding="{Binding RemainSum}" Width="{StaticResource DgWRightSmall}" />
                <DataGridTextColumn Header="周用量" Binding="{Binding WeekUsed}" Width="{StaticResource DgWRightSmall}" />
                <DataGridTextColumn Header="阈值" Binding="{Binding Threshold, StringFormat={}{0:0}}" Width="{StaticResource DgWRightSmall}" IsVisible="False" />
              </DataGrid.Columns>
                </DataGrid>
              </controls:EmptyStatePanel>
              </suki:BusyArea>
            </Grid>

            
            <Grid IsVisible="{Binding IsLowMode}">
              <suki:BusyArea IsBusy="{Binding IsLowBusy}">
              <controls:EmptyStatePanel
                IsEmpty="{Binding IsLowEmpty}"
                EmptyText="暂无低库存药品"
                EmptyHint="当前筛选条件下没有数据">
                <DataGrid Classes="SectionGrid InventoryGrid LowToneGrid InventoryContextMenuGrid StickyIndexGrid StickyIndexRowNo"
                     ItemsSource="{Binding LowStockRows}"
                     x:Name="LowStockGrid"
                     PointerReleased="OnLowOrMissingGridPointerReleased"
                     HeadersVisibility="All"
                     GridLinesVisibility="All"
                     HorizontalScrollBarVisibility="Disabled"
                     MinHeight="0">

              <DataGrid.Columns>
                <DataGridTextColumn Header="药品名" Binding="{Binding DrugId}" Width="1.2*" />
                <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="1.4*" />

                <DataGridTextColumn Header="剩余" Binding="{Binding RemainSum}" Width="{StaticResource DgWRightSmall}" />
                <DataGridTextColumn Header="阈值" Binding="{Binding Threshold, StringFormat={}{0:0}}" Width="{StaticResource DgWRightSmall}" />
              </DataGrid.Columns>
                </DataGrid>
              </controls:EmptyStatePanel>
              </suki:BusyArea>
            </Grid>

            <Grid IsVisible="{Binding IsMissingMode}">
              <suki:BusyArea IsBusy="{Binding IsMissingBusy}">
              <controls:EmptyStatePanel
                IsEmpty="{Binding IsMissingEmpty}"
                EmptyText="暂无缺失药品"
                EmptyHint="当前筛选条件下没有数据">
                <DataGrid Classes="SectionGrid InventoryGrid MissingGrid InventoryContextMenuGrid StickyIndexGrid StickyIndexRowNo"
                     ItemsSource="{Binding MissingStockRows}"
                     x:Name="MissingGrid"
                     PointerReleased="OnLowOrMissingGridPointerReleased"
                     HeadersVisibility="All"
                     GridLinesVisibility="All"
                     HorizontalScrollBarVisibility="Disabled"
                     MinHeight="0">

              <DataGrid.Columns>
                <DataGridTextColumn Header="药品名" Binding="{Binding DrugId}" Width="1.3*" />
                <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="1.4*" />
              </DataGrid.Columns>
                </DataGrid>
              </controls:EmptyStatePanel>
              </suki:BusyArea>
            </Grid>

            </Grid>

          <Grid Grid.Row="4"
             IsVisible="{Binding IsPagedMode}"
             ColumnDefinitions="*,Auto"
             ColumnSpacing="{DynamicResource FormColumnSpacing}"
             VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"
                  Spacing="10"
                  Opacity="{StaticResource SectionHintOpacity}">
              <TextBlock Text="{Binding TotalCount, StringFormat=共 {0} 条}" />
              <TextBlock Text="{Binding PageIndex, StringFormat=第 {0} 页}" />
              <TextBlock Text="{Binding TotalPages, StringFormat=/ {0} 页}" />
              <TextBlock Text="{Binding PageSize, StringFormat=每页 {0} 条}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Classes="Action"
                  Height="{StaticResource ControlHeightCompact}"
                  MinWidth="{StaticResource MinWAction}"
                  Command="{Binding FirstPageCommand}">
                <TextBlock Text="首页" />
              </Button>
              <Button Classes="Action"
                  Height="{StaticResource ControlHeightCompact}"
                  MinWidth="{StaticResource MinWAction}"
                  Command="{Binding PrevPageCommand}">
                <TextBlock Text="上一页" />
              </Button>
              <Button Classes="Action"
                  Height="{StaticResource ControlHeightCompact}"
                  MinWidth="{StaticResource MinWAction}"
                  Command="{Binding NextPageCommand}">
                <TextBlock Text="下一页" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </suki:GlassCard>

    </Grid>
</UserControl>
