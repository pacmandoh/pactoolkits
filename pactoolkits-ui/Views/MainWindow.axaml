<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:pactoolkits_ui.ViewModels"
                   xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                   xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                   xmlns:conv="clr-namespace:pactoolkits_ui.Converters"
                   xmlns:behaviors="clr-namespace:pactoolkits_ui.Behaviors"
                   x:Class="pactoolkits_ui.Views.MainWindow"
                   x:DataType="vm:MainWindowViewModel"
                   Title="PacToolkits - 自动化套件"
                   Icon="avares://pactoolkits-ui/Assets/app.ico"
                   BackgroundStyle="Flat"
                   IsMenuVisible="True"
                   Width="1450"
                   Height="900"
                   MinWidth="1350"
                   MinHeight="800"
                   behaviors:FocusClearBehavior.Enable="True"
                   WindowStartupLocation="CenterScreen">
    <suki:SukiWindow.Resources>
        <conv:BoolToDoneDangerBrushConverter x:Key="BoolToDoneDangerBrush" />
    </suki:SukiWindow.Resources>

    <suki:SukiWindow.Hosts>
        
        <suki:SukiToastHost Manager="{Binding ToastManager}" />

        
        <suki:SukiDialogHost Manager="{Binding DialogManager}" />
    </suki:SukiWindow.Hosts>

    <suki:SukiWindow.RightWindowTitleBarControls>
        <Button
            Classes="WindowControlsButton"
            Command="{Binding ToggleBaseThemeCommand}">
            <Panel>
                <icons:MaterialIcon IsVisible="{Binding IsNightMode}" Kind="WbSunny" Foreground="{DynamicResource SukiText}" />
                <icons:MaterialIcon IsVisible="{Binding !IsNightMode}" Kind="MoonAndStars" Foreground="{DynamicResource SukiText}" />
            </Panel>
        </Button>

        <Button
            Classes="WindowControlsButton"
            Command="{Binding CycleThemeColorCommand}">
            <icons:MaterialIcon Kind="ColorLens">
                <icons:MaterialIcon.Foreground>
                    <SolidColorBrush Color="{DynamicResource SukiText}" />
                </icons:MaterialIcon.Foreground>
            </icons:MaterialIcon>
        </Button>

        <Button
            Classes="WindowControlsButton"
            Command="{Binding OpenUpdateCenterCommand}"
            ToolTip.Tip="{Binding UpdateStatusTip}"
            IsVisible="{Binding HasUpdateAvailable}">
            <icons:MaterialIcon Kind="Upload"
                                Width="17"
                                Height="17"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource BrushWarning}" />
        </Button>

        
        <Button
            Classes="WindowControlsButton"
            Command="{Binding TryReconnectDbCommand}">
            <Panel>
                
                <icons:MaterialIcon
                    IsVisible="{Binding IsDbConnected}"
                    Kind="Link"
                    Foreground="{DynamicResource BrushDone}" />

                
                <icons:MaterialIcon
                    IsVisible="{Binding !IsDbConnected}"
                    Kind="LinkOff"
                    Foreground="{DynamicResource BrushDanger}" />
            </Panel>
        </Button>

        
        <Button
            Classes="WindowControlsButton"
            Command="{Binding StartOrRestartAhkCommand}">
            <Panel>
                <icons:MaterialIcon
                    IsVisible="{Binding IsAhkRunning}"
                    Kind="Syringe"
                    Foreground="{DynamicResource BrushDone}" />
                <icons:MaterialIcon
                    IsVisible="{Binding !IsAhkRunning}"
                    Kind="Syringe"
                    Foreground="{DynamicResource BrushDanger}" />
            </Panel>
        </Button>
    </suki:SukiWindow.RightWindowTitleBarControls>

    <suki:SukiWindow.LogoContent>
        <Image Source="avares://pactoolkits-ui/Assets/icon-32.png"
               Height="20"
               Stretch="Uniform"
               VerticalAlignment="Center" />
    </suki:SukiWindow.LogoContent>

    <suki:SukiWindow.MenuItems>
        <MenuItem Header="刷新"
                  Command="{Binding RefreshActivePageCommand}"
                  IsEnabled="{Binding CanTopRefresh}" />

        <MenuItem Header="导入"
                  Command="{Binding TopImportCommand}"
                  IsEnabled="{Binding CanTopImport}" />

        <MenuItem Header="导出"
                  Command="{Binding TopExportCommand}"
                  IsEnabled="{Binding CanTopExport}" />

        <MenuItem Header="设置"
                  Command="{Binding OpenSettingsCommand}" />

        <MenuItem Header="关于">
            <MenuItem Header="关于 PacToolkits"
                      Command="{Binding OpenAboutCommand}">
                <MenuItem.Icon>
                    <icons:MaterialIcon Kind="CardAccountDetailsOutline" Width="14" Height="14" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="检查更新"
                      Command="{Binding CheckAppUpdateCommand}"
                      IsEnabled="{Binding !IsUpdateChecking}">
                <MenuItem.Icon>
                    <Panel>
                        <icons:MaterialIcon Kind="Loading"
                                            IsVisible="{Binding IsUpdateChecking}"
                                            Width="14"
                                            Height="14"
                                            Foreground="{DynamicResource BrushInfo}" />
                        <Panel IsVisible="{Binding !IsUpdateChecking}">
                            <icons:MaterialIcon Kind="Download"
                                                IsVisible="{Binding !HasUpdateAvailable}"
                                                Width="14"
                                                Height="14" />
                            <icons:MaterialIcon Kind="Upload"
                                                IsVisible="{Binding HasUpdateAvailable}"
                                                Width="14"
                                                Height="14"
                                                Foreground="{DynamicResource BrushWarning}" />
                        </Panel>
                    </Panel>
                </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
    </suki:SukiWindow.MenuItems>

    <suki:SukiSideMenu
        x:Name="MainSideMenu"
        ItemsSource="{Binding SidebarPages}"
        SelectedItem="{Binding ActivePage}"
        IsMenuExpanded="True">
        <suki:SukiSideMenu.HeaderContent>
            <Grid Margin="8,4,8,10" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <suki:GlassCard Classes="SectionCard" Grid.Row="0" Padding="10,10" Opacity="0.95">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Border Width="35" Height="35" CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource SukiPrimaryColor}" Opacity="0.25" />
                            </Border.Background>
                            <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <icons:MaterialIcon Kind="SitemapOutline">
                                    <icons:MaterialIcon.Foreground>
                                        <SolidColorBrush Color="{DynamicResource SukiPrimaryColor}" />
                                    </icons:MaterialIcon.Foreground>
                                </icons:MaterialIcon>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="PacToolkits"
                                       FontWeight="Bold"
                                       FontSize="14" />
                            <TextBlock Text="自动化套件控制台"
                                       Classes="SectionHint" />
                        </StackPanel>
                    </Grid>
                </suki:GlassCard>

                <Border Grid.Row="1" Padding="2,0,2,0">
                    <Grid>
                        <TextBox MinHeight="32"
                                 VerticalContentAlignment="Center"
                                 Padding="30,0,8,0"
                                 Watermark="搜索页面"
                                 UseFloatingWatermark="False"
                                 Text="{Binding #MainSideMenu.SearchText, Mode=TwoWay}" />
                        <icons:MaterialIcon Kind="Magnify"
                                            Width="14"
                                            Height="14"
                                            Margin="10,0,0,0"
                                            IsHitTestVisible="False"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            Opacity="0.72" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <suki:GlassCard Classes="SectionCard" Grid.Column="0" Padding="8,6" Height="44" VerticalAlignment="Center" VerticalContentAlignment="Center" Opacity="0.9">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <icons:MaterialIcon Kind="DatabaseOutline"
                                                Width="14"
                                                Height="14"
                                                Foreground="{Binding IsDbConnected, Converter={StaticResource BoolToDoneDangerBrush}}"
                                                VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DbStatusText}"
                                       Classes="SectionHint"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </suki:GlassCard>

                    <suki:GlassCard Classes="SectionCard" Grid.Column="1" Padding="8,6" Height="44" VerticalAlignment="Center" VerticalContentAlignment="Center" Opacity="0.9">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <icons:MaterialIcon Kind="Syringe"
                                                Width="14"
                                                Height="14"
                                                Foreground="{Binding IsAhkRunning, Converter={StaticResource BoolToDoneDangerBrush}}"
                                                VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AhkStatusText}"
                                       Classes="SectionHint"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </suki:GlassCard>

                </Grid>
            </Grid>
        </suki:SukiSideMenu.HeaderContent>
        
        <suki:SukiSideMenu.ItemTemplate>
            <DataTemplate>
                <suki:SukiSideMenuItem
                    Header="{Binding DisplayName}"
                    IsEnabled="{Binding IsEnabled}">
                    <suki:SukiSideMenuItem.Icon>
                        <icons:MaterialIcon Kind="{Binding Icon}" />
                    </suki:SukiSideMenuItem.Icon>
                </suki:SukiSideMenuItem>
            </DataTemplate>
        </suki:SukiSideMenu.ItemTemplate>

        <suki:SukiSideMenu.FooterContent>
            <Grid Margin="8,10,8,6" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Grid Grid.Row="0">
                    <Button Classes="Ghost"
                            Command="{Binding OpenSettingsCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="999"
                                    Background="{DynamicResource BrushWarning}"
                                    IsVisible="{Binding HasUpdateAvailable}"
                                    VerticalAlignment="Center" />
                            <icons:MaterialIcon Kind="CogOutline" Width="15" Height="15" />
                            <TextBlock Text="打开设置" />
                        </StackPanel>
                    </Button>
                </Grid>

                <suki:GlassCard Classes="SectionCard" Grid.Row="1" Padding="10,8" Height="72" VerticalAlignment="Center" VerticalContentAlignment="Center" Opacity="0.9">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <icons:MaterialIcon Kind="TagOutline" Width="14" Height="14" Opacity="0.75" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource AppVersionText}" Classes="SectionHint" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <icons:MaterialIcon Kind="Copyright" Width="14" Height="14" Opacity="0.75" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource AppCopyrightText}" Classes="SectionHint" />
                        </Grid>
                        </StackPanel>
                    </Grid>
                </suki:GlassCard>

                <TextBlock Grid.Row="2"
                           HorizontalAlignment="Center"
                           Text="为井研县中医医院 - 药剂科构建"
                           Classes="SectionHint"
                           Opacity="0.65" />
            </Grid>
        </suki:SukiSideMenu.FooterContent>
    </suki:SukiSideMenu>
</suki:SukiWindow>
