<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:pactoolkits_ui.ViewModels"
                   xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                   xmlns:icons="clr-namespace:pactoolkits_ui.Controls"
                   xmlns:behaviors="clr-namespace:pactoolkits_ui.Behaviors"
                   xmlns:controls="clr-namespace:pactoolkits_ui.Controls"
                   x:Class="pactoolkits_ui.Views.MainWindow"
                   x:DataType="vm:MainWindowViewModel"
                   Title="PacToolkits - 自动化套件"
                   Icon="avares://pactoolkits-ui/Assets/app.ico"
                   BackgroundStyle="Flat"
                   IsMenuVisible="True"
                   Width="1450"
                   Height="900"
                   MinWidth="1350"
                   MinHeight="800"
                   behaviors:FocusClearBehavior.Enable="True"
                   WindowStartupLocation="CenterScreen">
    <suki:SukiWindow.Hosts>
        
        <suki:SukiToastHost Manager="{Binding ToastManager}" />

        
        <suki:SukiDialogHost Manager="{Binding DialogManager}" />
    </suki:SukiWindow.Hosts>

    <suki:SukiWindow.RightWindowTitleBarControls>
        <Button
            Classes="WindowControlsButton"
            Command="{Binding OpenUpdateCenterCommand}"
            ToolTip.Tip="{Binding UpdateStatusTip}"
            IsVisible="{Binding HasUpdateAvailable}"
            Margin="0,0,6,0">
            <icons:AppIcon Kind="Upload"
                                Width="17"
                                Height="17"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource BrushWarning}" />
        </Button>

        <Border BorderBrush="{DynamicResource SukiControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="999"
                Padding="2,0"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="0">
                <Button
                    Classes="WindowControlsButton"
                    Command="{Binding ToggleBaseThemeCommand}">
                    <Panel>
                        <icons:AppIcon IsVisible="{Binding IsNightMode}" Kind="SunMedium" Width="16" Height="16" Foreground="{DynamicResource SukiText}" />
                        <icons:AppIcon IsVisible="{Binding !IsNightMode}" Kind="MoonStar" Width="16" Height="16" Foreground="{DynamicResource SukiText}" />
                    </Panel>
                </Button>

                <Button
                    Classes="WindowControlsButton"
                    Command="{Binding CycleThemeColorCommand}">
                    <icons:AppIcon Kind="Palette"
                                   Width="16"
                                   Height="16"
                                   Foreground="{DynamicResource SukiText}" />
                </Button>

                <Border Width="1"
                        Height="16"
                        Margin="3,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SukiControlBorderBrush}" />

                <Button
                    Classes="WindowControlsButton"
                    Command="{Binding TryReconnectDbCommand}">
                    <Panel>
                        <controls:BusyCircle
                            IsVisible="{Binding ShowDbBusyIcon}"
                            Width="16"
                            Height="16"
                            DotBrush="{DynamicResource SukiText}" />

                        <icons:AppIcon
                            IsVisible="{Binding ShowDbConnectedIcon}"
                            Kind="Link"
                            Width="16"
                            Height="16"
                            Foreground="{DynamicResource BrushDone}" />

                        <icons:AppIcon
                            IsVisible="{Binding ShowDbDisconnectedIcon}"
                            Kind="Unlink"
                            Width="16"
                            Height="16"
                            Foreground="{DynamicResource BrushDanger}" />
                    </Panel>
                </Button>

                <Button
                    Classes="WindowControlsButton"
                    Command="{Binding StartOrRestartAhkCommand}">
                    <Panel>
                        <icons:AppIcon
                            IsVisible="{Binding IsAhkRunning}"
                            Kind="Syringe"
                            Width="16"
                            Height="16"
                            Foreground="{DynamicResource BrushDone}" />
                        <icons:AppIcon
                            IsVisible="{Binding !IsAhkRunning}"
                            Kind="Syringe"
                            Width="16"
                            Height="16"
                            Foreground="{DynamicResource BrushDanger}" />
                    </Panel>
                </Button>
            </StackPanel>
        </Border>
    </suki:SukiWindow.RightWindowTitleBarControls>

    <suki:SukiWindow.LogoContent>
        <Image Source="avares://pactoolkits-ui/Assets/icon-32.png"
               Height="20"
               Stretch="Uniform"
               VerticalAlignment="Center" />
    </suki:SukiWindow.LogoContent>

    <suki:SukiWindow.MenuItems>
        <MenuItem Header="刷新"
                  Command="{Binding RefreshActivePageCommand}"
                  IsEnabled="{Binding CanTopRefresh}" />

        <MenuItem Header="导入"
                  Command="{Binding TopImportCommand}"
                  IsEnabled="{Binding CanTopImport}" />

        <MenuItem Header="导出"
                  Command="{Binding TopExportCommand}"
                  IsEnabled="{Binding CanTopExport}" />

        <MenuItem Header="设置"
                  Command="{Binding OpenSettingsCommand}" />

        <MenuItem Header="关于">
            <MenuItem Header="关于 PacToolkits"
                      Command="{Binding OpenAboutCommand}">
                <MenuItem.Icon>
                    <icons:AppIcon Kind="IdCard" Width="14" Height="14" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="检查更新"
                      Command="{Binding CheckAppUpdateCommand}"
                      IsEnabled="{Binding !IsUpdateChecking}">
                <MenuItem.Icon>
                    <Panel>
                        <controls:BusyCircle IsVisible="{Binding IsUpdateChecking}"
                                             Width="14"
                                             Height="14"
                                             DotBrush="{DynamicResource SukiText}" />
                        <Panel IsVisible="{Binding !IsUpdateChecking}">
                            <icons:AppIcon Kind="Download"
                                                IsVisible="{Binding !HasUpdateAvailable}"
                                                Width="14"
                                                Height="14" />
                            <icons:AppIcon Kind="Upload"
                                                IsVisible="{Binding HasUpdateAvailable}"
                                                Width="14"
                                                Height="14"
                                                Foreground="{DynamicResource BrushWarning}" />
                        </Panel>
                    </Panel>
                </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
    </suki:SukiWindow.MenuItems>

    <suki:SukiSideMenu
        x:Name="MainSideMenu"
        ItemsSource="{Binding SidebarPages}"
        SelectedItem="{Binding ActivePage}"
        IsMenuExpanded="False"
        IsSelectedItemContentMovable="False"
        IsEnabled="{Binding !IsDbProbeRunning}">
        <suki:SukiSideMenu.HeaderContent>
            <Grid Margin="8,6,8,12" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <suki:GlassCard Classes="SectionCard" Grid.Row="0" Padding="12,11" Opacity="0.96">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Width="40" Height="40" CornerRadius="11">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource SukiPrimaryColor}" Opacity="0.22" />
                            </Border.Background>
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <icons:AppIcon Kind="Workflow" Foreground="{DynamicResource SukiPrimaryColor}" />
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="PacToolkits" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                <controls:StatusPill Icon="ShieldCheck"
                                                     Text="PRO"
                                                     IconSize="11"
                                                     TextSize="9"
                                                     PillPadding="7,2"
                                                     VerticalAlignment="Center"
                                                     BackgroundBrush="{DynamicResource SukiPrimaryColor10}"
                                                     PillBorderBrush="{DynamicResource SukiPrimaryColor25}"
                                                     ForegroundBrush="{DynamicResource SukiPrimaryColor120}" />
                            </StackPanel>
                            <TextBlock Text="自动化套件控制台" Classes="SectionHint" />
                        </StackPanel>
                    </Grid>
                </suki:GlassCard>

                <suki:GlassCard Grid.Row="1" Classes="SectionCard" Padding="8,8" Opacity="0.92">
                    <Grid>
                        <TextBox Height="{StaticResource ControlHeightCompact}"
                                 VerticalContentAlignment="Center"
                                 Padding="31,0,10,0"
                                 Watermark="搜索页面 / 命令"
                                 UseFloatingWatermark="False"
                                 Text="{Binding #MainSideMenu.SearchText, Mode=TwoWay}" />
                        <icons:AppIcon Kind="Search"
                                            Width="14"
                                            Height="14"
                                            Margin="10,0,0,0"
                                            IsHitTestVisible="False"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            Opacity="0.74" />
                    </Grid>
                </suki:GlassCard>

                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <suki:GlassCard Classes="SectionCard" Grid.Column="0" Padding="{StaticResource CompactPadding}" Height="50" VerticalAlignment="Center" Opacity="0.92">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                            <icons:AppIcon Kind="Database"
                                                Width="15"
                                                Height="15"
                                                Foreground="{Binding IsDbConnected, Converter={StaticResource BoolToDoneDangerBrush}}"
                                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="数据库" FontSize="11" Opacity="{StaticResource SectionHintOpacity}" />
                                <TextBlock Text="{Binding DbStatusText}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </suki:GlassCard>

                    <suki:GlassCard Classes="SectionCard" Grid.Column="1" Padding="{StaticResource CompactPadding}" Height="50" VerticalAlignment="Center" Opacity="0.92">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                            <icons:AppIcon Kind="Syringe"
                                                Width="15"
                                                Height="15"
                                                Foreground="{Binding IsAhkRunning, Converter={StaticResource BoolToDoneDangerBrush}}"
                                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Agent" FontSize="11" Opacity="{StaticResource SectionHintOpacity}" />
                                <TextBlock Text="{Binding AhkStatusText}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </suki:GlassCard>
                </Grid>
            </Grid>
        </suki:SukiSideMenu.HeaderContent>
        
        <suki:SukiSideMenu.ItemTemplate>
            <DataTemplate>
                <suki:SukiSideMenuItem
                    Header="{Binding DisplayName}"
                    IsEnabled="{Binding IsEnabled}">
                    <suki:SukiSideMenuItem.Icon>
                        <icons:AppIcon Kind="{Binding Icon}" Width="16" Height="16" />
                    </suki:SukiSideMenuItem.Icon>
                </suki:SukiSideMenuItem>
            </DataTemplate>
        </suki:SukiSideMenu.ItemTemplate>

        <suki:SukiSideMenu.FooterContent>
            <Grid Margin="8,10,8,6">
                <Grid IsVisible="{Binding #MainSideMenu.IsMenuExpanded}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <suki:GlassCard Grid.Row="0" Classes="SectionCard" Padding="9,9" Opacity="0.93">
                            <StackPanel Spacing="0">
                                <Button Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <icons:AppIcon Kind="Settings" Width="15" Height="15" />
                                        <TextBlock Grid.Column="1" Text="系统设置中心" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Border Width="8"
                                                    Height="8"
                                                    CornerRadius="999"
                                                    Background="{DynamicResource BrushWarning}"
                                                    IsVisible="{Binding HasUpdateAvailable}" />
                                            <icons:AppIcon Kind="ChevronRight" Width="14" Height="14" Opacity="0.65" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </suki:GlassCard>

                        <suki:GlassCard Classes="SectionCard" Grid.Row="1" Padding="{StaticResource CompactPadding}" VerticalAlignment="Center" Opacity="0.9">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                <Border Grid.Row="0" Padding="8,6" CornerRadius="10" Background="{DynamicResource SukiPrimaryColor5}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                        <icons:AppIcon Kind="Tag" Width="14" Height="14" Opacity="0.82" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="版本信息" FontSize="10" Opacity="0.62" />
                                            <TextBlock Text="{DynamicResource AppVersionText}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Padding="8,6" CornerRadius="10" Background="{DynamicResource SukiControlTouchBackground}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                        <icons:AppIcon Kind="Copyright" Width="14" Height="14" Opacity="0.82" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="版权与归属" FontSize="10" Opacity="0.62" />
                                            <TextBlock Text="{DynamicResource AppCopyrightText}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </suki:GlassCard>
                    </Grid>
                </Grid>

                <Grid IsVisible="{Binding !#MainSideMenu.IsMenuExpanded}" RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Height="1" Margin="2,0,2,2" Background="{DynamicResource SukiControlBorderBrush}" />
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4" Margin="0,0,0,0">
                        <Button Classes="SidebarCompactAction"
                                IsVisible="{Binding !IsSettingsPageActive}"
                                Command="{Binding OpenSettingsCommand}">
                            <icons:AppIcon Kind="Settings" Width="16" Height="16" />
                        </Button>
                        <Button Classes="SidebarCompactAction ActiveCompactAction"
                                IsVisible="{Binding IsSettingsPageActive}"
                                Command="{Binding OpenSettingsCommand}">
                            <icons:AppIcon Kind="Settings" Width="16" Height="16" />
                        </Button>

                        <Button Classes="SidebarCompactAction"
                                IsVisible="{Binding !IsAboutPageActive}"
                                Command="{Binding OpenAboutCommand}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="关于 PacToolkits" Command="{Binding OpenAboutCommand}">
                                        <MenuItem.Icon>
                                            <icons:AppIcon Kind="Info" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="检查更新" Command="{Binding CheckAppUpdateCommand}" IsEnabled="{Binding !IsUpdateChecking}">
                                        <MenuItem.Icon>
                                            <icons:AppIcon Kind="Download" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="打开设置" Command="{Binding OpenSettingsCommand}">
                                        <MenuItem.Icon>
                                            <icons:AppIcon Kind="Settings" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Border Width="30" Height="30" CornerRadius="9" ClipToBounds="True">
                                <Image Source="avares://pactoolkits-ui/Assets/app.ico" Stretch="Uniform" />
                            </Border>
                        </Button>
                        <Button Classes="SidebarCompactAction ActiveCompactAction"
                                IsVisible="{Binding IsAboutPageActive}"
                                Command="{Binding OpenAboutCommand}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="关于 PacToolkits" Command="{Binding OpenAboutCommand}">
                                        <MenuItem.Icon>
                                            <icons:AppIcon Kind="Info" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="检查更新" Command="{Binding CheckAppUpdateCommand}" IsEnabled="{Binding !IsUpdateChecking}">
                                        <MenuItem.Icon>
                                            <icons:AppIcon Kind="Download" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="打开设置" Command="{Binding OpenSettingsCommand}">
                                        <MenuItem.Icon>
                                            <icons:AppIcon Kind="Settings" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Border Width="30" Height="30" CornerRadius="9" ClipToBounds="True">
                                <Image Source="avares://pactoolkits-ui/Assets/app.ico" Stretch="Uniform" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </suki:SukiSideMenu.FooterContent>
    </suki:SukiSideMenu>
</suki:SukiWindow>
