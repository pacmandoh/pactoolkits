<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:pactoolkits_ui.Controls">
  <Style Selector="icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource AppIconDefaultSize}" />
    <Setter Property="Height" Value="{DynamicResource AppIconDefaultSize}" />
  </Style>
</Styles>
