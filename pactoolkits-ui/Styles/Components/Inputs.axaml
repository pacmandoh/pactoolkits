<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sukiControls="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:icons="clr-namespace:pactoolkits_ui.Controls"
    xmlns:controls="clr-namespace:pactoolkits_ui.Controls">
  <Style Selector="sukiControls|BusyArea[IsBusy=true]">
    <Setter Property="IsEnabled" Value="False" />
  </Style>

  <Style Selector="TextBox.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="Padding" Value="{DynamicResource InputPaddingHorizontal}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="AcceptsReturn" Value="False" />
  </Style>

  <Style Selector="ComboBox.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="CalendarDatePicker.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="NumericUpDown.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="Border.AutoCompleteInputHost">
    <Setter Property="CornerRadius" Value="{DynamicResource InputCornerRadius}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AutoCompleteBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource ThemeBorderLowBrush}" />
  </Style>

  <Style Selector="Border.AutoCompleteInputHost.DarkMode">
    <Setter Property="Background" Value="{DynamicResource AutoCompleteDarkBackgroundBrush}" />
  </Style>

  <Style Selector="Border.AutoCompleteInputHost:enabled:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
  </Style>

  <Style Selector="Border.AutoCompleteInputHost:enabled:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
  </Style>

  <Style Selector="Border.RowItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RowRadius}" />
    <Setter Property="Padding" Value="{DynamicResource RowPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource RowMinHeight}" />
  </Style>

  <Style Selector="controls|EmptyStatePanel">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <ContentPresenter
            Content="{TemplateBinding Content}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsVisible="{Binding !IsEmpty, RelativeSource={RelativeSource TemplatedParent}}" />

          <Border
            IsVisible="{Binding IsEmpty, RelativeSource={RelativeSource TemplatedParent}}"
            Padding="{DynamicResource EmptyStatePadding}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <StackPanel Spacing="{DynamicResource EmptyStateSpacing}" HorizontalAlignment="Center">
              <icons:AppIcon
                Kind="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                Width="{DynamicResource EmptyStateIconSize}"
                Height="{DynamicResource EmptyStateIconSize}"
                Foreground="{StaticResource BrushWarning}" />

              <TextBlock
                Text="{Binding EmptyText, RelativeSource={RelativeSource TemplatedParent}}"
                FontSize="{DynamicResource EmptyStateTitleSize}"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource SukiText}" />

              <TextBlock
                Text="{Binding EmptyHint, RelativeSource={RelativeSource TemplatedParent}}"
                Classes="SectionHint"
                IsVisible="{Binding HasHint, RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
