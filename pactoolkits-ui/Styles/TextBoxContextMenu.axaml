<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:pactoolkits_ui.Controls"
        x:CompileBindings="False">
    <Style Selector="TextBox">
        <Setter Property="ContextMenu">
            <Template>
                <ContextMenu>
                    <MenuItem Header="剪切"
                              Command="{Binding $parent[TextBox].Cut}"
                              InputGesture="{x:Static TextBox.CutGesture}"
                              IsEnabled="{Binding $parent[TextBox].CanCut}">
                        <MenuItem.Icon>
                            <icons:AppIcon Kind="Scissors" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="复制"
                              Command="{Binding $parent[TextBox].Copy}"
                              InputGesture="{x:Static TextBox.CopyGesture}"
                              IsEnabled="{Binding $parent[TextBox].CanCopy}">
                        <MenuItem.Icon>
                            <icons:AppIcon Kind="Copy" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="粘贴"
                              Command="{Binding $parent[TextBox].Paste}"
                              InputGesture="{x:Static TextBox.PasteGesture}"
                              IsEnabled="{Binding $parent[TextBox].CanPaste}">
                        <MenuItem.Icon>
                            <icons:AppIcon Kind="ClipboardPaste" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="全选"
                              Command="{Binding $parent[TextBox].SelectAll}"
                              InputGesture="Ctrl + A">
                        <MenuItem.Icon>
                            <icons:AppIcon Kind="ListChecks" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Template>
        </Setter>
    </Style>
</Styles>
