<ResourceDictionary xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="SectionTitleSize">16</x:Double>
  <x:Double x:Key="SectionHintSize">12</x:Double>
  <x:Double x:Key="SectionHintOpacity">0.75</x:Double>

  <x:Double x:Key="EmptyStateTitleSize">14</x:Double>
  <x:Double x:Key="DgRowHeaderFontSize">10</x:Double>
</ResourceDictionary>
