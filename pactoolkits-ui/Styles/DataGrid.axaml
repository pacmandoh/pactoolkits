<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:pactoolkits_ui.Behaviors">

    <Style Selector="DataGrid.SectionGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="All" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="RowHeight" Value="{DynamicResource RowMinHeight}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style Selector="DataGrid.StickyIndexGrid">
        <Setter Property="RowHeaderWidth" Value="36" />
        <Setter Property="behaviors:DataGridSortResetBehavior.Enabled" Value="True" />
    </Style>

    <Style Selector="DataGrid.MsfxIndexedGrid">
        <Setter Property="RowHeaderWidth" Value="36" />
        <Setter Property="behaviors:DataGridSortResetBehavior.Enabled" Value="True" />
    </Style>

    <Style Selector="DataGrid.StickyIndexGrid /template/ DataGridColumnHeader#PART_TopLeftCornerHeader">
        <Setter Property="Width" Value="36" />
        <Setter Property="MinWidth" Value="36" />
    </Style>

    <Style Selector="DataGrid.MsfxIndexedGrid /template/ DataGridColumnHeader#PART_TopLeftCornerHeader">
        <Setter Property="Width" Value="36" />
        <Setter Property="MinWidth" Value="36" />
    </Style>

    <Style Selector="DataGrid.NonInteractive">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <Style Selector="DataGridRow">
        <Setter Property="MinHeight" Value="{DynamicResource RowMinHeight}" />
    </Style>

    <Style Selector="DataGrid.StickyIndexGrid DataGridRowHeader">
        <Setter Property="Width" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.72" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Content">
            <Setter.Value>
                <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                         Path="Index"
                         Converter="{StaticResource RowIndexPlusOne}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGrid.MsfxIndexedGrid DataGridRowHeader">
        <Setter Property="Width" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.72" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Content">
            <Setter.Value>
                <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                         Path="Index"
                         Converter="{StaticResource RowIndexPlusOne}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGrid.StickyIndexGrid.StickyIndexDisplayIndex DataGridRowHeader">
        <Setter Property="Content">
            <Setter.Value>
                <ReflectionBinding RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                   Path="DataContext.DisplayIndex" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGrid.StickyIndexGrid.StickyIndexRowNo DataGridRowHeader">
        <Setter Property="Content">
            <Setter.Value>
                <ReflectionBinding RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                   Path="DataContext.RowNo" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGrid.MsfxIndexedGrid.MapIndexedGrid DataGridRowHeader">
        <Setter Property="Content">
            <Setter.Value>
                <ReflectionBinding RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                   Path="DataContext.DisplayIndex" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGrid.StickyIndexGrid DataGridRowHeader ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <Style Selector="DataGrid.MsfxIndexedGrid DataGridRowHeader ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <Style Selector="DataGrid.StickyIndexGrid DataGridRowHeader TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="DataGrid.MsfxIndexedGrid DataGridRowHeader TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource DgCellPadCell}" />
    </Style>

    <Style Selector="DataGridCell TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.DataGridSortResetButton">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="#1E2F4D80" />
        <Setter Property="Foreground" Value="#D7E3F9" />
        <Setter Property="BorderBrush" Value="#3A4C6D" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.DataGridSortResetButton:pointerover">
        <Setter Property="Background" Value="#2D4E86A0" />
        <Setter Property="BorderBrush" Value="#5576B0" />
        <Setter Property="Foreground" Value="White" />
    </Style>

</Styles>
