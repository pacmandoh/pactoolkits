<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Version.g.props" Condition="Exists('Version.g.props')" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Agents</AssemblyName>
    <RootNamespace>PacToolkits.Agents.Host</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Product>PacToolkits Agents</Product>
    <Authors>PacmanDoh</Authors>
    <Company>PacDocs</Company>
    <Description>PacToolkits Agents entry process that hosts modules</Description>
    <ApplicationIcon>assets\pactoolkits-agents.ico</ApplicationIcon>
    <AppVersion Condition="'$(AppVersion)' == ''">0.0.0-local</AppVersion>
    <Version Condition="'$(Version)' == ''">$(AppVersion)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.0.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">0.0.0.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(AppVersion)+local</InformationalVersion>
  </PropertyGroup>

    <ItemGroup>
    <None Include="ReleaseManifest.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('ReleaseManifest.json')" />
    <ProjectReference Include="..\..\..\packages\agents-contracts\PacToolkits.Agents.Contracts.csproj" />
    <ProjectReference Include="..\..\..\packages\logger\PacToolkits.Logger.csproj" />
  </ItemGroup>

</Project>
