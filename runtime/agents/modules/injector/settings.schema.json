{
  "schemaVersion": 1,
  "title": "Injector 设置",
  "sections": [
    {
      "title": "基础配置",
      "fields": [
        {
          "key": "PgDriver",
          "type": "string",
          "label": "PG 驱动",
          "description": "Injector 连接 PostgreSQL 使用的 ODBC 驱动名"
        },
        {
          "key": "PgSsl",
          "type": "enum",
          "label": "PG SSL",
          "description": "Injector 连接数据库时的 SSL 模式",
          "options": [
            {
              "value": "disable",
              "label": "禁用"
            },
            {
              "value": "allow",
              "label": "允许（可明文）"
            },
            {
              "value": "prefer",
              "label": "优先 SSL"
            },
            {
              "value": "require",
              "label": "必须 SSL"
            },
            {
              "value": "verify-ca",
              "label": "校验 CA"
            },
            {
              "value": "verify-full",
              "label": "完整校验"
            }
          ]
        },
        {
          "key": "ConfirmTimeoutMs",
          "type": "int",
          "label": "确认超时",
          "description": "UI 操作确认等待时间（毫秒）",
          "min": 100,
          "max": 10000
        }
      ]
    },
    {
      "title": "目标进程",
      "fields": [
        {
          "key": "AppWin",
          "type": "stringList",
          "label": "目标进程",
          "description": "Injector 模块可注入的目标可执行文件，每行一个"
        }
      ]
    },
    {
      "title": "门诊窗口",
      "fields": [
        {
          "key": "OptWindowClass",
          "type": "string",
          "label": "门诊窗口类",
          "description": "门诊顶层窗口 Class"
        },
        {
          "key": "OptParseGridClassNN",
          "type": "string",
          "label": "门诊解析网格",
          "description": "门诊解析区/验证区 ClassNN"
        },
        {
          "key": "OptInputClassNN",
          "type": "string",
          "label": "门诊输入控件",
          "description": "门诊输入 ClassNN"
        },
        {
          "key": "OptPackUnits",
          "type": "stringList",
          "label": "门诊包装单位",
          "description": "数量「单位」落在此清单则按整包装计；与「门诊数量单位」不可重叠"
        },
        {
          "key": "OptPieceUnits",
          "type": "stringList",
          "label": "门诊数量单位",
          "description": "数量「单位」落在此清单则按非整包装数量计；未命中任一侧则中止"
        }
      ]
    },
    {
      "title": "住院窗口",
      "fields": [
        {
          "key": "IptWindowClass",
          "type": "string",
          "label": "住院窗口类",
          "description": "住院顶层窗口 Class"
        },
        {
          "key": "IptParseGridClassNN",
          "type": "string",
          "label": "住院解析网格",
          "description": "住院解析区 ClassNN"
        },
        {
          "key": "IptVerifyGridClassNN",
          "type": "string",
          "label": "住院验证网格",
          "description": "住院验证区 ClassNN"
        },
        {
          "key": "IptInputClassNN",
          "type": "string",
          "label": "住院输入控件",
          "description": "住院输入 ClassNN"
        }
      ]
    },
    {
      "title": "仓库任务",
      "fields": [
        {
          "key": "WarehouseEnabled",
          "type": "bool",
          "label": "启用仓库",
          "description": "是否启用仓库注入任务"
        },
        {
          "key": "CodePickPolicy",
          "type": "enum",
          "label": "选码策略",
          "options": [
            {
              "value": "MAX_LEVEL",
              "label": "按最大码"
            },
            {
              "value": "MIN_LEVEL",
              "label": "按最小码"
            }
          ]
        },
        {
          "key": "WarehouseAnchorTexts",
          "type": "stringList",
          "label": "仓库锚点文案",
          "description": "仓库界面特征文案，每行一条"
        }
      ]
    },
    {
      "title": "数据列解析",
      "fields": [
        {
          "key": "ColFields",
          "type": "colFieldList",
          "label": "解析列明细",
          "description": "每行一项：id、headers（/ 分隔别名）、必填、整数；锁定行仅可改 headers"
        }
      ]
    },
    {
      "title": "日志",
      "fields": [
        {
          "key": "LogEnabled",
          "type": "bool",
          "label": "启用模块日志",
          "description": "关闭后本模块不再写入日志文件"
        },
        {
          "key": "LogMinimumLevel",
          "type": "enum",
          "label": "最小级别",
          "description": "低于该级别的日志将被丢弃",
          "options": [
            "Debug",
            "Info",
            "Warn",
            "Error",
            "Fatal"
          ]
        },
        {
          "key": "LogRetentionDays",
          "type": "int",
          "label": "保留天数",
          "description": "超过保留天数的日志文件将被自动清理",
          "min": 1,
          "max": 180
        },
        {
          "key": "LogMaxFileSizeMb",
          "type": "int",
          "label": "单文件上限(MB)",
          "description": "单个日志文件的最大体积，超出后滚动到新文件",
          "min": 1,
          "max": 200
        }
      ]
    }
  ]
}
