<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="Version.g.props" Condition="Exists('Version.g.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PacToolkits.Api</RootNamespace>
    <AssemblyName>PacToolkits.Api</AssemblyName>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <AppVersion Condition="'$(AppVersion)' == ''">0.0.0-local</AppVersion>
    <Version Condition="'$(Version)' == ''">$(AppVersion)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.0.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">0.0.0.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(AppVersion)+local</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\packages\application\PacToolkits.Application.csproj" />
    <ProjectReference Include="..\..\..\packages\infrastructure\PacToolkits.Infrastructure.csproj" />
  </ItemGroup>

</Project>
