<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Grid.PageRoot">
    <Setter Property="Margin" Value="{DynamicResource PageRootMargin}" />
  </Style>

  <Style Selector="Grid.PageRootLayout">
    <Setter Property="Margin" Value="{DynamicResource PageRootMargin}" />
    <Setter Property="RowSpacing" Value="{DynamicResource PageRowSpacing}" />
  </Style>

  <Style Selector="Grid.FormLabelLayout">
    <Setter Property="ColumnSpacing" Value="{DynamicResource FormColumnSpacing}" />
    <Setter Property="RowSpacing" Value="{DynamicResource FormRowSpacing}" />
  </Style>

  <Style Selector="Grid.FormLabelReadonlyRow">
    <Setter Property="ColumnSpacing" Value="{DynamicResource PageColumnSpacing}" />
  </Style>

  <Style Selector="Grid.SettingsSectionHeader">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ColumnSpacing" Value="{DynamicResource PageColumnSpacing}" />
  </Style>

  <!--  Pair a left field/summary with right actions; ColumnDefinitions="*,Auto" must be set inline on the Grid.  -->
  <Style Selector="Grid.ToolbarPairRow">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ColumnSpacing" Value="{DynamicResource PageColumnSpacing}" />
  </Style>

  <Style Selector="StackPanel.SectionHeaderStack">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="{DynamicResource SpacingInlineMd}" />
  </Style>

  <Style Selector="Grid.DashboardShell">
    <Setter Property="RowSpacing" Value="{DynamicResource PageRowSpacing}" />
  </Style>

  <!-- Dashboard tabs: headers only; body lives in Grid row below. -->
  <Style Selector="TabControl.DashboardTabHeaders /template/ LayoutTransformControl > Border">
    <Setter Property="Background" Value="{DynamicResource SwitchBackgroundColor}" />
  </Style>

  <Style Selector="TabControl.DashboardTabHeaders /template/ StackPanel">
    <Setter Property="Spacing" Value="0" />
  </Style>

  <Style Selector="TabControl.DashboardTabHeaders /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="Height" Value="0" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="Border.DashboardFilterChrome">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource DashboardFilterBarPadding}" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Grid.DashboardFilterColumns">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Grid.DashboardFilterColumn">
    <Setter Property="Margin" Value="{DynamicResource DashboardFilterColumnPadding}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ColumnSpacing" Value="{DynamicResource DashboardFilterGroupSpacing}" />
  </Style>

  <Style Selector="Grid.DashboardFilterColumn > TextBlock.Caption">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.DashboardFilterColumnDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="{DynamicResource DashboardFilterDividerMargin}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource BorderColor}" />
  </Style>

  <Style Selector="Border.ShellConnectivityBanner">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
  </Style>

  <Style Selector="Border.ShellConnectivityBanner.error">
    <Setter Property="Background" Value="{DynamicResource BrushDangerBg15}" />
  </Style>

  <Style Selector="Border.ShellConnectivityBanner.warning">
    <Setter Property="Background" Value="{DynamicResource BrushWarningBg15}" />
  </Style>

  <Style Selector="Border.ShellConnectivityBanner.info">
    <Setter Property="Background" Value="{DynamicResource BrushWarningBg10}" />
  </Style>

  <Style Selector="Border.PageStaleBanner">
    <Setter Property="Background" Value="{DynamicResource BrushWarningBg10}" />
  </Style>

  <Style Selector="Border.ShellContentHeader">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
    <Setter Property="MinHeight" Value="{DynamicResource ContentChromeHeight}" />
  </Style>

  <Style Selector="ToggleButton.ShellChromeToggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MdCornerRadius}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Theme" Value="{DynamicResource SideTogglerTheme}" />
  </Style>

  <Style Selector="StackPanel.ShellContentHeaderMenuItemHeader">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="{DynamicResource SpacingInlineSm}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="StackPanel.ShellContentHeaderMenuItemHeader > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource ShellTitleSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Rectangle.ShellContentHeaderDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="{DynamicResource ShellContentHeaderDividerMargin}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource BorderColor}" />
  </Style>

  <Style Selector="Menu.ShellContentHeaderMenu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.ShellWorkspace">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundColor}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.ShellStatusBar">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
  </Style>
</Styles>
