<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI">
  <Style Selector="Grid.PageRoot">
    <Setter Property="Margin" Value="{DynamicResource PageRootMargin}" />
  </Style>

  <Style Selector="Grid.PageRootLayout">
    <Setter Property="Margin" Value="{DynamicResource PageRootMargin}" />
    <Setter Property="RowSpacing" Value="{DynamicResource PageRowSpacing}" />
  </Style>

  <Style Selector="Grid.FormFieldLayout">
    <Setter Property="ColumnSpacing" Value="{DynamicResource FormColumnSpacing}" />
    <Setter Property="RowSpacing" Value="{DynamicResource FormRowSpacing}" />
  </Style>

  <Style Selector="Grid.FormFieldReadonlyRow">
    <Setter Property="ColumnSpacing" Value="{DynamicResource PageColumnSpacing}" />
  </Style>

  <!--  Pair a left field/summary with right actions; ColumnDefinitions="*,Auto" must be set inline on the Grid.  -->
  <Style Selector="Grid.ToolbarPairRow">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ColumnSpacing" Value="{DynamicResource PageColumnSpacing}" />
  </Style>

  <Style Selector="StackPanel.SectionHeaderStack">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="{DynamicResource SpacingInlineMd}" />
  </Style>

  <Style Selector="Grid.DashboardLayout">
    <Setter Property="RowSpacing" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="Grid.DashboardContent">
    <Setter Property="Margin" Value="{DynamicResource PageRootMargin}" />
  </Style>

  <!--  Dashboard tabs in content header: layout only (center in header, hide empty content host).  -->
  <Style Selector="TabControl.DashboardTabHeaders">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TabControl.DashboardTabHeaders /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="Height" Value="0" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="Border.FilterBarChrome">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource FilterBarPadding}" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Grid.FilterBarColumns">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.DashboardTabContext">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>

  <Style Selector="Border.DashboardTabContext icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
  </Style>

  <Style Selector="Grid.FilterBarColumn">
    <Setter Property="Margin" Value="{DynamicResource FilterBarColumnPadding}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ColumnSpacing" Value="{DynamicResource FilterBarGroupSpacing}" />
  </Style>

  <Style Selector="Grid.FilterBarColumn &gt; TextBlock.Caption">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.FilterBarDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource BorderColor}" />
  </Style>

  <Style Selector="Border.ConnectivityBanner">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
  </Style>

  <Style Selector="Border.ConnectivityBanner.error">
    <Setter Property="Background" Value="{DynamicResource ErrorColor10}" />
  </Style>

  <Style Selector="Border.ConnectivityBanner.warning">
    <Setter Property="Background" Value="{DynamicResource WarningColor10}" />
  </Style>

  <Style Selector="Border.ConnectivityBanner.info">
    <Setter Property="Background" Value="{DynamicResource WarningColor10}" />
  </Style>

  <Style Selector="Border.PageStaleBanner">
    <Setter Property="Background" Value="{DynamicResource WarningColor10}" />
  </Style>

  <Style Selector="Border.PageHeader">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
    <Setter Property="MinHeight" Value="{DynamicResource ChromeRowHeight}" />
  </Style>

  <Style Selector="StackPanel.HeaderMenuItem">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="{DynamicResource SpacingInlineSm}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="StackPanel.HeaderMenuItem &gt; TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource HeaderMenuTitleSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Rectangle.HeaderDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="{DynamicResource HeaderDividerMargin}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource BorderColor}" />
  </Style>

  <Style Selector="StackPanel.HeaderTitleRail">
    <Setter Property="Spacing" Value="{DynamicResource SpacingInlineSm}" />
  </Style>

  <Style Selector="StackPanel.HeaderTitleRail &gt; TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="icons|AppIcon.HeaderTitleChevron">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
  </Style>

  <Style Selector="Menu.HeaderMenu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.ContentWorkspace">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundColor}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.StatusBar">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
  </Style>
</Styles>
