<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls">
  <Style Selector="UserControl.SettingsPage TextBox">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseFloatingWatermark" Value="False" />
  </Style>

  <Style Selector="UserControl.SettingsPage ComboBox">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="UserControl.SettingsPage NumericUpDown">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="StackPanel.SettingsNavHost > Button.SettingsNavItem">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="{DynamicResource SettingsNavButtonPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource ButtonPrimaryMinHeight}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                   Content="{TemplateBinding Content}"
                   ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="StackPanel.SettingsNavHost > Button.SettingsNavItem > StackPanel">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="StackPanel.SettingsNavHost > Button.SettingsNavItem icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource SidebarMenuIconSize}" />
    <Setter Property="Height" Value="{DynamicResource SidebarMenuIconSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource NavTextRest}" />
  </Style>

  <Style Selector="StackPanel.SettingsNavHost > Button.SettingsNavItem TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource NavTextRest}" />
  </Style>

  <Style Selector="StackPanel.SettingsNavHost > Button.SettingsNavItem:not(.Active):pointerover,
                     StackPanel.SettingsNavHost > Button.SettingsNavItem:not(.Active):pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="StackPanel.SettingsNavHost > Button.SettingsNavItem:not(.Active):pointerover /template/ Border,
                     StackPanel.SettingsNavHost > Button.SettingsNavItem:not(.Active):pressed /template/ Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="StackPanel.SettingsNavHost > Button.SettingsNavItem:not(.Active):pointerover icons|AppIcon,
                     StackPanel.SettingsNavHost > Button.SettingsNavItem:not(.Active):pressed icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextHover}" />
  </Style>

  <Style Selector="StackPanel.SettingsNavHost > Button.SettingsNavItem:not(.Active):pointerover TextBlock,
                     StackPanel.SettingsNavHost > Button.SettingsNavItem:not(.Active):pressed TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NavTextHover}" />
  </Style>

  <Style Selector="StackPanel.SettingsNavHost > Button.SettingsNavItem.Active,
                     StackPanel.SettingsNavHost > Button.SettingsNavItem.Active:pointerover">
    <Setter Property="Background" Value="{DynamicResource NavIndicatorBrushExpanded}" />
  </Style>

  <Style Selector="StackPanel.SettingsNavHost > Button.SettingsNavItem.Active icons|AppIcon,
                     StackPanel.SettingsNavHost > Button.SettingsNavItem.Active:pointerover icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
  </Style>

  <Style Selector="StackPanel.SettingsNavHost > Button.SettingsNavItem.Active TextBlock,
                     StackPanel.SettingsNavHost > Button.SettingsNavItem.Active:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</Styles>
