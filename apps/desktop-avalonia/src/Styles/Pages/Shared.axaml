<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Style Selector="shad|Badge.MsfxMetaBadge">
    <Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="shad|Badge.MsfxMetaBadge /template/ ContentPresenter">
    <Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

</Styles>
