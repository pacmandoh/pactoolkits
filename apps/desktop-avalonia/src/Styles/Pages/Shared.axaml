<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Style Selector="shad|Badge.MsfxMetaBadge">
    <Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="shad|Badge.MsfxMetaBadge /template/ ContentPresenter">
    <Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <Style Selector="Button.MsfxMiniIconBtn">
    <Setter Property="Width" Value="{DynamicResource MsfxIconBtnSize}" />
    <Setter Property="Height" Value="{DynamicResource MsfxIconBtnSize}" />
    <Setter Property="MinWidth" Value="{DynamicResource MsfxIconBtnSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource MsfxIconBtnSize}" />
    <Setter Property="Padding" Value="{DynamicResource MsfxIconBtnPadding}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
</Styles>
