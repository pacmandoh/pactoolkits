<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!--  Slightly darker than SukiStrongBackground (#fcfcfc).  -->
      <Color x:Key="ShellChromeBackgroundColor">#ebebeb</Color>
      <SolidColorBrush x:Key="ShellStatusItemHoverBrush" Color="#14000000" />
      <SolidColorBrush x:Key="ShellStatusItemActiveBrush" Color="#22000000" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <!--  Slightly darker than SukiStrongBackground (#353535).  -->
      <Color x:Key="ShellChromeBackgroundColor">#252525</Color>
      <SolidColorBrush x:Key="ShellStatusItemHoverBrush" Color="#18FFFFFF" />
      <SolidColorBrush x:Key="ShellStatusItemActiveBrush" Color="#2AFFFFFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="ShellChromeBackgroundBrush" Color="{DynamicResource ShellChromeBackgroundColor}" />
  <SolidColorBrush x:Key="AutoCompleteDarkBackgroundBrush" Color="#1E000000" />
</ResourceDictionary>
