<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    透明度：10≈0.1 / 20≈0.2 / 60≈0.6；底色与 ChartCategoryPurpleColor 同源
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PurpleColor">#8B5CF6</Color>
      <Color x:Key="PurpleColor10">#1A8B5CF6</Color>
      <Color x:Key="PurpleColor20">#338B5CF6</Color>
      <Color x:Key="PurpleColor60">#998B5CF6</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PurpleColor">#6D28D9</Color>
      <Color x:Key="PurpleColor10">#1A6D28D9</Color>
      <Color x:Key="PurpleColor20">#336D28D9</Color>
      <Color x:Key="PurpleColor60">#996D28D9</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
