<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="TitleBarBackgroundColor">#FFFFFF</Color>
      <Color x:Key="ShellAccentColor">#3D6FEF</Color>
      <SolidColorBrush x:Key="CardPanelSectionBg" Color="{DynamicResource DialogBackgroundColor}" />
      <SolidColorBrush x:Key="TabItemsBackgroundColor" Color="{DynamicResource SwitchBackgroundColor}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="TitleBarBackgroundColor">#171717</Color>
      <Color x:Key="ShellAccentColor">#1140D0</Color>
      <SolidColorBrush x:Key="CardPanelSectionBg" Color="{DynamicResource SwitchBackgroundColor}" />
      <SolidColorBrush x:Key="TabItemsBackgroundColor" Color="{DynamicResource SwitchBackgroundColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="ShellAccentBrush" Color="{DynamicResource ShellAccentColor}" />
  <Color x:Key="ShellAccentOnColor">#FFFFFF</Color>
</ResourceDictionary>
