<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI">
  <!--
    Shad Card wraps content in a ScrollViewer. Data pages host DataGrid inside Card,
    which breaks row virtualization (nested scroll + infinite measure). Use a direct
    ContentPresenter; opt into ScrollHostCard when scroll is needed.
  -->
  <Style Selector="shad|Card">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate TargetType="shad:Card">
        <Border
          Name="OuterBorder"
          Width="{TemplateBinding Width}"
          Height="{TemplateBinding Height}"
          Margin="{TemplateBinding Margin}">
          <Border
            Name="Container"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <Grid Margin="{TemplateBinding Padding}" RowDefinitions="Auto,*,Auto">
              <ContentPresenter
                Grid.Row="0"
                Margin="0,0,0,24"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Header}"
                IsVisible="{TemplateBinding Header,
                                            Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ContentPresenter
                Grid.Row="1"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}" />
              <ContentPresenter
                Grid.Row="2"
                Margin="0,24,0,0"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Footer}"
                IsVisible="{TemplateBinding Footer,
                                            Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="shad|Card.ScrollHostCard">
    <Setter Property="Template">
      <ControlTemplate TargetType="shad:Card">
        <Border
          Name="OuterBorder"
          Width="{TemplateBinding Width}"
          Height="{TemplateBinding Height}"
          Margin="{TemplateBinding Margin}">
          <Border
            Name="Container"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <Grid Margin="{TemplateBinding Padding}" RowDefinitions="Auto,*,Auto">
              <ContentPresenter
                Grid.Row="0"
                Margin="0,0,0,24"
                Content="{TemplateBinding Header}"
                IsVisible="{TemplateBinding Header,
                                            Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <ContentPresenter
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                  Content="{TemplateBinding Content}" />
              </ScrollViewer>
              <ContentPresenter
                Grid.Row="2"
                Margin="0,24,0,0"
                Content="{TemplateBinding Footer}"
                IsVisible="{TemplateBinding Footer,
                                            Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="shad|Card.SectionCard">
    <Setter Property="CornerRadius" Value="{DynamicResource SectionCardRadius}" />
    <Setter Property="Padding" Value="{DynamicResource SectionCardPadding}" />
  </Style>

  <Style Selector="shad|Card.PageHero">
    <Setter Property="Padding" Value="{DynamicResource AboutHeroCardPadding}" />
  </Style>

  <Style Selector="shad|Card.ActionTile">
    <Setter Property="Padding" Value="{DynamicResource FilterHintCardPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource ActionTileMinHeight}" />
  </Style>

  <Style Selector="shad|Card.TraceCodePreviewCard">
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}" />
    <Setter Property="MinHeight" Value="120" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.HeroIconBadge">
    <Setter Property="Width" Value="{DynamicResource HeroIconBadgeSize}" />
    <Setter Property="Height" Value="{DynamicResource HeroIconBadgeSize}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.HeroIconBadge &gt; icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource HeroIconBadgeInnerSize}" />
    <Setter Property="Height" Value="{DynamicResource HeroIconBadgeInnerSize}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.MsfxBoardSkeletonOverlay">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
    <Setter Property="CornerRadius" Value="{DynamicResource SectionCardRadius}" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>

  <Style Selector="Border.MsfxBoardSkeletonTile">
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}" />
    <Setter Property="MinHeight" Value="120" />
  </Style>

  <Style Selector="Border.GridSlotSkeleton">
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>
</Styles>
