<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="https://github.com/kikipoulet/SukiUI"
    xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls">
  <Style Selector="con|GlassCard.SectionCard">
    <Setter Property="CornerRadius" Value="{DynamicResource SectionCardRadius}" />
    <Setter Property="Padding" Value="{DynamicResource SectionCardPadding}" />
  </Style>

  <Style Selector="con|GlassCard.PageHero">
    <Setter Property="Padding" Value="{DynamicResource AboutHeroCardPadding}" />
  </Style>

  <Style Selector="con|GlassCard.ScanCodeHeroCard">
    <Setter Property="Padding" Value="{DynamicResource ScanCodeHeroCardPadding}" />
  </Style>

  <Style Selector="con|GlassCard.CompactCard">
    <Setter Property="Padding" Value="{DynamicResource FilterHintCardPadding}" />
  </Style>

  <Style Selector="con|GlassCard.ActionTile">
    <Setter Property="Padding" Value="{DynamicResource FilterHintCardPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource ActionTileMinHeight}" />
  </Style>

  <Style Selector="con|GlassCard.FilterFieldCard">
    <Setter Property="Padding" Value="{DynamicResource CompactPadding}" />
    <Setter Property="Opacity" Value="0.94" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="con|GlassCard.FilterFieldCard > Grid">
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="con|GlassCard.FilterSectionCard,
                     con|GlassCard.ScanCodeHeroCard">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="con|GlassCard.FilterHintCard">
    <Setter Property="Padding" Value="{DynamicResource FilterHintCardPadding}" />
    <Setter Property="Opacity" Value="0.98" />
  </Style>

  <Style Selector="con|GlassCard.CounterPillCard">
    <Setter Property="Padding" Value="{DynamicResource CompactPadding}" />
    <Setter Property="Opacity" Value="0.96" />
  </Style>

  <Style Selector="Border.HeroIconBadge">
    <Setter Property="Width" Value="{DynamicResource HeroIconBadgeSize}" />
    <Setter Property="Height" Value="{DynamicResource HeroIconBadgeSize}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.HeroIconBadge > icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource HeroIconBadgeInnerSize}" />
    <Setter Property="Height" Value="{DynamicResource HeroIconBadgeInnerSize}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</Styles>
