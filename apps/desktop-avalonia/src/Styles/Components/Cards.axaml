<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI">
  <!--
    Shad Card wraps content in a ScrollViewer. Data pages host DataGrid inside Card,
    which breaks row virtualization (nested scroll + infinite measure). Use a direct
    ContentPresenter; opt into ScrollHostCard when scroll is needed.
  -->
  <Style Selector="shad|Card">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate TargetType="shad:Card">
        <Border
          Name="OuterBorder"
          Width="{TemplateBinding Width}"
          Height="{TemplateBinding Height}"
          Margin="{TemplateBinding Margin}">
          <Border
            Name="Container"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <Grid Margin="{TemplateBinding Padding}" RowDefinitions="Auto,*,Auto">
              <ContentPresenter
                Grid.Row="0"
                Margin="0,0,0,24"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Header}"
                IsVisible="{TemplateBinding Header,
                                            Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ContentPresenter
                Grid.Row="1"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}" />
              <ContentPresenter
                Grid.Row="2"
                Margin="0,24,0,0"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Footer}"
                IsVisible="{TemplateBinding Footer,
                                            Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="shad|Card.ScrollHostCard">
    <Setter Property="Template">
      <ControlTemplate TargetType="shad:Card">
        <Border
          Name="OuterBorder"
          Width="{TemplateBinding Width}"
          Height="{TemplateBinding Height}"
          Margin="{TemplateBinding Margin}">
          <Border
            Name="Container"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <Grid Margin="{TemplateBinding Padding}" RowDefinitions="Auto,*,Auto">
              <ContentPresenter
                Grid.Row="0"
                Margin="0,0,0,24"
                Content="{TemplateBinding Header}"
                IsVisible="{TemplateBinding Header,
                                            Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <ContentPresenter
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                  Content="{TemplateBinding Content}" />
              </ScrollViewer>
              <ContentPresenter
                Grid.Row="2"
                Margin="0,24,0,0"
                Content="{TemplateBinding Footer}"
                IsVisible="{TemplateBinding Footer,
                                            Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="shad|Card.SectionCard">
    <Setter Property="CornerRadius" Value="{DynamicResource XlCornerRadius}" />
    <Setter Property="Padding" Value="{DynamicResource SectionCardPadding}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="shad:Card">
        <Border
          Name="OuterBorder"
          Width="{TemplateBinding Width}"
          Height="{TemplateBinding Height}"
          Margin="{TemplateBinding Margin}">
          <Border
            Name="Container"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <Grid
              Margin="{TemplateBinding Padding}"
              RowDefinitions="Auto,*,Auto"
              RowSpacing="{DynamicResource SectionCardZoneGap}">
              <ContentPresenter
                Grid.Row="0"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Header}"
                IsVisible="{TemplateBinding Header,
                                            Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ContentPresenter
                x:Name="SectionBody"
                Grid.Row="1"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}" />
              <ScrollViewer
                x:Name="SectionBodyScroll"
                Grid.Row="1"
                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                IsVisible="False"
                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <ContentPresenter
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                  Content="{TemplateBinding Content}" />
              </ScrollViewer>
              <ContentPresenter
                Grid.Row="2"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Footer}"
                IsVisible="{TemplateBinding Footer,
                                            Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="shad|Card.SectionCard.ScrollHostCard /template/ ContentPresenter#SectionBody">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="shad|Card.SectionCard.ScrollHostCard /template/ ScrollViewer#SectionBodyScroll">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="shad|Card.SectionCard Grid.SectionCardFoot">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ColumnSpacing" Value="{DynamicResource PageColumnSpacing}" />
  </Style>

  <Style Selector="shad|Card.SectionCard Grid.SectionCardFoot &gt; StackPanel, shad|Card.SectionCard Grid.SectionCardFoot Button">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="shad|Card.SectionCard.ScrollHostCard, shad|Card.SectionCard.StretchBody">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.GridSlotSkeleton">
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource XlCornerRadius}" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>
</Styles>
