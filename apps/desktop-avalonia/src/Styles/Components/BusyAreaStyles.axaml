<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI">
  <!--
    ShadUI default uses BusyAreaOverlayColor (third-tone gray mask). Pac uses Suki-style dim:
    content stays on the host background; busy dims ContentPresenter and shows a centered spinner.
    No AreaBackground — avoids gray-on-black clash with SectionPanel Inner (WindowBackgroundColor).
  -->
  <Style Selector="shad|BusyArea">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter
            Name="PART_ContentPresenter"
            HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
            VerticalAlignment="{TemplateBinding VerticalAlignment}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            Opacity="1">
            <ContentPresenter.Transitions>
              <Transitions>
                <DoubleTransition Duration="0:0:0.3" Easing="{StaticResource EaseOut}" Property="Opacity" />
              </Transitions>
            </ContentPresenter.Transitions>
          </ContentPresenter>

          <Viewbox
            Name="LoadingIndicator"
            Height="{TemplateBinding LoadingSize}"
            HorizontalAlignment="Center"
            IsHitTestVisible="False"
            IsVisible="False"
            VerticalAlignment="Center"
            Width="{TemplateBinding LoadingSize}">
            <ContentPresenter Content="{TemplateBinding IsBusy, Converter={x:Static shad:BooleanConverters.ToLoading}}" />
          </Viewbox>

          <Panel.Styles>
            <Style Selector="shad|BusyArea[IsBusy=True] /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Opacity" Value="0.1" />
            </Style>
            <Style Selector="shad|BusyArea[IsBusy=False] /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="shad|BusyArea[IsBusy=True] /template/ Viewbox#LoadingIndicator">
              <Setter Property="IsVisible" Value="True" />
              <Setter Property="IsHitTestVisible" Value="True" />
            </Style>
            <Style Selector="shad|BusyArea[IsBusy=False] /template/ Viewbox#LoadingIndicator">
              <Setter Property="IsVisible" Value="False" />
              <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
          </Panel.Styles>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
