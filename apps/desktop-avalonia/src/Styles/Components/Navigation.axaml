<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI">
  <Style Selector="shad|Window MenuItem:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="Padding" Value="{DynamicResource SidebarChromePadding}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar /template/ ScrollViewer">
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar MenuItem.SidebarFunctionAreaMenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar MenuItem.SidebarFunctionAreaMenuItem /template/ Border#BaseBackground">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar MenuItem.SidebarFunctionAreaMenuItem:pointerover /template/ Border#HoverBackground">
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar MenuItem.SidebarFunctionAreaMenuItem:pointerover /template/ Border#BaseBackground">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="Border.SidebarFunctionAreaBadge">
    <Setter Property="Background" Value="{DynamicResource SidebarFunctionAreaBadgeBrush}" />
  </Style>

  <Style Selector="Border.SidebarFunctionAreaBadge icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource SidebarFunctionAreaBadgeForegroundBrush}" />
  </Style>

  <Style Selector="StackPanel.SidebarFunctionAreaText">
    <Setter Property="Spacing" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="StackPanel.SidebarFunctionAreaText &gt; TextBlock.Small,                      Border.ConnectivityBanner TextBlock.Small,                      Border.ShellContentHeader TextBlock.Small">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=True] MenuItem.SidebarFunctionAreaMenuItem">
    <Setter Property="Margin" Value="{DynamicResource SidebarFunctionAreaExpandedMargin}" />
    <Setter Property="MinHeight" Value="{DynamicResource ContentChromeHeight}" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] MenuItem.SidebarFunctionAreaMenuItem">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="MinHeight" Value="{DynamicResource ContentChromeHeight}" />
    <Setter Property="MaxHeight" Value="{DynamicResource ContentChromeHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] StackPanel.SidebarNavHost">
    <Setter Property="Spacing" Value="{DynamicResource SidebarNavItemSpacing}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=True] shad|SidebarItemLabel.SidebarNavSectionLabel">
    <Setter Property="Margin" Value="8,0,8,8" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] shad|SidebarItemLabel.SidebarNavSectionLabel">
    <Setter Property="Margin" Value="{DynamicResource SidebarNavSeparatorMargin}" />
  </Style>

  <Style Selector="Image.SidebarBrandIcon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem Viewbox">
    <Setter Property="Width" Value="{DynamicResource SidebarMenuIconSize}" />
    <Setter Property="Height" Value="{DynamicResource SidebarMenuIconSize}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar MenuItem Viewbox">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>

  <Style Selector="StackPanel.SidebarAccountText">
    <Setter Property="Spacing" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--  Sidebar nav: left indicator bar on selection; hover tints text/icon only.  -->
  <Style Selector="shad|Sidebar#MainSidebar[Expanded=True] shad|SidebarItem">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] shad|SidebarItem">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="4,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] MenuItem.SidebarFooterMenuItem">
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked)">
    <Setter Property="Foreground" Value="{DynamicResource NavTextRest}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked) icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextRest}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked) TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NavTextRest}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pointerover /template/ Border#HoverBackground,                      shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pressed /template/ Border#HoverBackground">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pointerover /template/ Border#BaseBackground">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pointerover,                      shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pressed">
    <Setter Property="Foreground" Value="{DynamicResource NavTextHover}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pointerover icons|AppIcon,                      shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pressed icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextHover}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pointerover TextBlock,                      shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pressed TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NavTextHover}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:checked /template/ Border#SelectedBackground,                      shad|Sidebar#MainSidebar shad|SidebarItem:checked /template/ Border#HoverBackground">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=True] shad|SidebarItem:checked /template/ Border#BaseBackground,                      shad|Sidebar#MainSidebar[Expanded=True] shad|SidebarItem:checked:pointerover /template/ Border#BaseBackground">
    <Setter Property="Background" Value="{DynamicResource NavIndicatorBrushExpanded}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] shad|SidebarItem:checked /template/ Border#BaseBackground,                      shad|Sidebar#MainSidebar[Expanded=False] shad|SidebarItem:checked:pointerover /template/ Border#BaseBackground">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource NavIndicatorBarBrush}" />
    <Setter Property="BorderThickness" Value="4,0,0,0" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:checked,                      shad|Sidebar#MainSidebar shad|SidebarItem:checked:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:checked icons|AppIcon,                      shad|Sidebar#MainSidebar shad|SidebarItem:checked:pointerover icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:checked TextBlock,                      shad|Sidebar#MainSidebar shad|SidebarItem:checked:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--  Tab strip chrome: align with SectionPanel outer via SectionPanelChromeBackground.  -->
  <Style Selector="StackPanel.TabItemHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="{DynamicResource SpacingInlineSm}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="StackPanel.TabItemHeader &gt; TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
