<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI">
  <Style Selector="shad|Window MenuItem:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="Padding" Value="{DynamicResource SidebarChromePadding}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar /template/ ScrollViewer">
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar MenuItem.SidebarFuncMenuItem">
    <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] MenuItem.SidebarFuncMenuItem /template/ Border#BaseBackground">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] MenuItem.SidebarFuncMenuItem:pointerover /template/ Border#HoverBackground, shad|Sidebar#MainSidebar[Expanded=False] MenuItem.SidebarFuncMenuItem:pressed /template/ Border#HoverBackground, shad|Sidebar#MainSidebar[Expanded=False] MenuItem.SidebarFuncMenuItem:open /template/ Border#HoverBackground, shad|Sidebar#MainSidebar[Expanded=False] MenuItem.SidebarFuncMenuItem:selected /template/ Border#HoverBackground">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="Border.SidebarFuncBadge">
    <Setter Property="Background" Value="{DynamicResource ShellAccentColor}" />
  </Style>

  <Style Selector="Border.SidebarFuncBadge icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentOnColor}" />
  </Style>

  <Style Selector="Border.UpdateDot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="{DynamicResource WarningColor}" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>

  <Style Selector="Border.SidebarFuncHost">
    <Setter Property="MinHeight" Value="{DynamicResource SidebarFuncHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] Border.SidebarFuncHost">
    <Setter Property="MinHeight" Value="{DynamicResource ChromeRowHeight}" />
  </Style>

  <Style Selector="StackPanel.SidebarFuncText">
    <Setter Property="Spacing" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="StackPanel.SidebarFuncText &gt; TextBlock.Small,Border.ConnectivityBanner TextBlock.Small,Border.PageHeader TextBlock.Small">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=True] MenuItem.SidebarFuncMenuItem, shad|Sidebar#MainSidebar[Expanded=True] MenuItem.SidebarFooterMenuItem">
    <Setter Property="Margin" Value="{DynamicResource SidebarFuncMargin}" />
    <Setter Property="MinHeight" Value="{DynamicResource ChromeRowHeight}" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] MenuItem.SidebarFuncMenuItem">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="MinHeight" Value="{DynamicResource ChromeRowHeight}" />
    <Setter Property="MaxHeight" Value="{DynamicResource ChromeRowHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] Border.SidebarFuncBadge">
    <Setter Property="Width" Value="{DynamicResource SidebarFuncCollapsedSize}" />
    <Setter Property="Height" Value="{DynamicResource SidebarFuncCollapsedSize}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] MenuItem.SidebarFuncMenuItem:pointerover Border.SidebarFuncBadge, shad|Sidebar#MainSidebar[Expanded=False] MenuItem.SidebarFuncMenuItem:pressed Border.SidebarFuncBadge, shad|Sidebar#MainSidebar[Expanded=False] MenuItem.SidebarFuncMenuItem:open Border.SidebarFuncBadge, shad|Sidebar#MainSidebar[Expanded=False] MenuItem.SidebarFuncMenuItem:selected Border.SidebarFuncBadge">
    <Setter Property="Opacity" Value="0.82" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] StackPanel.SidebarNavHost">
    <Setter Property="Spacing" Value="{DynamicResource SidebarNavItemSpacing}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=True] shad|SidebarItemLabel.SidebarSectionLabel">
    <Setter Property="Margin" Value="8,0,8,8" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] shad|SidebarItemLabel.SidebarSectionLabel">
    <Setter Property="Margin" Value="{DynamicResource SidebarNavSeparatorMargin}" />
  </Style>

  <Style Selector="Image.SidebarBrandIcon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem Viewbox">
    <Setter Property="Width" Value="{DynamicResource IconSizeHeader}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeHeader}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] shad|SidebarItem Viewbox">
    <Setter Property="Width" Value="{DynamicResource SidebarCollapsedIconSize}" />
    <Setter Property="Height" Value="{DynamicResource SidebarCollapsedIconSize}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar MenuItem Viewbox">
    <Setter Property="Width" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeSmall}" />
  </Style>

  <Style Selector="StackPanel.SidebarAccountText">
    <Setter Property="Spacing" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--  Sidebar nav: left indicator bar on selection; hover tints text/icon only.  -->
  <Style Selector="shad|Sidebar#MainSidebar[Expanded=True] shad|SidebarItem">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] shad|SidebarItem">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="4,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked) icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextRest}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked) /template/ Border#PART_BorderContainer">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NavTextRest}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pointerover /template/ Border#HoverBackground,shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pressed /template/ Border#HoverBackground">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pointerover /template/ Border#BaseBackground">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pointerover icons|AppIcon,shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pressed icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextHover}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pointerover /template/ Border#PART_BorderContainer,shad|Sidebar#MainSidebar shad|SidebarItem:not(:checked):pressed /template/ Border#PART_BorderContainer">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NavTextHover}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:checked /template/ Border#SelectedBackground,shad|Sidebar#MainSidebar shad|SidebarItem:checked /template/ Border#HoverBackground">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=True] shad|SidebarItem:checked /template/ Border#BaseBackground,shad|Sidebar#MainSidebar[Expanded=True] shad|SidebarItem:checked:pointerover /template/ Border#BaseBackground">
    <Setter Property="Background" Value="{DynamicResource NavIndicatorBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar[Expanded=False] shad|SidebarItem:checked /template/ Border#BaseBackground,shad|Sidebar#MainSidebar[Expanded=False] shad|SidebarItem:checked:pointerover /template/ Border#BaseBackground">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource NavIndicatorFg}" />
    <Setter Property="BorderThickness" Value="4,0,0,0" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:checked icons|AppIcon,shad|Sidebar#MainSidebar shad|SidebarItem:checked:pointerover icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:checked /template/ Border#PART_BorderContainer,shad|Sidebar#MainSidebar shad|SidebarItem:checked:pointerover /template/ Border#PART_BorderContainer">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NavTextSelected}" />
  </Style>

  <Style Selector="shad|Sidebar#MainSidebar shad|SidebarItem:checked /template/ TextBlock,shad|Sidebar#MainSidebar shad|SidebarItem:checked:pointerover /template/ TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--  Tab item header content layout.  -->
  <Style Selector="StackPanel.TabItemHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="{DynamicResource SpacingInlineSm}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="StackPanel.TabItemHeader &gt; TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
