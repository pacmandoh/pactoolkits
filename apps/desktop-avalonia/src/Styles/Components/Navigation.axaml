<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:con="https://github.com/kikipoulet/SukiUI"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:sukiControls="clr-namespace:SukiUI.Controls;assembly=SukiUI">
  <Style Selector="con|SukiWindow MenuItem:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <Style Selector="sukiControls|SukiSideMenu#MainSideMenu[IsMenuExpanded=False] /template/ ContentControl">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource SidebarMenuIconSize}" />
    <Setter Property="Height" Value="{DynamicResource SidebarMenuIconSize}" />
    <Setter Property="StrokeWidth" Value="{DynamicResource SidebarMenuIconStroke}" />
  </Style>

  <Style Selector="con|SukiSideMenuItem /template/ TextBlock#PART_Header">
    <Setter Property="Foreground" Value="{DynamicResource NavTextRest}" />
  </Style>

  <Style Selector="con|SukiSideMenuItem /template/ ContentControl#PART_Icon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextRest}" />
  </Style>

  <Style Selector="con|SukiSideMenuItem /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <!--  Expanded: Suki PART_Border is rounded — clip makes full-height bar look like a pill.  -->
  <Style Selector="con|SukiSideMenu[IsMenuExpanded=True] con|SukiSideMenuItem /template/ Border#PART_Border">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem[IsSelected=False]:pointerover /template/ Border#PART_Border,                      con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem[IsSelected=False]:pressed /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem[IsSelected=False]:pointerover,                      con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem[IsSelected=False]:pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem[IsSelected=False] icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextRest}" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem[IsSelected=False]:pointerover /template/ TextBlock#PART_Header,                      con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem[IsSelected=False]:pressed /template/ TextBlock#PART_Header">
    <Setter Property="Foreground" Value="{DynamicResource NavTextHover}" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem[IsSelected=False]:pointerover /template/ ContentControl#PART_Icon,                      con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem[IsSelected=False]:pressed /template/ ContentControl#PART_Icon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextHover}" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem[IsSelected=True] icons|AppIcon,                      con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem[IsSelected=True]:pointerover icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem[IsSelected=False]:pointerover icons|AppIcon,                      con|SukiSideMenu#MainSideMenu con|SukiSideMenuItem[IsSelected=False]:pressed icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextHover}" />
  </Style>

  <Style Selector="con|SukiSideMenu[IsMenuExpanded=True] con|SukiSideMenuItem[IsSelected=True] /template/ Border#PART_Border,                      con|SukiSideMenu[IsMenuExpanded=True] con|SukiSideMenuItem[IsSelected=True]:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource NavIndicatorBrushExpanded}" />
  </Style>

  <Style Selector="con|SukiSideMenu[IsMenuExpanded=False] con|SukiSideMenuItem[IsSelected=True] /template/ Border#PART_Border,                      con|SukiSideMenu[IsMenuExpanded=False] con|SukiSideMenuItem[IsSelected=True]:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource NavIndicatorBrushCollapsed}" />
  </Style>

  <Style Selector="con|SukiSideMenuItem[IsSelected=True] /template/ TextBlock#PART_Header">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="con|SukiSideMenuItem[IsSelected=True] /template/ ContentControl#PART_Icon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
  </Style>

  <Style Selector="con|SukiSideMenuItem[IsSelected=True]:pointerover /template/ TextBlock#PART_Header">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
  </Style>

  <Style Selector="con|SukiSideMenuItem[IsSelected=True]:pointerover /template/ ContentControl#PART_Icon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
  </Style>

  <Style Selector="Button.SidebarFooterAction">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          x:Name="PART_Border"
          Padding="{TemplateBinding Padding}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=False] Button.SidebarFooterAction">
    <Setter Property="Width" Value="{DynamicResource SidebarCompactActionWidth}" />
    <Setter Property="Height" Value="{DynamicResource SidebarFooterActionHeight}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction">
    <Setter Property="Height" Value="{DynamicResource SidebarFooterActionHeight}" />
    <Setter Property="Padding" Value="{DynamicResource SidebarFooterExpandedPadding}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=False] Button.SidebarFooterAction icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource SidebarCompactIconSize}" />
    <Setter Property="Height" Value="{DynamicResource SidebarCompactIconSize}" />
    <Setter Property="StrokeWidth" Value="{DynamicResource SidebarCompactIconStroke}" />
    <Setter Property="Foreground" Value="{DynamicResource NavTextRest}" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource SidebarMenuIconSize}" />
    <Setter Property="Height" Value="{DynamicResource SidebarMenuIconSize}" />
    <Setter Property="StrokeWidth" Value="{DynamicResource SidebarMenuIconStroke}" />
    <Setter Property="Foreground" Value="{DynamicResource NavTextRest}" />
  </Style>

  <Style Selector="Button.SidebarFooterAction TextBlock.SidebarFooterLabel">
    <Setter Property="Foreground" Value="{DynamicResource NavTextRest}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=False] Button.SidebarFooterAction:pointerover,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=False] Button.SidebarFooterAction:pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=False] Button.SidebarFooterAction:pointerover icons|AppIcon,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=False] Button.SidebarFooterAction:pressed icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextHover}" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=False] Button.SidebarFooterAction.active,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=False] Button.SidebarFooterAction.active:pointerover,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=False] Button.SidebarFooterAction.active:pressed">
    <Setter Property="Background" Value="{DynamicResource NavIndicatorBrushCollapsed}" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=False] Button.SidebarFooterAction.active icons|AppIcon,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=False] Button.SidebarFooterAction.active:pointerover icons|AppIcon,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=False] Button.SidebarFooterAction.active:pressed icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction:pointerover,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction:pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction:pointerover icons|AppIcon,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction:pressed icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextHover}" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction:pointerover TextBlock.SidebarFooterLabel,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction:pressed TextBlock.SidebarFooterLabel">
    <Setter Property="Foreground" Value="{DynamicResource NavTextHover}" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction.active,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction.active:pointerover,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction.active:pressed">
    <Setter Property="Background" Value="{DynamicResource NavIndicatorBrushExpanded}" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction.active icons|AppIcon,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction.active:pointerover icons|AppIcon,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction.active:pressed icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
  </Style>

  <Style Selector="con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction.active TextBlock.SidebarFooterLabel,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction.active:pointerover TextBlock.SidebarFooterLabel,                      con|SukiSideMenu#MainSideMenu[IsMenuExpanded=True] Button.SidebarFooterAction.active:pressed TextBlock.SidebarFooterLabel">
    <Setter Property="Foreground" Value="{DynamicResource NavTextSelected}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</Styles>
