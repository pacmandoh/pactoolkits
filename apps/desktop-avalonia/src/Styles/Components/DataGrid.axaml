<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:PacToolkits.Desktop.Avalonia.Behaviors"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls">

  <!--
    SectionGrid keeps ShadUI ControlTheme chrome (cell/header/row/hover/sort icons)
    but replaces the root template scroll area: no nested ScrollViewer around rows.
  -->
  <Style Selector="DataGrid.SectionGrid">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="RowHeight" Value="{DynamicResource RowMinHeight}" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="CanUserSortColumns" Value="True" />
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="behaviors:DataGridSortSupport.Enabled" Value="True" />
    <Setter Property="Template">
      <ControlTemplate TargetType="DataGrid">
        <Border
          Name="DataGridBorder"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          ClipToBounds="True"
          CornerRadius="{TemplateBinding CornerRadius}">
          <Border ClipToBounds="True" CornerRadius="{TemplateBinding CornerRadius}">
            <Grid
              Name="Grid"
              ClipToBounds="True"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,*,Auto">
              <Border
                Name="PART_HeaderBackground"
                Grid.Row="0"
                Grid.Column="0"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1">
                <DataGridColumnHeadersPresenter Name="PART_ColumnHeadersPresenter" />
              </Border>
              <!--  Align header columns with body when PART_VerticalScrollbar reserves column 1.  -->
              <Border
                Name="PART_TopRightCorner"
                Grid.Row="0"
                Grid.Column="1" />
              <DataGridRowsPresenter
                Name="PART_RowsPresenter"
                Grid.Row="1"
                Grid.Column="0"
                ClipToBounds="True">
                <DataGridRowsPresenter.GestureRecognizers>
                  <ScrollGestureRecognizer CanHorizontallyScroll="True" CanVerticallyScroll="True" />
                </DataGridRowsPresenter.GestureRecognizers>
              </DataGridRowsPresenter>
              <ScrollBar
                Name="PART_VerticalScrollbar"
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Vertical" />
              <Grid
                Grid.Row="2"
                Grid.Column="0"
                ColumnDefinitions="Auto,*">
                <Rectangle Name="PART_FrozenColumnScrollBarSpacer" />
                <ScrollBar
                  Name="PART_HorizontalScrollbar"
                  Grid.Column="1"
                  Orientation="Horizontal" />
              </Grid>
              <Border
                Name="PART_BottomRightCorner"
                Grid.Row="2"
                Grid.Column="1" />
            </Grid>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!--  First column # index (Shad BasicDataTable look).  -->
  <Style Selector="DataGrid.IndexedGrid">
    <Setter Property="behaviors:DataGridIndexColumn.Enabled" Value="True" />
    <Setter Property="behaviors:DataGridIndexColumn.Mode" Value="DisplayOrder" />
    <Setter Property="behaviors:DataGridIndexColumn.IsVisible" Value="True" />
    <Setter Property="behaviors:DataGridSortReset.Enabled" Value="True" />
  </Style>

  <Style Selector="DataGrid.IndexedGrid.StickyIndexDisplayIndex">
    <Setter Property="behaviors:DataGridIndexColumn.Mode" Value="DisplayIndex" />
  </Style>

  <Style Selector="DataGrid.IndexedGrid.StickyIndexRowNo">
    <Setter Property="behaviors:DataGridIndexColumn.Mode" Value="RowNo" />
  </Style>

  <Style Selector="DataGrid.IndexedGrid.MapIndexedGrid">
    <Setter Property="behaviors:DataGridIndexColumn.Mode" Value="DisplayIndex" />
  </Style>

  <Style Selector="DataGrid.MsfxStickyColumns">
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="behaviors:DataGridFrozenColumns.Enabled" Value="True" />
  </Style>

  <Style Selector="DataGrid.FixedColumns">
    <Setter Property="CanUserResizeColumns" Value="False" />
  </Style>

  <Style Selector="DataGrid.InventoryGrid">
    <Setter Property="RowHeight" Value="{DynamicResource InventoryRowHeight}" />
  </Style>

  <Style Selector="DataGrid.ReassignPreviewGrid">
    <Setter Property="RowHeight" Value="{DynamicResource ReassignPreviewRowHeight}" />
    <Setter Property="Height" Value="{DynamicResource ReassignPreviewHeight}" />
    <Setter Property="MinHeight" Value="{DynamicResource ReassignPreviewHeight}" />
    <Setter Property="MaxHeight" Value="{DynamicResource ReassignPreviewHeight}" />
    <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="CanUserSortColumns" Value="False" />
    <Setter Property="CanUserResizeColumns" Value="False" />
    <Setter Property="behaviors:DataGridSortSupport.Enabled" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
  </Style>

  <Style Selector="DataGrid.ReassignPreviewGrid DataGridRow">
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="DataGrid.ReassignPreviewGrid /template/ Border#PART_HeaderBackground, DataGrid.ReassignPreviewGrid /template/ Border#PART_HeaderBackground:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="DataGrid.ReassignPreviewGrid DataGridColumnHeader">
    <Setter Property="FontSize" Value="{DynamicResource ReassignPreviewHeaderFontSize}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="DataGrid.ReassignPreviewGrid DataGridCell">
    <Setter Property="FontSize" Value="{DynamicResource ReassignPreviewFontSize}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="DataGrid DataGridCheckBoxColumn">
    <Setter Property="Width" Value="{StaticResource DgWSelect}" />
  </Style>

  <Style Selector="Button.DgIndexHeaderButton">
    <Setter Property="Width" Value="{DynamicResource DgHeaderBtnSize}" />
    <Setter Property="Height" Value="{DynamicResource DgHeaderBtnSize}" />
    <Setter Property="MinWidth" Value="{DynamicResource DgHeaderBtnSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource DgHeaderBtnSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.DgIndexHeaderButton:disabled">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.DgIndexHeaderButton icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeSmall}" />
  </Style>

  <Style Selector="TextBlock.DgIndexCell">
    <Setter Property="FontSize" Value="{DynamicResource DgIndexFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
    <Setter Property="TextTrimming" Value="None" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.DgStatusBadge">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.DgQtyCell">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!--
    Avalonia MakeFirstDisplayed 必须留一个 CurrentColumn（清成 -1 会再落回 #），拦不住
    CellSelect：只给非 DgChrome 数据格画 :current；# / 勾选列带 DgChrome，初始化幽灵 currency 无视觉
    Tone* 行 hover/selected → Color20；数据格 :current → Color30
  -->
  <Style Selector="DataGrid.CellSelect DataGridCell:current">
    <Setter Property="Background" Value="{DynamicResource SelectionColor}" />
  </Style>
  <Style Selector="DataGrid.CellSelect DataGridCell.DgChrome:current">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="DataGridRow.ToneWarning10">
    <Setter Property="Background" Value="{DynamicResource WarningColor10}" />
  </Style>
  <Style Selector="DataGridRow.ToneWarning10:pointerover /template/ Rectangle#BackgroundRectangle, DataGridRow.ToneWarning10:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="DataGridRow.ToneWarning10:pointerover, DataGridRow.ToneWarning10:selected">
    <Setter Property="Background" Value="{DynamicResource WarningColor20}" />
  </Style>
  <Style Selector="DataGrid.CellSelect DataGridRow.ToneWarning10 DataGridCell:current">
    <Setter Property="Background" Value="{DynamicResource WarningColor30}" />
  </Style>
  <Style Selector="DataGrid.CellSelect DataGridRow.ToneWarning10 DataGridCell.DgChrome:current">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="DataGridRow.ToneDanger10">
    <Setter Property="Background" Value="{DynamicResource ErrorColor10}" />
  </Style>
  <Style Selector="DataGridRow.ToneDanger10:pointerover /template/ Rectangle#BackgroundRectangle, DataGridRow.ToneDanger10:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="DataGridRow.ToneDanger10:pointerover, DataGridRow.ToneDanger10:selected">
    <Setter Property="Background" Value="{DynamicResource ErrorColor20}" />
  </Style>
  <Style Selector="DataGrid.CellSelect DataGridRow.ToneDanger10 DataGridCell:current">
    <Setter Property="Background" Value="{DynamicResource ErrorColor30}" />
  </Style>
  <Style Selector="DataGrid.CellSelect DataGridRow.ToneDanger10 DataGridCell.DgChrome:current">
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
