<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:PacToolkits.Desktop.Avalonia.Behaviors">

  <Style Selector="DataGrid.SectionGrid">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="HeadersVisibility" Value="All" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="RowHeight" Value="{DynamicResource RowMinHeight}" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <Style Selector="DataGrid.StickyIndexGrid">
    <Setter Property="RowHeaderWidth" Value="{DynamicResource DgRowHeaderWidth}" />
    <Setter Property="behaviors:DataGridSortResetBehavior.Enabled" Value="True" />
  </Style>

  <Style Selector="DataGrid.DrugGrid">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style Selector="DataGrid.MsfxIndexedGrid">
    <Setter Property="RowHeaderWidth" Value="{DynamicResource DgRowHeaderWidth}" />
    <Setter Property="behaviors:DataGridSortResetBehavior.Enabled" Value="True" />
  </Style>

  <Style Selector="DataGrid.StickyIndexGrid /template/ DataGridColumnHeader#PART_TopLeftCornerHeader">
    <Setter Property="Width" Value="{DynamicResource DgRowHeaderWidth}" />
    <Setter Property="MinWidth" Value="{DynamicResource DgRowHeaderWidth}" />
  </Style>

  <Style Selector="DataGrid.MsfxIndexedGrid /template/ DataGridColumnHeader#PART_TopLeftCornerHeader">
    <Setter Property="Width" Value="{DynamicResource DgRowHeaderWidth}" />
    <Setter Property="MinWidth" Value="{DynamicResource DgRowHeaderWidth}" />
  </Style>

  <Style Selector="DataGrid.NonInteractive">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
  </Style>

  <Style Selector="DataGridRow">
    <Setter Property="MinHeight" Value="{DynamicResource RowMinHeight}" />
  </Style>

  <Style Selector="DataGrid.StickyIndexGrid DataGridRowHeader">
    <Setter Property="Width" Value="{DynamicResource DgRowHeaderWidth}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.72" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Content">
      <Setter.Value>
        <Binding
          Converter="{StaticResource RowIndexPlusOne}"
          Path="Index"
          RelativeSource="{RelativeSource AncestorType=DataGridRow}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="DataGrid.MsfxIndexedGrid DataGridRowHeader">
    <Setter Property="Width" Value="{DynamicResource DgRowHeaderWidth}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.72" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Content">
      <Setter.Value>
        <Binding
          Converter="{StaticResource RowIndexPlusOne}"
          Path="Index"
          RelativeSource="{RelativeSource AncestorType=DataGridRow}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="DataGrid.StickyIndexGrid.StickyIndexDisplayIndex DataGridRowHeader">
    <Setter Property="Content">
      <Setter.Value>
        <ReflectionBinding Path="DataContext.DisplayIndex" RelativeSource="{RelativeSource AncestorType=DataGridRow}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="DataGrid.StickyIndexGrid.StickyIndexRowNo DataGridRowHeader">
    <Setter Property="Content">
      <Setter.Value>
        <ReflectionBinding Path="DataContext.RowNo" RelativeSource="{RelativeSource AncestorType=DataGridRow}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="DataGrid.MsfxIndexedGrid.MapIndexedGrid DataGridRowHeader">
    <Setter Property="Content">
      <Setter.Value>
        <ReflectionBinding Path="DataContext.DisplayIndex" RelativeSource="{RelativeSource AncestorType=DataGridRow}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="DataGrid.StickyIndexGrid DataGridRowHeader ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource DgRowHeaderFontSize}" />
  </Style>

  <Style Selector="DataGrid.MsfxIndexedGrid DataGridRowHeader ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource DgRowHeaderFontSize}" />
  </Style>

  <Style Selector="DataGrid.StickyIndexGrid DataGridRowHeader TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource DgRowHeaderFontSize}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style Selector="DataGrid.MsfxIndexedGrid DataGridRowHeader TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource DgRowHeaderFontSize}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style Selector="DataGridCell">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource DgCellPadCell}" />
  </Style>

  <Style Selector="DataGridCell TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.DataGridSortResetButton">
    <Setter Property="Width" Value="{DynamicResource DgSortResetButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource DgSortResetButtonSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource BrushGridSortResetBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushGridSortResetForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushGridSortResetBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.DataGridSortResetButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushGridSortResetBackgroundHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushGridSortResetBorderHover}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

</Styles>
