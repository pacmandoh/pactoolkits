<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:PacToolkits.Desktop.Avalonia.Behaviors"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls">

  <!--
    SectionGrid keeps ShadUI ControlTheme chrome (cell/header/row/hover/sort icons)
    but replaces the root template scroll area: no nested ScrollViewer around rows.
  -->
  <Style Selector="DataGrid.SectionGrid">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="CanUserSortColumns" Value="True" />
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="behaviors:DataGridSortSupportBehavior.Enabled" Value="True" />
    <Setter Property="Template">
      <ControlTemplate TargetType="DataGrid">
        <Border
          Name="DataGridBorder"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          ClipToBounds="True"
          CornerRadius="{TemplateBinding CornerRadius}">
          <Border ClipToBounds="True" CornerRadius="{TemplateBinding CornerRadius}">
            <Grid
              Name="Grid"
              ClipToBounds="True"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,*,Auto">
              <Border
                Name="PART_HeaderBackground"
                Grid.Row="0"
                Grid.Column="0"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1">
                <DataGridColumnHeadersPresenter Name="PART_ColumnHeadersPresenter" />
              </Border>
              <!--  Align header columns with body when PART_VerticalScrollbar reserves column 1.  -->
              <Border
                Name="PART_TopRightCorner"
                Grid.Row="0"
                Grid.Column="1" />
              <DataGridRowsPresenter
                Name="PART_RowsPresenter"
                Grid.Row="1"
                Grid.Column="0"
                ClipToBounds="True">
                <DataGridRowsPresenter.GestureRecognizers>
                  <ScrollGestureRecognizer CanHorizontallyScroll="True" CanVerticallyScroll="True" />
                </DataGridRowsPresenter.GestureRecognizers>
              </DataGridRowsPresenter>
              <ScrollBar
                Name="PART_VerticalScrollbar"
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Vertical" />
              <ScrollBar
                Name="PART_HorizontalScrollbar"
                Grid.Row="2"
                Grid.Column="0"
                Orientation="Horizontal" />
              <Rectangle
                Name="PART_FrozenColumnScrollBarSpacer"
                Grid.Row="2"
                Grid.Column="1" />
            </Grid>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="DataGrid.SectionGrid /template/ ScrollBar#PART_HorizontalScrollbar">
    <Setter Property="Height" Value="0" />
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="DataGrid.SectionGrid /template/ Rectangle#PART_FrozenColumnScrollBarSpacer">
    <Setter Property="Height" Value="0" />
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!--  First column # index (Shad BasicDataTable look).  -->
  <Style Selector="DataGrid.IndexedGrid">
    <Setter Property="behaviors:DataGridIndexColumnBehavior.Enabled" Value="True" />
    <Setter Property="behaviors:DataGridIndexColumnBehavior.Mode" Value="DisplayOrder" />
    <Setter Property="behaviors:DataGridIndexColumnBehavior.IsVisible" Value="True" />
    <Setter Property="behaviors:DataGridSortResetBehavior.Enabled" Value="True" />
  </Style>

  <Style Selector="DataGrid.IndexedGrid.StickyIndexDisplayIndex">
    <Setter Property="behaviors:DataGridIndexColumnBehavior.Mode" Value="DisplayIndex" />
  </Style>

  <Style Selector="DataGrid.IndexedGrid.StickyIndexRowNo">
    <Setter Property="behaviors:DataGridIndexColumnBehavior.Mode" Value="RowNo" />
  </Style>

  <Style Selector="DataGrid.IndexedGrid.MapIndexedGrid">
    <Setter Property="behaviors:DataGridIndexColumnBehavior.Mode" Value="DisplayIndex" />
  </Style>

  <Style Selector="DataGrid.NonInteractive">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
  </Style>

  <Style Selector="DataGrid.InventoryGrid">
    <Setter Property="RowHeight" Value="{DynamicResource InventoryRowHeight}" />
  </Style>

  <Style Selector="Button.DgIndexHeaderButton">
    <Setter Property="Width" Value="{DynamicResource DgHeaderBtnSize}" />
    <Setter Property="Height" Value="{DynamicResource DgHeaderBtnSize}" />
    <Setter Property="MinWidth" Value="{DynamicResource DgHeaderBtnSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource DgHeaderBtnSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.DgIndexHeaderButton:disabled">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.DgIndexHeaderButton icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource DgHeaderIconSize}" />
    <Setter Property="Height" Value="{DynamicResource DgHeaderIconSize}" />
  </Style>

  <Style Selector="TextBlock.DgIndexCell">
    <Setter Property="FontSize" Value="{DynamicResource DgIndexFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
    <Setter Property="TextTrimming" Value="None" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

</Styles>
