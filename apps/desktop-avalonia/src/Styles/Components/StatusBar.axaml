<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI">
  <Style Selector="Button.StatusBarItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="Padding" Value="{DynamicResource StatusBarItemPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource StatusBarHeight}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          x:Name="PART_Border"
          Padding="{TemplateBinding Padding}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
          <StackPanel
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            Orientation="Horizontal"
            Spacing="{DynamicResource SpacingInlineSm}">
            <Viewbox
              Width="{DynamicResource IconSizeSmall}"
              Height="{DynamicResource IconSizeSmall}"
              VerticalAlignment="Center"
              IsVisible="{TemplateBinding shad:ButtonAssist.Icon,
                                          Converter={x:Static ObjectConverters.IsNotNull}}">
              <ContentPresenter Content="{TemplateBinding shad:ButtonAssist.Icon}" />
            </Viewbox>
            <ContentPresenter
              VerticalAlignment="Center"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.StatusBarItem:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
  </Style>

  <Style Selector="Button.StatusBarItem:pressed /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
  </Style>

  <Style Selector="Button.StatusBarItem.active /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
  </Style>

  <Style Selector="Button.StatusBarItem.active:pointerover /template/ Border#PART_Border,Button.StatusBarItem.active:pressed /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
  </Style>

  <Style Selector="Button.StatusBarItem:disabled">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="Button.StatusBarItem:disabled:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.StatusBarItem:pointerover,Button.StatusBarItem:pressed,Button.StatusBarItem.active,Button.StatusBarItem.active:pointerover,Button.StatusBarItem.active:pressed">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="Border.StatusBar TextBlock.Caption.Muted">
    <Setter Property="FontSize" Value="{DynamicResource StatusBarCaptionSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--  仅尺寸/描边；不设 Foreground，保留状态色与 Caption Muted  -->
  <Style Selector="Button.StatusBarItem icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="StrokeWidth" Value="{DynamicResource SidebarMenuIconStroke}" />
  </Style>

  <Style Selector="Menu.StatusBarAgentsMenu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="{DynamicResource StatusBarHeight}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Menu.StatusBarAgentsMenu &gt; MenuItem.StatusBarAgentsMenuRoot">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource StatusBarItemPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource StatusBarHeight}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <!--  贴窗底 tip 压控件会闪，强制向上  -->
    <Setter Property="ToolTip.Placement" Value="Top" />
    <Setter Property="ToolTip.VerticalOffset" Value="-6" />
  </Style>

  <Style Selector="Menu.StatusBarAgentsMenu &gt; MenuItem.StatusBarAgentsMenuRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
  </Style>

  <Style Selector="Menu.StatusBarAgentsMenu &gt; MenuItem.StatusBarAgentsMenuRoot icons|AppIcon.StatusBarAgentsCountIcon">
    <Setter Property="Width" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="StrokeWidth" Value="{DynamicResource SidebarMenuIconStroke}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.StatusBarIconItem">
    <Setter Property="Padding" Value="{DynamicResource StatusBarIconPadding}" />
  </Style>

  <Style Selector="Border.StatusBar Button.StatusBarItem">
    <Setter Property="ToolTip.Placement" Value="Top" />
    <Setter Property="ToolTip.VerticalOffset" Value="-6" />
  </Style>

  <Style Selector="Border.StatusBarDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="{DynamicResource StatusBarDividerHeight}" />
    <Setter Property="Background" Value="{DynamicResource BorderColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>
</Styles>
