<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="https://github.com/kikipoulet/SukiUI"
    xmlns:sukiControls="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
    xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls">
  <Style Selector="sukiControls|BusyArea[IsBusy=true]">
    <Setter Property="IsEnabled" Value="False" />
  </Style>

  <Style Selector="TextBox.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="Padding" Value="{DynamicResource InputPaddingHorizontal}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="AcceptsReturn" Value="False" />
  </Style>

  <Style Selector="ComboBox.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="CalendarDatePicker.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="NumericUpDown.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="TextBox.FilterSearchTextBox">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="Padding" Value="{DynamicResource FilterSearchTextBoxPadding}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="controls|FilterFieldInput">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:FilterFieldInput">
        <Border Classes="FilterFieldInputHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
          <ContentPresenter HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|FilterFieldInput:disabled">
    <Setter Property="Opacity" Value="0.72" />
  </Style>

  <Style Selector="Border.FilterFieldInputHost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.FilterFieldInputHost > Grid,
                     Border.FilterFieldInputHost Grid,
                     controls|FilterFieldInput > Grid">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="controls|FilterFieldInput ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource FilterFieldComboBoxHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="controls|FilterFieldInput TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="controls|FilterFieldInput CalendarDatePicker">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="con|GlassCard.AutoCompleteInputHost">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="Padding" Value="{DynamicResource InputPaddingHorizontal}" />
    <Setter Property="Opacity" Value="0.96" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="controls|PlainAutoCompleteBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="AutoCompleteBox.FilterFieldInnerInput">
    <Setter Property="BorderThickness" Value="0,0,0,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="AutoCompleteBox.FilterFieldInnerInput /template/ TextBox#PART_TextBox">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="{DynamicResource InputPaddingHorizontal}" />
    <Setter Property="UseFloatingPlaceholder" Value="False" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.RowItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RowRadius}" />
    <Setter Property="Padding" Value="{DynamicResource RowPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource RowMinHeight}" />
  </Style>

  <Style Selector="controls|EmptyStatePanel">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid MinHeight="{Binding EffectiveSlotMinHeight, RelativeSource={RelativeSource TemplatedParent}}"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
          <ContentPresenter
            Content="{TemplateBinding Content}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Opacity="{Binding ContentOpacity, RelativeSource={RelativeSource TemplatedParent}}"
            IsHitTestVisible="{Binding ShowContent, RelativeSource={RelativeSource TemplatedParent}}"
            IsEnabled="{Binding ShowContent, RelativeSource={RelativeSource TemplatedParent}}" />

          <Border
            IsVisible="{Binding IsEmpty, RelativeSource={RelativeSource TemplatedParent}}"
            IsHitTestVisible="{Binding IsEmpty, RelativeSource={RelativeSource TemplatedParent}}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Padding="{DynamicResource EmptyStatePadding}">
            <StackPanel Spacing="{DynamicResource EmptyStateSpacing}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
              <icons:AppIcon
                Kind="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                Width="{DynamicResource EmptyStateIconSize}"
                Height="{DynamicResource EmptyStateIconSize}"
                Foreground="{StaticResource BrushWarning}" />

              <TextBlock
                Text="{Binding EmptyText, RelativeSource={RelativeSource TemplatedParent}}"
                FontSize="{DynamicResource EmptyStateTitleSize}"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource SukiText}" />

              <TextBlock
                Text="{Binding EmptyHint, RelativeSource={RelativeSource TemplatedParent}}"
                Classes="SectionHint"
                IsVisible="{Binding HasHint, RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>
          </Border>

          <sukiControls:BusyArea
              IsVisible="{Binding IsPending, RelativeSource={RelativeSource TemplatedParent}}"
              IsBusy="{Binding IsPending, RelativeSource={RelativeSource TemplatedParent}}"
              IsHitTestVisible="{Binding IsPending, RelativeSource={RelativeSource TemplatedParent}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Stretch"
              MinHeight="0">
            <Panel />
          </sukiControls:BusyArea>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
