<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls">
  <Style Selector="shad|BusyArea[IsBusy=true]">
    <Setter Property="IsEnabled" Value="False" />
  </Style>

  <Style Selector="TextBox.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="Padding" Value="{DynamicResource InputPaddingHorizontal}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="AcceptsReturn" Value="False" />
  </Style>

  <Style Selector="ComboBox.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="CalendarDatePicker.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="NumericUpDown.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="TextBox.CompactField">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox.SearchBox">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="InnerRightContent">
      <Setter.Value>
        <Template>
          <PathIcon
            Width="16"
            Height="16"
            Opacity="0.75"
            Data="{x:Static shad:Icons.Search}" />
        </Template>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="AutoCompleteBox">
    <Setter Property="InnerRightContent">
      <Setter.Value>
        <Template>
          <PathIcon
            Width="16"
            Height="16"
            Opacity="0.75"
            Data="{x:Static shad:Icons.Search}" />
        </Template>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="Border.DashboardFilterChrome AutoCompleteBox">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="MaxHeight" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="TextBox.TraceCodeInput">
    <Setter Property="MinHeight" Value="120" />
    <Setter Property="Padding" Value="{DynamicResource TraceCodeInputPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RowRadius}" />
    <Setter Property="FontFamily" Value="{DynamicResource TraceCodeInputFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource TraceCodeInputFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource TraceCodeLineHeight}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="controls|FilterFieldInput">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:FilterFieldInput">
        <Border
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Classes="FilterFieldInputHost">
          <ContentPresenter
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|FilterFieldInput:disabled">
    <Setter Property="Opacity" Value="0.72" />
  </Style>

  <Style Selector="Border.FilterFieldInputHost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.FilterFieldInputHost &gt; Grid,                      Border.FilterFieldInputHost Grid,                      controls|FilterFieldInput &gt; Grid">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="controls|FilterFieldInput ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource FilterFieldComboBoxHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="controls|FilterFieldInput TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="controls|FilterFieldInput CalendarDatePicker">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="Border.DashboardFilterChrome controls|FilterFieldInput ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource DashboardFilterControlHeight}" />
    <Setter Property="MaxHeight" Value="{DynamicResource DashboardFilterControlHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.DashboardFilterChrome controls|FilterFieldInput CalendarDatePicker">
    <Setter Property="MinHeight" Value="{DynamicResource DashboardFilterControlHeight}" />
    <Setter Property="MaxHeight" Value="{DynamicResource DashboardFilterControlHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.DashboardFilterChrome controls|FilterFieldInput">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.RowItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RowRadius}" />
    <Setter Property="Padding" Value="{DynamicResource RowPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource RowMinHeight}" />
  </Style>

  <Style Selector="TextBlock.TraceCodeText">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="TextBlock.TraceCodeText.Valid">
    <Setter Property="Foreground" Value="{StaticResource BrushDone}" />
  </Style>

  <Style Selector="TextBlock.TraceCodeText.Duplicate">
    <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
  </Style>

  <Style Selector="TextBlock.TraceCodeText.Invalid">
    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
  </Style>

  <Style Selector="TextBlock.TraceCodeStatusHint">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource SectionHintSize}" />
    <Setter Property="Opacity" Value="0.88" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>

  <Style Selector="TextBlock.TraceCodeStatusHint.Duplicate">
    <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
  </Style>

  <Style Selector="TextBlock.TraceCodeStatusHint.Invalid">
    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
  </Style>

  <Style Selector="controls|EmptyStatePanel">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid
          MinHeight="{Binding EffectiveSlotMinHeight, RelativeSource={RelativeSource TemplatedParent}}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="False">
          <ContentPresenter
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            ClipToBounds="False"
            Content="{TemplateBinding Content}"
            Opacity="{Binding ContentOpacity, RelativeSource={RelativeSource TemplatedParent}}" />

          <Border
            Padding="{DynamicResource EmptyStatePadding}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="{Binding IsEmpty, RelativeSource={RelativeSource TemplatedParent}}"
            IsVisible="{Binding IsEmpty, RelativeSource={RelativeSource TemplatedParent}}"
            ZIndex="1">
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="{DynamicResource EmptyStateSpacing}">
              <icons:AppIcon
                Width="{DynamicResource EmptyStateIconSize}"
                Height="{DynamicResource EmptyStateIconSize}"
                Foreground="{StaticResource BrushWarning}"
                Kind="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}" />

              <TextBlock
                HorizontalAlignment="Center"
                FontSize="{DynamicResource EmptyStateTitleSize}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource ForegroundColor}"
                Text="{Binding EmptyText, RelativeSource={RelativeSource TemplatedParent}}" />

              <TextBlock
                Classes="SectionHint"
                IsVisible="{Binding HasHint, RelativeSource={RelativeSource TemplatedParent}}"
                Text="{Binding EmptyHint, RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>
          </Border>

          <shad:BusyArea
            MinHeight="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsBusy="{Binding IsPending, RelativeSource={RelativeSource TemplatedParent}}"
            IsHitTestVisible="{Binding IsPending, RelativeSource={RelativeSource TemplatedParent}}"
            IsVisible="{Binding IsPending, RelativeSource={RelativeSource TemplatedParent}}"
            ZIndex="2">
            <Panel />
          </shad:BusyArea>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
