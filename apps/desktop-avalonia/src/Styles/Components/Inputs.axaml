<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI">
  <Style Selector="shad|BusyArea[IsBusy=true]">
    <Setter Property="IsEnabled" Value="False" />
  </Style>

  <Style Selector="TextBox.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="Padding" Value="{DynamicResource InputPaddingHorizontal}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="AcceptsReturn" Value="False" />
  </Style>

  <Style Selector="ComboBox.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="CalendarDatePicker.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="NumericUpDown.MsfxInput">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
  </Style>

  <Style Selector="TextBox.CompactField">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox.SearchBox">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="InnerRightContent">
      <Setter.Value>
        <Template>
          <PathIcon
            Width="16"
            Height="16"
            Data="{x:Static shad:Icons.Search}"
            Opacity="0.75" />
        </Template>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="AutoCompleteBox">
    <Setter Property="InnerRightContent">
      <Setter.Value>
        <Template>
          <PathIcon
            Width="16"
            Height="16"
            Data="{x:Static shad:Icons.Search}"
            Opacity="0.75" />
        </Template>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="Border.FilterBarChrome AutoCompleteBox">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="MaxHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.FilterBarChrome ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="MaxHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.FilterBarChrome ComboBox.FilterBarComboAuto">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="TextBlock.InputPlaceholder">
    <Setter Property="Margin" Value="{DynamicResource InputPlaceholderMargin}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource HeaderMenuTitleSize}" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="TextBox.PasswordReveal">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RevealPassword" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style Selector="TextBlock.ClientMetaSubline">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="14" />
    <Setter Property="MaxHeight" Value="14" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style Selector="controls|TraceCodeEditor">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="controls|FilterFieldInput">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:FilterFieldInput">
        <Border
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Classes="FilterInputHost">
          <ContentPresenter
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|FilterFieldInput:disabled">
    <Setter Property="Opacity" Value="0.72" />
  </Style>

  <Style Selector="Border.FilterInputHost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.FilterInputHost &gt; Grid, Border.FilterInputHost Grid, controls|FilterFieldInput &gt; Grid">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="controls|FilterFieldInput ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource FilterComboHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="controls|FilterFieldInput TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="controls|FilterFieldInput CalendarDatePicker">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="Border.FilterBarChrome controls|FilterFieldInput ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="MaxHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.FilterBarChrome controls|FilterFieldInput CalendarDatePicker">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="MaxHeight" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.FilterBarChrome controls|FilterFieldInput">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.RowItem">
    <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}" />
    <Setter Property="Padding" Value="{DynamicResource RowPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource RowMinHeight}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Border.RowItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
  </Style>

  <Style Selector="Border.RowItem:pressed">
    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
  </Style>

  <Style Selector="controls|EmptyStatePanel">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid
          MinHeight="{Binding EffectiveSlotMinHeight, RelativeSource={RelativeSource TemplatedParent}}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="False">
          <ContentPresenter
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            ClipToBounds="False"
            Content="{TemplateBinding Content}"
            Opacity="{Binding ContentOpacity, RelativeSource={RelativeSource TemplatedParent}}" />

          <Border
            Padding="{DynamicResource EmptyStatePadding}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="{Binding ShowEmptyOverlay, RelativeSource={RelativeSource TemplatedParent}}"
            IsVisible="{Binding ShowEmptyOverlay, RelativeSource={RelativeSource TemplatedParent}}"
            ZIndex="1">
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="{DynamicResource EmptyStateSpacing}">
              <icons:AppIcon
                Width="{DynamicResource EmptyStateIconSize}"
                Height="{DynamicResource EmptyStateIconSize}"
                Foreground="{DynamicResource WarningColor}"
                Kind="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}" />

              <TextBlock
                HorizontalAlignment="Center"
                Classes="Small SubsectionTitle"
                Text="{Binding EmptyText, RelativeSource={RelativeSource TemplatedParent}}" />

              <TextBlock
                Classes="Caption Muted"
                IsVisible="{Binding HasHint, RelativeSource={RelativeSource TemplatedParent}}"
                Text="{Binding EmptyHint, RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>
          </Border>

          <shad:BusyArea
            MinHeight="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsBusy="{Binding IsPending, RelativeSource={RelativeSource TemplatedParent}}"
            IsHitTestVisible="{Binding IsPending, RelativeSource={RelativeSource TemplatedParent}}"
            IsVisible="{Binding IsPending, RelativeSource={RelativeSource TemplatedParent}}"
            ZIndex="2">
            <Panel />
          </shad:BusyArea>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
