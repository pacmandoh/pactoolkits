<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI">
  <!--
    Pac typography — only where ShadUI has no 1:1 class:
    - SectionTitle (16 semi) — page/card headers; Shad Small=14, Large=18
    - SubsectionTitle (Shad Small semi) — in-card group headers
    - DialogTitle* — dialog chrome
    Content header page title: Small Muted.
    Secondary copy: use Shad Caption Muted. Body values: use Shad Small.
  -->

  <!--  Match the ShadUI demo typography roots, including detached popup trees.  -->
  <Style Selector="shad|Window">
    <Setter Property="FontFamily" Value="{DynamicResource ShadBodyFontFamily}" />
  </Style>

  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="FontFamily" Value="{DynamicResource ShadBodyFontFamily}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="FontFamily" Value="{DynamicResource ShadBodyFontFamily}" />
  </Style>

  <Style Selector="TextBlock.SectionTitle">
    <Setter Property="FontSize" Value="{DynamicResource SectionTitleSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.SubsectionTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.DialogTitle">
    <Setter Property="FontSize" Value="{DynamicResource DialogTitleSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

</Styles>
