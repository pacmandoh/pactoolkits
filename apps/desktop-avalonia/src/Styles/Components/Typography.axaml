<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI">
  <!--
    Pac typography — only where ShadUI has no 1:1 class:
    - SectionTitle (16 semi) — page/card headers; Shad Small=14, Large=18
    - SubsectionTitle (14 semi) — in-card group headers
    - DialogTitle* — dialog chrome
    - AboutHeroVersion, AboutSubtitle — About hero only
    - ShellTitle — shell chrome
    Secondary copy: use Shad Caption Muted. Body values: use Shad Small.
  -->

  <!--  Match the ShadUI demo typography roots, including detached popup trees.  -->
  <Style Selector="shad|Window">
    <Setter Property="FontFamily" Value="{DynamicResource ShadBodyFontFamily}" />
  </Style>

  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="FontFamily" Value="{DynamicResource ShadBodyFontFamily}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="FontFamily" Value="{DynamicResource ShadBodyFontFamily}" />
  </Style>

  <Style Selector="TextBlock.SectionTitle">
    <Setter Property="FontSize" Value="{DynamicResource SectionTitleSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.SectionTitle.Strong">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.SubsectionTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.DialogTitle">
    <Setter Property="FontSize" Value="{DynamicResource DialogTitleSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="TextBlock.DialogTitleLg">
    <Setter Property="FontSize" Value="{DynamicResource DialogTitleSizeLg}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="TextBlock.AboutSubtitle">
    <Setter Property="FontSize" Value="{DynamicResource AboutSubtitleSize}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundLeadColor}" />
  </Style>

  <Style Selector="TextBlock.AboutHeroVersion">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="LineHeight" Value="32" />
  </Style>

  <Style Selector="TextBlock.ShellTitle">
    <Setter Property="FontSize" Value="{DynamicResource ShellTitleSize}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

</Styles>
