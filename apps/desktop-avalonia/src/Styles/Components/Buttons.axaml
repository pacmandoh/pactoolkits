<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button.Ghost">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="Padding" Value="{DynamicResource ButtonPaddingHorizontal}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="Opacity" Value="{DynamicResource ButtonGhostOpacity}" />
  </Style>

  <Style Selector="Button.Action">
    <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
    <Setter Property="MinWidth" Value="{DynamicResource MinWAction}" />
    <Setter Property="Padding" Value="{DynamicResource ButtonPaddingHorizontal}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
  </Style>

  <Style Selector="Button.ActionWide">
    <Setter Property="MinWidth" Value="{DynamicResource ButtonActionWideMinWidth}" />
  </Style>

  <Style Selector="Button.IconToggle">
    <Setter Property="Width" Value="{DynamicResource ButtonIconToggleSize}" />
    <Setter Property="MinWidth" Value="{DynamicResource ButtonIconToggleSize}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button.MicroClear">
    <Setter Property="Width" Value="{DynamicResource DgSortResetButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource DgSortResetButtonSize}" />
    <Setter Property="MinWidth" Value="{DynamicResource DgSortResetButtonSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource DgSortResetButtonSize}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button.DrugAutoCompleteClear">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.MsfxMiniIconBtn">
    <Setter Property="Width" Value="{DynamicResource MsfxMiniIconBtnSize}" />
    <Setter Property="Height" Value="{DynamicResource MsfxMiniIconBtnSize}" />
    <Setter Property="MinWidth" Value="{DynamicResource MsfxMiniIconBtnSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource MsfxMiniIconBtnSize}" />
    <Setter Property="Padding" Value="{DynamicResource MsfxMiniIconBtnPadding}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
</Styles>
