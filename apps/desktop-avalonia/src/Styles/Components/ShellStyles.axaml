<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI">
  <Style Selector="shad|Window /template/ Border#PART_TitleBarBackground">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
  </Style>

  <Style Selector="shad|Window /template/ LayoutTransformControl#LayoutTransform > Border">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <Style Selector="shad|Window /template/ Border#BottomBorder">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="shad|Window /template/ StackPanel#AppTitlePanel > TextBlock">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="shad|Window /template/ StackPanel#AppTitlePanel">
    <Setter Property="Margin" Value="72,0,12,0" />
  </Style>

  <Style Selector="shad|Window /template/ ContentPresenter#RightButtons">
    <Setter Property="Margin" Value="{DynamicResource ShellTitleBarRightContentMargin}" />
  </Style>

  <Style Selector="Border.ShellTitleBarCapsule">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Margin" Value="{DynamicResource ShellTitleBarCapsuleMargin}" />
    <Setter Property="Padding" Value="0.5" />
  </Style>

  <Style Selector="Border.ShellTitleBarCapsule Button.WindowControlsButton">
    <Setter Property="MinWidth" Value="{DynamicResource ShellTitleBarCapsuleButtonMinSize}" />
    <Setter Property="MaxWidth" Value="{DynamicResource ShellTitleBarCapsuleButtonMinSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource ShellTitleBarCapsuleButtonMinSize}" />
    <Setter Property="MaxHeight" Value="{DynamicResource ShellTitleBarCapsuleButtonMinSize}" />
    <Setter Property="Padding" Value="{DynamicResource ShellTitleBarCapsuleButtonPadding}" />
  </Style>

  <Style Selector="Border.ShellTitleBarCapsule Button.WindowControlsButton icons|AppIcon, Border.ShellTitleBarCapsule Button.WindowControlsButton controls|BusyCircle">
    <Setter Property="Width" Value="{DynamicResource ShellTitleBarCapsuleIconSize}" />
    <Setter Property="Height" Value="{DynamicResource ShellTitleBarCapsuleIconSize}" />
  </Style>

  <Style Selector="Grid.ShellTitleBarNavChrome">
    <Setter Property="Width" Value="{DynamicResource ShellTitleBarNavChromeWidth}" />
    <Setter Property="ColumnSpacing" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.ShellTitleBarNavButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}" />
    <Setter Property="Width" Value="{DynamicResource ShellTitleBarNavButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource ShellTitleBarNavButtonSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.ShellTitleBarNavButton icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource ShellTitleBarNavIconSize}" />
    <Setter Property="Height" Value="{DynamicResource ShellTitleBarNavIconSize}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
  </Style>

  <Style Selector="Border.ShellTitleBarPathBar">
    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellTitleBarPathBarRadius}" />
    <Setter Property="Height" Value="{DynamicResource ShellTitleBarPathBarHeight}" />
  </Style>

  <Style Selector="TextBlock.ShellTitleBarPathText">
    <Setter Property="FontSize" Value="{DynamicResource ShellTitleBarPathBarFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.ShellTitleBarPathDot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource MutedColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="StackPanel.ShellTitleBarPathTrailing icons|AppIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
  </Style>

  <Style Selector="Button.ShellStatusItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="Padding" Value="{DynamicResource ShellStatusItemPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource ShellStatusBarHeight}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          x:Name="PART_Border"
          Padding="{TemplateBinding Padding}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.ShellStatusItem:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
  </Style>

  <Style Selector="Button.ShellStatusItem:pressed /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
  </Style>

  <Style Selector="Button.ShellStatusItem.active /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
  </Style>

  <Style Selector="Button.ShellStatusItem.active:pointerover /template/ Border#PART_Border,                      Button.ShellStatusItem.active:pressed /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
  </Style>

  <Style Selector="Button.ShellStatusItem:disabled">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="Button.ShellStatusItem:disabled:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.ShellStatusItem:pointerover,                      Button.ShellStatusItem:pressed,                      Button.ShellStatusItem.active,                      Button.ShellStatusItem.active:pointerover,                      Button.ShellStatusItem.active:pressed">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="Border.ShellStatusBar TextBlock.Caption.Muted">
    <Setter Property="FontSize" Value="{DynamicResource ShellStatusLabelSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.ShellStatusItem TextBlock.Caption.Muted,                      Button.ShellStatusItem:pointerover TextBlock.Caption.Muted,                      Button.ShellStatusItem:pressed TextBlock.Caption.Muted,                      Button.ShellStatusItem.active TextBlock.Caption.Muted,                      Button.ShellStatusItem.active:pointerover TextBlock.Caption.Muted,                      Button.ShellStatusItem.active:pressed TextBlock.Caption.Muted">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="Button.ShellStatusItem:not(.ShellStatusDbItem):not(.ShellStatusAgentItem) icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="StrokeWidth" Value="{DynamicResource SidebarMenuIconStroke}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="Button.ShellStatusItem:not(.ShellStatusDbItem):not(.ShellStatusAgentItem):pointerover icons|AppIcon,                      Button.ShellStatusItem:not(.ShellStatusDbItem):not(.ShellStatusAgentItem):pressed icons|AppIcon,                      Button.ShellStatusItem:not(.ShellStatusDbItem):not(.ShellStatusAgentItem).active icons|AppIcon,                      Button.ShellStatusItem:not(.ShellStatusDbItem):not(.ShellStatusAgentItem).active:pointerover icons|AppIcon,                      Button.ShellStatusItem:not(.ShellStatusDbItem):not(.ShellStatusAgentItem).active:pressed icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="Button.ShellStatusDbItem icons|AppIcon,                      Button.ShellStatusAgentItem icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="StrokeWidth" Value="{DynamicResource SidebarMenuIconStroke}" />
  </Style>

  <Style Selector="Button.ShellStatusIconItem">
    <Setter Property="Padding" Value="{DynamicResource ShellStatusIconItemPadding}" />
  </Style>

  <Style Selector="Border.ShellStatusDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="{DynamicResource ShellStatusDividerHeight}" />
    <Setter Property="Background" Value="{DynamicResource BorderColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>

  <Style Selector="Button.WindowControlsButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="Padding" Value="{DynamicResource ShellTitleBarCapsuleButtonPadding}" />
    <Setter Property="MinWidth" Value="{DynamicResource ShellTitleBarCapsuleButtonMinSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource ShellTitleBarCapsuleButtonMinSize}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          x:Name="PART_Border"
          Padding="{TemplateBinding Padding}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.WindowControlsButton:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
  </Style>

  <Style Selector="Button.WindowControlsButton:pressed /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
  </Style>

  <Style Selector="Button.WindowControlsButton:pointerover,                      Button.WindowControlsButton:pressed">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>
</Styles>
