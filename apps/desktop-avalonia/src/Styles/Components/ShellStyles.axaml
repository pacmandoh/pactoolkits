<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI">
  <Style Selector="shad|Window /template/ Border#PART_TitleBarBackground">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
  </Style>

  <Style Selector="shad|Window /template/ LayoutTransformControl#LayoutTransform">
    <Setter Property="MinHeight" Value="{DynamicResource TitleBarHeight}" />
  </Style>

  <Style Selector="shad|Window /template/ LayoutTransformControl#LayoutTransform &gt; Border">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <Style Selector="shad|Window /template/ Border#BottomBorder">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="shad|Window /template/ StackPanel#AppTitlePanel &gt; TextBlock">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Width" Value="0" />
    <Setter Property="Height" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="shad|Window /template/ StackPanel#AppTitlePanel">
    <Setter Property="Margin" Value="72,0,12,0" />
    <Setter Property="MinHeight" Value="{DynamicResource TitleBarHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="shad|Window /template/ ContentPresenter#RightButtons">
    <Setter Property="Margin" Value="{DynamicResource TitleBarRightMargin}" />
  </Style>

  <Style Selector="Border.TitleBarCapsule">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Margin" Value="{DynamicResource TitleBarCapsuleMargin}" />
    <Setter Property="Padding" Value="0.5" />
  </Style>

  <Style Selector="Border.TitleBarCapsule Button.WindowControlsButton">
    <Setter Property="MinWidth" Value="{DynamicResource TitleBarCapsuleBtnSize}" />
    <Setter Property="MaxWidth" Value="{DynamicResource TitleBarCapsuleBtnSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource TitleBarCapsuleBtnSize}" />
    <Setter Property="MaxHeight" Value="{DynamicResource TitleBarCapsuleBtnSize}" />
    <Setter Property="Padding" Value="{DynamicResource TitleBarCapsuleBtnPadding}" />
  </Style>

  <Style Selector="Border.TitleBarCapsule Button.WindowControlsButton icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource TitleBarCapsuleIconSize}" />
    <Setter Property="Height" Value="{DynamicResource TitleBarCapsuleIconSize}" />
  </Style>

  <Style Selector="Grid.TitleBarNav">
    <Setter Property="Width" Value="{DynamicResource TitleBarNavWidth}" />
    <Setter Property="ColumnSpacing" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.TitleBarNavBtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}" />
    <Setter Property="Width" Value="{DynamicResource TitleBarNavBtnSize}" />
    <Setter Property="Height" Value="{DynamicResource TitleBarNavBtnSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.TitleBarNavBtn icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource TitleBarNavIconSize}" />
    <Setter Property="Height" Value="{DynamicResource TitleBarNavIconSize}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
  </Style>

  <Style Selector="Border.TitleBarPath">
    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource TitleBarPathRadius}" />
    <Setter Property="Height" Value="{DynamicResource TitleBarPathHeight}" />
  </Style>

  <Style Selector="Border.TitleBarPath TextBlock.Caption.Muted">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.TitleBarPathDot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource MutedColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="StackPanel.TitleBarPathTrail icons|AppIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
  </Style>

  <Style Selector="Button.StatusBarItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="Padding" Value="{DynamicResource StatusBarItemPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource StatusBarHeight}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          x:Name="PART_Border"
          Padding="{TemplateBinding Padding}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
          <StackPanel
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            Orientation="Horizontal"
            Spacing="{DynamicResource SpacingInlineSm}">
            <Viewbox
              Width="{TemplateBinding shad:ButtonAssist.ShowProgress,
                                      Converter={x:Static shad:BooleanConverters.ToZeroOrDouble},
                                      ConverterParameter=16}"
              Height="{DynamicResource IconSizeSmall}"
              VerticalAlignment="Center"
              IsVisible="{TemplateBinding shad:ButtonAssist.ShowProgress}">
              <ContentPresenter Content="{TemplateBinding shad:ButtonAssist.ShowProgress, Converter={x:Static shad:BooleanConverters.ToLoading}}" />
            </Viewbox>
            <Viewbox
              Width="{TemplateBinding shad:ButtonAssist.ShowProgress,
                                      Converter={x:Static shad:BooleanConverters.ToDoubleOrZero},
                                      ConverterParameter=16}"
              Height="{DynamicResource IconSizeSmall}"
              VerticalAlignment="Center"
              IsVisible="{TemplateBinding shad:ButtonAssist.Icon,
                                          Converter={x:Static ObjectConverters.IsNotNull}}"
              Opacity="{TemplateBinding shad:ButtonAssist.ShowProgress,
                                        Converter={x:Static shad:BooleanConverters.ToInverseOpacity}}">
              <ContentPresenter Content="{TemplateBinding shad:ButtonAssist.Icon}" />
            </Viewbox>
            <ContentPresenter
              VerticalAlignment="Center"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.StatusBarItem:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
  </Style>

  <Style Selector="Button.StatusBarItem:pressed /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
  </Style>

  <Style Selector="Button.StatusBarItem.active /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
  </Style>

  <Style Selector="Button.StatusBarItem.active:pointerover /template/ Border#PART_Border,Button.StatusBarItem.active:pressed /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
  </Style>

  <Style Selector="Button.StatusBarItem:disabled">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="Button.StatusBarItem:disabled:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.StatusBarItem:pointerover,Button.StatusBarItem:pressed,Button.StatusBarItem.active,Button.StatusBarItem.active:pointerover,Button.StatusBarItem.active:pressed">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="Border.StatusBar TextBlock.Caption.Muted">
    <Setter Property="FontSize" Value="{DynamicResource StatusBarCaptionSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.StatusBarItem TextBlock.Caption.Muted,Button.StatusBarItem:pointerover TextBlock.Caption.Muted,Button.StatusBarItem:pressed TextBlock.Caption.Muted,Button.StatusBarItem.active TextBlock.Caption.Muted,Button.StatusBarItem.active:pointerover TextBlock.Caption.Muted,Button.StatusBarItem.active:pressed TextBlock.Caption.Muted">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="Button.StatusBarItem:not(.StatusBarDbItem):not(.StatusBarAgentItem) icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="StrokeWidth" Value="{DynamicResource SidebarMenuIconStroke}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="Button.StatusBarItem:not(.StatusBarDbItem):not(.StatusBarAgentItem):pointerover icons|AppIcon,Button.StatusBarItem:not(.StatusBarDbItem):not(.StatusBarAgentItem):pressed icons|AppIcon,Button.StatusBarItem:not(.StatusBarDbItem):not(.StatusBarAgentItem).active icons|AppIcon,Button.StatusBarItem:not(.StatusBarDbItem):not(.StatusBarAgentItem).active:pointerover icons|AppIcon,Button.StatusBarItem:not(.StatusBarDbItem):not(.StatusBarAgentItem).active:pressed icons|AppIcon">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>

  <Style Selector="Button.StatusBarDbItem icons|AppIcon,Button.StatusBarAgentItem icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeSmall}" />
    <Setter Property="StrokeWidth" Value="{DynamicResource SidebarMenuIconStroke}" />
  </Style>

  <Style Selector="Button.StatusBarIconItem">
    <Setter Property="Padding" Value="{DynamicResource StatusBarIconPadding}" />
  </Style>

  <Style Selector="Border.StatusBarDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="{DynamicResource StatusBarDividerHeight}" />
    <Setter Property="Background" Value="{DynamicResource BorderColor}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>

  <Style Selector="Button.WindowControlsButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="Padding" Value="{DynamicResource TitleBarCapsuleBtnPadding}" />
    <Setter Property="MinWidth" Value="{DynamicResource TitleBarCapsuleBtnSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource TitleBarCapsuleBtnSize}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          x:Name="PART_Border"
          Padding="{TemplateBinding Padding}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
          <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox
              Width="{TemplateBinding shad:ButtonAssist.ShowProgress,
                                      Converter={x:Static shad:BooleanConverters.ToZeroOrDouble},
                                      ConverterParameter=16}"
              Height="{DynamicResource TitleBarCapsuleIconSize}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
              <ContentPresenter Content="{TemplateBinding shad:ButtonAssist.ShowProgress, Converter={x:Static shad:BooleanConverters.ToLoading}}" />
            </Viewbox>
            <ContentPresenter
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              Opacity="{TemplateBinding shad:ButtonAssist.ShowProgress,
                                        Converter={x:Static shad:BooleanConverters.ToInverseOpacity}}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.WindowControlsButton:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
  </Style>

  <Style Selector="Button.WindowControlsButton:pressed /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
  </Style>

  <Style Selector="Button.WindowControlsButton:pointerover,Button.WindowControlsButton:pressed">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
  </Style>
</Styles>
