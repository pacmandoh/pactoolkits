<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI">
  <Style Selector="shad|Window /template/ LayoutTransformControl#LayoutTransform">
    <Setter Property="MinHeight" Value="{DynamicResource TitleBarHeight}" />
  </Style>

  <Style Selector="shad|Window /template/ LayoutTransformControl#LayoutTransform &gt; Border">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <Style Selector="shad|Window /template/ Border#BottomBorder">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="Panel.ShellMenuUpdateIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Panel.ShellMenuUpdateIcon icons|AppIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>

  <Style Selector="Panel.ShellMenuUpdateIcon Border.UpdateDot">
    <Setter Property="Margin" Value="0" />
  </Style>
</Styles>
