<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls">
  <Style Selector="icons|AppIcon">
    <Setter Property="Width" Value="{DynamicResource IconSizeDefault}" />
    <Setter Property="Height" Value="{DynamicResource IconSizeDefault}" />
  </Style>
</Styles>
