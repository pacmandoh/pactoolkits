<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls">
  <!-- Demo DataTable footer: status text + Outline nav buttons -->
  <Style Selector="controls|DataGridPager">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="controls|DataGridPager StackPanel.DataGridPagerLeft">
    <Setter Property="Spacing" Value="{DynamicResource SpacingInlineMd}" />
  </Style>

  <Style Selector="controls|DataGridPager StackPanel.DataGridPagerRight">
    <Setter Property="Spacing" Value="{DynamicResource SpacingInlineMd}" />
  </Style>

  <Style Selector="controls|DataGridPager Button.PagerIconOnly">
    <Setter Property="Width" Value="{DynamicResource PagerNavButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource PagerNavButtonSize}" />
    <Setter Property="MinWidth" Value="{DynamicResource PagerNavButtonSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource PagerNavButtonSize}" />
    <Setter Property="Padding" Value="0" />
  </Style>
</Styles>
