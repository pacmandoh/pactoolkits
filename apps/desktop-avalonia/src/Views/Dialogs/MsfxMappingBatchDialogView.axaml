<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Dialogs.MsfxMappingBatchDialogView"
  xmlns="https://github.com/avaloniaui"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:PacToolkits.Desktop.Avalonia.Behaviors"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:dialogs="clr-namespace:PacToolkits.Desktop.Avalonia.Services.Infrastructure"
  xmlns:dto="clr-namespace:PacToolkits.Application.DTOs;assembly=PacToolkits.Application"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:Name="Root"
  behaviors:FocusClearBehavior.Enable="True"
  behaviors:FocusClearBehavior.SuppressGridClear="True"
  x:DataType="dialogs:MsfxMappingBatchDialogModel"
  Focusable="True">
  <shad:Card
    MinWidth="920"
    MaxWidth="1180"
    Padding="16"
    behaviors:FocusClearBehavior.SuppressGridClear="True">
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource PageColumnSpacing}">
        <Border
          Width="40"
          Height="40"
          CornerRadius="20">
          <icons:AppIcon
            Width="20"
            Height="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Kind="Table2" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Classes="DialogTitle" Text="批量映射处理" />
          <TextBlock Classes="Caption Muted" Text="先选分组，再映射或直接弃用任务" />
        </StackPanel>
        <Button
          x:Name="ToggleSearchPanelButton"
          Grid.Column="2"
          Width="40"
          Height="{StaticResource ControlHeightCompact}"
          MinWidth="40"
          Padding="0"
          HorizontalContentAlignment="Center"
          VerticalContentAlignment="Center"
          Classes="Action"
          Click="ToggleSearchPanel_OnClick">
          <Panel
            Width="{DynamicResource IconSizeDefault}"
            Height="{DynamicResource IconSizeDefault}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <icons:AppIcon
              x:Name="SearchPanelClosedIcon"
              Width="{DynamicResource IconSizeSmall}"
              Height="{DynamicResource IconSizeSmall}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Kind="Search" />
            <icons:AppIcon
              x:Name="SearchPanelOpenIcon"
              Width="{DynamicResource IconSizeSmall}"
              Height="{DynamicResource IconSizeSmall}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="False"
              Kind="SearchX" />
          </Panel>
        </Button>
      </Grid>

      <Grid
        Grid.Row="1"
        RowDefinitions="Auto,*"
        RowSpacing="{DynamicResource DialogInnerRowSpacing}">
        <shad:Card
          x:Name="SearchPanel"
          IsVisible="False">
          <Grid
            VerticalAlignment="Center"
            ColumnDefinitions="160,Auto,180,Auto,130,*,Auto,Auto"
            ColumnSpacing="{DynamicResource PageColumnSpacing}">
            <ComboBox
              x:Name="SearchScopeBox"
              MinWidth="160"
              HorizontalAlignment="Stretch" />
            <TextBlock
              Grid.Column="1"
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              Classes="Caption Muted"
              Text="映射状态" />
            <ComboBox
              x:Name="MapStatusBox"
              Grid.Column="2"
              MinWidth="180"
              HorizontalAlignment="Stretch" />
            <TextBlock
              Grid.Column="3"
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              Classes="Caption Muted"
              Text="码状态" />
            <ComboBox
              x:Name="CodeStatusBox"
              Grid.Column="4"
              HorizontalAlignment="Stretch" />
            <TextBox
              x:Name="KeywordBox"
              Grid.Column="5"
              VerticalContentAlignment="Center"
              AcceptsReturn="False"
              Classes="SearchBox"
              KeyDown="KeywordBox_OnKeyDown"
              PlaceholderText="搜索分组..."
              TextWrapping="NoWrap" />
            <Button
              Grid.Column="6"
              Classes="Action"
              Click="SearchButton_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeDefault}"
                  Height="{DynamicResource IconSizeDefault}"
                  Kind="Search" />
                <TextBlock Text="搜索" />
              </StackPanel>
            </Button>
            <Button
              Grid.Column="7"
              Classes="Action"
              Click="ResetFiltersButton_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeDefault}"
                  Height="{DynamicResource IconSizeDefault}"
                  Kind="Eraser" />
                <TextBlock Text="重置" />
              </StackPanel>
            </Button>
          </Grid>
        </shad:Card>

        <DataGrid
          x:Name="GroupGrid"
          Grid.Row="1"
          Height="280"
          x:DataType="dto:MsfxMappingBatchGroupRow"
          Classes="SectionGrid InventoryGrid LowToneGrid MsfxIndexedGrid"
          HorizontalScrollBarVisibility="Auto"
          IsReadOnly="True"
          PointerPressed="GroupGrid_OnPointerPressed"
          SelectionMode="Single">
          <DataGrid.Columns>
            <DataGridTextColumn
              Width="140"
              Binding="{Binding SourceBillTimes}"
              Header="单据时间" />
            <DataGridTextColumn
              Width="220"
              Binding="{Binding SourceBillCodes}"
              Header="单据编码" />
            <DataGridTextColumn
              Width="180"
              Binding="{Binding SourceDrugNameRaw}"
              Header="原始药名" />
            <DataGridTextColumn
              Width="180"
              Binding="{Binding SourceSpecRaw}"
              Header="原始规格" />
            <DataGridTextColumn
              Width="180"
              Binding="{Binding SourceNameNorm}"
              Header="归一化药名" />
            <DataGridTextColumn
              Width="180"
              Binding="{Binding SourceSpecNorm}"
              Header="归一化规格" />
            <DataGridTextColumn
              Width="80"
              Binding="{Binding TotalCount}"
              Header="总数" />
            <DataGridTemplateColumn Width="520" Header="状态构成">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="dto:MsfxMappingBatchGroupRow">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
                    <controls:StatusPill
                      Classes="ToneWarning25"
                      Icon="Info"
                      IconSize="12"
                      PillPadding="8,3"
                      Text="{Binding PendingCount, StringFormat=待映射 {0}}"
                      TextSize="11" />
                    <controls:StatusPill
                      Classes="ToneInfo25"
                      Icon="Bookmark"
                      IconSize="12"
                      PillPadding="8,3"
                      Text="{Binding NeedReviewCount, StringFormat=待人工 {0}}"
                      TextSize="11" />
                    <controls:StatusPill
                      Classes="ToneDanger25"
                      Icon="CircleX"
                      IconSize="12"
                      PillPadding="8,3"
                      Text="{Binding FailedCount, StringFormat=失败 {0}}"
                      TextSize="11" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <Grid
        Grid.Row="2"
        RowDefinitions="Auto,Auto"
        RowSpacing="{DynamicResource FormRowSpacing}">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
          <shad:Card
            Grid.Column="0"
            Padding="10,8">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeSmall}"
                  Height="{DynamicResource IconSizeSmall}"
                  Kind="Pill" />
                <TextBlock Classes="Caption Muted" Text="药品名称" />
              </StackPanel>
              <AutoCompleteBox
                x:Name="DrugIdBox"
                Grid.Row="1"
                FilterMode="Contains"
                KeyDown="DrugIdBox_OnKeyDown"
                MinimumPrefixLength="1"
                PlaceholderText="输入院内药品信息">
                <AutoCompleteBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionItem">
                    <TextBlock Text="{Binding Display}" />
                  </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
              </AutoCompleteBox>
            </Grid>
          </shad:Card>

          <shad:Card
            Grid.Column="1"
            Padding="10,8">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource DialogFormRowSpacing}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeSmall}"
                  Height="{DynamicResource IconSizeSmall}"
                  Kind="Scale" />
                <TextBlock Classes="Caption Muted" Text="规格" />
              </StackPanel>
              <Grid Grid.Row="1">
                <ComboBox
                  x:Name="SpecBox"
                  Height="{StaticResource ControlHeightCompact}"
                  MinWidth="220"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  MaxDropDownHeight="300" />
                <TextBlock
                  x:Name="SpecPlaceholder"
                  Margin="{DynamicResource MarginLeftMd}"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"
                  Opacity="0.55"
                  Text="请选择规格" />
              </Grid>
            </Grid>
          </shad:Card>
        </Grid>

        <shad:Card Grid.Row="1">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SpacingInlineMd}">
            <icons:AppIcon
              Width="{DynamicResource IconSizeSmall}"
              Height="{DynamicResource IconSizeSmall}"
              VerticalAlignment="Center"
              Kind="ChartSpline" />
            <TextBlock
              x:Name="PreviewText"
              Grid.Column="1"
              Opacity="0.9"
              Text="请选择分组后自动预览"
              TextWrapping="Wrap" />
          </Grid>
        </shad:Card>
      </Grid>
    </Grid>
  </shad:Card>
</UserControl>
