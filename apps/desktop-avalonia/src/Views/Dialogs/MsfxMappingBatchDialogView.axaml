<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Dialogs.MsfxMappingBatchDialogView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:PacToolkits.Desktop.Avalonia.Behaviors"
  xmlns:con="https://github.com/kikipoulet/SukiUI"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:dialogs="clr-namespace:PacToolkits.Desktop.Avalonia.Services.Infrastructure"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:Name="Root"
  behaviors:FocusClearBehavior.Enable="True"
  behaviors:FocusClearBehavior.SuppressGridClear="True"
  x:DataType="dialogs:MsfxMappingBatchDialogModel"
  Focusable="True">
  <suki:GlassCard
    MinWidth="920"
    MaxWidth="1180"
    Padding="16"
    behaviors:FocusClearBehavior.SuppressGridClear="True"
    Classes="SectionCard">
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
        <Border
          Width="40"
          Height="40"
          CornerRadius="20">
          <icons:AppIcon
            Width="20"
            Height="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Kind="Table2" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Classes="DialogTitle" Text="批量映射处理" />
          <TextBlock Opacity="0.75" Text="先选分组，再映射或直接弃用任务" />
        </StackPanel>
      </Grid>

      <Grid
        Grid.Row="1"
        RowDefinitions="Auto,*"
        RowSpacing="{DynamicResource DialogFormRowSpacing}">
        <TextBlock Opacity="0.8" Text="待处理分组（按 原始药名/规格 + 归一化药名/规格）" />
        <DataGrid
          x:Name="GroupGrid"
          Grid.Row="1"
          Height="280"
          Classes="SectionGrid InventoryGrid LowToneGrid MsfxIndexedGrid"
          GridLinesVisibility="All"
          HeadersVisibility="All"
          HorizontalScrollBarVisibility="Auto"
          IsReadOnly="True"
          ItemsSource="{Binding Groups}"
          PointerPressed="GroupGrid_OnPointerPressed"
          SelectionMode="Single">
          <DataGrid.Styles>
            <Style Selector="DataGrid#GroupGrid DataGridCell TextBlock">
              <Setter Property="TextWrapping" Value="NoWrap" />
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTextColumn
              Width="140"
              Binding="{Binding SourceBillTimes}"
              Header="单据时间" />
            <DataGridTextColumn
              Width="220"
              Binding="{Binding SourceBillCodes}"
              Header="单据编码" />
            <DataGridTextColumn
              Width="180"
              Binding="{Binding SourceDrugNameRaw}"
              Header="原始药名" />
            <DataGridTextColumn
              Width="180"
              Binding="{Binding SourceSpecRaw}"
              Header="原始规格" />
            <DataGridTextColumn
              Width="180"
              Binding="{Binding SourceNameNorm}"
              Header="归一化药名" />
            <DataGridTextColumn
              Width="180"
              Binding="{Binding SourceSpecNorm}"
              Header="归一化规格" />
            <DataGridTextColumn
              Width="80"
              Binding="{Binding TotalCount}"
              Header="总数" />
            <DataGridTemplateColumn Width="520" Header="状态构成">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
                    <controls:StatusPill
                      Classes="ToneWarning25"
                      Icon="Info"
                      IconSize="12"
                      PillPadding="8,3"
                      Text="{Binding PendingCount, StringFormat=待映射 {0}}"
                      TextSize="11" />
                    <controls:StatusPill
                      Classes="ToneInfo25"
                      Icon="Bookmark"
                      IconSize="12"
                      PillPadding="8,3"
                      Text="{Binding NeedReviewCount, StringFormat=待人工 {0}}"
                      TextSize="11" />
                    <controls:StatusPill
                      Classes="ToneDanger25"
                      Icon="CircleX"
                      IconSize="12"
                      PillPadding="8,3"
                      Text="{Binding FailedCount, StringFormat=失败 {0}}"
                      TextSize="11" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <Grid
        Grid.Row="2"
        RowDefinitions="Auto,Auto"
        RowSpacing="{DynamicResource FormRowSpacing}">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
          <con:GlassCard
            Grid.Column="0"
            Padding="10,8"
            Classes="FilterFieldCard">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeSmall}"
                  Height="{DynamicResource IconSizeSmall}"
                  Kind="Pill" />
                <TextBlock Opacity="0.82" Text="药品名称" />
              </StackPanel>
              <controls:PlainAutoCompleteBox
                x:Name="DrugIdBox"
                Grid.Row="1"
                KeyDown="DrugIdBox_OnKeyDown"
                MinimumPrefixLength="1"
                PlaceholderText="输入院内药品信息">
                <controls:PlainAutoCompleteBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionItem">
                    <TextBlock Text="{Binding Display}" />
                  </DataTemplate>
                </controls:PlainAutoCompleteBox.ItemTemplate>
              </controls:PlainAutoCompleteBox>
            </Grid>
          </con:GlassCard>

          <con:GlassCard
            Grid.Column="1"
            Padding="10,8"
            Classes="FilterFieldCard">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource DialogFormRowSpacing}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeSmall}"
                  Height="{DynamicResource IconSizeSmall}"
                  Kind="Scale" />
                <TextBlock Opacity="0.82" Text="规格" />
              </StackPanel>
              <Grid Grid.Row="1">
                <ComboBox
                  x:Name="SpecBox"
                  Height="{StaticResource ControlHeightCompact}"
                  MinWidth="220"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  MaxDropDownHeight="300" />
                <TextBlock
                  x:Name="SpecPlaceholder"
                  Margin="{DynamicResource MarginLeftMd}"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"
                  Opacity="0.55"
                  Text="请选择规格" />
              </Grid>
            </Grid>
          </con:GlassCard>
        </Grid>

        <con:GlassCard Grid.Row="1" Classes="FilterHintCard">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SpacingInlineMd}">
            <icons:AppIcon
              Width="{DynamicResource IconSizeSmall}"
              Height="{DynamicResource IconSizeSmall}"
              VerticalAlignment="Center"
              Kind="ChartSpline" />
            <TextBlock
              x:Name="PreviewText"
              Grid.Column="1"
              Opacity="0.9"
              Text="请选择分组后自动预览"
              TextWrapping="Wrap" />
          </Grid>
        </con:GlassCard>
      </Grid>
    </Grid>
  </suki:GlassCard>
</UserControl>
