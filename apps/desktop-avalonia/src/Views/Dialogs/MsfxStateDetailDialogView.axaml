<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Dialogs.MsfxStateDetailDialogView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:dialogs="clr-namespace:PacToolkits.Desktop.Avalonia.Services.Infrastructure"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  x:DataType="dialogs:MsfxStateDetailDialogModel">
  <Border
    MinWidth="560"
    MaxWidth="920"
    Padding="{DynamicResource DialogPadding}"
    CornerRadius="16">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource PageRowSpacing}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
        <Border
          Width="44"
          Height="44"
          Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
          CornerRadius="22">
          <icons:AppIcon
            Width="24"
            Height="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
            Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
        </Border>
        <StackPanel
          Grid.Column="1"
          VerticalAlignment="Center"
          Spacing="2">
          <TextBlock Classes="DialogTitleLg" Text="{Binding Header}" />
          <TextBlock Classes="Caption Muted" Text="{Binding SubHeader}" />
        </StackPanel>
      </Grid>

      <Border
        Grid.Row="1"
        Padding="12"
        Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
        CornerRadius="12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
          <icons:AppIcon
            Width="{DynamicResource IconSizeSectionHeader}"
            Height="{DynamicResource IconSizeSectionHeader}"
            VerticalAlignment="Top"
            Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
            Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
          <StackPanel Grid.Column="1" Spacing="{DynamicResource SpacingInlineSm}">
            <TextBlock FontWeight="SemiBold" Text="{Binding HighlightTitle}" />
            <TextBlock
              MaxHeight="220"
              Text="{Binding HighlightMessage}"
              TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <Border
        Grid.Row="2"
        Height="1"
        Opacity="0.2" />

      <ScrollViewer
        Grid.Row="3"
        MaxHeight="420"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel
                ItemSpacing="{DynamicResource SpacingInlineMd}"
                ItemWidth="280"
                LineSpacing="{DynamicResource SpacingInlineMd}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="dialogs:InfoDetailItem">
              <Border Padding="10,8" CornerRadius="10">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                  <TextBlock Classes="Caption Muted" Text="{Binding Label}" />
                  <TextBlock
                    Grid.Row="1"
                    Text="{Binding Value}"
                    TextWrapping="Wrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
