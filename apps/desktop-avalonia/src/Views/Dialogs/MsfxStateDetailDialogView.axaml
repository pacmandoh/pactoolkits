<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Dialogs.MsfxStateDetailDialogView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:dialogs="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Dialogs"
  xmlns:infra="clr-namespace:PacToolkits.Desktop.Avalonia.Services.Infrastructure"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  x:DataType="dialogs:MsfxStateDetailDialogViewModel">
  <StackPanel
    Margin="24"
    MinWidth="560"
    MaxWidth="920"
    Spacing="16">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
      <Border
        Width="44"
        Height="44"
        Background="{Binding Detail.State, Converter={StaticResource TraceEntryStateToBgBrush}}"
        CornerRadius="22">
        <icons:AppIcon
          Width="24"
          Height="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Foreground="{Binding Detail.State, Converter={StaticResource TraceEntryStateToFgBrush}}"
          Kind="{Binding Detail.State, Converter={StaticResource TraceEntryStateToIconKind}}" />
      </Border>
      <StackPanel
        Grid.Column="1"
        VerticalAlignment="Center"
        Spacing="2">
        <TextBlock Classes="h4" Text="{Binding Detail.Header}" />
        <TextBlock Classes="Caption Muted" Text="{Binding Detail.SubHeader}" />
      </StackPanel>
    </Grid>

    <Border
      Padding="12"
      Background="{Binding Detail.State, Converter={StaticResource TraceEntryStateToBgBrush}}"
      CornerRadius="12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
        <icons:AppIcon
          Width="{DynamicResource IconSizeSectionHeader}"
          Height="{DynamicResource IconSizeSectionHeader}"
          VerticalAlignment="Top"
          Foreground="{Binding Detail.State, Converter={StaticResource TraceEntryStateToFgBrush}}"
          Kind="{Binding Detail.State, Converter={StaticResource TraceEntryStateToIconKind}}" />
        <StackPanel Grid.Column="1" Spacing="{DynamicResource SpacingInlineSm}">
          <TextBlock FontWeight="SemiBold" Text="{Binding Detail.HighlightTitle}" />
          <TextBlock
            MaxHeight="220"
            Text="{Binding Detail.HighlightMessage}"
            TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer
      MaxHeight="420"
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Detail.Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel
              ItemSpacing="{DynamicResource SpacingInlineMd}"
              ItemWidth="280"
              LineSpacing="{DynamicResource SpacingInlineMd}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="infra:InfoDetailItem">
            <Border Padding="10,8" CornerRadius="10">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                <TextBlock Classes="Caption Muted" Text="{Binding Label}" />
                <TextBlock
                  Grid.Row="1"
                  Text="{Binding Value}"
                  TextWrapping="Wrap" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Button
      Classes="Primary"
      Command="{Binding CloseCommand}"
      Content="关闭"
      HotKey="Escape" />
  </StackPanel>
</UserControl>
