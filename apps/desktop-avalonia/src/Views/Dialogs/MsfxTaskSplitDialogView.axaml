<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Dialogs.MsfxTaskSplitDialogView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:dialogs="clr-namespace:PacToolkits.Desktop.Avalonia.Services.Infrastructure"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  x:DataType="dialogs:MsfxTaskSplitDialogModel">
  <shad:Card
    MinWidth="980"
    MaxWidth="1220"
    Padding="16"
    Classes="SectionCard">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource PageRowSpacing}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
        <Border
          Width="40"
          Height="40"
          Background="{DynamicResource BrushInfoBg15}"
          CornerRadius="20">
          <icons:AppIcon
            Width="20"
            Height="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{DynamicResource BrushInfo}"
            Kind="GitBranchPlus" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Classes="DialogTitle" Text="拆分任务预览" />
          <TextBlock Opacity="0.75" Text="按父码簇安全拆分，不再按叶子码任意硬切。" />
        </StackPanel>
      </Grid>

      <Grid
        Grid.Row="1"
        ColumnDefinitions="Auto,Auto,Auto,*"
        ColumnSpacing="{DynamicResource SpacingInlineMd}">
        <controls:StatusPill
          Classes="ToneInfo15"
          Icon="Hash"
          Text="{Binding TaskId, StringFormat=任务 #{0}}" />
        <controls:StatusPill
          Grid.Column="1"
          Classes="ToneWarning15"
          Icon="Package"
          Text="{Binding TotalCodes, StringFormat=总码数 {0}}" />
        <controls:StatusPill
          Grid.Column="2"
          Classes="ToneDone15"
          Icon="ReceiptText"
          Text="{Binding SourceBillCode}" />
        <TextBlock
          Grid.Column="3"
          VerticalAlignment="Center"
          Opacity="0.82"
          Text="{Binding Target}"
          TextTrimming="CharacterEllipsis" />
      </Grid>

      <Grid
        Grid.Row="2"
        ColumnDefinitions="Auto,*"
        ColumnSpacing="{DynamicResource PageColumnSpacing}">
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock FontWeight="SemiBold" Text="自定义数量拆分" />
          <TextBlock
            MaxWidth="300"
            Classes="SectionHint"
            Text="按逗号或空格输入数量，例如：400,400,800，系统只会按父码簇完整分配，不会危险硬切"
            TextWrapping="Wrap" />
        </StackPanel>
        <TextBox
          x:Name="QuantitySplitBox"
          Grid.Column="1"
          HorizontalAlignment="Stretch"
          Classes="Control"
          PlaceholderText="例如：400, 400, 400, 400" />
      </Grid>

      <DataGrid
        x:Name="SplitUnitGrid"
        Grid.Row="3"
        Height="320"
        Classes="SectionGrid InventoryGrid LowToneGrid MsfxIndexedGrid"
        GridLinesVisibility="All"
        HeadersVisibility="All"
        HorizontalScrollBarVisibility="Auto"
        IsReadOnly="True"
        ItemsSource="{Binding SplitCodeRows}">
        <DataGrid.Columns>
          <DataGridTextColumn
            Width="220"
            Binding="{Binding DisplayClusterCode}"
            Header="父码簇" />
          <DataGridTextColumn
            Width="220"
            Binding="{Binding LeafCode}"
            Header="最小包装码" />
          <DataGridTextColumn
            Width="180"
            Binding="{Binding CodeLevel1}"
            Header="一级码" />
          <DataGridTextColumn
            Width="180"
            Binding="{Binding CodeLevel2}"
            Header="二级码" />
          <DataGridTextColumn
            Width="180"
            Binding="{Binding CodeLevel3}"
            Header="三级码" />
          <DataGridTextColumn
            Width="180"
            Binding="{Binding CodeLevel4}"
            Header="四级码" />
          <DataGridTextColumn
            Width="180"
            Binding="{Binding CodeLevel5}"
            Header="五级码" />
          <DataGridTextColumn
            Width="180"
            Binding="{Binding BatchNo}"
            Header="批号" />
          <DataGridTextColumn
            Width="220"
            Binding="{Binding SourceBillCode}"
            Header="来源单据" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </shad:Card>
</UserControl>
