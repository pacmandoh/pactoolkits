<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Dialogs.MsfxMappingBatchView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:PacToolkits.Desktop.Avalonia.Behaviors"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:dto="clr-namespace:PacToolkits.Application.DTOs;assembly=PacToolkits.Application"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  xmlns:vmDialogs="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Dialogs"
  x:Name="Root"
  behaviors:FocusClear.Enable="True"
  behaviors:FocusClear.SuppressGridClear="True"
  x:DataType="vmDialogs:MsfxMappingBatch"
  Focusable="True">
  <shad:Card
    MinWidth="920"
    MaxWidth="1180"
    Padding="16"
    behaviors:FocusClear.SuppressGridClear="True">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource PageColumnSpacing}">
        <Border
          Width="40"
          Height="40"
          CornerRadius="20">
          <icons:AppIcon
            Width="20"
            Height="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Kind="Table2" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Classes="DialogTitle" Text="批量映射处理" />
          <TextBlock Classes="Caption Muted" Text="先选分组，再映射或直接弃用任务" />
        </StackPanel>
        <Button
          Grid.Column="2"
          Width="40"
          Height="{StaticResource ControlHeightCompact}"
          MinWidth="40"
          Padding="0"
          HorizontalContentAlignment="Center"
          VerticalContentAlignment="Center"
          Classes="Action"
          Command="{Binding ToggleSearchPanelCommand}">
          <Panel
            Width="{DynamicResource IconSizeDefault}"
            Height="{DynamicResource IconSizeDefault}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <icons:AppIcon
              Width="{DynamicResource IconSizeSmall}"
              Height="{DynamicResource IconSizeSmall}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding SearchPanelClosedIconVisible}"
              Kind="Search" />
            <icons:AppIcon
              Width="{DynamicResource IconSizeSmall}"
              Height="{DynamicResource IconSizeSmall}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding SearchPanelOpenIconVisible}"
              Kind="SearchX" />
          </Panel>
        </Button>
      </Grid>

      <Grid
        Grid.Row="1"
        RowDefinitions="Auto,*"
        RowSpacing="{DynamicResource DialogRowSpacing}">
        <shad:Card IsVisible="{Binding IsSearchPanelVisible}">
          <Grid
            VerticalAlignment="Center"
            ColumnDefinitions="160,Auto,180,Auto,130,*,Auto,Auto"
            ColumnSpacing="{DynamicResource PageColumnSpacing}">
            <ComboBox
              MinWidth="160"
              HorizontalAlignment="Stretch"
              ItemsSource="{Binding SearchScopeOptions}"
              SelectedItem="{Binding SelectedSearchScope, Mode=TwoWay}" />
            <TextBlock
              Grid.Column="1"
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              Classes="Caption Muted"
              Text="映射状态" />
            <ComboBox
              Grid.Column="2"
              MinWidth="180"
              HorizontalAlignment="Stretch"
              ItemsSource="{Binding MapStatusFilters}"
              SelectedItem="{Binding SelectedMapStatus, Mode=TwoWay}" />
            <TextBlock
              Grid.Column="3"
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              Classes="Caption Muted"
              Text="码状态" />
            <ComboBox
              Grid.Column="4"
              HorizontalAlignment="Stretch"
              ItemsSource="{Binding CodeStatusFilters}"
              SelectedItem="{Binding SelectedCodeStatus, Mode=TwoWay}" />
            <TextBox
              Grid.Column="5"
              VerticalContentAlignment="Center"
              AcceptsReturn="False"
              Classes="SearchBox"
              KeyDown="KeywordBox_OnKeyDown"
              PlaceholderText="搜索分组..."
              Text="{Binding Keyword, Mode=TwoWay}"
              TextWrapping="NoWrap" />
            <Button
              Grid.Column="6"
              Classes="Action"
              Command="{Binding SearchCommand}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeDefault}"
                  Height="{DynamicResource IconSizeDefault}"
                  Kind="Search" />
                <TextBlock Text="搜索" />
              </StackPanel>
            </Button>
            <Button
              Grid.Column="7"
              Classes="Action"
              Command="{Binding ResetFiltersCommand}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeDefault}"
                  Height="{DynamicResource IconSizeDefault}"
                  Kind="Eraser" />
                <TextBlock Text="重置" />
              </StackPanel>
            </Button>
          </Grid>
        </shad:Card>

        <DataGrid
          x:Name="GroupGrid"
          Grid.Row="1"
          Height="280"
          Classes="SectionGrid InventoryGrid IndexedGrid"
          HorizontalScrollBarVisibility="Auto"
          IsReadOnly="True"
          ItemsSource="{Binding Groups}"
          PointerPressed="GroupGrid_OnPointerPressed"
          SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
          SelectionMode="Single">
          <DataGrid.Columns>
            <DataGridTextColumn
              Width="140"
              Binding="{Binding SourceBillTimes}"
              Header="单据时间" />
            <DataGridTextColumn
              Width="220"
              Binding="{Binding SourceBillCodes}"
              Header="单据编码" />
            <DataGridTextColumn
              Width="180"
              Binding="{Binding SourceDrugNameRaw}"
              Header="原始药名" />
            <DataGridTextColumn
              Width="180"
              Binding="{Binding SourceSpecRaw}"
              Header="原始规格" />
            <DataGridTextColumn
              Width="180"
              Binding="{Binding SourceNameNorm}"
              Header="归一化药名" />
            <DataGridTextColumn
              Width="180"
              Binding="{Binding SourceSpecNorm}"
              Header="归一化规格" />
            <DataGridTextColumn
              Width="80"
              Binding="{Binding TotalCount}"
              Header="总数" />
            <DataGridTemplateColumn Width="520" Header="状态构成">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="dto:MsfxMappingBatchGroupRow">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
                    <controls:StatusPill
                      Classes="ToneWarning25"
                      Icon="Info"
                      IconSize="12"
                      PillPadding="8,3"
                      Text="{Binding PendingCount, StringFormat=待映射 {0}}"
                      TextSize="11" />
                    <controls:StatusPill
                      Classes="ToneInfo25"
                      Icon="Bookmark"
                      IconSize="12"
                      PillPadding="8,3"
                      Text="{Binding NeedReviewCount, StringFormat=待人工 {0}}"
                      TextSize="11" />
                    <controls:StatusPill
                      Classes="ToneDanger25"
                      Icon="CircleX"
                      IconSize="12"
                      PillPadding="8,3"
                      Text="{Binding FailedCount, StringFormat=失败 {0}}"
                      TextSize="11" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <Grid
        Grid.Row="2"
        RowDefinitions="Auto,Auto"
        RowSpacing="{DynamicResource FormRowSpacing}">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
          <shad:Card Grid.Column="0" Padding="10,8">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeSmall}"
                  Height="{DynamicResource IconSizeSmall}"
                  Kind="Pill" />
                <TextBlock Classes="Caption Muted" Text="药品名称" />
              </StackPanel>
              <AutoCompleteBox
                x:Name="DrugIdBox"
                Grid.Row="1"
                FilterMode="Contains"
                ItemsSource="{Binding DrugOptions}"
                KeyDown="DrugIdBox_OnKeyDown"
                MinimumPrefixLength="1"
                PlaceholderText="输入院内药品信息"
                Text="{Binding DrugText, Mode=TwoWay}">
                <AutoCompleteBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionItem">
                    <TextBlock Text="{Binding Display}" />
                  </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
              </AutoCompleteBox>
            </Grid>
          </shad:Card>

          <shad:Card Grid.Column="1" Padding="10,8">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource DialogRowSpacing}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeSmall}"
                  Height="{DynamicResource IconSizeSmall}"
                  Kind="Scale" />
                <TextBlock Classes="Caption Muted" Text="规格" />
              </StackPanel>
              <Grid Grid.Row="1">
                <ComboBox
                  x:Name="SpecBox"
                  Height="{StaticResource ControlHeightCompact}"
                  MinWidth="220"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding SpecOptions}"
                  MaxDropDownHeight="300"
                  SelectedItem="{Binding SelectedSpec, Mode=TwoWay}" />
                <TextBlock
                  Margin="{DynamicResource InputPlaceholderMargin}"
                  VerticalAlignment="Center"
                  Classes="Caption Muted"
                  IsHitTestVisible="False"
                  IsVisible="{Binding ShowSpecPlaceholder}"
                  Text="请选择规格" />
              </Grid>
            </Grid>
          </shad:Card>
        </Grid>

        <shad:Card Grid.Row="1">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SpacingInlineMd}">
            <icons:AppIcon
              Width="{DynamicResource IconSizeSmall}"
              Height="{DynamicResource IconSizeSmall}"
              VerticalAlignment="Center"
              Kind="ChartSpline" />
            <TextBlock
              Grid.Column="1"
              Classes="Caption Muted"
              Text="{Binding PreviewText}"
              TextWrapping="Wrap" />
          </Grid>
        </shad:Card>
      </Grid>

      <StackPanel
        Grid.Row="3"
        HorizontalAlignment="Right"
        Orientation="Horizontal"
        Spacing="{DynamicResource SpacingInlineSm}">
        <Button
          Classes="Outline"
          Command="{Binding CloseCommand}"
          Content="关闭" />
        <Button
          Classes="Secondary"
          Command="{Binding DiscardTaskCommand}"
          Content="弃用任务" />
        <Button
          Classes="Primary"
          Command="{Binding ApplyMapCommand}"
          Content="批量映射" />
      </StackPanel>
    </Grid>
  </shad:Card>
</UserControl>
