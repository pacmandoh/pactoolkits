<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Dialogs.DrugKeyFixPreviewDialogView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:dialogs="clr-namespace:PacToolkits.Desktop.Avalonia.Views.Dialogs"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="380"
  d:DesignWidth="420"
  x:DataType="dialogs:DrugKeyFixPreviewDialogModel"
  mc:Ignorable="d">
  <Border
    MinWidth="380"
    MaxWidth="520"
    Padding="{DynamicResource DialogPadding}"
    CornerRadius="16">
    <StackPanel Spacing="14">
      <Border
        Width="44"
        Height="44"
        HorizontalAlignment="Center"
        CornerRadius="22">
        <icons:AppIcon
          Width="24"
          Height="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Kind="ArrowRightLeft" />
      </Border>

      <TextBlock
        HorizontalAlignment="Center"
        Classes="DialogTitleLg"
        FontWeight="SemiBold"
        Text="纠错迁移预览详情" />

      <Grid
        ColumnDefinitions="Auto,*"
        ColumnSpacing="{DynamicResource PageColumnSpacing}"
        RowDefinitions="Auto,Auto"
        RowSpacing="{DynamicResource DialogInnerRowSpacing}">
        <TextBlock
          Grid.Row="0"
          Grid.Column="0"
          Classes="Caption Muted"
          Text="源药品键" />
        <TextBlock
          Grid.Row="0"
          Grid.Column="1"
          FontFamily="Consolas"
          Text="{Binding SourceKeyDisplay}" />

        <TextBlock
          Grid.Row="1"
          Grid.Column="0"
          Classes="Caption Muted"
          Text="目标药品键" />
        <TextBlock
          Grid.Row="1"
          Grid.Column="1"
          FontFamily="Consolas"
          Text="{Binding TargetKeyDisplay}" />
      </Grid>

      <Border Padding="12" CornerRadius="12">
        <Grid
          ColumnDefinitions="*,*"
          ColumnSpacing="{DynamicResource PageColumnSpacing}"
          RowDefinitions="Auto,Auto"
          RowSpacing="{DynamicResource DialogFormRowSpacing}">
          <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Classes="Caption Muted"
            Text="trace_pool 影响" />
          <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Right"
            FontWeight="SemiBold"
            Text="{Binding TracePoolAffectedDisplay}" />

          <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Classes="Caption Muted"
            Text="trace_txn 影响" />
          <TextBlock
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Right"
            FontWeight="SemiBold"
            Text="{Binding TraceTxnAffectedDisplay}" />
        </Grid>
      </Border>

      <TextBlock
        Opacity="0.9"
        Text="{Binding TargetExistsDisplay}"
        TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
