<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.ScanCodeAutoFetch"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:conv="clr-namespace:PacToolkits.Desktop.Avalonia.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:DataType="vm:ScanCode"
  Classes="ScanCodePage"
  mc:Ignorable="d">
  <UserControl.Resources>
    <conv:FetchStateToBgBrushConverter x:Key="FetchStateToBgBrush" />
    <conv:FetchStateToFgBrushConverter x:Key="FetchStateToFgBrush" />
    <conv:FetchStateToIconKindConverter x:Key="FetchStateToIconKind" />
  </UserControl.Resources>

  <Grid
    MinHeight="0"
    Classes="AutoFetchWorkspace"
    RowDefinitions="Auto,*">
    <Grid
      Grid.Row="0"
      Classes="AutoFetchMetrics"
      ColumnDefinitions="*,*,*,*">
      <controls:OverviewCard
        Title="已编排任务"
        Grid.Column="0"
        Classes="ReadOnly"
        Hint="全量、增量与回补策略"
        Value="{Binding AutoTasks.Count}">
        <controls:OverviewCard.Icon>
          <icons:AppIcon Classes="OverviewCardIcon" Kind="ListChecks" />
        </controls:OverviewCard.Icon>
      </controls:OverviewCard>
      <controls:OverviewCard
        Title="正在运行"
        Grid.Column="1"
        Classes="ReadOnly Success"
        Hint="当前活动执行上下文"
        Value="{Binding ActiveAutoTaskCount}">
        <controls:OverviewCard.Icon>
          <icons:AppIcon Classes="OverviewCardIcon" Kind="Activity" />
        </controls:OverviewCard.Icon>
      </controls:OverviewCard>
      <controls:OverviewCard
        Title="近期成功率"
        Grid.Column="2"
        Classes="ReadOnly Success"
        Hint="按最近执行记录计算"
        Value="{Binding AutoFetchSuccessRateText}">
        <controls:OverviewCard.Icon>
          <icons:AppIcon Classes="OverviewCardIcon" Kind="ChartNoAxesCombined" />
        </controls:OverviewCard.Icon>
      </controls:OverviewCard>
      <controls:OverviewCard
        Title="待重试"
        Grid.Column="3"
        Classes="ReadOnly Warning"
        Hint="失败恢复队列"
        Value="{Binding RetryQueue.Count}">
        <controls:OverviewCard.Icon>
          <icons:AppIcon Classes="OverviewCardIcon" Kind="RotateCcw" />
        </controls:OverviewCard.Icon>
      </controls:OverviewCard>
    </Grid>

    <Grid
      Grid.Row="1"
      MinHeight="0"
      Classes="AutoFetchBoard"
      ColumnDefinitions="1.25*,1*">
      <controls:CardPanel
        Title="任务编排"
        Grid.Column="0"
        MinHeight="0"
        AccentBrush="{DynamicResource InfoColor}"
        Chrome="Card"
        Classes="FlushBody"
        HeaderHint="{Binding AutoFetchNextRunText}">
        <controls:CardPanel.HeaderContent>
          <shad:Badge Content="{Binding AutoTasks.Count, StringFormat=共 {0} 项}" Variant="Secondary" />
        </controls:CardPanel.HeaderContent>
        <DataGrid
          x:Name="AutoTaskGrid"
          MinHeight="0"
          Background="Transparent"
          CanUserResizeColumns="True"
          Classes="SectionGrid IndexedGrid"
          ItemsSource="{Binding AutoTasks}"
          SelectionChanged="OnBrowsingGridSelectionChanged">
          <DataGrid.Columns>
            <DataGridTemplateColumn
              Width="{StaticResource DgWIcon}"
              Header="状态"
              SortMemberPath="StateText">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:AutoFetchTaskItem">
                  <Border
                    Width="{DynamicResource IconBadgeSize}"
                    Height="{DynamicResource IconBadgeSize}"
                    Background="{Binding State, Converter={StaticResource FetchStateToBgBrush}}"
                    Classes="DgStatusBadge"
                    CornerRadius="{DynamicResource LgCornerRadius}"
                    ToolTip.Tip="{Binding StateText}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      Foreground="{Binding State, Converter={StaticResource FetchStateToFgBrush}}"
                      Kind="{Binding State, Converter={StaticResource FetchStateToIconKind}}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn
              Width="1.2*"
              Binding="{Binding Name}"
              Header="任务"
              SortMemberPath="Name" />
            <DataGridTextColumn
              Width="0.8*"
              Binding="{Binding Schedule}"
              Header="触发策略"
              SortMemberPath="Schedule" />
            <DataGridTextColumn
              Width="1.7*"
              Binding="{Binding Detail}"
              Header="处理范围"
              SortMemberPath="Detail" />
          </DataGrid.Columns>
        </DataGrid>
      </controls:CardPanel>

      <Grid
        Grid.Column="1"
        MinHeight="0"
        Classes="AutoFetchSide"
        RowDefinitions="*,*">
        <controls:CardPanel
          Title="最近执行"
          Grid.Row="0"
          MinHeight="0"
          AccentBrush="{DynamicResource SuccessColor}"
          Chrome="Card"
          Classes="FlushBody">
          <controls:CardPanel.HeaderContent>
            <shad:Badge Content="{Binding RecentRuns.Count, StringFormat=近 {0} 条}" Variant="Secondary" />
          </controls:CardPanel.HeaderContent>
          <DataGrid
            x:Name="RecentRunGrid"
            MinHeight="0"
            Background="Transparent"
            CanUserResizeColumns="True"
            Classes="SectionGrid IndexedGrid"
            ItemsSource="{Binding RecentRuns}"
            SelectionChanged="OnBrowsingGridSelectionChanged">
            <DataGrid.Columns>
              <DataGridTemplateColumn
                Width="{StaticResource DgWIcon}"
                Header="状态"
                SortMemberPath="StateText">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:AutoFetchRunItem">
                    <Border
                      Width="{DynamicResource IconBadgeSize}"
                      Height="{DynamicResource IconBadgeSize}"
                      Background="{Binding State, Converter={StaticResource FetchStateToBgBrush}}"
                      Classes="DgStatusBadge"
                      CornerRadius="{DynamicResource LgCornerRadius}"
                      ToolTip.Tip="{Binding StateText}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeDefault}"
                        Height="{DynamicResource IconSizeDefault}"
                        Foreground="{Binding State, Converter={StaticResource FetchStateToFgBrush}}"
                        Kind="{Binding State, Converter={StaticResource FetchStateToIconKind}}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn
                Width="1*"
                Binding="{Binding Name}"
                Header="任务"
                SortMemberPath="Name" />
              <DataGridTextColumn
                Width="1.15*"
                Binding="{Binding StartedAtText}"
                Header="开始时间"
                SortMemberPath="StartedAtText" />
            </DataGrid.Columns>
          </DataGrid>
        </controls:CardPanel>

        <controls:CardPanel
          Title="失败恢复"
          Grid.Row="1"
          MinHeight="0"
          AccentBrush="{DynamicResource WarningColor}"
          Chrome="Card"
          Classes="FlushBody">
          <controls:CardPanel.HeaderContent>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
              <shad:Badge Content="{Binding RetryQueue.Count, StringFormat=待处理 {0}}" Variant="Secondary" />
              <Button Classes="Ghost" Command="{Binding RetryFailedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeSmall}"
                    Height="{DynamicResource IconSizeSmall}"
                    Kind="RotateCcw" />
                  <TextBlock Text="重试一项" />
                </StackPanel>
              </Button>
            </StackPanel>
          </controls:CardPanel.HeaderContent>
          <DataGrid
            x:Name="RetryQueueGrid"
            MinHeight="0"
            Background="Transparent"
            CanUserResizeColumns="True"
            Classes="SectionGrid IndexedGrid"
            ItemsSource="{Binding RetryQueue}"
            SelectionChanged="OnBrowsingGridSelectionChanged">
            <DataGrid.Columns>
              <DataGridTemplateColumn
                Width="{StaticResource DgWIcon}"
                Header="状态"
                SortMemberPath="StateText">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:AutoFetchRetryItem">
                    <Border
                      Width="{DynamicResource IconBadgeSize}"
                      Height="{DynamicResource IconBadgeSize}"
                      Background="{Binding State, Converter={StaticResource FetchStateToBgBrush}}"
                      Classes="DgStatusBadge"
                      CornerRadius="{DynamicResource LgCornerRadius}"
                      ToolTip.Tip="{Binding StateText}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeDefault}"
                        Height="{DynamicResource IconSizeDefault}"
                        Foreground="{Binding State, Converter={StaticResource FetchStateToFgBrush}}"
                        Kind="{Binding State, Converter={StaticResource FetchStateToIconKind}}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn
                Width="1*"
                Binding="{Binding Name}"
                Header="任务"
                SortMemberPath="Name" />
              <DataGridTextColumn
                Width="1.3*"
                Binding="{Binding Reason}"
                Header="失败原因"
                SortMemberPath="Reason" />
              <DataGridTextColumn
                Width="0.65*"
                Binding="{Binding RetryCountText}"
                Header="次数"
                SortMemberPath="RetryCountText" />
            </DataGrid.Columns>
          </DataGrid>
        </controls:CardPanel>
      </Grid>
    </Grid>
  </Grid>

</UserControl>
