<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.DashboardView"
  xmlns="https://github.com/avaloniaui"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:Name="Root"
  d:DesignHeight="820"
  d:DesignWidth="1200"
  x:DataType="vm:DashboardViewModel"
  mc:Ignorable="d">
  <UserControl.Styles>
    <Style Selector="DataGrid.CopySelectMenuGrid DataGridRow">
      <Setter Property="ContextMenu">
        <Setter.Value>
          <ContextMenu>
            <MenuItem
              Click="OnGridRowCopy"
              CommandParameter="{Binding}"
              Header="复制">
              <MenuItem.Icon>
                <icons:AppIcon
                  Width="{DynamicResource IconSizeDefault}"
                  Height="{DynamicResource IconSizeDefault}"
                  Kind="Copy" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem
              Click="OnGridSelectAll"
              CommandParameter="{Binding}"
              Header="全选">
              <MenuItem.Icon>
                <icons:AppIcon
                  Width="{DynamicResource IconSizeDefault}"
                  Height="{DynamicResource IconSizeDefault}"
                  Kind="ListChecks" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Styles>

  <controls:PageDataShell
    IsLoadingData="{Binding IsBusy}"
    ShowStale="{Binding IsShowingStaleData}"
    ShowUnavailable="{Binding ShowPageUnavailable}"
    StaleHint="{Binding PageStaleHint}"
    UnavailableHint="{Binding PageUnavailableHint}"
    UnavailableIcon="{Binding PageUnavailableIcon}"
    UnavailableTitle="{Binding PageUnavailableTitle}">
    <Grid Classes="DashboardShell" RowDefinitions="Auto,Auto,*">
      <Border
        Grid.Row="0"
        Classes="DashboardFilterChrome"
        IsVisible="{Binding IsFilterBarVisible}">
        <Grid Classes="DashboardFilterColumns" ColumnDefinitions="*,Auto,*,Auto,*">
          <Grid
            Grid.Column="0"
            Classes="DashboardFilterColumn"
            ColumnDefinitions="Auto,*,Auto,*,Auto">
            <TextBlock
              Grid.Column="0"
              Classes="FilterLabel"
              Text="起始" />
            <controls:FilterFieldInput Grid.Column="1">
              <CalendarDatePicker
                HorizontalAlignment="Stretch"
                DisplayDateEnd="{Binding FromMaxDate}"
                IsTodayHighlighted="True"
                SelectedDate="{Binding FromDate}" />
            </controls:FilterFieldInput>
            <TextBlock
              Grid.Column="2"
              Classes="FilterLabel"
              Text="结束" />
            <controls:FilterFieldInput Grid.Column="3">
              <CalendarDatePicker
                HorizontalAlignment="Stretch"
                DisplayDateEnd="{Binding ToMaxDate}"
                DisplayDateStart="{Binding ToMinDate}"
                IsTodayHighlighted="True"
                SelectedDate="{Binding ToDate}"
                SelectedDateFormat="Short" />
            </controls:FilterFieldInput>
            <Button
              Grid.Column="4"
              VerticalAlignment="Center"
              Classes="Basic MicroClear"
              Command="{Binding ResetDateRangeCommand}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeSmall}"
                Height="{DynamicResource IconSizeSmall}"
                Kind="RotateCcw" />
            </Button>
          </Grid>

          <Border Grid.Column="1" Classes="DashboardFilterColumnDivider" />

          <Grid
            Grid.Column="2"
            Classes="DashboardFilterColumn"
            ColumnDefinitions="Auto,*,Auto">
            <TextBlock
              Grid.Column="0"
              Classes="FilterLabel"
              Text="药品" />
            <AutoCompleteBox
              x:Name="DrugBox"
              Grid.Column="1"
              HorizontalAlignment="Stretch"
              FilterMode="Contains"
              IsDropDownOpen="{Binding IsDrugSuggestOpen, Mode=TwoWay}"
              IsTextCompletionEnabled="True"
              ItemsSource="{Binding DrugOptions}"
              KeyDown="DrugBox_OnKeyDown"
              PlaceholderText="全部药品"
              Text="{Binding DrugText, Mode=TwoWay, TargetNullValue='', FallbackValue=''}">
              <AutoCompleteBox.ItemTemplate>
                <DataTemplate x:DataType="vm:OptionItem">
                  <TextBlock Text="{Binding Display}" />
                </DataTemplate>
              </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
            <Button
              Grid.Column="2"
              Classes="Basic MicroClear DrugAutoCompleteClear"
              Command="{Binding ClearDrugSpecFilterCommand}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeSmall}"
                Height="{DynamicResource IconSizeSmall}"
                Kind="CircleX" />
            </Button>
          </Grid>

          <Border Grid.Column="3" Classes="DashboardFilterColumnDivider" />

          <Grid
            Grid.Column="4"
            Classes="DashboardFilterColumn"
            ColumnDefinitions="Auto,*,Auto,*">
            <TextBlock
              Grid.Column="0"
              Classes="FilterLabel"
              Text="规格" />
            <controls:FilterFieldInput Grid.Column="1">
              <ComboBox
                x:Name="SpecBox"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                DisplayMemberBinding="{Binding Display}"
                ItemsSource="{Binding SpecOptions}"
                SelectedItem="{Binding SelectedSpec}" />
            </controls:FilterFieldInput>
            <TextBlock
              Grid.Column="2"
              Classes="FilterLabel"
              Text="客户端" />
            <controls:FilterFieldInput Grid.Column="3">
              <ComboBox
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                DisplayMemberBinding="{Binding Display}"
                ItemsSource="{Binding Clients}"
                SelectedItem="{Binding SelectedClient}" />
            </controls:FilterFieldInput>
          </Grid>
        </Grid>
      </Border>

      <TabControl
        Grid.Row="1"
        Margin="{DynamicResource DashboardTabsPadding}"
        SelectedIndex="{Binding SelectedTabIndex}">
          <TabItem>
            <TabItem.Header>
              <StackPanel Classes="TabItemHeader">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeCompact}"
                  Height="{DynamicResource IconSizeCompact}"
                  Kind="ChartLine" />
                <TextBlock Text="总览" />
              </StackPanel>
            </TabItem.Header>
          </TabItem>
          <TabItem>
            <TabItem.Header>
              <StackPanel Classes="TabItemHeader">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeCompact}"
                  Height="{DynamicResource IconSizeCompact}"
                  Kind="Clipboard" />
                <TextBlock Text="录入" />
              </StackPanel>
            </TabItem.Header>
          </TabItem>
          <TabItem>
            <TabItem.Header>
              <StackPanel Classes="TabItemHeader">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeCompact}"
                  Height="{DynamicResource IconSizeCompact}"
                  Kind="ArrowRightLeft" />
                <TextBlock Text="事务" />
              </StackPanel>
            </TabItem.Header>
          </TabItem>
          <TabItem>
            <TabItem.Header>
              <StackPanel Classes="TabItemHeader">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeCompact}"
                  Height="{DynamicResource IconSizeCompact}"
                  Kind="OctagonAlert" />
                <TextBlock Text="异常" />
              </StackPanel>
            </TabItem.Header>
          </TabItem>
      </TabControl>


      <Grid
        Grid.Row="2"
        Margin="{DynamicResource PagePaddingHorizontal}"
        IsVisible="{Binding IsOverviewTab}"
        RowDefinitions="*">
        <ScrollViewer
          Grid.Row="0"
          Padding="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          AllowAutoHide="False"
          BringIntoViewOnFocusChange="False"
          Classes="Stack"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <Grid
            Margin="{DynamicResource PageScrollExtentBottomMargin}"
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="14">


            <Grid
              Grid.Row="0"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="{DynamicResource FormColumnSpacing}">

              <Button
                Grid.Column="0" Classes="KpiNavCard" Command="{Binding OpenInventoryCommand}">
                <Grid
                  ColumnDefinitions="Auto,*,Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  RowSpacing="{DynamicResource DialogInnerRowSpacing}">

                  <icons:AppIcon
                    Width="{DynamicResource IconSizeSectionHeader}"
                    Height="{DynamicResource IconSizeSectionHeader}"
                    Kind="Database" />

                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="{DynamicResource MarginLeftSm}"
                    FontWeight="SemiBold"
                    Opacity="0.85"
                    Text="可用追溯码库存" />

                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Classes="SectionHint"
                    Text="{Binding Kpi.AvailableRemainPct, StringFormat={}{0:F0}%}" />

                  <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    FontSize="22"
                    FontWeight="Bold"
                    Text="{Binding Kpi.AvailableRemain}" />

                  <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Classes="SectionHint"
                    MaxLines="2"
                    Text="{Binding Kpi.AvailableRemainHint}"
                    TextWrapping="Wrap" />

                  <ProgressBar
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Height="6"
                    Margin="{DynamicResource MarginTopMd}"
                    Foreground="{Binding Kpi.AvailableRemainPct, Converter={StaticResource KpiPctToBrush}, ConverterParameter=Remain}"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Kpi.AvailableRemainPct}" />
                </Grid>
              </Button>

              <Button
                Grid.Column="1" Classes="KpiNavCard" Command="{Binding OpenPeriodUsageCommand}">
                <Grid
                  ColumnDefinitions="Auto,*,Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  RowSpacing="{DynamicResource DialogInnerRowSpacing}">

                  <icons:AppIcon
                    Width="{DynamicResource IconSizeSectionHeader}"
                    Height="{DynamicResource IconSizeSectionHeader}"
                    Kind="ChartLine" />

                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="{DynamicResource MarginLeftSm}"
                    FontWeight="SemiBold"
                    Opacity="0.85"
                    Text="期间使用条数" />

                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Classes="SectionHint"
                    Text="{Binding Kpi.PeriodUsedPct, StringFormat={}{0:F0}%}" />

                  <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    FontSize="22"
                    FontWeight="Bold"
                    Text="{Binding Kpi.PeriodUsed}" />

                  <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Classes="SectionHint"
                    MaxLines="2"
                    Text="{Binding Kpi.PeriodUsedHint}"
                    TextWrapping="Wrap" />

                  <ProgressBar
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Height="6"
                    Margin="{DynamicResource MarginTopMd}"
                    Foreground="{Binding Kpi.PeriodUsedPct, Converter={StaticResource KpiPctToBrush}, ConverterParameter=Alert}"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Kpi.PeriodUsedPct}" />
                </Grid>
              </Button>

              <Button
                Grid.Column="2" Classes="KpiNavCard" Command="{Binding OpenAbnormalCommand}">
                <Grid
                  ColumnDefinitions="Auto,*,Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  RowSpacing="{DynamicResource DialogInnerRowSpacing}">

                  <icons:AppIcon
                    Width="{DynamicResource IconSizeSectionHeader}"
                    Height="{DynamicResource IconSizeSectionHeader}"
                    Foreground="{StaticResource BrushWarning}"
                    Kind="CircleX" />

                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="{DynamicResource MarginLeftSm}"
                    FontWeight="SemiBold"
                    Opacity="0.85"
                    Text="异常 / 回滚" />

                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Classes="SectionHint"
                    Text="{Binding Kpi.AbnormalPct, StringFormat={}{0:F0}%}" />

                  <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{StaticResource BrushWarning}"
                    Text="{Binding Kpi.Abnormal}" />

                  <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Classes="SectionHint"
                    MaxLines="2"
                    Text="{Binding Kpi.AbnormalHint}"
                    TextWrapping="Wrap" />

                  <ProgressBar
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Height="6"
                    Margin="{DynamicResource MarginTopMd}"
                    Foreground="{Binding Kpi.AbnormalPct, Converter={StaticResource KpiPctToBrush}, ConverterParameter=Alert}"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Kpi.AbnormalPct}" />
                </Grid>
              </Button>

              <Button
                Grid.Column="3" Classes="KpiNavCard" Command="{Binding OpenLowStockCommand}">
                <Grid
                  ColumnDefinitions="Auto,*,Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  RowSpacing="{DynamicResource DialogInnerRowSpacing}">

                  <icons:AppIcon
                    Width="{DynamicResource IconSizeSectionHeader}"
                    Height="{DynamicResource IconSizeSectionHeader}"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource BrushDanger}"
                    Kind="TriangleAlert" />

                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="{DynamicResource MarginLeftSm}"
                    FontWeight="SemiBold"
                    Opacity="0.85"
                    Text="追溯码告紧" />

                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Classes="SectionHint"
                    Text="{Binding Kpi.LowStockPct, StringFormat={}{0:F0}%}" />

                  <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{StaticResource BrushDanger}"
                    Text="{Binding Kpi.LowStockCount}" />

                  <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Classes="SectionHint"
                    MaxLines="2"
                    Text="{Binding Kpi.LowStockHint}"
                    TextWrapping="Wrap" />

                  <ProgressBar
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Height="6"
                    Margin="{DynamicResource MarginTopMd}"
                    Foreground="{Binding Kpi.LowStockPct, Converter={StaticResource KpiPctToBrush}, ConverterParameter=Alert}"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Kpi.LowStockPct}" />
                </Grid>
              </Button>
            </Grid>


            <Grid
              Grid.Row="1"
              ColumnDefinitions="2*,*"
              ColumnSpacing="{DynamicResource PageColumnSpacingWide}">


              <shad:Card Grid.Column="0">
                <Grid
                  MinHeight="0"
                  RowDefinitions="Auto,*,Auto"
                  RowSpacing="{DynamicResource DialogFormRowSpacing}">
                  <Grid
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,*,240"
                    ColumnSpacing="{DynamicResource PageColumnSpacing}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSectionHeader}"
                      Height="{DynamicResource IconSizeSectionHeader}"
                      VerticalAlignment="Center"
                      Kind="ChartSpline" />
                    <StackPanel
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Spacing="2">
                      <TextBlock
                        VerticalAlignment="Center"
                        Classes="SectionTitle"
                        Text="药品使用统计" />
                      <TextBlock Classes="SectionHint" Text="{Binding SectionHint}" />
                    </StackPanel>
                    <ComboBox
                      Grid.Column="2"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding TrendModes}"
                      SelectedItem="{Binding TrendMode}" />
                  </Grid>
                  <controls:EmptyStatePanel
                    Grid.Row="1"
                    MinHeight="0"
                    EmptyHint="{Binding TrendEmptyHint}"
                    EmptyText="{Binding TrendEmptyText}"
                    Icon="{Binding SectionEmptyIcon}"
                    IsEmpty="{Binding IsTrendEmpty}"
                    IsPending="{Binding IsSectionPending}"
                    SlotMinHeight="{DynamicResource DgH10Rows}"
                    SlotMode="Always">
                    <shad:BusyArea MinHeight="{StaticResource DgH10Rows}" IsBusy="{Binding IsTxnBusy}">
                      <controls:DeferredGridSlot
                        x:Name="TrendGridSlot"
                        SlotMinHeight="{DynamicResource DgH10Rows}"
                        SlotName="TrendGridOverview">
                        <controls:DeferredGridSlot.GridTemplate>
                          <DataTemplate x:DataType="vm:DashboardViewModel">
                            <DataGrid
                              HorizontalAlignment="Stretch"
                              Classes="SectionGrid Headerless"
                              ItemsSource="{Binding DrugTrend}"
                              RowHeight="{StaticResource RowMinHeight}"
                              SelectedItem="{Binding SelectedTrendItem}"
                              SelectionMode="Single">
                              <DataGrid.Columns>
                                <DataGridTemplateColumn Width="{StaticResource DgWRank}">
                                  <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                      <Border>
                                        <Border
                                          Width="36"
                                          Height="36"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          CornerRadius="10">
                                          <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="{Binding Rank}" />
                                        </Border>
                                      </Border>
                                    </DataTemplate>
                                  </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="*">
                                  <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                      <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Classes="DGSub" Text="{Binding Sub}" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="Auto">
                                  <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                      <TextBlock Classes="SectionHint" Text="{Binding SourceText}" />
                                    </DataTemplate>
                                  </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="{StaticResource DgWRightValue}">
                                  <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                      <TextBlock Classes="DGRightCell DGNum" Text="{Binding ValueText}" />
                                    </DataTemplate>
                                  </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                              </DataGrid.Columns>
                            </DataGrid>
                          </DataTemplate>
                        </controls:DeferredGridSlot.GridTemplate>
                      </controls:DeferredGridSlot>
                    </shad:BusyArea>
                  </controls:EmptyStatePanel>

                  <Border
                    Grid.Row="2"
                    Padding="2,6,2,0"
                    BorderBrush="{DynamicResource OutlineColor}"
                    BorderThickness="0,1,0,0"
                    Opacity="0.7">
                    <TextBlock Classes="DGSub" Text="{Binding DrugTrend.Count, StringFormat=共 {0} 条趋势项}" />
                  </Border>
                </Grid>
              </shad:Card>


              <shad:Card Grid.Column="1">
                <Grid
                  MinHeight="0"
                  RowDefinitions="Auto,*,Auto"
                  RowSpacing="{DynamicResource DialogFormRowSpacing}">
                  <Grid
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="{DynamicResource PageColumnSpacing}">
                    <icons:AppIcon
                      Grid.Column="0"
                      Width="{DynamicResource IconSizeSectionHeader}"
                      Height="{DynamicResource IconSizeSectionHeader}"
                      VerticalAlignment="Center"
                      Kind="ReceiptText" />
                    <StackPanel
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Spacing="1">
                      <TextBlock
                        VerticalAlignment="Center"
                        Classes="SectionTitle"
                        Text="事务总览" />
                      <TextBlock Classes="SectionHint" Text="{Binding SectionHint}" />
                    </StackPanel>
                    <Button
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Classes="Ghost"
                      Command="{Binding OpenTxnListCommand}"
                      Content="查看全部" />
                  </Grid>
                  <controls:EmptyStatePanel
                    Grid.Row="1"
                    MinHeight="0"
                    EmptyHint="{Binding RecentTxnsEmptyHint}"
                    EmptyText="{Binding RecentTxnsEmptyText}"
                    Icon="{Binding SectionEmptyIcon}"
                    IsEmpty="{Binding IsRecentTxnsEmpty}"
                    IsPending="{Binding IsSectionPending}"
                    SlotMinHeight="{DynamicResource DgH10Rows}"
                    SlotMode="Always">
                    <shad:BusyArea IsBusy="{Binding IsTxnBusy}">
                      <controls:DeferredGridSlot
                        x:Name="RecentTxnGridSlot"
                        SlotMinHeight="{DynamicResource DgH10Rows}"
                        SlotName="RecentTxnGridOverview">
                        <controls:DeferredGridSlot.GridTemplate>
                          <DataTemplate x:DataType="vm:DashboardViewModel">
                            <DataGrid
                              HorizontalAlignment="Stretch"
                              Classes="SectionGrid TxnGrid StickyIndexGrid"
                              ItemsSource="{Binding RecentTxnsOverview}"
                              RowHeight="{StaticResource RowMinHeight}"
                              SelectedItem="{Binding SelectedTxn}"
                              SelectionMode="Single">
                              <DataGrid.Columns>
                                <DataGridTemplateColumn Width="{StaticResource DgWIcon}">
                                  <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                      <Border
                                        Width="{DynamicResource IconBadgeSize}"
                                        Height="{DynamicResource IconBadgeSize}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{Binding Badge, Converter={StaticResource BadgeToBgBrush}}"
                                        CornerRadius="{DynamicResource TraceBadgeRadius}">
                                        <icons:AppIcon
                                          Width="{DynamicResource IconSizeDefault}"
                                          Height="{DynamicResource IconSizeDefault}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{Binding Badge, Converter={StaticResource BadgeToFgBrush}}"
                                          Kind="{Binding Badge, Converter={StaticResource BadgeToIconKind}}" />
                                      </Border>
                                    </DataTemplate>
                                  </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="*">
                                  <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                      <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    </DataTemplate>
                                  </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="*">
                                  <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                      <TextBlock Text="{Binding Time}" />
                                    </DataTemplate>
                                  </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="{StaticResource DgWRightSmall}">
                                  <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                      <TextBlock Classes="DGRightCell DGNum" Text="{Binding Qty}" />
                                    </DataTemplate>
                                  </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                              </DataGrid.Columns>
                            </DataGrid>
                          </DataTemplate>
                        </controls:DeferredGridSlot.GridTemplate>
                      </controls:DeferredGridSlot>
                    </shad:BusyArea>
                  </controls:EmptyStatePanel>

                  <Border
                    Grid.Row="2"
                    Padding="2,6,2,0"
                    BorderBrush="{DynamicResource OutlineColor}"
                    BorderThickness="0,1,0,0"
                    Opacity="0.7">
                    <TextBlock Classes="DGSub" Text="{Binding RecentTxnsOverview.Count, StringFormat=共 {0} 条事务}" />
                  </Border>
                </Grid>
              </shad:Card>
            </Grid>


            <Grid
              Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="{DynamicResource PageColumnSpacingWide}">


              <shad:Card
                Grid.Column="0"
                MinHeight="220"
                VerticalAlignment="Stretch">
                <Grid
                  VerticalAlignment="Stretch"
                  RowDefinitions="Auto,*,Auto"
                  RowSpacing="{DynamicResource DialogFormRowSpacing}">
                  <Grid
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,*,220"
                    ColumnSpacing="{DynamicResource PageColumnSpacing}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSectionHeader}"
                      Height="{DynamicResource IconSizeSectionHeader}"
                      VerticalAlignment="Center"
                      Kind="Users" />
                    <StackPanel
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Spacing="1">
                      <TextBlock Classes="SectionTitle" Text="客户端" />
                      <TextBlock Classes="SectionHint" Text="{Binding SectionHint}" />
                    </StackPanel>
                    <ComboBox
                      Grid.Column="2"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding ClientMetricModes}"
                      SelectedItem="{Binding ClientMetricMode}" />
                  </Grid>

                  <controls:EmptyStatePanel
                    Grid.Row="1"
                    MinHeight="0"
                    EmptyHint="{Binding TopClientsEmptyHint}"
                    EmptyText="{Binding TopClientsEmptyText}"
                    Icon="{Binding SectionEmptyIcon}"
                    IsEmpty="{Binding IsTopClientsEmpty}"
                    IsPending="{Binding IsSectionPending}"
                    SlotMinHeight="{DynamicResource OverviewListPendingMinHeight}"
                    SlotMode="PendingOnly">
                    <shad:BusyArea IsBusy="{Binding IsTxnBusy}">
                      <ScrollViewer
                        BringIntoViewOnFocusChange="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TopClients}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="{DynamicResource SpacingInlineSm}" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="RowItem">
                                <Grid
                                  VerticalAlignment="Center"
                                  ColumnDefinitions="44,*,84"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="4">
                                  <Border
                                    Width="{DynamicResource IconBadgeSize}"
                                    Height="{DynamicResource IconBadgeSize}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="{DynamicResource TraceBadgeRadius}">
                                    <TextBlock
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontWeight="Bold"
                                      Text="{Binding Index}" />
                                  </Border>
                                  <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontWeight="SemiBold"
                                    TextWrapping="NoWrap">
                                    <Run Text="{Binding ClientDisplay}" />
                                  </TextBlock>
                                  <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    Classes="DGRightCell DGNum"
                                    Text="{Binding Value}" />
                                  <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Classes="DGSub"
                                    IsVisible="{Binding HasMeta}"
                                    Text="{Binding MetaText}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </shad:BusyArea>
                  </controls:EmptyStatePanel>

                  <Border
                    Grid.Row="2"
                    Padding="2,6,2,0"
                    BorderBrush="{DynamicResource OutlineColor}"
                    BorderThickness="0,1,0,0"
                    Opacity="0.7">
                    <TextBlock Classes="DGSub" Text="{Binding TopClients.Count, StringFormat=共 {0} 个客户端}" />
                  </Border>
                </Grid>
              </shad:Card>


              <shad:Card
                Grid.Column="1"
                MinHeight="220"
                VerticalAlignment="Stretch">
                <Grid
                  VerticalAlignment="Stretch"
                  RowDefinitions="Auto,*,Auto"
                  RowSpacing="{DynamicResource DialogFormRowSpacing}">

                  <Grid
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    ColumnSpacing="{DynamicResource PageColumnSpacing}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSectionHeader}"
                      Height="{DynamicResource IconSizeSectionHeader}"
                      VerticalAlignment="Center"
                      Kind="FilePlus" />
                    <StackPanel
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Spacing="2">
                      <TextBlock
                        VerticalAlignment="Center"
                        Classes="SectionTitle"
                        Text="录入追溯码情况" />
                      <TextBlock Classes="SectionHint" Text="{Binding SectionHint}" />
                    </StackPanel>
                    <Button
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Classes="Ghost"
                      Command="{Binding GoInputTabCommand}"
                      Content="去录入" />
                    <Button
                      Grid.Column="3"
                      VerticalAlignment="Center"
                      Classes="Ghost"
                      Command="{Binding OpenInputHistoryCommand}"
                      Content="查看全部" />
                  </Grid>

                  <controls:EmptyStatePanel
                    Grid.Row="1"
                    MinHeight="0"
                    EmptyHint="{Binding EntryRecentEmptyHint}"
                    EmptyText="{Binding EntryRecentEmptyText}"
                    Icon="{Binding SectionEmptyIcon}"
                    IsEmpty="{Binding IsEntryRecentEmpty}"
                    IsPending="{Binding IsSectionPending}"
                    SlotMinHeight="{DynamicResource OverviewListPendingMinHeight}"
                    SlotMode="PendingOnly">
                    <shad:BusyArea IsBusy="{Binding IsEntryBusy}">
                      <ScrollViewer
                        BringIntoViewOnFocusChange="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding EntryRecentOverview}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="{DynamicResource SpacingInlineSm}" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>

                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="RowItem" PointerReleased="OnEntryRecentRowPointerReleased">
                                <Grid
                                  VerticalAlignment="Center"
                                  ColumnDefinitions="44,*,180,84"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="4">
                                  <Border
                                    Width="{DynamicResource IconBadgeSize}"
                                    Height="{DynamicResource IconBadgeSize}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                                    CornerRadius="{DynamicResource TraceBadgeRadius}">
                                    <icons:AppIcon
                                      Width="{DynamicResource IconSizeDefault}"
                                      Height="{DynamicResource IconSizeDefault}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                                      Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                                      Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                                  </Border>

                                  <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontWeight="SemiBold"
                                    TextWrapping="NoWrap">
                                    <Run Text="{Binding DrugId}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding Spec}" />
                                  </TextBlock>

                                  <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Classes="SectionHint"
                                    Text="{Binding ClientDisplay}"
                                    TextTrimming="CharacterEllipsis" />

                                  <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Classes="DGRightCell DGNum"
                                    Text="{Binding Qty}" />

                                  <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3"
                                    Classes="DGSub"
                                    Text="{Binding Message}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </shad:BusyArea>
                  </controls:EmptyStatePanel>

                  <Border
                    Grid.Row="2"
                    Padding="2,6,2,0"
                    BorderBrush="{DynamicResource OutlineColor}"
                    BorderThickness="0,1,0,0"
                    Opacity="0.7">
                    <TextBlock Classes="DGSub" Text="{Binding EntryTotalCount, StringFormat=共 {0} 条录入}" />
                  </Border>

                </Grid>
              </shad:Card>
            </Grid>
          </Grid>
        </ScrollViewer>
      </Grid>

      <Grid
        Grid.Row="2"
        Margin="{DynamicResource PageTabScrollMargin}"
        IsVisible="{Binding IsInputTab}"
        RowDefinitions="*">
        <shad:Card Grid.Row="0">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
            <Grid
              VerticalAlignment="Center"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="{DynamicResource PageColumnSpacing}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeSectionHeader}"
                Height="{DynamicResource IconSizeSectionHeader}"
                VerticalAlignment="Center"
                Kind="NotebookText" />
              <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="SectionTitle" Text="录入追溯码情况" />
                <TextBlock Classes="SectionHint" Text="受顶部药品/规格/客户端/日期筛选影响，展示录入条码明细" />
                <TextBlock Classes="SectionHint" Text="{Binding SectionHint}" />
              </StackPanel>
              <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Classes="Ghost"
                Command="{Binding GoInputTabCommand}"
                Content="去录入" />
              <Button
                Grid.Column="3"
                VerticalAlignment="Center"
                Classes="Ghost"
                Command="{Binding OpenOverviewTabCommand}"
                Content="回总览" />
            </Grid>
            <controls:EmptyStatePanel
              Grid.Row="1"
              MinHeight="0"
              EmptyHint="{Binding EntryRecentEmptyHint}"
              EmptyText="{Binding EntryRecentEmptyText}"
              Icon="{Binding SectionEmptyIcon}"
              IsEmpty="{Binding IsEntryRecentEmpty}"
              IsPending="{Binding IsSectionPending}"
              SlotMinHeight="{DynamicResource OverviewListPendingMinHeight}"
              SlotMode="PendingOnly">
              <shad:BusyArea IsBusy="{Binding IsEntryBusy}">
                <controls:DeferredGridSlot
                  x:Name="EntryGridSlot"
                  SlotMinHeight="{DynamicResource OverviewListPendingMinHeight}"
                  SlotName="EntryRecentGridInputTab">
                  <controls:DeferredGridSlot.GridTemplate>
                    <DataTemplate x:DataType="vm:DashboardViewModel">
                      <DataGrid
                        MinHeight="0"
                        HorizontalAlignment="Stretch"
                        CanUserResizeColumns="True"
                        Classes="SectionGrid CopySelectMenuGrid TraceStateGrid StickyIndexGrid StickyIndexDisplayIndex"
                        HorizontalScrollBarVisibility="Disabled"
                        ItemsSource="{Binding EntryRecent}"
                        RowHeight="{StaticResource RowMinHeight}"
                        SelectedItem="{Binding SelectedEntryRecent}"
                        SelectionMode="Extended"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                          <DataGridTemplateColumn Width="{StaticResource DgWIcon}">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <Border
                                  Width="{DynamicResource IconBadgeSize}"
                                  Height="{DynamicResource IconBadgeSize}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                                  CornerRadius="{DynamicResource TraceBadgeRadius}">
                                  <icons:AppIcon
                                    Width="{DynamicResource IconSizeDefault}"
                                    Height="{DynamicResource IconSizeDefault}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                                    Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                                </Border>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn Width="120" Binding="{Binding EntryAtText}" Header="时间" />
                          <DataGridTextColumn Width="1.5*" Binding="{Binding DrugId}" Header="药品" />
                          <DataGridTextColumn Width="1.2*" Binding="{Binding Spec}" Header="规格" />
                          <DataGridTextColumn Width="90" Binding="{Binding Qty}" Header="数量" />
                          <DataGridTextColumn Width="110" Binding="{Binding Source}" Header="来源" />
                          <DataGridTextColumn Width="1.4*" Binding="{Binding ClientDisplay}" Header="客户端" />
                          <DataGridTextColumn Width="2.2*" Binding="{Binding Message}" Header="说明" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </DataTemplate>
                  </controls:DeferredGridSlot.GridTemplate>
                </controls:DeferredGridSlot>
              </shad:BusyArea>
            </controls:EmptyStatePanel>

            <controls:DataGridPager
              Grid.Row="2"
              FirstPageCommand="{Binding FirstEntryPageCommand}"
              IsContentEmpty="{Binding IsEntryRecentEmpty}"
              LastPageCommand="{Binding LastEntryPageCommand}"
              NextPageCommand="{Binding NextEntryPageCommand}"
              PageSizeOptions="{Binding TabPageSizeOptions}"
              PrevPageCommand="{Binding PrevEntryPageCommand}"
              SelectedPageSize="{Binding TabPageSize, Mode=TwoWay}"
              TotalCount="{Binding EntryTotalCount}"
              TotalPages="{Binding EntryTotalPages}"
              PageIndex="{Binding EntryPageIndex}" />
          </Grid>
        </shad:Card>
      </Grid>


      <Grid
        Grid.Row="2"
        Margin="{DynamicResource PageTabScrollMargin}"
        IsVisible="{Binding IsTxnTab}"
        RowDefinitions="*">
        <shad:Card Grid.Row="0">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource DialogInnerRowSpacing}">
            <Grid
              VerticalAlignment="Center"
              ColumnDefinitions="Auto,*,220,Auto"
              ColumnSpacing="{DynamicResource PageColumnSpacing}">
              <icons:AppIcon
                Grid.Column="0"
                Width="{DynamicResource IconSizeSectionHeader}"
                Height="{DynamicResource IconSizeSectionHeader}"
                VerticalAlignment="Center"
                Kind="ReceiptText" />
              <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="1">
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="SectionTitle"
                  Text="{Binding TxnPanelMode.Title}" />
                <TextBlock Classes="SectionHint" Text="受顶部药品/规格/客户端/日期筛选影响，展示取码事务明细" />
                <TextBlock Classes="SectionHint" Text="{Binding SectionHint}" />
              </StackPanel>
              <ComboBox
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ItemsSource="{Binding TxnPanelModes}"
                SelectedItem="{Binding TxnPanelMode}" />
              <Button
                Grid.Column="3"
                VerticalAlignment="Center"
                Classes="Ghost"
                Command="{Binding OpenAbnormalCommand}"
                Content="查看异常" />
            </Grid>
            <controls:EmptyStatePanel
              Grid.Row="1"
              MinHeight="0"
              EmptyHint="{Binding TxnPanelEmptyHint}"
              EmptyText="{Binding TxnPanelEmptyText}"
              Icon="{Binding SectionEmptyIcon}"
              IsEmpty="{Binding IsTxnPanelEmpty}"
              IsPending="{Binding IsSectionPending}"
              SlotMinHeight="{DynamicResource OverviewListPendingMinHeight}"
              SlotMode="PendingOnly">
              <shad:BusyArea IsBusy="{Binding IsTxnBusy}">
                <Grid MinHeight="0">
                  <controls:DeferredGridSlot
                    x:Name="TxnDetailGridSlot"
                    SlotMinHeight="{DynamicResource OverviewListPendingMinHeight}"
                    SlotName="TxnDetailGrid">
                    <controls:DeferredGridSlot.GridTemplate>
                      <DataTemplate x:DataType="vm:DashboardViewModel">
                        <DataGrid
                          MinHeight="0"
                          HorizontalAlignment="Stretch"
                          Classes="SectionGrid TxnGrid CopySelectMenuGrid StickyIndexGrid StickyIndexDisplayIndex"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsTxnPanelDetailMode}"
                          ItemsSource="{Binding RecentTxns}"
                          RowHeight="{StaticResource RowMinHeight}"
                          SelectedItem="{Binding SelectedTxn}"
                          SelectionMode="Extended"
                          VerticalScrollBarVisibility="Auto">
                          <DataGrid.Columns>
                            <DataGridTemplateColumn Width="{StaticResource DgWIcon}">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <Border
                                    Width="{DynamicResource IconBadgeSize}"
                                    Height="{DynamicResource IconBadgeSize}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{Binding Badge, Converter={StaticResource BadgeToBgBrush}}"
                                    CornerRadius="{DynamicResource TraceBadgeRadius}">
                                    <icons:AppIcon
                                      Width="{DynamicResource IconSizeDefault}"
                                      Height="{DynamicResource IconSizeDefault}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{Binding Badge, Converter={StaticResource BadgeToFgBrush}}"
                                      Kind="{Binding Badge, Converter={StaticResource BadgeToIconKind}}" />
                                  </Border>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="1.9*" Binding="{Binding Title}" Header="标题" />
                            <DataGridTextColumn Width="1.2*" Binding="{Binding ClientDisplay}" Header="客户端" />
                            <DataGridTextColumn Width="1.1*" Binding="{Binding Time}" Header="时间" />
                            <DataGridTextColumn Width="100" Binding="{Binding Qty}" Header="数量" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DataTemplate>
                    </controls:DeferredGridSlot.GridTemplate>
                  </controls:DeferredGridSlot>

                  <controls:DeferredGridSlot
                    x:Name="TxnTrendGridSlot"
                    SlotMinHeight="{DynamicResource OverviewListPendingMinHeight}"
                    SlotName="TxnTrendGrid">
                    <controls:DeferredGridSlot.GridTemplate>
                      <DataTemplate x:DataType="vm:DashboardViewModel">
                        <DataGrid
                          MinHeight="0"
                          HorizontalAlignment="Stretch"
                          Classes="SectionGrid CopySelectMenuGrid StickyIndexGrid StickyIndexDisplayIndex"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsTxnPanelTrendMode}"
                          ItemsSource="{Binding TxnTrendRows}"
                          RowHeight="{StaticResource RowMinHeight}"
                          SelectedItem="{Binding SelectedTrendItem}"
                          SelectionMode="Extended"
                          VerticalScrollBarVisibility="Auto">
                          <DataGrid.Columns>
                            <DataGridTextColumn Width="70" Binding="{Binding Rank}" Header="#" />
                            <DataGridTextColumn Width="1.2*" Binding="{Binding Name}" Header="药品" />
                            <DataGridTextColumn Width="1.2*" Binding="{Binding Sub}" Header="规格" />
                            <DataGridTextColumn Width="1.8*" Binding="{Binding SourceText}" Header="来源" />
                            <DataGridTextColumn Width="100" Binding="{Binding ValueText}" Header="值" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DataTemplate>
                    </controls:DeferredGridSlot.GridTemplate>
                  </controls:DeferredGridSlot>
                </Grid>
              </shad:BusyArea>
            </controls:EmptyStatePanel>

            <controls:DataGridPager
              Grid.Row="2"
              FirstPageCommand="{Binding FirstTxnPageCommand}"
              IsActive="{Binding IsTxnPanelDetailMode}"
              IsContentEmpty="{Binding IsRecentTxnsEmpty}"
              LastPageCommand="{Binding LastTxnPageCommand}"
              NextPageCommand="{Binding NextTxnPageCommand}"
              PageSizeOptions="{Binding TabPageSizeOptions}"
              PrevPageCommand="{Binding PrevTxnPageCommand}"
              SelectedPageSize="{Binding TabPageSize, Mode=TwoWay}"
              TotalCount="{Binding TxnTotalCount}"
              TotalPages="{Binding TxnTotalPages}"
              PageIndex="{Binding TxnPageIndex}" />

            <controls:DataGridPager
              Grid.Row="2"
              FirstPageCommand="{Binding FirstTxnTrendPageCommand}"
              IsActive="{Binding IsTxnPanelTrendMode}"
              IsContentEmpty="{Binding IsTxnTrendEmpty}"
              LastPageCommand="{Binding LastTxnTrendPageCommand}"
              NextPageCommand="{Binding NextTxnTrendPageCommand}"
              PageSizeOptions="{Binding TabPageSizeOptions}"
              PrevPageCommand="{Binding PrevTxnTrendPageCommand}"
              SelectedPageSize="{Binding TabPageSize, Mode=TwoWay}"
              TotalCount="{Binding TxnTrendTotalCount}"
              TotalPages="{Binding TxnTrendTotalPages}"
              PageIndex="{Binding TxnTrendPageIndex}" />
          </Grid>
        </shad:Card>
      </Grid>

      <Grid
        Grid.Row="2"
        Margin="{DynamicResource PageTabScrollMargin}"
        IsVisible="{Binding IsAbnormalTab}"
        RowDefinitions="*">
        <shad:Card Grid.Row="0">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
            <Grid
              VerticalAlignment="Center"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="{DynamicResource PageColumnSpacing}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeSectionHeader}"
                Height="{DynamicResource IconSizeSectionHeader}"
                VerticalAlignment="Center"
                Foreground="{StaticResource BrushDanger}"
                Kind="OctagonAlert" />
              <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="SectionTitle" Text="异常事务队列" />
                <TextBlock Classes="SectionHint" Text="优先处理回滚事务，确认客户端与库存状态后再重试" />
                <TextBlock Classes="SectionHint" Text="{Binding SectionHint}" />
              </StackPanel>
              <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Classes="Ghost"
                Command="{Binding OpenTxnListCommand}"
                Content="查看事务" />
              <Button
                Grid.Column="3"
                VerticalAlignment="Center"
                Classes="Ghost"
                Command="{Binding GoInputTabCommand}"
                Content="去录入页" />
            </Grid>
            <controls:EmptyStatePanel
              Grid.Row="1"
              MinHeight="0"
              EmptyHint="{Binding AbnormalEmptyHint}"
              EmptyText="{Binding AbnormalEmptyText}"
              Icon="{Binding SectionEmptyIcon}"
              IsEmpty="{Binding IsAbnormalEmpty}"
              IsPending="{Binding IsSectionPending}"
              SlotMinHeight="{DynamicResource OverviewListPendingMinHeight}"
              SlotMode="PendingOnly">
              <shad:BusyArea IsBusy="{Binding IsAbnormalBusy}">
                <controls:DeferredGridSlot
                  x:Name="AbnormalGridSlot"
                  SlotMinHeight="{DynamicResource OverviewListPendingMinHeight}"
                  SlotName="AbnormalGrid">
                  <controls:DeferredGridSlot.GridTemplate>
                    <DataTemplate x:DataType="vm:DashboardViewModel">
                      <DataGrid
                        MinHeight="0"
                        HorizontalAlignment="Stretch"
                        Classes="SectionGrid TxnGrid AbnormalGrid CopySelectMenuGrid StickyIndexGrid StickyIndexDisplayIndex"
                        HorizontalScrollBarVisibility="Disabled"
                        ItemsSource="{Binding AbnormalQueue}"
                        RowHeight="{StaticResource RowMinHeight}"
                        SelectedItem="{Binding SelectedAbnormal}"
                        SelectionMode="Extended"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                          <DataGridTemplateColumn Width="{StaticResource DgWIcon}">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <Border
                                  Width="{DynamicResource IconBadgeSize}"
                                  Height="{DynamicResource IconBadgeSize}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Background="{Binding Badge, Converter={StaticResource BadgeToBgBrush}}"
                                  CornerRadius="{DynamicResource TraceBadgeRadius}">
                                  <icons:AppIcon
                                    Width="{DynamicResource IconSizeDefault}"
                                    Height="{DynamicResource IconSizeDefault}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Badge, Converter={StaticResource BadgeToFgBrush}}"
                                    Kind="{Binding Badge, Converter={StaticResource BadgeToIconKind}}" />
                                </Border>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn Width="180" Binding="{Binding Title}" Header="类型" />
                          <DataGridTextColumn Width="1.1*" Binding="{Binding ClientDisplay}" Header="客户端" />
                          <DataGridTextColumn Width="2*" Binding="{Binding Detail}" Header="详情" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </DataTemplate>
                  </controls:DeferredGridSlot.GridTemplate>
                </controls:DeferredGridSlot>
              </shad:BusyArea>
            </controls:EmptyStatePanel>

            <controls:DataGridPager
              Grid.Row="2"
              FirstPageCommand="{Binding FirstAbnormalPageCommand}"
              IsContentEmpty="{Binding IsAbnormalEmpty}"
              LastPageCommand="{Binding LastAbnormalPageCommand}"
              NextPageCommand="{Binding NextAbnormalPageCommand}"
              PageSizeOptions="{Binding TabPageSizeOptions}"
              PrevPageCommand="{Binding PrevAbnormalPageCommand}"
              SelectedPageSize="{Binding TabPageSize, Mode=TwoWay}"
              TotalCount="{Binding AbnormalTotalCount}"
              TotalPages="{Binding AbnormalTotalPages}"
              PageIndex="{Binding AbnormalPageIndex}" />
          </Grid>
        </shad:Card>
      </Grid>


    </Grid>
  </controls:PageDataShell>
</UserControl>
