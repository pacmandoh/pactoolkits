<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.MsfxAutoLogPanelView"
  xmlns="https://github.com/avaloniaui"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:Name="Root"
  HorizontalAlignment="Stretch"
  VerticalAlignment="Stretch"
  MinHeight="0"
  x:DataType="vm:MsfxLinkViewModel">
  <shad:Card
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource DialogInnerRowSpacing}">
      <Grid
        ColumnDefinitions="Auto,*,Auto"
        ColumnSpacing="{DynamicResource PageColumnSpacing}"
        IsVisible="{Binding !IsLogPanelExpanded}">
        <StackPanel
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="{DynamicResource SpacingInlineMd}">
          <icons:AppIcon
            Width="{DynamicResource IconSizeDefault}"
            Height="{DynamicResource IconSizeDefault}"
            Kind="TextSearch" />
          <TextBlock
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Opacity="0.9"
            Text="自动化运行审计日志" />
        </StackPanel>
        <StackPanel
          Grid.Column="2"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="{DynamicResource SpacingInlineSm}">
          <shad:Badge
            VerticalAlignment="Center"
            Variant="Secondary"
            Content="{Binding AutoLogs.Count, StringFormat=共 {0} 条}" />
          <Button
            Classes="Ghost MsfxMiniIconBtn"
            Command="{Binding ToggleAutoPanelExpandCommand}"
            CommandParameter="LOG">
            <icons:AppIcon
              Width="{DynamicResource IconSizeCompact}"
              Height="{DynamicResource IconSizeCompact}"
              Kind="Fullscreen" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid
        ColumnDefinitions="Auto,*,Auto"
        ColumnSpacing="{DynamicResource PageColumnSpacing}"
        IsVisible="{Binding IsLogPanelExpanded}">
        <StackPanel
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="{DynamicResource SpacingInlineMd}">
          <icons:AppIcon
            Width="{DynamicResource IconSizeDefault}"
            Height="{DynamicResource IconSizeDefault}"
            Kind="{Binding AutoExpandedPanelIcon}" />
          <TextBlock
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Opacity="0.9"
            Text="{Binding AutoExpandedPanelTitle}" />
        </StackPanel>
        <StackPanel
          Grid.Column="2"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="{DynamicResource SpacingInlineSm}">
          <Button
            Width="{StaticResource ControlHeightCompact}"
            Height="{StaticResource ControlHeightCompact}"
            MinWidth="{StaticResource ControlHeightCompact}"
            Padding="0"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Classes="Ghost"
            Command="{Binding ToggleAutoPanelExpandCommand}"
            CommandParameter="{Binding AutoExpandedPanel}">
            <icons:AppIcon
              Width="{DynamicResource IconSizeCompact}"
              Height="{DynamicResource IconSizeCompact}"
              Kind="Minimize" />
          </Button>
        </StackPanel>
      </Grid>

      <controls:DataGridPager
        Grid.Row="1"
        FirstPageCommand="{Binding FirstAutoLogPageCommand}"
        IsContentEmpty="{Binding IsAutoLogsEmpty}"
        IsVisible="{Binding IsLogPanelExpanded}"
        LastPageCommand="{Binding LastAutoLogPageCommand}"
        NextPageCommand="{Binding NextAutoLogPageCommand}"
        PageIndex="{Binding AutoLogPage}"
        PageSizeOptions="{Binding AutoLogPageSizeOptions}"
        Placement="Top"
        PrevPageCommand="{Binding PrevAutoLogPageCommand}"
        SelectedPageSize="{Binding AutoLogPageSize, Mode=TwoWay}"
        TotalCount="{Binding AutoLogs.Count}"
        TotalPages="{Binding AutoLogTotalPages}" />

      <controls:EmptyStatePanel
        Grid.Row="2"
        EmptyHint="点击“立即巡检”或开启自动监控后将显示执行日志"
        EmptyText="暂无自动化日志"
        IsEmpty="{Binding IsAutoLogsEmpty}">
        <DataGrid
          x:Name="AutoLogGrid"
          Classes="SectionGrid InventoryGrid LowToneGrid TraceStateGrid MsfxIndexedGrid"
          ColumnWidth="*"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          HorizontalScrollBarVisibility="Auto"
          ItemsSource="{Binding AutoLogPageRows}"
          SelectedItem="{Binding SelectedAutoLogRow, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="44">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border
                    Width="24"
                    Height="24"
                    Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                    CornerRadius="12">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                      Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn
              Width="140"
              Binding="{Binding At}"
              Header="时间" />
            <DataGridTextColumn
              Width="160"
              Binding="{Binding Stage}"
              Header="流程阶段" />
            <DataGridTextColumn
              Width="*"
              Binding="{Binding Message}"
              Header="详细信息" />
          </DataGrid.Columns>
        </DataGrid>
      </controls:EmptyStatePanel>
    </Grid>
  </shad:Card>
</UserControl>
