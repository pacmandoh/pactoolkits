<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.MsfxLinkSubcodeTabView"
  xmlns="https://github.com/avaloniaui"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:DataType="vm:MsfxLinkViewModel"
  Focusable="True">
  <Grid
    Margin="{DynamicResource MarginTopLg}"
    RowDefinitions="Auto,*"
    RowSpacing="{DynamicResource FormRowSpacing}">
    <shad:Card Grid.Row="0">
      <Grid ColumnDefinitions="Auto,1.4*,2.0*,Auto,Auto" ColumnSpacing="{DynamicResource PageColumnSpacing}">
        <TextBlock
          Grid.Column="0"
          VerticalAlignment="Center"
          Text="单据编码" />
        <TextBox
          Grid.Column="1"
          Classes="MsfxInput"
          PlaceholderText="必填：订单编码"
          Text="{Binding SubcodeBillCode}">
          <TextBox.KeyBindings>
            <KeyBinding Command="{Binding QuerySubCodesCommand}" Gesture="Enter" />
          </TextBox.KeyBindings>
        </TextBox>
        <Border Grid.Column="2" />
        <Button
          Grid.Column="3"
          Classes="Action"
          Command="{Binding QuerySubCodesCommand}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
            <icons:AppIcon
              Width="{DynamicResource IconSizeCompact}"
              Height="{DynamicResource IconSizeCompact}"
              Kind="ScanSearch" />
            <TextBlock Text="查询子码" />
          </StackPanel>
        </Button>
        <Button
          Grid.Column="4"
          Classes="Ghost"
          Command="{Binding ClearSubcodeQueryCommand}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
            <icons:AppIcon
              Width="{DynamicResource IconSizeCompact}"
              Height="{DynamicResource IconSizeCompact}"
              Kind="Delete" />
            <TextBlock Text="清除" />
          </StackPanel>
        </Button>
      </Grid>
    </shad:Card>

    <shad:Card Grid.Row="1">
      <Grid
        Margin="{DynamicResource MarginHorizontalTiny}"
        RowDefinitions="Auto,*"
        RowSpacing="{DynamicResource DialogInnerRowSpacing}">
        <controls:DataGridPager
          FirstPageCommand="{Binding FirstSubcodePageCommand}"
          IsContentEmpty="{Binding IsSubCodeEmpty}"
          LastPageCommand="{Binding LastSubcodePageCommand}"
          NextPageCommand="{Binding NextSubcodePageCommand}"
          PageSizeOptions="{Binding SubcodePageSizeOptions}"
          Placement="Top"
          PrevPageCommand="{Binding PrevSubcodePageCommand}"
          SelectedPageSize="{Binding SubcodePageSize, Mode=TwoWay}"
          StatusText="{Binding SubcodeStatus}"
          TotalCount="{Binding SubcodeTotal}"
          TotalPages="{Binding SubcodeTotalPages}"
          PageIndex="{Binding SubcodePage}" />

        <shad:BusyArea Grid.Row="1" IsBusy="{Binding IsSubcodeBusy}">
          <controls:EmptyStatePanel
            EmptyHint="请输入单据编码并执行查询"
            EmptyText="暂无子码结果"
            IsEmpty="{Binding IsSubCodeEmpty}">
            <DataGrid
              Classes="SectionGrid InventoryGrid LowToneGrid IndexedGrid CellTemplateHighlightGrid"
              HorizontalScrollBarVisibility="Auto"
              ItemsSource="{Binding SubCodeRows}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="44">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border
                        Width="24"
                        Height="24"
                        Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                        CornerRadius="12">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeSmall}"
                          Height="{DynamicResource IconSizeSmall}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                          Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                  Width="220"
                  Binding="{Binding BillCode}"
                  Header="单据编码" />
                <DataGridTextColumn
                  Width="280"
                  Binding="{Binding DrugName}"
                  Header="药品" />
                <DataGridTextColumn
                  Width="140"
                  Binding="{Binding PackageSpec}"
                  Header="包装规格" />
                <DataGridTextColumn
                  Width="180"
                  Binding="{Binding PrepnSpec}"
                  Header="制剂规格" />
                <DataGridTextColumn
                  Width="130"
                  Binding="{Binding BatchNo}"
                  Header="批号" />
                <DataGridTextColumn
                  Width="240"
                  Binding="{Binding Code}"
                  Header="追溯码" />
                <DataGridTextColumn
                  Width="220"
                  Binding="{Binding Level1Code}"
                  Header="一级码" />
                <DataGridTextColumn
                  Width="220"
                  Binding="{Binding Level2Code}"
                  Header="二级码" />
                <DataGridTextColumn
                  Width="220"
                  Binding="{Binding Level3Code}"
                  Header="三级码" />
                <DataGridTextColumn
                  Width="220"
                  Binding="{Binding Level4Code}"
                  Header="四级码" />
                <DataGridTextColumn
                  Width="220"
                  Binding="{Binding Level5Code}"
                  Header="五级码" />
              </DataGrid.Columns>
            </DataGrid>
          </controls:EmptyStatePanel>
        </shad:BusyArea>
      </Grid>
    </shad:Card>
  </Grid>
</UserControl>
