<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.Settings"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:Name="Root"
  d:DesignHeight="450"
  d:DesignWidth="800"
  x:DataType="vm:Settings"
  Classes="SettingsPage"
  Focusable="True"
  mc:Ignorable="d">
  <Grid ColumnDefinitions="228,1,*">
    <StackPanel
      x:Name="NavItemsHost"
      Grid.Column="0"
      Margin="{DynamicResource SidebarPadding}"
      VerticalAlignment="Stretch"
      Classes="NavHost"
      Spacing="{DynamicResource NavItemsSpacing}" />
    <Border Grid.Column="1" Classes="SidebarDivider" />
    <Panel
      x:Name="ContentHost"
      Grid.Column="2"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Classes="ContentHost">

      <!--  PostgreSQL  -->
      <Grid
        x:Name="TabDbPage"
        Classes="TabPage"
        IsVisible="True">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #DbStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="PostgreSQL 设置" />
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel Classes="H2Title">
                  <icons:AppIcon
                    VerticalAlignment="Center"
                    Classes="H2Hash"
                    Kind="Hash" />
                  <TextBlock Classes="Large H2Text" Text="连接信息" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Outline"
                    Command="{Binding TestCommand}"
                    Content="测试连接" />
                  <Button
                    Classes="Primary"
                    Command="{Binding SaveCommand}"
                    Content="保存并应用" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="地址" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="数据库服务器主机名或 IP 地址" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="例如：127.0.0.1"
                  Text="{Binding Host}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="端口" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="PostgreSQL 监听端口，默认 5432" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FormatString="0"
                  Increment="1"
                  Maximum="65535"
                  Minimum="1"
                  PlaceholderText="例如：5432"
                  Value="{Binding Port}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="数据库名" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="要连接的数据库名称" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="例如：pactoolkits"
                  Text="{Binding Database}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="用户名" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="数据库登录用户名" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="例如：postgres"
                  Text="{Binding Username}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="密码" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="数据库登录密码" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="PasswordReveal"
                  PasswordChar="•"
                  PlaceholderText="请输入数据库密码"
                  Text="{Binding Password}" />
              </Grid>
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel Classes="H2Title">
                  <icons:AppIcon
                    VerticalAlignment="Center"
                    Classes="H2Hash"
                    Kind="Hash" />
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="Large H2Text"
                    Text="数据库架构" />
                  <controls:UpdateStatusBadge
                    VerticalAlignment="Center"
                    Label="{Binding DbSchemaBadgeLabel}"
                    LatestVersion="{Binding DbSchemaTargetVersion}"
                    Status="{Binding DbSchemaBadgeStatus}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    shad:ButtonAssist.ShowProgress="{Binding IsDbSchemaChecking}"
                    Classes="Outline"
                    Command="{Binding CheckDbSchemaStatusCommand}"
                    Content="检查状态"
                    IsEnabled="{Binding !IsDbSchemaChecking}" />
                  <Button
                    Classes="Outline"
                    Command="{Binding CopyDbSchemaDiagnosticsCommand}"
                    Content="复制诊断"
                    IsEnabled="{Binding CanCopyDbSchemaDiagnostics}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <StackPanel Spacing="4">
                <TextBlock
                  Classes="Caption Muted FieldDesc"
                  Text="{Binding DbSchemaManagementText}"
                  TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="H3">
              <StackPanel Classes="H3Title">
                <icons:AppIcon
                  VerticalAlignment="Center"
                  Classes="H3Hash"
                  Kind="Hash" />
                <TextBlock Classes="Small H3Text" Text="结构信息" />
              </StackPanel>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="目标版本" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding DbSchemaTargetVersion}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="数据库版本" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding DbSchemaCurrentVersion}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最低要求" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding DbSchemaRequiredMinVersion}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最高支持" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding DbSchemaRequiredMaxVersion}" />
              </Grid>
            </Border>

            <Border Classes="H3">
              <StackPanel Classes="H3Title">
                <icons:AppIcon
                  VerticalAlignment="Center"
                  Classes="H3Hash"
                  Kind="Hash" />
                <TextBlock Classes="Small H3Text" Text="运行信息" />
              </StackPanel>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最近检查" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding DbSchemaLastCheckedAtText}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="触发来源" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding DbSchemaLastCheckSourceText}" />
              </Grid>
            </Border>

          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="DbStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  Client Aliases  -->
      <Grid
        x:Name="TabAliasPage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #AliasStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="客户端别名映射" />
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <StackPanel Classes="H2Title">
                    <icons:AppIcon
                      VerticalAlignment="Center"
                      Classes="H2Hash"
                      Kind="Hash" />
                    <TextBlock Classes="Large H2Text" Text="别名列表" />
                  </StackPanel>
                  <TextBlock Classes="Caption Muted FieldDesc" Text="为每台客户端机器设置显示别名" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Outline"
                    Command="{Binding StartEditClientAliasesCommand}"
                    Content="开始编辑"
                    IsEnabled="{Binding !IsClientAliasEditMode}" />
                  <Button
                    Classes="Primary"
                    Command="{Binding SaveClientAliasesCommand}"
                    Content="保存别名"
                    IsEnabled="{Binding IsClientAliasEditMode}" />
                </StackPanel>
              </Grid>
            </Border>

            <controls:EmptyStatePanel
              EmptyHint="连接数据库后可自动同步机器标识并维护别名"
              EmptyText="暂无客户端别名"
              IsEmpty="{Binding IsClientAliasesEmpty}">
              <ItemsControl ItemsSource="{Binding ClientAliases}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ClientAliasRow">
                    <Border Classes="Field">
                      <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                        <TextBlock
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          Classes="FieldTitle"
                          Text="{Binding Machine}"
                          TextTrimming="CharacterEllipsis" />
                        <TextBox
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding IsClientAliasEditable, ElementName=Root}"
                          PlaceholderText="输入别名"
                          Text="{Binding Alias}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </controls:EmptyStatePanel>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="AliasStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  Trace Code Rules  -->
      <Grid
        x:Name="TabTraceRulePage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #TraceStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="追溯码校验规则" />
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel Classes="H2Title">
                  <icons:AppIcon
                    VerticalAlignment="Center"
                    Classes="H2Hash"
                    Kind="Hash" />
                  <TextBlock Classes="Large H2Text" Text="单条追溯码合法性" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Primary"
                    Command="{Binding SaveTraceCodeRuleCommand}"
                    Content="保存规则" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="固定长度" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="追溯码必须满足的字符长度" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FormatString="0"
                  Increment="1"
                  Maximum="256"
                  Minimum="1"
                  Value="{Binding TraceCodeRequiredLength}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="正则规则" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="示例：^8\d+$ （以 8 开头的全数字）" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="例如：^8\\d+$"
                  Text="{Binding TraceCodePattern}" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="TraceStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  UI Behavior  -->
      <Grid
        x:Name="TabUiBehaviorPage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #UiStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="界面行为" />
            </Border>

            <Border Classes="H2">
              <StackPanel Classes="H2Title">
                <icons:AppIcon
                  VerticalAlignment="Center"
                  Classes="H2Hash"
                  Kind="Hash" />
                <TextBlock Classes="Large H2Text" Text="托盘模式" />
              </StackPanel>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="关闭窗口时最小化到托盘" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="关闭主窗口后保留在系统托盘，而非退出应用" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding MinimizeToTrayOnClose}"
                  OffContent="关闭"
                  OnContent="开启" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="UiStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  Updates  -->
      <Grid
        x:Name="TabUpdatePage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #UpdateStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="应用更新" />
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel Classes="H2Title">
                  <icons:AppIcon
                    VerticalAlignment="Center"
                    Classes="H2Hash"
                    Kind="Hash" />
                  <TextBlock Classes="Large H2Text" Text="更新源与策略" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    shad:ButtonAssist.ShowProgress="{Binding IsUpdateChecking}"
                    Classes="Outline"
                    Command="{Binding CheckUpdatesCommand}"
                    Content="检查更新"
                    IsEnabled="{Binding !IsUpdateChecking}" />
                  <Button
                    Classes="Outline"
                    Command="{Binding ApplyUpdateNowCommand}"
                    IsEnabled="{Binding CanApplyProductUpdateNow}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                      <Border
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Background="{DynamicResource WarningColor}"
                        CornerRadius="999"
                        IsVisible="{Binding HasUpdateAvailable}" />
                      <TextBlock VerticalAlignment="Center" Text="立即更新" />
                    </StackPanel>
                  </Button>
                  <Button
                    Classes="Primary"
                    Command="{Binding SaveUpdateOptionsCommand}"
                    Content="保存配置" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="PacToolkits 版本" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="当前已安装版本" />
                </StackPanel>
                <Grid
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="{DynamicResource SpacingInlineMd}">
                  <TextBox
                    IsEnabled="False"
                    PlaceholderText="当前已安装版本"
                    Text="{Binding CurrentProductVersion}" />
                  <controls:UpdateStatusBadge
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Label="{Binding UpdateAvailabilityLabel}"
                    LatestVersion="{Binding LatestProductVersion}"
                    Status="{Binding UpdateAvailability}" />
                </Grid>
              </Grid>
            </Border>

            <Border Classes="Field" IsVisible="{Binding HasUpdateTarget}">
              <Grid>
                <StackPanel Spacing="4">
                  <TextBlock Classes="FieldTitle" Text="待更新版本详情" />
                  <TextBlock Classes="Caption Muted" Text="{Binding UpdateTargetStatus, StringFormat=状态：{0}}" />
                  <TextBlock
                    Classes="Caption Muted"
                    Text="{Binding UpdateTargetMessage}"
                    TextWrapping="Wrap" />
                  <TextBlock Classes="Caption Muted" Text="{Binding UpdateTargetVersion, StringFormat=版本：{0}}" />
                  <TextBlock
                    Classes="Caption Muted"
                    Text="{Binding UpdateTargetSource, StringFormat=来源：{0}}"
                    TextWrapping="Wrap" />
                  <TextBlock Classes="Caption Muted" Text="{Binding UpdateTargetDatabase, StringFormat=数据库：{0}}" />
                  <TextBlock Classes="Caption Muted" Text="{Binding UpdateTargetSchemaRange, StringFormat=Schema 范围：{0}}" />
                  <TextBlock
                    Classes="Caption Muted"
                    IsVisible="{Binding HasCheckedUpdate}"
                    Text="{Binding UpdateTargetCheckedAt, StringFormat=检查时间：{0}}" />
                  <TextBlock
                    Classes="Caption Muted"
                    IsVisible="{Binding HasDownloadedUpdate}"
                    Text="{Binding UpdateTargetDownloadedAt, StringFormat=下载时间：{0}}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="自动检查更新" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="启动后及运行期间静默检查，仅显示状态提示，不会自动下载" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding AutoCheckUpdateOnStartup}"
                  OffContent="关闭"
                  OnContent="开启" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="更新通道" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="{Binding UpdateChannelSwitchHint}" />
                </StackPanel>
                <ComboBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding UpdateChannelOptions}"
                  SelectedItem="{Binding UpdateChannel}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="更新源地址" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="留空使用默认更新源" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="留空使用默认更新源"
                  Text="{Binding UpdateFeedUrl}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="自动轮询（分钟）" />
                  <TextBlock
                    Classes="Caption Muted FieldDesc"
                    Text="{Binding UpdatePollIntervalHint}"
                    TextWrapping="Wrap" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FormatString="N0"
                  Increment="5"
                  Maximum="720"
                  Minimum="0"
                  Value="{Binding UpdatePollIntervalMinutes}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="忽略版本" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="留空表示不忽略任何版本" />
                </StackPanel>
                <Grid
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="{DynamicResource SpacingInlineSm}">
                  <TextBox PlaceholderText="留空表示不忽略任何版本" Text="{Binding IgnoredProductVersion}" />
                  <Button
                    Grid.Column="1"
                    Classes="Outline"
                    Command="{Binding ClearIgnoredVersionCommand}"
                    Content="清空" />
                </Grid>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="UpdateStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  Logging  -->
      <Grid
        x:Name="TabLoggingPage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #LoggingStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="日志与诊断" />
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel Classes="H2Title">
                  <icons:AppIcon
                    VerticalAlignment="Center"
                    Classes="H2Hash"
                    Kind="Hash" />
                  <TextBlock Classes="Large H2Text" Text="日志策略与操作" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Outline"
                    Command="{Binding OpenLogDirectoryCommand}"
                    Content="打开目录"
                    IsEnabled="{Binding !IsLoggingBusy}" />
                  <Button
                    Classes="Outline"
                    Command="{Binding CopyCurrentLogPathCommand}"
                    Content="复制路径"
                    IsEnabled="{Binding !IsLoggingBusy}" />
                  <Button
                    Classes="Outline"
                    Command="{Binding ExportRecentLogsCommand}"
                    Content="导出24h"
                    IsEnabled="{Binding !IsLoggingBusy}" />
                  <Button
                    Classes="Primary"
                    Command="{Binding SaveLoggingOptionsCommand}"
                    Content="保存日志配置"
                    IsEnabled="{Binding !IsLoggingBusy}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="启用日志" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="开启后将按配置写入本地日志文件" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding LoggingEnabled}"
                  OffContent="关闭"
                  OnContent="开启" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="最小级别" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="{Binding LoggingMinimumLevelHint}" />
                </StackPanel>
                <ComboBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding LoggingLevelOptions}"
                  SelectedItem="{Binding LoggingMinimumLevel}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="保留天数" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="超过保留天数的日志文件将被自动清理" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Increment="1"
                  Maximum="180"
                  Minimum="1"
                  Value="{Binding LoggingRetentionDays}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="单文件上限(MB)" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="单个日志文件的最大体积，超出后滚动到新文件" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Increment="1"
                  Maximum="200"
                  Minimum="1"
                  Value="{Binding LoggingMaxFileSizeMb}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="日志目录" />
                  <TextBlock
                    Classes="Caption Muted FieldDesc"
                    Text="默认目录：ApplicationData/PacToolkits/logs/desktop；建议保持默认，便于部署和故障回溯"
                    TextWrapping="Wrap" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="留空使用默认日志目录"
                  Text="{Binding LoggingDirectory}" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="LoggingStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  MSFX API  -->
      <Grid
        x:Name="TabMsfxPage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #MsfxStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="码上放心 API" />
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel Classes="H2Title">
                  <icons:AppIcon
                    VerticalAlignment="Center"
                    Classes="H2Hash"
                    Kind="Hash" />
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="Large H2Text"
                    Text="调用凭证与网关" />
                  <controls:UpdateStatusBadge
                    VerticalAlignment="Center"
                    Label="{Binding MsfxApiBadgeLabel}"
                    Status="{Binding MsfxApiBadgeStatus}" />
                  <controls:StatusPill
                    Classes="ToneInfo15"
                    Icon="Link"
                    Text="MSFX" />
                  <controls:StatusPill
                    Classes="ToneInfo15"
                    Icon="Cog"
                    Text="配置中心" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Primary"
                    Command="{Binding SaveMsfxApiConfigCommand}"
                    Content="保存配置" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="网关地址" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="码上放心 API 网关 URL" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="https://eco.taobao.com/router/rest"
                  Text="{Binding MsfxGatewayUrl}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="AppKey" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="应用 AppKey 凭证" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="请输入 AppKey"
                  Text="{Binding MsfxAppKey}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="AppSecret" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="应用 AppSecret 凭证" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="PasswordReveal"
                  PasswordChar="•"
                  PlaceholderText="请输入 AppSecret"
                  Text="{Binding MsfxAppSecret}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="SessionToken" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="非必填，可留空" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="非必填，可留空"
                  Text="{Binding MsfxSessionToken}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="接收企业 RefEntId" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="用于 ref_ent_id / 默认 to_ref_user_id" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="用于 ref_ent_id / 默认 to_ref_user_id"
                  Text="{Binding MsfxRefEntId}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="超时（秒）" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="建议 15-30 秒；网络较慢可适当调大" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FormatString="0"
                  Increment="1"
                  Maximum="120"
                  Minimum="3"
                  Value="{Binding MsfxTimeoutSeconds}" />
              </Grid>
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel Classes="H2Title">
                  <icons:AppIcon
                    VerticalAlignment="Center"
                    Classes="H2Hash"
                    Kind="Hash" />
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="Large H2Text"
                    Text="拉取游标" />
                  <controls:StatusPill
                    Classes="ToneWarning15"
                    Icon="History"
                    Text="高级操作" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Outline"
                    Command="{Binding RefreshMsfxCursorCommand}"
                    Content="刷新"
                    IsEnabled="{Binding !IsMsfxCursorBusy}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="手动前移游标" />
                  <TextBlock
                    Classes="Caption Muted FieldDesc"
                    Text="{Binding MsfxCursorCurrentText}"
                    TextWrapping="Wrap" />
                </StackPanel>
                <Grid
                  Grid.Column="1"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="{DynamicResource SpacingInlineMd}">
                  <CalendarDatePicker
                    VerticalAlignment="Center"
                    DisplayDateEnd="{Binding MsfxCursorMaxDate}"
                    IsTodayHighlighted="True"
                    SelectedDate="{Binding MsfxCursorTargetDate}"
                    SelectedDateFormat="Short" />
                  <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Outline"
                    Command="{Binding AdvanceMsfxCursorCommand}"
                    Content="跳过至该日"
                    IsEnabled="{Binding !IsMsfxCursorBusy}" />
                </Grid>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="MsfxStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  自动化集成  -->
      <Grid
        x:Name="TabAgentsPage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          x:Name="AgentsScrollViewer"
          controls:SettingsScroll.StickyHost="{Binding #AgentsStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="H1Text"
                  Text="自动化集成" />
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Outline"
                    Command="{Binding RestartAgentsCommand}"
                    Content="重启 Agents"
                    IsEnabled="{Binding !IsAgentsToggling}" />
                  <Button
                    shad:ButtonAssist.ShowProgress="{Binding IsSavingSettings}"
                    Classes="Primary"
                    Command="{Binding SaveAgentsSettingsCommand}"
                    Content="保存配置"
                    IsEnabled="{Binding !IsSavingSettings}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="H2">
              <StackPanel Classes="H2Title">
                <icons:AppIcon
                  VerticalAlignment="Center"
                  Classes="H2Hash"
                  Kind="Hash" />
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="Large H2Text"
                  Text="Agents 运行" />
                <controls:StatusPill
                  VerticalAlignment="Center"
                  Classes="ToneInfo15"
                  Icon="BadgeQuestionMark"
                  IsVisible="{Binding IsHostStatusUnknown}"
                  Text="{Binding HostStatusText}" />
                <controls:StatusPill
                  VerticalAlignment="Center"
                  Classes="ToneWarning15"
                  Icon="LoaderCircle"
                  IsVisible="{Binding IsHostStatusStarting}"
                  Text="{Binding HostStatusText}" />
                <controls:StatusPill
                  VerticalAlignment="Center"
                  Classes="ToneDone25"
                  Icon="CircleCheck"
                  IsVisible="{Binding IsHostStatusRunning}"
                  Text="{Binding HostStatusText}" />
                <controls:StatusPill
                  VerticalAlignment="Center"
                  Classes="ToneDanger15"
                  Icon="CircleAlert"
                  IsVisible="{Binding IsHostStatusFailed}"
                  Text="{Binding HostStatusText}" />
                <controls:StatusPill
                  VerticalAlignment="Center"
                  Classes="ToneDanger15"
                  Icon="CircleAlert"
                  IsVisible="{Binding IsHostStatusStopped}"
                  Text="{Binding HostStatusText}" />
              </StackPanel>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="运行 Agents" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="启动或停止 Agents 进程管理器" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding IsHostRunningSwitch, Mode=TwoWay}"
                  IsEnabled="{Binding !IsAgentsToggling}"
                  OffContent="停止"
                  OnContent="启动" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="运行说明" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="当前 Agents 状态与操作建议" />
                </StackPanel>
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding HostStatusDetail}"
                  TextWrapping="Wrap" />
              </Grid>
            </Border>

            <Border Classes="H3">
              <StackPanel Classes="H3Title">
                <icons:AppIcon
                  VerticalAlignment="Center"
                  Classes="H3Hash"
                  Kind="Hash" />
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="Small H3Text"
                  Text="Injector" />
                <controls:StatusPill
                  VerticalAlignment="Center"
                  Classes="ToneInfo15"
                  Icon="BadgeQuestionMark"
                  IsVisible="{Binding IsInjectorStatusUnknown}"
                  Text="{Binding InjectorStatusText}" />
                <controls:StatusPill
                  VerticalAlignment="Center"
                  Classes="ToneWarning15"
                  Icon="LoaderCircle"
                  IsVisible="{Binding IsInjectorStatusStarting}"
                  Text="{Binding InjectorStatusText}" />
                <controls:StatusPill
                  VerticalAlignment="Center"
                  Classes="ToneDone25"
                  Icon="CircleCheck"
                  IsVisible="{Binding IsInjectorStatusRunning}"
                  Text="{Binding InjectorStatusText}" />
                <controls:StatusPill
                  VerticalAlignment="Center"
                  Classes="ToneDanger15"
                  Icon="CircleAlert"
                  IsVisible="{Binding IsInjectorStatusFailed}"
                  Text="{Binding InjectorStatusText}" />
                <controls:StatusPill
                  VerticalAlignment="Center"
                  Classes="ToneDanger15"
                  Icon="CircleAlert"
                  IsVisible="{Binding IsInjectorStatusStopped}"
                  Text="{Binding InjectorStatusText}" />
              </StackPanel>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="启用 Injector" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="Agents 启动时是否挂载此模块" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding IsInjectorEnabled, Mode=TwoWay}"
                  IsEnabled="{Binding !IsAgentsToggling}"
                  OffContent="否"
                  OnContent="是" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="运行 Injector" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="启动或停止 Injector 模块（不停止 Agents）" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding IsInjectorRunningSwitch, Mode=TwoWay}"
                  IsEnabled="{Binding !IsAgentsToggling}"
                  OffContent="停止"
                  OnContent="启动" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="运行说明" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="当前模块状态与操作建议" />
                </StackPanel>
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding InjectorStatusDetail}"
                  TextWrapping="Wrap" />
              </Grid>
            </Border>

            <Border Classes="H2">
              <StackPanel Classes="H2Title">
                <icons:AppIcon
                  VerticalAlignment="Center"
                  Classes="H2Hash"
                  Kind="Hash" />
                <TextBlock Classes="Large H2Text" Text="版本与运行信息" />
              </StackPanel>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="Agents 版本" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding HostVersionText}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最近拉起" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding HostLastLaunchText}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最近错误" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding HostLastErrorText}"
                  TextWrapping="Wrap" />
              </Grid>
            </Border>

            <Border Classes="H3">
              <StackPanel Classes="H3Title">
                <icons:AppIcon
                  VerticalAlignment="Center"
                  Classes="H3Hash"
                  Kind="Hash" />
                <TextBlock Classes="Small H3Text" Text="Injector" />
              </StackPanel>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="版本" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding InjectorVersionText}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最近拉起" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding InjectorLastLaunchText}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最近错误" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding InjectorLastErrorText}"
                  TextWrapping="Wrap" />
              </Grid>
            </Border>

            <Border Classes="H2">
              <StackPanel Classes="H2Title">
                <icons:AppIcon
                  VerticalAlignment="Center"
                  Classes="H2Hash"
                  Kind="Hash" />
                <TextBlock Classes="Large H2Text" Text="基础配置" />
              </StackPanel>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="可执行路径" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="Agents 可执行文件路径" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="例如：.\Agents\Agents.exe"
                  Text="{Binding AgentsExecutablePath}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="进程名" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="可选，用于检测 Agents 进程（不带 .exe）" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="例如：Agents"
                  Text="{Binding AgentsProcessName}" />
              </Grid>
            </Border>

            <Border Classes="H2">
              <StackPanel Classes="H2Title">
                <icons:AppIcon
                  VerticalAlignment="Center"
                  Classes="H2Hash"
                  Kind="Hash" />
                <TextBlock Classes="Large H2Text" Text="Injector 配置" />
              </StackPanel>
            </Border>

            <Border Classes="H3">
              <StackPanel Classes="H3Title">
                <icons:AppIcon
                  VerticalAlignment="Center"
                  Classes="H3Hash"
                  Kind="Hash" />
                <TextBlock Classes="Small H3Text" Text="基础配置" />
              </StackPanel>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="PG 驱动" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="Injector 连接 PostgreSQL 使用的 ODBC 驱动名" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding InjectorPgDriver}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="PG SSL" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="Injector 连接数据库时是否启用 SSL" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding InjectorPgSslEnabled, Mode=TwoWay}"
                  OffContent="否"
                  OnContent="是" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="确认超时" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="UI 操作确认等待时间（毫秒，100–10000）" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FormatString="0"
                  Increment="100"
                  Maximum="10000"
                  Minimum="100"
                  Value="{Binding InjectorConfirmTimeoutMs}" />
              </Grid>
            </Border>

            <Border Classes="H3">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <StackPanel Classes="H3Title">
                    <icons:AppIcon
                      VerticalAlignment="Center"
                      Classes="H3Hash"
                      Kind="Hash" />
                    <TextBlock Classes="Small H3Text" Text="目标进程" />
                  </StackPanel>
                  <TextBlock Classes="Caption Muted FieldDesc" Text="Injector 模块可注入的目标可执行文件，每行一个" />
                </StackPanel>
                <Button
                  Grid.Column="1"
                  Classes="Outline"
                  Click="OnAgentsAddLineClicked"
                  Command="{Binding AddInjectorAppWinItemCommand}"
                  Tag="InjectorAppWinItemsControl">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="Plus" />
                    <TextBlock VerticalAlignment="Center" Text="新增" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <ItemsControl x:Name="InjectorAppWinItemsControl" ItemsSource="{Binding InjectorAppWinItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InjectorLineItem">
                  <Border Classes="Field">
                    <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,Auto">
                      <TextBox
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        PlaceholderText="例如：his-client.exe"
                        Text="{Binding Value}" />
                      <Button
                        Grid.Column="1"
                        Classes="Ghost"
                        Command="{Binding #Root.((vm:Settings)DataContext).RemoveInjectorAppWinItemCommand}"
                        CommandParameter="{Binding .}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeSmall}"
                            Height="{DynamicResource IconSizeSmall}"
                            Kind="X" />
                          <TextBlock VerticalAlignment="Center" Text="移除" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="H3">
              <StackPanel Classes="H3Title">
                <icons:AppIcon
                  VerticalAlignment="Center"
                  Classes="H3Hash"
                  Kind="Hash" />
                <TextBlock Classes="Small H3Text" Text="门诊配置" />
              </StackPanel>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="窗口类" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="门诊窗口 Class 名称" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding InjectorOptWindowClass}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="解析区 ClassNN" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="门诊表格解析区域控件标识" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding InjectorOptParseGridClassNN}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="验证区 ClassNN" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="门诊表格验证区域控件标识" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding InjectorOptVerifyGridClassNN}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="输入控件 ClassNN" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="门诊追溯码输入框控件标识" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding InjectorOptInputClassNN}" />
              </Grid>
            </Border>

            <Border Classes="H3">
              <StackPanel Classes="H3Title">
                <icons:AppIcon
                  VerticalAlignment="Center"
                  Classes="H3Hash"
                  Kind="Hash" />
                <TextBlock Classes="Small H3Text" Text="住院配置" />
              </StackPanel>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="窗口类" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="住院窗口 Class 名称" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding InjectorIptWindowClass}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="解析区 ClassNN" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="住院表格解析区域控件标识" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding InjectorIptParseGridClassNN}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="验证区 ClassNN" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="住院表格验证区域控件标识" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding InjectorIptVerifyGridClassNN}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="输入控件 ClassNN" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="住院追溯码输入框控件标识" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding InjectorIptInputClassNN}" />
              </Grid>
            </Border>

            <Border Classes="H3">
              <StackPanel Classes="H3Title">
                <icons:AppIcon
                  VerticalAlignment="Center"
                  Classes="H3Hash"
                  Kind="Hash" />
                <TextBlock Classes="Small H3Text" Text="仓库配置" />
              </StackPanel>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="仓库模式" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="开启后从数据库任务队列取单注入" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding InjectorWarehouseEnabled, Mode=TwoWay}"
                  OffContent="正常模式"
                  OnContent="仓库模式" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="任务标识" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="默认可填：单据号||当前编号" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding InjectorWarehouseTaskIdentifier}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="取码策略" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="多层级追溯码选取规则" />
                </StackPanel>
                <ComboBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding InjectorCodePickPolicyOptions}"
                  SelectedItem="{Binding SelectedInjectorCodePickPolicyOption, Mode=TwoWay}" />
              </Grid>
            </Border>

            <Border Classes="H3">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <StackPanel Classes="H3Title">
                    <icons:AppIcon
                      VerticalAlignment="Center"
                      Classes="H3Hash"
                      Kind="Hash" />
                    <TextBlock Classes="Small H3Text" Text="仓库列特征" />
                  </StackPanel>
                  <TextBlock
                    Classes="Caption Muted FieldDesc"
                    Text="表头命中任一列名则判定为住院；均未命中则判定为仓库（默认：患者姓名、应扫次数）"
                    TextWrapping="Wrap" />
                </StackPanel>
                <Button
                  Grid.Column="1"
                  Classes="Outline"
                  Click="OnAgentsAddLineClicked"
                  Command="{Binding AddInjectorWarehouseAnchorItemCommand}"
                  Tag="InjectorWarehouseAnchorItemsControl">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="Plus" />
                    <TextBlock VerticalAlignment="Center" Text="新增" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <ItemsControl x:Name="InjectorWarehouseAnchorItemsControl" ItemsSource="{Binding InjectorWarehouseAnchorItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InjectorLineItem">
                  <Border Classes="Field">
                    <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,Auto">
                      <TextBox
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        PlaceholderText="列名"
                        Text="{Binding Value}" />
                      <Button
                        Grid.Column="1"
                        Classes="Ghost"
                        Command="{Binding #Root.((vm:Settings)DataContext).RemoveInjectorWarehouseAnchorItemCommand}"
                        CommandParameter="{Binding .}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeSmall}"
                            Height="{DynamicResource IconSizeSmall}"
                            Kind="X" />
                          <TextBlock VerticalAlignment="Center" Text="移除" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="H3">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <StackPanel Classes="H3Title">
                    <icons:AppIcon
                      VerticalAlignment="Center"
                      Classes="H3Hash"
                      Kind="Hash" />
                    <TextBlock Classes="Small H3Text" Text="解析规则" />
                  </StackPanel>
                  <TextBlock Classes="Caption Muted FieldDesc" Text="表格列解析规则（ColSpecs），每行一条" />
                </StackPanel>
                <Button
                  Grid.Column="1"
                  Classes="Outline"
                  Click="OnAgentsAddLineClicked"
                  Command="{Binding AddInjectorColSpecsItemCommand}"
                  Tag="InjectorColSpecsItemsControl">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="Plus" />
                    <TextBlock VerticalAlignment="Center" Text="新增" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <ItemsControl x:Name="InjectorColSpecsItemsControl" ItemsSource="{Binding InjectorColSpecsItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InjectorLineItem">
                  <Border Classes="Field">
                    <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,Auto">
                      <TextBox
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        PlaceholderText="列规则"
                        Text="{Binding Value}" />
                      <Button
                        Grid.Column="1"
                        Classes="Ghost"
                        Command="{Binding #Root.((vm:Settings)DataContext).RemoveInjectorColSpecsItemCommand}"
                        CommandParameter="{Binding .}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeSmall}"
                            Height="{DynamicResource IconSizeSmall}"
                            Kind="X" />
                          <TextBlock VerticalAlignment="Center" Text="移除" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="H3">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <StackPanel Classes="H3Title">
                    <icons:AppIcon
                      VerticalAlignment="Center"
                      Classes="H3Hash"
                      Kind="Hash" />
                    <TextBlock Classes="Small H3Text" Text="整数列" />
                  </StackPanel>
                  <TextBlock Classes="Caption Muted FieldDesc" Text="需要按整数解析的列名，每行一个" />
                </StackPanel>
                <Button
                  Grid.Column="1"
                  Classes="Outline"
                  Click="OnAgentsAddLineClicked"
                  Command="{Binding AddInjectorIntColsItemCommand}"
                  Tag="InjectorIntColsItemsControl">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="Plus" />
                    <TextBlock VerticalAlignment="Center" Text="新增" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <ItemsControl x:Name="InjectorIntColsItemsControl" ItemsSource="{Binding InjectorIntColsItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InjectorLineItem">
                  <Border Classes="Field">
                    <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,Auto">
                      <TextBox
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        PlaceholderText="列名"
                        Text="{Binding Value}" />
                      <Button
                        Grid.Column="1"
                        Classes="Ghost"
                        Command="{Binding #Root.((vm:Settings)DataContext).RemoveInjectorIntColsItemCommand}"
                        CommandParameter="{Binding .}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeSmall}"
                            Height="{DynamicResource IconSizeSmall}"
                            Kind="X" />
                          <TextBlock VerticalAlignment="Center" Text="移除" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="AgentsStickyHost" Spacing="0" />
        </Border>
      </Grid>

    </Panel>
  </Grid>
</UserControl>
