<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.Settings"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:Name="Root"
  d:DesignHeight="450"
  d:DesignWidth="800"
  x:DataType="vm:Settings"
  Classes="SettingsPage"
  Focusable="True"
  mc:Ignorable="d">
  <Grid ColumnDefinitions="228,1,*">
    <StackPanel
      x:Name="NavItemsHost"
      Grid.Column="0"
      Margin="{DynamicResource SidebarPadding}"
      VerticalAlignment="Stretch"
      Classes="NavHost"
      Spacing="{DynamicResource NavItemsSpacing}" />
    <Border Grid.Column="1" Classes="SidebarDivider" />
    <Panel
      x:Name="ContentHost"
      Grid.Column="2"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Classes="ContentHost">

      <!--  PostgreSQL  -->
      <Grid
        x:Name="TabDbPage"
        Classes="TabPage"
        IsVisible="True">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #DbStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="PostgreSQL 设置" />
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <TextBlock Classes="Large H2Text" Text="连接信息" />
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Outline"
                    Command="{Binding TestCommand}"
                    Content="测试连接" />
                  <Button
                    Classes="Primary"
                    Command="{Binding SaveCommand}"
                    Content="保存并应用" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="地址" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="数据库服务器主机名或 IP 地址" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="例如：127.0.0.1"
                  Text="{Binding Host}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="端口" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="PostgreSQL 监听端口，默认 5432" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FormatString="0"
                  Increment="1"
                  Maximum="65535"
                  Minimum="1"
                  PlaceholderText="例如：5432"
                  Value="{Binding Port}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="数据库名" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="要连接的数据库名称" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="例如：pactoolkits"
                  Text="{Binding Database}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="用户名" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="数据库登录用户名" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="例如：postgres"
                  Text="{Binding Username}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="密码" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="数据库登录密码" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="PasswordReveal"
                  PasswordChar="•"
                  PlaceholderText="请输入数据库密码"
                  Text="{Binding Password}" />
              </Grid>
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="Large H2Text"
                    Text="数据库架构" />
                  <controls:UpdateStatusBadge
                    VerticalAlignment="Center"
                    Label="{Binding DbSchemaBadgeLabel}"
                    LatestVersion="{Binding DbSchemaTargetVersion}"
                    Status="{Binding DbSchemaBadgeStatus}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    shad:ButtonAssist.ShowProgress="{Binding IsDbSchemaChecking}"
                    Classes="Outline"
                    Command="{Binding CheckDbSchemaStatusCommand}"
                    Content="检查更新"
                    IsEnabled="{Binding !IsDbSchemaChecking}" />
                  <Button
                    Classes="Outline"
                    Command="{Binding ViewDbSchemaMigrationPlanCommand}"
                    Content="查看计划"
                    IsEnabled="{Binding !IsDbSchemaChecking}" />
                  <Button
                    Classes="Outline"
                    Command="{Binding CopyDbSchemaDiagnosticsCommand}"
                    Content="复制诊断"
                    IsEnabled="{Binding CanCopyDbSchemaDiagnostics}" />
                  <Button
                    shad:ButtonAssist.ShowProgress="{Binding IsDbSchemaChecking}"
                    Classes="Primary"
                    Command="{Binding ApplyDbSchemaUpdateCommand}"
                    Content="立即更新"
                    IsEnabled="{Binding CanApplyDbSchemaUpdate}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <StackPanel Spacing="4">
                <TextBlock
                  Classes="Caption Muted FieldDesc"
                  Text="{Binding DbSchemaBetaConceptText}"
                  TextWrapping="Wrap" />
                <TextBlock
                  Classes="Caption Muted FieldDesc"
                  Text="{Binding DbSchemaPolicyText}"
                  TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="H3">
              <TextBlock Classes="Small H3Text" Text="结构信息" />
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最新版本" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding DbSchemaTargetVersion}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="数据库版本" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding DbSchemaCurrentVersion}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最低要求" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding DbSchemaRequiredMinVersion}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最高支持" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding DbSchemaRequiredMaxVersion}" />
              </Grid>
            </Border>

            <Border Classes="H3">
              <TextBlock Classes="Small H3Text" Text="运行信息" />
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最近检查" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding DbSchemaLastCheckedAtText}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="触发来源" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding DbSchemaLastCheckSourceText}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最近迁移" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding DbSchemaLastMigrationText}"
                  TextTrimming="CharacterEllipsis"
                  TextWrapping="NoWrap" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="DbStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  Client Aliases  -->
      <Grid
        x:Name="TabAliasPage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #AliasStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="客户端别名映射" />
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Classes="Large H2Text" Text="别名列表" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="为每台客户端机器设置显示别名" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Outline"
                    Command="{Binding StartEditClientAliasesCommand}"
                    Content="开始编辑"
                    IsEnabled="{Binding !IsClientAliasEditMode}" />
                  <Button
                    Classes="Outline"
                    Command="{Binding ReloadClientAliasesCommand}"
                    Content="刷新机器标识"
                    IsEnabled="{Binding !IsClientAliasRefreshing}" />
                  <Button
                    Classes="Primary"
                    Command="{Binding SaveClientAliasesCommand}"
                    Content="保存别名"
                    IsEnabled="{Binding IsClientAliasEditMode}" />
                </StackPanel>
              </Grid>
            </Border>

            <controls:EmptyStatePanel
              EmptyHint="连接数据库或开始编辑后可维护别名"
              EmptyText="暂无客户端别名"
              IsEmpty="{Binding IsClientAliasesEmpty}">
              <ItemsControl ItemsSource="{Binding ClientAliases}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ClientAliasRow">
                    <Border Classes="Field">
                      <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                        <TextBlock
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          Classes="FieldTitle"
                          Text="{Binding Machine}"
                          TextTrimming="CharacterEllipsis" />
                        <TextBox
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding IsClientAliasEditable, ElementName=Root}"
                          PlaceholderText="输入别名"
                          Text="{Binding Alias}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </controls:EmptyStatePanel>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="AliasStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  Trace Code Rules  -->
      <Grid
        x:Name="TabTraceRulePage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #TraceStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="追溯码校验规则" />
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <TextBlock Classes="Large H2Text" Text="单条追溯码合法性" />
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Primary"
                    Command="{Binding SaveTraceCodeRuleCommand}"
                    Content="保存规则" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="固定长度" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="追溯码必须满足的字符长度" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FormatString="0"
                  Increment="1"
                  Maximum="256"
                  Minimum="1"
                  Value="{Binding TraceCodeRequiredLength}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="正则规则" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="示例：^8\d+$ （以 8 开头的全数字）" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="例如：^8\\d+$"
                  Text="{Binding TraceCodePattern}" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="TraceStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  UI Behavior  -->
      <Grid
        x:Name="TabUiBehaviorPage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #UiStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="界面行为" />
            </Border>

            <Border Classes="H2">
              <TextBlock Classes="Large H2Text" Text="托盘模式" />
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="关闭窗口时最小化到托盘" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="关闭主窗口后保留在系统托盘，而非退出应用" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding MinimizeToTrayOnClose}" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="UiStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  Updates  -->
      <Grid
        x:Name="TabUpdatePage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #UpdateStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="应用更新" />
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <TextBlock Classes="Large H2Text" Text="更新源与策略" />
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    shad:ButtonAssist.ShowProgress="{Binding IsUpdateChecking}"
                    Classes="Outline"
                    Command="{Binding CheckUpdatesCommand}"
                    Content="检查更新"
                    IsEnabled="{Binding !IsUpdateChecking}" />
                  <Button
                    Classes="Outline"
                    Command="{Binding ApplyUpdateNowCommand}"
                    IsEnabled="{Binding CanApplyProductUpdateNow}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                      <Border
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Background="{DynamicResource WarningColor}"
                        CornerRadius="999"
                        IsVisible="{Binding HasUpdateAvailable}" />
                      <TextBlock VerticalAlignment="Center" Text="立即更新" />
                    </StackPanel>
                  </Button>
                  <Button
                    Classes="Primary"
                    Command="{Binding SaveUpdateOptionsCommand}"
                    Content="保存配置" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="PacToolkits 版本" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="当前已安装版本" />
                </StackPanel>
                <Grid
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="{DynamicResource SpacingInlineMd}">
                  <TextBox
                    IsEnabled="False"
                    PlaceholderText="当前已安装版本"
                    Text="{Binding CurrentProductVersion}" />
                  <controls:UpdateStatusBadge
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Label="{Binding ProductUpdateAvailabilityLabel}"
                    LatestVersion="{Binding LatestProductVersion}"
                    Status="{Binding ProductUpdateAvailable}" />
                </Grid>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="自动检查更新" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="启动后及运行期间静默检查，仅显示状态提示，不会自动下载" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding AutoCheckUpdateOnStartup}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="更新通道" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="{Binding UpdateChannelSwitchHint}" />
                </StackPanel>
                <ComboBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding UpdateChannelOptions}"
                  SelectedItem="{Binding UpdateChannel}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="更新源地址" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="留空使用默认更新源" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="留空使用默认更新源"
                  Text="{Binding UpdateFeedUrl}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="自动轮询（分钟）" />
                  <TextBlock
                    Classes="Caption Muted FieldDesc"
                    Text="{Binding UpdatePollIntervalHint}"
                    TextWrapping="Wrap" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FormatString="N0"
                  Increment="5"
                  Maximum="720"
                  Minimum="0"
                  Value="{Binding UpdatePollIntervalMinutes}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="忽略版本" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="留空表示不忽略任何版本" />
                </StackPanel>
                <Grid
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="{DynamicResource SpacingInlineSm}">
                  <TextBox PlaceholderText="留空表示不忽略任何版本" Text="{Binding IgnoredProductVersion}" />
                  <Button
                    Grid.Column="1"
                    Classes="Outline"
                    Command="{Binding ClearIgnoredVersionCommand}"
                    Content="清空" />
                </Grid>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="UpdateStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  Logging  -->
      <Grid
        x:Name="TabLoggingPage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #LoggingStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="日志与诊断" />
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <TextBlock Classes="Large H2Text" Text="日志策略与操作" />
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Outline"
                    Command="{Binding OpenLogDirectoryCommand}"
                    Content="打开目录"
                    IsEnabled="{Binding !IsLoggingBusy}" />
                  <Button
                    Classes="Outline"
                    Command="{Binding CopyCurrentLogPathCommand}"
                    Content="复制路径"
                    IsEnabled="{Binding !IsLoggingBusy}" />
                  <Button
                    Classes="Outline"
                    Command="{Binding ExportRecentLogsCommand}"
                    Content="导出24h"
                    IsEnabled="{Binding !IsLoggingBusy}" />
                  <Button
                    Classes="Primary"
                    Command="{Binding SaveLoggingOptionsCommand}"
                    Content="保存日志配置"
                    IsEnabled="{Binding !IsLoggingBusy}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="启用日志" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="开启后将按配置写入本地日志文件" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding LoggingEnabled}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="最小级别" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="{Binding LoggingMinimumLevelHint}" />
                </StackPanel>
                <ComboBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding LoggingLevelOptions}"
                  SelectedItem="{Binding LoggingMinimumLevel}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="保留天数" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="超过保留天数的日志文件将被自动清理" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Increment="1"
                  Maximum="180"
                  Minimum="1"
                  Value="{Binding LoggingRetentionDays}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="单文件上限(MB)" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="单个日志文件的最大体积，超出后滚动到新文件" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Increment="1"
                  Maximum="200"
                  Minimum="1"
                  Value="{Binding LoggingMaxFileSizeMb}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="日志目录" />
                  <TextBlock
                    Classes="Caption Muted FieldDesc"
                    Text="默认目录：ApplicationData/PacToolkits/logs/desktop；建议保持默认，便于部署和故障回溯"
                    TextWrapping="Wrap" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="留空使用默认日志目录"
                  Text="{Binding LoggingDirectory}" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="LoggingStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  MSFX API  -->
      <Grid
        x:Name="TabMsfxPage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          controls:SettingsScroll.StickyHost="{Binding #MsfxStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <TextBlock Classes="H1Text" Text="码上放心 API" />
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="Large H2Text"
                    Text="调用凭证与网关" />
                  <controls:UpdateStatusBadge
                    VerticalAlignment="Center"
                    Label="{Binding MsfxApiBadgeLabel}"
                    Status="{Binding MsfxApiBadgeStatus}" />
                  <controls:StatusPill
                    Classes="ToneInfo15"
                    Icon="Link"
                    Text="MSFX" />
                  <controls:StatusPill
                    Classes="ToneInfo15"
                    Icon="Cog"
                    Text="配置中心" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Primary"
                    Command="{Binding SaveMsfxApiConfigCommand}"
                    Content="保存配置" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="网关地址" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="码上放心 API 网关 URL" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="https://eco.taobao.com/router/rest"
                  Text="{Binding MsfxGatewayUrl}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="AppKey" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="应用 AppKey 凭证" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="请输入 AppKey"
                  Text="{Binding MsfxAppKey}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="AppSecret" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="应用 AppSecret 凭证" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="PasswordReveal"
                  PasswordChar="•"
                  PlaceholderText="请输入 AppSecret"
                  Text="{Binding MsfxAppSecret}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="SessionToken" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="非必填，可留空" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="非必填，可留空"
                  Text="{Binding MsfxSessionToken}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="接收企业 RefEntId" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="用于 ref_ent_id / 默认 to_ref_user_id" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="用于 ref_ent_id / 默认 to_ref_user_id"
                  Text="{Binding MsfxRefEntId}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="超时（秒）" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="建议 15-30 秒；网络较慢可适当调大" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FormatString="0"
                  Increment="1"
                  Maximum="120"
                  Minimum="3"
                  Value="{Binding MsfxTimeoutSeconds}" />
              </Grid>
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="Large H2Text"
                    Text="拉取游标" />
                  <controls:StatusPill
                    Classes="ToneWarning15"
                    Icon="History"
                    Text="高级操作" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Outline"
                    Command="{Binding RefreshMsfxCursorCommand}"
                    Content="刷新"
                    IsEnabled="{Binding !IsMsfxCursorBusy}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="手动前移游标" />
                  <TextBlock
                    Classes="Caption Muted FieldDesc"
                    Text="{Binding MsfxCursorCurrentText}"
                    TextWrapping="Wrap" />
                </StackPanel>
                <Grid
                  Grid.Column="1"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="{DynamicResource SpacingInlineMd}">
                  <CalendarDatePicker
                    VerticalAlignment="Center"
                    DisplayDateEnd="{Binding MsfxCursorMaxDate}"
                    IsTodayHighlighted="True"
                    SelectedDate="{Binding MsfxCursorTargetDate}"
                    SelectedDateFormat="Short" />
                  <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Outline"
                    Command="{Binding AdvanceMsfxCursorCommand}"
                    Content="跳过至该日"
                    IsEnabled="{Binding !IsMsfxCursorBusy}" />
                </Grid>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="MsfxStickyHost" Spacing="0" />
        </Border>
      </Grid>

      <!--  自动化集成  -->
      <Grid
        x:Name="TabAutomationPage"
        Classes="TabPage"
        IsVisible="False">
        <ScrollViewer
          x:Name="AutomationScrollViewer"
          controls:SettingsScroll.StickyHost="{Binding #AutomationStickyHost}"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="Body">
            <Border Classes="H1">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="H1Text"
                  Text="自动化集成" />
                <StackPanel Grid.Column="1" Classes="H2Actions">
                  <Button
                    Classes="Outline"
                    Command="{Binding RestartAhkCommand}"
                    Content="重启 Agent"
                    IsEnabled="{Binding !IsAhkToggling}" />
                  <Button
                    shad:ButtonAssist.ShowProgress="{Binding IsSavingSettings}"
                    Classes="Primary"
                    Command="{Binding SaveAhkSettingsCommand}"
                    Content="保存配置"
                    IsEnabled="{Binding !IsSavingSettings}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="H2">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="Large H2Text"
                  Text="Agent-Injector 运行" />
                <controls:StatusPill
                  VerticalAlignment="Center"
                  Classes="ToneInfo15"
                  Icon="BadgeQuestionMark"
                  IsVisible="{Binding IsAhkStatusUnknown}"
                  Text="{Binding AhkStatusText}" />
                <controls:StatusPill
                  VerticalAlignment="Center"
                  Classes="ToneDone25"
                  Icon="CircleCheck"
                  IsVisible="{Binding IsAhkStatusRunning}"
                  Text="{Binding AhkStatusText}" />
                <controls:StatusPill
                  VerticalAlignment="Center"
                  Classes="ToneDanger15"
                  Icon="CircleAlert"
                  IsVisible="{Binding IsAhkStatusStopped}"
                  Text="{Binding AhkStatusText}" />
              </StackPanel>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="启动 Injector" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="开启后自动拉起 pactoolkits-injector 进程" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding IsAhkEnabled, Mode=TwoWay}"
                  IsEnabled="{Binding !IsAhkToggling}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="运行说明" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="当前进程状态与操作建议" />
                </StackPanel>
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding AhkStatusDetail}"
                  TextWrapping="Wrap" />
              </Grid>
            </Border>

            <Border Classes="H2">
              <TextBlock Classes="Large H2Text" Text="版本与运行信息" />
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="程序版本" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding ProgramVersionText}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="工具版本" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding AhkVersionText}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最近拉起" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding LastLaunchText}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="FieldTitle"
                  Text="最近错误" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="FieldValue"
                  Text="{Binding LastErrorText}"
                  TextWrapping="Wrap" />
              </Grid>
            </Border>

            <Border Classes="H2">
              <TextBlock Classes="Large H2Text" Text="基础配置" />
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="可执行路径" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="pactoolkits-injector 可执行文件路径" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="例如：.\Agents\injector\pactoolkits-injector.exe"
                  Text="{Binding AhkExecutablePath}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="进程名" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="可选，用于检测进程（不带 .exe）" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  PlaceholderText="例如：pactoolkits-injector"
                  Text="{Binding AhkProcessName}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="PG 驱动" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="Agent 连接 PostgreSQL 使用的 ODBC 驱动名" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding AgentPgDriver}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="PG SSL" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="Agent 连接数据库时是否启用 SSL" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding AgentPgSslEnabled, Mode=TwoWay}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="确认超时" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="UI 操作确认等待时间（毫秒，100–10000）" />
                </StackPanel>
                <NumericUpDown
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FormatString="0"
                  Increment="100"
                  Maximum="10000"
                  Minimum="100"
                  Value="{Binding AgentConfirmTimeoutMs}" />
              </Grid>
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Classes="Large H2Text" Text="目标进程" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="Agent 可注入的目标可执行文件，每行一个" />
                </StackPanel>
                <Button
                  Grid.Column="1"
                  Classes="Outline"
                  Click="OnAutomationAddLineClicked"
                  Command="{Binding AddAgentAppWinItemCommand}"
                  Tag="AgentAppWinItemsControl">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="Plus" />
                    <TextBlock VerticalAlignment="Center" Text="新增" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <ItemsControl x:Name="AgentAppWinItemsControl" ItemsSource="{Binding AgentAppWinItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AgentLineItem">
                  <Border Classes="Field">
                    <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,Auto">
                      <TextBox
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        PlaceholderText="例如：his-client.exe"
                        Text="{Binding Value}" />
                      <Button
                        Grid.Column="1"
                        Classes="Ghost"
                        Command="{Binding #Root.((vm:Settings)DataContext).RemoveAgentAppWinItemCommand}"
                        CommandParameter="{Binding .}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeSmall}"
                            Height="{DynamicResource IconSizeSmall}"
                            Kind="X" />
                          <TextBlock VerticalAlignment="Center" Text="移除" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="H2">
              <TextBlock Classes="Large H2Text" Text="门诊配置" />
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="窗口类" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="门诊窗口 Class 名称" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding AgentOptWindowClass}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="解析区 ClassNN" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="门诊表格解析区域控件标识" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding AgentOptParseGridClassNN}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="验证区 ClassNN" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="门诊表格验证区域控件标识" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding AgentOptVerifyGridClassNN}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="输入控件 ClassNN" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="门诊追溯码输入框控件标识" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding AgentOptInputClassNN}" />
              </Grid>
            </Border>

            <Border Classes="H2">
              <TextBlock Classes="Large H2Text" Text="住院配置" />
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="窗口类" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="住院窗口 Class 名称" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding AgentIptWindowClass}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="解析区 ClassNN" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="住院表格解析区域控件标识" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding AgentIptParseGridClassNN}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="验证区 ClassNN" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="住院表格验证区域控件标识" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding AgentIptVerifyGridClassNN}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="输入控件 ClassNN" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="住院追溯码输入框控件标识" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding AgentIptInputClassNN}" />
              </Grid>
            </Border>

            <Border Classes="H2">
              <TextBlock Classes="Large H2Text" Text="仓库配置" />
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="仓库模式" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="开启后从数据库任务队列取单注入" />
                </StackPanel>
                <ToggleSwitch
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding AgentWarehouseEnabled, Mode=TwoWay}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="任务标识" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="默认可填：单据号||当前编号" />
                </StackPanel>
                <TextBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding AgentWarehouseTaskIdentifier}" />
              </Grid>
            </Border>

            <Border Classes="Field">
              <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,1*">
                <StackPanel
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="FieldTitle" Text="取码策略" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="多层级追溯码选取规则" />
                </StackPanel>
                <ComboBox
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding AgentCodePickPolicyOptions}"
                  SelectedItem="{Binding SelectedAgentCodePickPolicyOption, Mode=TwoWay}" />
              </Grid>
            </Border>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Classes="Large H2Text" Text="仓库列特征" />
                  <TextBlock
                    Classes="Caption Muted FieldDesc"
                    Text="表头命中任一列名则判定为住院；均未命中则判定为仓库（默认：患者姓名、应扫次数）"
                    TextWrapping="Wrap" />
                </StackPanel>
                <Button
                  Grid.Column="1"
                  Classes="Outline"
                  Click="OnAutomationAddLineClicked"
                  Command="{Binding AddAgentWarehouseAnchorItemCommand}"
                  Tag="AgentWarehouseAnchorItemsControl">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="Plus" />
                    <TextBlock VerticalAlignment="Center" Text="新增" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <ItemsControl x:Name="AgentWarehouseAnchorItemsControl" ItemsSource="{Binding AgentWarehouseAnchorItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AgentLineItem">
                  <Border Classes="Field">
                    <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,Auto">
                      <TextBox
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        PlaceholderText="列名"
                        Text="{Binding Value}" />
                      <Button
                        Grid.Column="1"
                        Classes="Ghost"
                        Command="{Binding #Root.((vm:Settings)DataContext).RemoveAgentWarehouseAnchorItemCommand}"
                        CommandParameter="{Binding .}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeSmall}"
                            Height="{DynamicResource IconSizeSmall}"
                            Kind="X" />
                          <TextBlock VerticalAlignment="Center" Text="移除" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Classes="Large H2Text" Text="解析规则" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="表格列解析规则（ColSpecs），每行一条" />
                </StackPanel>
                <Button
                  Grid.Column="1"
                  Classes="Outline"
                  Click="OnAutomationAddLineClicked"
                  Command="{Binding AddAgentColSpecsItemCommand}"
                  Tag="AgentColSpecsItemsControl">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="Plus" />
                    <TextBlock VerticalAlignment="Center" Text="新增" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <ItemsControl x:Name="AgentColSpecsItemsControl" ItemsSource="{Binding AgentColSpecsItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AgentLineItem">
                  <Border Classes="Field">
                    <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,Auto">
                      <TextBox
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        PlaceholderText="列规则"
                        Text="{Binding Value}" />
                      <Button
                        Grid.Column="1"
                        Classes="Ghost"
                        Command="{Binding #Root.((vm:Settings)DataContext).RemoveAgentColSpecsItemCommand}"
                        CommandParameter="{Binding .}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeSmall}"
                            Height="{DynamicResource IconSizeSmall}"
                            Kind="X" />
                          <TextBlock VerticalAlignment="Center" Text="移除" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="H2">
              <Grid Classes="H2Row" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Classes="Large H2Text" Text="整数列" />
                  <TextBlock Classes="Caption Muted FieldDesc" Text="需要按整数解析的列名，每行一个" />
                </StackPanel>
                <Button
                  Grid.Column="1"
                  Classes="Outline"
                  Click="OnAutomationAddLineClicked"
                  Command="{Binding AddAgentIntColsItemCommand}"
                  Tag="AgentIntColsItemsControl">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="Plus" />
                    <TextBlock VerticalAlignment="Center" Text="新增" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <ItemsControl x:Name="AgentIntColsItemsControl" ItemsSource="{Binding AgentIntColsItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AgentLineItem">
                  <Border Classes="Field">
                    <Grid Classes="FieldSplit" ColumnDefinitions="1.35*,Auto">
                      <TextBox
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        PlaceholderText="列名"
                        Text="{Binding Value}" />
                      <Button
                        Grid.Column="1"
                        Classes="Ghost"
                        Command="{Binding #Root.((vm:Settings)DataContext).RemoveAgentIntColsItemCommand}"
                        CommandParameter="{Binding .}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeSmall}"
                            Height="{DynamicResource IconSizeSmall}"
                            Kind="X" />
                          <TextBlock VerticalAlignment="Center" Text="移除" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <Border
          VerticalAlignment="Top"
          Classes="StickyHost"
          IsHitTestVisible="False">
          <StackPanel x:Name="AutomationStickyHost" Spacing="0" />
        </Border>
      </Grid>

    </Panel>
  </Grid>
</UserControl>
