<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.MsfxLinkView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:PacToolkits.Desktop.Avalonia.Behaviors"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:pages="clr-namespace:PacToolkits.Desktop.Avalonia.Views.Pages"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:Name="Root"
  x:DataType="vm:MsfxLinkViewModel"
  ClipToBounds="True"
  Focusable="True">
  <controls:PageDataShell
    IsLoadingData="{Binding IsBusy}"
    ShowStale="{Binding IsShowingStaleData}"
    ShowUnavailable="{Binding ShowPageUnavailable}"
    StaleHint="{Binding PageStaleHint}"
    UnavailableHint="{Binding PageUnavailableHint}"
    UnavailableIcon="{Binding PageUnavailableIcon}"
    UnavailableTitle="{Binding PageUnavailableTitle}">
    <Grid
      Classes="PageRoot"
      RowDefinitions="Auto,*"
      RowSpacing="{DynamicResource FormRowSpacing}">

      <shad:Card Grid.Row="0">
        <Grid
          VerticalAlignment="Center"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="{DynamicResource PageColumnSpacing}">
          <Border Classes="HeroIconBadge">
            <icons:AppIcon Kind="CloudCog" />
          </Border>

          <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock Classes="SectionTitle" Text="码上放心联调" />
            <TextBlock Classes="Caption Muted" Text="上游出库单与子码链路联调" />
          </StackPanel>

          <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="{DynamicResource SpacingInlineMd}">
            <controls:StatusPill
              VerticalAlignment="Center"
              Classes="ToneInfo15"
              Icon="Link"
              Text="MSFX" />
            <controls:StatusPill
              VerticalAlignment="Center"
              Classes="ToneDone25"
              Icon="CircleCheck"
              Text="生产链路" />
          </StackPanel>
        </Grid>
      </shad:Card>

      <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem>
          <TabItem.Header>
            <StackPanel Classes="TabItemHeader" Spacing="{DynamicResource SpacingInlineMd}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeMini}"
                Height="{DynamicResource IconSizeMini}"
                Kind="Bot" />
              <TextBlock Text="自动化监控" />
            </StackPanel>
          </TabItem.Header>

          <Grid
            Margin="{DynamicResource MarginTopLg}"
            RowDefinitions="Auto,*"
            RowSpacing="{DynamicResource FormRowSpacing}">
            <Grid
              Grid.Row="0"
              RowDefinitions="Auto,Auto"
              RowSpacing="{DynamicResource DialogInnerRowSpacing}">
              <Grid
                Grid.Row="0"
                VerticalAlignment="Center"
                ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                ColumnSpacing="{DynamicResource PageColumnSpacing}">
                <shad:Card Grid.Column="0">
                  <Grid
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="{DynamicResource PageColumnSpacing}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      VerticalAlignment="Center"
                      Foreground="{Binding IsAutoEnabled, Converter={StaticResource BoolToDoneDangerBrush}}"
                      Kind="Power" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Classes="Caption Muted"
                      Text="自动监控" />
                    <ToggleSwitch
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsAutoEnabled, Mode=TwoWay}" />
                  </Grid>
                </shad:Card>

                <shad:Card Grid.Column="1">
                  <Grid
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="{DynamicResource SpacingInlineMd}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      Kind="Clock" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="轮询(分)" />
                    <NumericUpDown
                      Grid.Column="2"
                      Width="96"
                      Classes="MsfxInput"
                      FormatString="0"
                      Increment="5"
                      Maximum="720"
                      Minimum="1"
                      Value="{Binding AutoIntervalMinutes}" />
                  </Grid>
                </shad:Card>

                <shad:Card Grid.Column="2">
                  <Button
                    shad:ButtonAssist.ShowProgress="{Binding IsAutoBusy}"
                    Classes="Action"
                    Command="{Binding RunAutoOnceCommand}"
                    IsEnabled="{Binding !IsAutoBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeDefault}"
                        Height="{DynamicResource IconSizeDefault}"
                        Kind="CirclePlay" />
                      <TextBlock Text="立即巡检" />
                    </StackPanel>
                  </Button>
                </shad:Card>

                <shad:Card Grid.Column="3">
                  <Button Classes="Ghost" Command="{Binding ClearAutoLogsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeDefault}"
                        Height="{DynamicResource IconSizeDefault}"
                        Kind="Eraser" />
                      <TextBlock Text="清空日志" />
                    </StackPanel>
                  </Button>
                </shad:Card>

                <shad:Card
                  Grid.Column="4"
                  Padding="{StaticResource CompactPadding}"
                  HorizontalAlignment="Stretch"
                  Opacity="0.9">
                  <Grid
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="{DynamicResource SpacingInlineMd}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      VerticalAlignment="Center"
                      Foreground="{Binding AutoRiskState, Converter={StaticResource TraceEntryStateToFgBrush}}"
                      Kind="{Binding AutoRiskState, Converter={StaticResource TraceEntryStateToIconKind}}" />
                    <StackPanel
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Orientation="Horizontal"
                      Spacing="{DynamicResource SpacingInlineMd}">
                      <shad:Badge
                        VerticalAlignment="Center"
                        Classes="MsfxMetaBadge"
                        Content="{Binding AutoLogs.Count, StringFormat=日志 {0}}"
                        Variant="Secondary" />
                      <shad:Badge
                        VerticalAlignment="Center"
                        Classes="MsfxMetaBadge"
                        Content="{Binding AutoLastRunAtText, StringFormat=最近 {0}}"
                        ToolTip.Tip="{Binding AutoLastRunAtTip}"
                        Variant="Secondary" />
                    </StackPanel>
                    <Button
                      Grid.Column="2"
                      Classes="Ghost"
                      Command="{Binding RefreshAutoBoardCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeDefault}"
                          Height="{DynamicResource IconSizeDefault}"
                          Kind="RefreshCw" />
                        <TextBlock Text="刷新审计" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </shad:Card>
              </Grid>

              <shad:Card
                Grid.Row="1"
                Padding="10,8"
                IsVisible="{Binding ShowAutoProgressPanel}">
                <Grid
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="{DynamicResource PageColumnSpacing}"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="{DynamicResource DialogFormRowSpacing}">
                  <Border
                    Width="24"
                    Height="24"
                    Background="{Binding AutoRiskState, Converter={StaticResource TraceEntryStateToBgBrush}}"
                    CornerRadius="12">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Foreground="{Binding AutoRiskState, Converter={StaticResource TraceEntryStateToFgBrush}}"
                      Kind="{Binding AutoRiskState, Converter={StaticResource TraceEntryStateToIconKind}}" />
                  </Border>

                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Opacity="0.9"
                    Text="{Binding AutoStatus}"
                    TextTrimming="CharacterEllipsis" />

                  <StackPanel
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    MinWidth="108"
                    VerticalAlignment="Center"
                    Spacing="{DynamicResource SpacingInlineSm}">
                    <shad:Badge
                      VerticalAlignment="Center"
                      Classes="MsfxMetaBadge"
                      Content="{Binding AutoIntervalMinutes, StringFormat=轮询 {0} 分}"
                      Variant="Secondary" />
                    <shad:Badge
                      VerticalAlignment="Center"
                      Classes="MsfxMetaBadge"
                      Content="{Binding AutoRunProgressValue, StringFormat=进度 {0:F0}%}"
                      Variant="Secondary" />
                  </StackPanel>

                  <ProgressBar
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="6"
                    MinWidth="260"
                    VerticalAlignment="Center"
                    IsIndeterminate="False"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding AutoRunProgressValue}" />

                </Grid>
              </shad:Card>
            </Grid>
            <controls:MsfxAutoBoardHost
              x:Name="AutoBoardHost"
              Grid.Row="1"
              DataContext="{Binding}" />
          </Grid>
        </TabItem>

        <TabItem>
          <TabItem.Header>
            <StackPanel Classes="TabItemHeader" Spacing="{DynamicResource SpacingInlineMd}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeMini}"
                Height="{DynamicResource IconSizeMini}"
                Kind="ClipboardList" />
              <TextBlock Text="上游出库单查询" />
            </StackPanel>
          </TabItem.Header>

          <controls:DeferredContentHost IsActive="{Binding IsUpstreamTab}">
            <controls:DeferredContentHost.ContentTemplate>
              <DataTemplate>
                <pages:MsfxLinkUpstreamTabView />
              </DataTemplate>
            </controls:DeferredContentHost.ContentTemplate>
          </controls:DeferredContentHost>
        </TabItem>

        <TabItem>
          <TabItem.Header>
            <StackPanel Classes="TabItemHeader" Spacing="{DynamicResource SpacingInlineMd}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeMini}"
                Height="{DynamicResource IconSizeMini}"
                Kind="ScanBarcode" />
              <TextBlock Text="子码查询" />
            </StackPanel>
          </TabItem.Header>

          <controls:DeferredContentHost IsActive="{Binding IsSubcodeTab}">
            <controls:DeferredContentHost.ContentTemplate>
              <DataTemplate>
                <pages:MsfxLinkSubcodeTabView />
              </DataTemplate>
            </controls:DeferredContentHost.ContentTemplate>
          </controls:DeferredContentHost>
        </TabItem>
      </TabControl>
    </Grid>
  </controls:PageDataShell>
</UserControl>
