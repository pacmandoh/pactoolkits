<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.MsfxLinkView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:PacToolkits.Desktop.Avalonia.Behaviors"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
  xmlns:theme="clr-namespace:SukiUI.Theme;assembly=SukiUI"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:Name="Root"
  behaviors:FocusClearBehavior.Enable="True"
  x:DataType="vm:MsfxLinkViewModel"
  ClipToBounds="True"
  Focusable="True">
  <controls:PageDataShell
    IsLoadingData="{Binding IsBusy}"
    ShowStale="{Binding IsShowingStaleData}"
    ShowUnavailable="{Binding ShowPageUnavailable}"
    StaleHint="{Binding PageStaleHint}"
    UnavailableHint="{Binding PageUnavailableHint}"
    UnavailableIcon="{Binding PageUnavailableIcon}"
    UnavailableTitle="{Binding PageUnavailableTitle}">
    <Grid
      Classes="PageRoot"
      RowDefinitions="Auto,*"
      RowSpacing="{DynamicResource FormRowSpacing}">

      <suki:GlassCard Grid.Row="0" Classes="SectionCard PageHero">
        <Grid
          VerticalAlignment="Center"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="{DynamicResource PageColumnSpacing}">
          <Border Classes="HeroIconBadge">
            <icons:AppIcon Kind="CloudCog" />
          </Border>

          <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock Classes="SectionTitle" Text="码上放心联调" />
            <TextBlock Classes="SectionHint" Text="上游出库单与子码链路联调" />
          </StackPanel>

          <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="{DynamicResource SpacingInlineMd}">
            <controls:StatusPill
              VerticalAlignment="Center"
              Classes="ToneInfo15"
              Icon="Link"
              Text="MSFX" />
            <controls:StatusPill
              VerticalAlignment="Center"
              Classes="ToneDone25"
              Icon="CircleCheck"
              Text="生产链路" />
          </StackPanel>
        </Grid>
      </suki:GlassCard>

      <TabControl
        Grid.Row="1"
        Classes="DashboardSubTabs"
        SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeMini}"
                Height="{DynamicResource IconSizeMini}"
                Kind="Bot" />
              <TextBlock Text="自动化监控" />
            </StackPanel>
          </TabItem.Header>

          <Grid
            Margin="{DynamicResource MarginTopLg}"
            RowDefinitions="Auto,*"
            RowSpacing="{DynamicResource FormRowSpacing}">
            <Grid
              Grid.Row="0"
              RowDefinitions="Auto,Auto"
              RowSpacing="{DynamicResource DialogInnerRowSpacing}">
              <Grid
                Grid.Row="0"
                VerticalAlignment="Center"
                ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                ColumnSpacing="{DynamicResource PageColumnSpacing}">
                <suki:GlassCard Grid.Column="0" Classes="CompactCard">
                  <Grid
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="{DynamicResource PageColumnSpacing}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      VerticalAlignment="Center"
                      Foreground="{Binding IsAutoEnabled, Converter={StaticResource BoolToDoneDangerBrush}}"
                      Kind="Power" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Opacity="0.82"
                      Text="自动监控" />
                    <ToggleSwitch
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsAutoEnabled, Mode=TwoWay}" />
                  </Grid>
                </suki:GlassCard>

                <suki:GlassCard Grid.Column="1" Classes="CompactCard">
                  <Grid
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="{DynamicResource SpacingInlineMd}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      Kind="Clock" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="轮询(分)" />
                    <NumericUpDown
                      Grid.Column="2"
                      Width="96"
                      Classes="MsfxInput"
                      FormatString="0"
                      Increment="5"
                      Maximum="720"
                      Minimum="1"
                      Value="{Binding AutoIntervalMinutes}" />
                  </Grid>
                </suki:GlassCard>

                <suki:GlassCard Grid.Column="2" Classes="CompactCard">
                  <Button
                    theme:ButtonExtensions.ShowProgress="{Binding IsAutoBusy}"
                    Classes="Action"
                    Command="{Binding RunAutoOnceCommand}"
                    IsEnabled="{Binding !IsAutoBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeDefault}"
                        Height="{DynamicResource IconSizeDefault}"
                        Kind="CirclePlay" />
                      <TextBlock Text="立即巡检" />
                    </StackPanel>
                  </Button>
                </suki:GlassCard>

                <suki:GlassCard Grid.Column="3" Classes="CompactCard">
                  <Button Classes="Ghost" Command="{Binding ClearAutoLogsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeDefault}"
                        Height="{DynamicResource IconSizeDefault}"
                        Kind="Eraser" />
                      <TextBlock Text="清空日志" />
                    </StackPanel>
                  </Button>
                </suki:GlassCard>

                <suki:GlassCard
                  Grid.Column="4"
                  Padding="{StaticResource CompactPadding}"
                  HorizontalAlignment="Stretch"
                  Opacity="0.9">
                  <Grid
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="{DynamicResource SpacingInlineMd}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      VerticalAlignment="Center"
                      Foreground="{Binding AutoRiskState, Converter={StaticResource TraceEntryStateToFgBrush}}"
                      Kind="{Binding AutoRiskState, Converter={StaticResource TraceEntryStateToIconKind}}" />
                    <StackPanel
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Orientation="Horizontal"
                      Spacing="{DynamicResource SpacingInlineMd}">
                      <suki:InfoBadge
                        VerticalAlignment="Center"
                        Classes="MsfxMetaBadge"
                        Content="{Binding AutoLogs.Count, StringFormat=日志 {0}}" />
                      <suki:InfoBadge
                        VerticalAlignment="Center"
                        Classes="MsfxMetaBadge"
                        Content="{Binding AutoLastRunAtText, StringFormat=最近 {0}}" />
                    </StackPanel>
                    <Button
                      Grid.Column="2"
                      Classes="Ghost"
                      Command="{Binding RefreshAutoBoardCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeDefault}"
                          Height="{DynamicResource IconSizeDefault}"
                          Kind="RefreshCw" />
                        <TextBlock Text="刷新审计" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </suki:GlassCard>
              </Grid>

              <suki:GlassCard
                Grid.Row="1"
                Padding="10,8"
                IsVisible="{Binding ShowAutoProgressPanel}">
                <Grid
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="{DynamicResource PageColumnSpacing}"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="{DynamicResource DialogFormRowSpacing}">
                  <Border
                    Width="24"
                    Height="24"
                    Background="{Binding AutoRiskState, Converter={StaticResource TraceEntryStateToBgBrush}}"
                    CornerRadius="12">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Foreground="{Binding AutoRiskState, Converter={StaticResource TraceEntryStateToFgBrush}}"
                      Kind="{Binding AutoRiskState, Converter={StaticResource TraceEntryStateToIconKind}}" />
                  </Border>

                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Opacity="0.9"
                    Text="{Binding AutoStatus}"
                    TextTrimming="CharacterEllipsis" />

                  <StackPanel
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    MinWidth="108"
                    VerticalAlignment="Center"
                    Spacing="{DynamicResource SpacingInlineSm}">
                    <suki:InfoBadge
                      VerticalAlignment="Center"
                      Classes="MsfxMetaBadge"
                      Content="{Binding AutoIntervalMinutes, StringFormat=轮询 {0} 分}" />
                    <suki:InfoBadge
                      VerticalAlignment="Center"
                      Classes="MsfxMetaBadge"
                      Content="{Binding AutoRunProgressValue, StringFormat=进度 {0:F0}%}" />
                  </StackPanel>

                  <ProgressBar
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="6"
                    MinWidth="260"
                    VerticalAlignment="Center"
                    IsIndeterminate="False"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding AutoRunProgressValue}" />

                </Grid>
              </suki:GlassCard>
            </Grid>
            <Grid
              Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="{DynamicResource PageColumnSpacing}"
              RowDefinitions="*,*"
              RowSpacing="{DynamicResource FormRowSpacing}">
              <Grid
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                ColumnDefinitions="*,*"
                ColumnSpacing="{DynamicResource PageColumnSpacing}"
                IsVisible="{Binding !IsAutoExpanded}"
                RowDefinitions="*,*"
                RowSpacing="{DynamicResource FormRowSpacing}">
                <suki:GlassCard
                  Grid.Row="0"
                  Grid.Column="0"
                  Classes="SectionCard CompactCard">
                  <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource PageColumnSpacing}">
                      <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingInlineMd}">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeDefault}"
                          Height="{DynamicResource IconSizeDefault}"
                          Foreground="{Binding AutoPullState, Converter={StaticResource TraceEntryStateToFgBrush}}"
                          Kind="{Binding AutoPullState, Converter={StaticResource TraceEntryStateToIconKind}}" />
                        <TextBlock
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Opacity="0.9"
                          Text="拉取批次明细" />
                        <TextBlock
                          VerticalAlignment="Center"
                          Classes="SectionHint"
                          Text="{Binding AutoPullSummary}" />
                      </StackPanel>
                      <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingInlineSm}">
                        <suki:InfoBadge VerticalAlignment="Center" Content="{Binding AutoPullBatchRows.Count, StringFormat=共 {0} 条}" />
                        <Button
                          Classes="Ghost MsfxMiniIconBtn"
                          Command="{Binding ToggleAutoPanelExpandCommand}"
                          CommandParameter="PULL">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeCompact}"
                            Height="{DynamicResource IconSizeCompact}"
                            Kind="Fullscreen" />
                        </Button>
                      </StackPanel>
                    </Grid>
                    <suki:BusyArea
                      Grid.Row="1"
                      BusyText="加载中..."
                      IsBusy="{Binding IsPullPanelBusy}">
                      <controls:EmptyStatePanel
                        EmptyHint="执行一次巡检后查看最近批次详情"
                        EmptyText="暂无拉取批次数据"
                        IsEmpty="{Binding IsAutoPullBatchEmpty}">
                        <DataGrid
                          x:Name="AutoPullBatchGrid"
                          Classes="SectionGrid InventoryGrid LowToneGrid TraceStateGrid MsfxIndexedGrid"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          HorizontalScrollBarVisibility="Auto"
                          ItemsSource="{Binding AutoPullBatchRows}"
                          SelectedItem="{Binding SelectedAutoPullBatchRow, Mode=TwoWay}">
                          <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <Border
                                    Width="24"
                                    Height="24"
                                    Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                                    CornerRadius="12">
                                    <icons:AppIcon
                                      Width="{DynamicResource IconSizeSmall}"
                                      Height="{DynamicResource IconSizeSmall}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                                      Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                                  </Border>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                              Width="110"
                              Binding="{Binding BatchId}"
                              Header="批次ID" />
                            <DataGridTextColumn
                              Width="120"
                              Binding="{Binding SourceApi}"
                              Header="源接口" />
                            <DataGridTextColumn
                              Width="220"
                              Binding="{Binding Window}"
                              Header="日期窗口" />
                            <DataGridTextColumn
                              Width="100"
                              Binding="{Binding Status}"
                              Header="状态" />
                            <DataGridTextColumn
                              Width="80"
                              Binding="{Binding SuccessCount}"
                              Header="成功" />
                            <DataGridTextColumn
                              Width="80"
                              Binding="{Binding FailCount}"
                              Header="失败" />
                            <DataGridTextColumn
                              Width="165"
                              Binding="{Binding StartedAt}"
                              Header="开始时间" />
                            <DataGridTextColumn
                              Width="165"
                              Binding="{Binding FinishedAt}"
                              Header="结束时间" />
                            <DataGridTextColumn
                              Width="260"
                              Binding="{Binding ErrMsg}"
                              Header="错误信息" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </controls:EmptyStatePanel>
                    </suki:BusyArea>
                  </Grid>
                </suki:GlassCard>

                <suki:GlassCard
                  Grid.Row="0"
                  Grid.Column="1"
                  Classes="SectionCard CompactCard">
                  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource PageColumnSpacing}">
                      <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingInlineMd}">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeDefault}"
                          Height="{DynamicResource IconSizeDefault}"
                          Foreground="{Binding AutoMapState, Converter={StaticResource TraceEntryStateToFgBrush}}"
                          Kind="{Binding AutoMapState, Converter={StaticResource TraceEntryStateToIconKind}}" />
                        <TextBlock
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Opacity="0.9"
                          Text="映射结果队列" />
                        <TextBlock
                          VerticalAlignment="Center"
                          Classes="SectionHint"
                          Text="{Binding AutoMapSummary}" />
                      </StackPanel>
                      <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingInlineSm}">
                        <Button Classes="Ghost MsfxMiniIconBtn" Command="{Binding OpenMapBatchDialogCommand}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeCompact}"
                            Height="{DynamicResource IconSizeCompact}"
                            Kind="Table2" />
                        </Button>
                        <Button
                          Classes="Ghost MsfxMiniIconBtn"
                          Command="{Binding ToggleAutoPanelExpandCommand}"
                          CommandParameter="MAP">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeCompact}"
                            Height="{DynamicResource IconSizeCompact}"
                            Kind="Fullscreen" />
                        </Button>
                      </StackPanel>
                    </Grid>
                    <Grid
                      Grid.Row="1"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
                      ColumnSpacing="{DynamicResource SpacingInlineMd}"
                      IsVisible="False">
                      <suki:InfoBadge VerticalAlignment="Center" Content="{Binding MapQueueDisplayText}" />
                      <suki:InfoBadge
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="{Binding MapQueueRangeText}" />
                      <ComboBox
                        Grid.Column="2"
                        Height="{StaticResource ControlHeightCompact}"
                        MinWidth="86"
                        ItemsSource="{Binding MapQueuePageSizeOptions}"
                        SelectedItem="{Binding MapQueuePageSize, Mode=TwoWay}" />
                      <ComboBox
                        Grid.Column="3"
                        Height="{StaticResource ControlHeightCompact}"
                        MinWidth="120"
                        ItemsSource="{Binding MapStatusFilterOptions}"
                        SelectedItem="{Binding MapQueueMapStatusFilter, Mode=TwoWay}" />
                      <ComboBox
                        Grid.Column="4"
                        Height="{StaticResource ControlHeightCompact}"
                        MinWidth="120"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding CodeStatusFilterOptions}"
                        SelectedItem="{Binding MapQueueCodeStatusFilter, Mode=TwoWay}" />
                      <Button
                        Grid.Column="5"
                        Height="{StaticResource ControlHeightCompact}"
                        Classes="Ghost"
                        Command="{Binding PrevMapQueuePageCommand}"
                        IsEnabled="{Binding HasMapQueuePrevPage}">
                        <TextBlock Text="上页" />
                      </Button>
                      <Button
                        Grid.Column="6"
                        Height="{StaticResource ControlHeightCompact}"
                        Classes="Ghost"
                        Command="{Binding NextMapQueuePageCommand}"
                        IsEnabled="{Binding HasMapQueueNextPage}">
                        <TextBlock Text="下页" />
                      </Button>
                    </Grid>
                    <suki:BusyArea
                      Grid.Row="2"
                      BusyText="加载中..."
                      IsBusy="{Binding IsMapPanelBusy}">
                      <controls:EmptyStatePanel
                        EmptyHint="待映射、需人工、失败和待下发记录将显示在这里"
                        EmptyText="暂无映射队列数据"
                        IsEmpty="{Binding IsAutoMapQueueEmpty}">
                        <DataGrid
                          x:Name="AutoMapQueueGrid"
                          Classes="SectionGrid InventoryGrid LowToneGrid TraceStateGrid MsfxIndexedGrid CellTemplateHighlightGrid MapIndexedGrid"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          HorizontalScrollBarVisibility="Auto"
                          ItemsSource="{Binding AutoMapQueueRows}"
                          SelectedItem="{Binding SelectedAutoMapQueueRow, Mode=TwoWay}">
                          <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <Border
                                    Width="24"
                                    Height="24"
                                    Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                                    CornerRadius="12">
                                    <icons:AppIcon
                                      Width="{DynamicResource IconSizeSmall}"
                                      Height="{DynamicResource IconSizeSmall}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                                      Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                                  </Border>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                              Width="120"
                              Binding="{Binding SourceBillTime}"
                              Header="单据时间" />
                            <DataGridTextColumn
                              Width="220"
                              Binding="{Binding SourceBillCode}"
                              Header="单据编码" />
                            <DataGridTextColumn
                              Width="140"
                              Binding="{Binding ProduceBatchNo}"
                              Header="批号" />
                            <DataGridTextColumn
                              Width="220"
                              Binding="{Binding LeafCode}"
                              Header="最小包装码" />
                            <DataGridTextColumn
                              Width="200"
                              Binding="{Binding SourceDrugNameRaw}"
                              Header="药名(原始)" />
                            <DataGridTextColumn
                              Width="180"
                              Binding="{Binding SourceSpecRaw}"
                              Header="规格(原始)" />
                            <DataGridTextColumn
                              Width="180"
                              Binding="{Binding SourceNameNorm}"
                              Header="药名(归一化)" />
                            <DataGridTextColumn
                              Width="180"
                              Binding="{Binding SourceSpecNorm}"
                              Header="规格(归一化)" />
                            <DataGridTextColumn
                              Width="180"
                              Binding="{Binding SourceCodeLevel1}"
                              Header="一级码" />
                            <DataGridTextColumn
                              Width="180"
                              Binding="{Binding SourceCodeLevel2}"
                              Header="二级码" />
                            <DataGridTextColumn
                              Width="180"
                              Binding="{Binding SourceCodeLevel3}"
                              Header="三级码" />
                            <DataGridTextColumn
                              Width="180"
                              Binding="{Binding SourceCodeLevel4}"
                              Header="四级码" />
                            <DataGridTextColumn
                              Width="180"
                              Binding="{Binding SourceCodeLevel5}"
                              Header="五级码" />
                            <DataGridTextColumn
                              Width="160"
                              Binding="{Binding MapReasonCode}"
                              Header="原因编码" />
                            <DataGridTextColumn
                              Width="240"
                              Binding="{Binding MapReasonDetail}"
                              Header="原因详情" />
                            <DataGridTextColumn
                              Width="160"
                              Binding="{Binding MappedDrugId}"
                              Header="映射药品ID" />
                            <DataGridTextColumn
                              Width="160"
                              Binding="{Binding MappedSpec}"
                              Header="映射规格" />
                            <DataGridTextColumn
                              Width="130"
                              Binding="{Binding MapStatus}"
                              Header="映射状态" />
                            <DataGridTextColumn
                              Width="120"
                              Binding="{Binding CodeStatus}"
                              Header="码状态" />
                            <DataGridTextColumn
                              Width="170"
                              Binding="{Binding UpdatedAt}"
                              Header="更新时间" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </controls:EmptyStatePanel>
                    </suki:BusyArea>
                  </Grid>
                </suki:GlassCard>

                <suki:GlassCard
                  Grid.Row="1"
                  Grid.Column="0"
                  Classes="SectionCard CompactCard">
                  <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource PageColumnSpacing}">
                        <StackPanel
                          VerticalAlignment="Center"
                          Orientation="Horizontal"
                          Spacing="{DynamicResource SpacingInlineMd}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeDefault}"
                            Height="{DynamicResource IconSizeDefault}"
                            Foreground="{Binding AutoTaskState, Converter={StaticResource TraceEntryStateToFgBrush}}"
                            Kind="{Binding AutoTaskState, Converter={StaticResource TraceEntryStateToIconKind}}" />
                          <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Opacity="0.9"
                            Text="Agent 执行队列" />
                        </StackPanel>
                        <StackPanel
                          Grid.Column="2"
                          VerticalAlignment="Center"
                          IsVisible="{Binding !IsTaskQueueBatchModeActive}"
                          Orientation="Horizontal"
                          Spacing="{DynamicResource SpacingInlineSm}">
                          <Button
                            behaviors:FocusClearBehavior.SuppressGridClear="True"
                            Classes="Ghost MsfxMiniIconBtn"
                            Command="{Binding BeginMergeTaskSelectionCommand}"
                            IsEnabled="{Binding CanEnterTaskMergeMode}"
                            ToolTip.Tip="合并同药名同规格任务">
                            <icons:AppIcon
                              Width="{DynamicResource IconSizeCompact}"
                              Height="{DynamicResource IconSizeCompact}"
                              Kind="GitMerge" />
                          </Button>
                          <Button
                            behaviors:FocusClearBehavior.SuppressGridClear="True"
                            Classes="Ghost MsfxMiniIconBtn"
                            Command="{Binding SplitSelectedTaskCommand}"
                            IsEnabled="{Binding CanSplitSelectedTasks}"
                            ToolTip.Tip="拆分当前任务">
                            <icons:AppIcon
                              Width="{DynamicResource IconSizeCompact}"
                              Height="{DynamicResource IconSizeCompact}"
                              Kind="GitBranch" />
                          </Button>
                          <Button
                            behaviors:FocusClearBehavior.SuppressGridClear="True"
                            Classes="Ghost MsfxMiniIconBtn"
                            Command="{Binding BeginRemapTaskSelectionCommand}"
                            IsEnabled="{Binding CanEnterTaskRemapMode}"
                            ToolTip.Tip="重新映射选中任务">
                            <icons:AppIcon
                              Width="{DynamicResource IconSizeCompact}"
                              Height="{DynamicResource IconSizeCompact}"
                              Kind="Undo2" />
                          </Button>
                          <Button
                            behaviors:FocusClearBehavior.SuppressGridClear="True"
                            Classes="Ghost MsfxMiniIconBtn"
                            Command="{Binding BeginDiscardTaskSelectionCommand}"
                            IsEnabled="{Binding CanEnterTaskDiscardMode}"
                            ToolTip.Tip="弃用选中任务">
                            <icons:AppIcon
                              Width="{DynamicResource IconSizeCompact}"
                              Height="{DynamicResource IconSizeCompact}"
                              Kind="Ban" />
                          </Button>
                          <Button
                            behaviors:FocusClearBehavior.SuppressGridClear="True"
                            Classes="Ghost MsfxMiniIconBtn"
                            Command="{Binding BeginReopenTaskSelectionCommand}"
                            IsEnabled="{Binding CanEnterTaskReopenMode}"
                            ToolTip.Tip="重开选中任务">
                            <icons:AppIcon
                              Width="{DynamicResource IconSizeCompact}"
                              Height="{DynamicResource IconSizeCompact}"
                              Kind="RotateCcw" />
                          </Button>
                          <Button
                            behaviors:FocusClearBehavior.SuppressGridClear="True"
                            Classes="Ghost MsfxMiniIconBtn"
                            Command="{Binding ToggleAutoPanelExpandCommand}"
                            CommandParameter="TASK"
                            ToolTip.Tip="全屏查看执行队列">
                            <icons:AppIcon
                              Width="{DynamicResource IconSizeCompact}"
                              Height="{DynamicResource IconSizeCompact}"
                              Kind="Fullscreen" />
                          </Button>
                        </StackPanel>
                        <Grid
                          Grid.Column="2"
                          VerticalAlignment="Center"
                          ColumnDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="{DynamicResource SpacingInlineMd}"
                          IsVisible="{Binding IsTaskQueueBatchModeActive}">
                          <TextBlock
                            VerticalAlignment="Center"
                            Opacity="0.82"
                            Text="{Binding TaskQueueBatchModeTitle}" />
                          <Button
                            Grid.Column="1"
                            Classes="Action"
                            Command="{Binding ConfirmTaskQueueBatchActionCommand}"
                            IsEnabled="{Binding CanConfirmTaskQueueBatchAction}">
                            <TextBlock Text="{Binding TaskQueueBatchConfirmText}" />
                          </Button>
                          <Button
                            Grid.Column="2"
                            Classes="Ghost"
                            Command="{Binding CancelTaskQueueBatchSelectionCommand}">
                            <TextBlock Text="取消" />
                          </Button>
                        </Grid>
                      </Grid>
                      <TextBlock
                        Grid.Row="1"
                        Margin="{DynamicResource MarginBottomMd}"
                        Classes="SectionHint"
                        IsVisible="{Binding IsTaskQueueBatchModeActive}"
                        Text="{Binding TaskQueueBatchModeHint}" />
                      <WrapPanel
                        Grid.Row="2"
                        ItemSpacing="{DynamicResource SpacingInlineMd}"
                        LineSpacing="{DynamicResource SpacingInlineSm}">
                        <controls:StatusPill
                          Classes="ToneWarning15"
                          Icon="CircleDot"
                          IconSize="12"
                          PillPadding="8,3"
                          Text="{Binding AutoTaskNewCount, StringFormat=待执行 {0}}"
                          TextSize="11" />
                        <controls:StatusPill
                          Classes="ToneInfo15"
                          Icon="LoaderCircle"
                          IconSize="12"
                          PillPadding="8,3"
                          Text="{Binding AutoTaskRunningCount, StringFormat=运行中 {0}}"
                          TextSize="11" />
                        <controls:StatusPill
                          Classes="ToneDone15"
                          Icon="CircleCheck"
                          IconSize="12"
                          PillPadding="8,3"
                          Text="{Binding AutoTaskSuccessCount, StringFormat=成功 {0}}"
                          TextSize="11" />
                        <controls:StatusPill
                          Classes="ToneDanger15"
                          Icon="TriangleAlert"
                          IconSize="12"
                          PillPadding="8,3"
                          Text="{Binding AutoTaskFailedCount, StringFormat=失败 {0}}"
                          TextSize="11" />
                        <controls:StatusPill
                          Classes="TonePurple15"
                          Icon="Ban"
                          IconSize="12"
                          PillPadding="8,3"
                          Text="{Binding AutoTaskDiscardedCount, StringFormat=弃用 {0}}"
                          TextSize="11" />
                      </WrapPanel>
                    </Grid>
                    <suki:BusyArea
                      Grid.Row="1"
                      BusyText="加载中..."
                      IsBusy="{Binding IsTaskPanelBusy}">
                      <controls:EmptyStatePanel
                        EmptyHint="仅 MAPPED + NEW 的码会创建任务"
                        EmptyText="暂无 Agent 任务队列"
                        IsEmpty="{Binding IsAutoTaskQueueEmpty}">
                        <DataGrid
                          x:Name="AutoTaskQueueGrid"
                          Classes="SectionGrid InventoryGrid LowToneGrid TraceStateGrid MsfxIndexedGrid CellTemplateHighlightGrid"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          HorizontalScrollBarVisibility="Auto"
                          ItemsSource="{Binding AutoTaskQueueRows}"
                          SelectedItem="{Binding SelectedAutoTaskQueueRow, Mode=TwoWay}"
                          SelectionChanged="OnTaskQueueSelectionChanged"
                          SelectionMode="Single">
                          <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" IsVisible="{Binding #AutoTaskQueueGrid.((vm:MsfxLinkViewModel)DataContext).IsTaskQueueBatchModeActive}">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <CheckBox
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      IsCheckedChanged="OnTaskQueueCheckChanged" />
                                  </Grid>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="44">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <Border
                                    Width="24"
                                    Height="24"
                                    Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                                    CornerRadius="12">
                                    <icons:AppIcon
                                      Width="{DynamicResource IconSizeSmall}"
                                      Height="{DynamicResource IconSizeSmall}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                                      Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                                  </Border>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                              Width="110"
                              Binding="{Binding TaskId}"
                              Header="任务ID" />
                            <DataGridTextColumn
                              Width="220"
                              Binding="{Binding SourceBillCode}"
                              Header="单据编码" />
                            <DataGridTextColumn
                              Width="180"
                              Binding="{Binding BatchNos}"
                              Header="批号" />
                            <DataGridTextColumn
                              Width="260"
                              Binding="{Binding Target}"
                              Header="目标药品/规格" />
                            <DataGridTextColumn
                              Width="100"
                              Binding="{Binding Status}"
                              Header="状态" />
                            <DataGridTextColumn
                              Width="170"
                              Binding="{Binding Progress}"
                              Header="进度" />
                            <DataGridTextColumn
                              Width="70"
                              Binding="{Binding RetryCount}"
                              Header="重试" />
                            <DataGridTextColumn
                              Width="160"
                              Binding="{Binding CreatedAt}"
                              Header="创建时间" />
                            <DataGridTextColumn
                              Width="160"
                              Binding="{Binding PickedAt}"
                              Header="抢占时间" />
                            <DataGridTextColumn
                              Width="165"
                              Binding="{Binding FinishedAt}"
                              Header="完成时间" />
                            <DataGridTextColumn
                              Width="260"
                              Binding="{Binding ErrMsg}"
                              Header="错误信息" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </controls:EmptyStatePanel>
                    </suki:BusyArea>
                  </Grid>
                </suki:GlassCard>

                <suki:GlassCard
                  Grid.Row="1"
                  Grid.Column="1"
                  Classes="SectionCard CompactCard">
                  <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource PageColumnSpacing}">
                      <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingInlineMd}">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeDefault}"
                          Height="{DynamicResource IconSizeDefault}"
                          Kind="TextSearch" />
                        <TextBlock
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Opacity="0.9"
                          Text="自动化运行审计日志" />
                      </StackPanel>
                      <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingInlineSm}">
                        <suki:InfoBadge VerticalAlignment="Center" Content="{Binding AutoLogs.Count, StringFormat=共 {0} 条}" />
                        <Button
                          Classes="Ghost MsfxMiniIconBtn"
                          Command="{Binding ToggleAutoPanelExpandCommand}"
                          CommandParameter="LOG">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeCompact}"
                            Height="{DynamicResource IconSizeCompact}"
                            Kind="Fullscreen" />
                        </Button>
                      </StackPanel>
                    </Grid>

                    <controls:EmptyStatePanel
                      Grid.Row="1"
                      EmptyHint="点击“立即巡检”或开启自动监控后将显示执行日志"
                      EmptyText="暂无自动化日志"
                      IsEmpty="{Binding IsAutoLogsEmpty}">
                      <DataGrid
                        x:Name="AutoLogGrid"
                        Classes="SectionGrid InventoryGrid LowToneGrid TraceStateGrid MsfxIndexedGrid"
                        ColumnWidth="*"
                        GridLinesVisibility="All"
                        HeadersVisibility="All"
                        HorizontalScrollBarVisibility="Auto"
                        ItemsSource="{Binding AutoLogs}"
                        SelectedItem="{Binding SelectedAutoLogRow, Mode=TwoWay}">
                        <DataGrid.Columns>
                          <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <Border
                                  Width="24"
                                  Height="24"
                                  Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                                  CornerRadius="12">
                                  <icons:AppIcon
                                    Width="{DynamicResource IconSizeSmall}"
                                    Height="{DynamicResource IconSizeSmall}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                                    Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                                </Border>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn
                            Width="140"
                            Binding="{Binding At}"
                            Header="时间" />
                          <DataGridTextColumn
                            Width="160"
                            Binding="{Binding Stage}"
                            Header="流程阶段" />
                          <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Message}"
                            Header="详细信息" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </controls:EmptyStatePanel>
                  </Grid>
                </suki:GlassCard>
              </Grid>

              <suki:GlassCard
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Classes="SectionCard CompactCard"
                IsVisible="{Binding IsAutoExpanded}">
                <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource PageColumnSpacing}">
                    <StackPanel
                      VerticalAlignment="Center"
                      Orientation="Horizontal"
                      Spacing="{DynamicResource SpacingInlineMd}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeDefault}"
                        Height="{DynamicResource IconSizeDefault}"
                        Kind="{Binding AutoExpandedPanelIcon}" />
                      <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Opacity="0.9"
                        Text="{Binding AutoExpandedPanelTitle}" />
                    </StackPanel>
                    <StackPanel
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Orientation="Horizontal"
                      Spacing="{DynamicResource SpacingInlineSm}">
                      <Button
                        Height="{StaticResource ControlHeightCompact}"
                        MinWidth="110"
                        Classes="Action"
                        Command="{Binding OpenMapBatchDialogCommand}"
                        IsVisible="{Binding IsMapPanelExpanded}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeCompact}"
                            Height="{DynamicResource IconSizeCompact}"
                            Kind="Table2" />
                          <TextBlock Text="批量映射" />
                        </StackPanel>
                      </Button>
                      <Button
                        Height="{StaticResource ControlHeightCompact}"
                        MinWidth="110"
                        behaviors:FocusClearBehavior.SuppressGridClear="True"
                        Classes="Action"
                        Command="{Binding BeginMergeTaskSelectionCommand}"
                        IsEnabled="{Binding CanEnterTaskMergeMode}"
                        IsVisible="{Binding IsTaskPanelExpanded}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeCompact}"
                            Height="{DynamicResource IconSizeCompact}"
                            Kind="GitMerge" />
                          <TextBlock Text="合并任务" />
                        </StackPanel>
                      </Button>
                      <Button
                        Height="{StaticResource ControlHeightCompact}"
                        MinWidth="110"
                        behaviors:FocusClearBehavior.SuppressGridClear="True"
                        Classes="Action"
                        Command="{Binding SplitSelectedTaskCommand}"
                        IsEnabled="{Binding CanSplitSelectedTasks}"
                        IsVisible="{Binding IsTaskPanelExpanded}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeCompact}"
                            Height="{DynamicResource IconSizeCompact}"
                            Kind="GitBranch" />
                          <TextBlock Text="拆分任务" />
                        </StackPanel>
                      </Button>
                      <Button
                        Height="{StaticResource ControlHeightCompact}"
                        MinWidth="110"
                        behaviors:FocusClearBehavior.SuppressGridClear="True"
                        Classes="Action"
                        Command="{Binding BeginRemapTaskSelectionCommand}"
                        IsEnabled="{Binding CanEnterTaskRemapMode}"
                        IsVisible="{Binding IsTaskPanelExpanded}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeCompact}"
                            Height="{DynamicResource IconSizeCompact}"
                            Kind="Undo2" />
                          <TextBlock Text="重新映射" />
                        </StackPanel>
                      </Button>
                      <Button
                        Height="{StaticResource ControlHeightCompact}"
                        MinWidth="110"
                        behaviors:FocusClearBehavior.SuppressGridClear="True"
                        Classes="Action"
                        Command="{Binding BeginDiscardTaskSelectionCommand}"
                        IsEnabled="{Binding CanEnterTaskDiscardMode}"
                        IsVisible="{Binding IsTaskPanelExpanded}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeCompact}"
                            Height="{DynamicResource IconSizeCompact}"
                            Kind="Ban" />
                          <TextBlock Text="弃用" />
                        </StackPanel>
                      </Button>
                      <Button
                        Height="{StaticResource ControlHeightCompact}"
                        MinWidth="110"
                        behaviors:FocusClearBehavior.SuppressGridClear="True"
                        Classes="Action"
                        Command="{Binding BeginReopenTaskSelectionCommand}"
                        IsEnabled="{Binding CanEnterTaskReopenMode}"
                        IsVisible="{Binding IsTaskPanelExpanded}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeCompact}"
                            Height="{DynamicResource IconSizeCompact}"
                            Kind="RotateCcw" />
                          <TextBlock Text="重启任务" />
                        </StackPanel>
                      </Button>
                      <Button
                        Width="40"
                        Height="{StaticResource ControlHeightCompact}"
                        MinWidth="40"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Classes="Action"
                        Command="{Binding ToggleTaskQueueSearchPanelCommand}"
                        IsVisible="{Binding IsTaskPanelExpanded}"
                        ToolTip.Tip="显示/隐藏执行队列搜索">
                        <Panel
                          Width="{DynamicResource IconSizeDefault}"
                          Height="{DynamicResource IconSizeDefault}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeSmall}"
                            Height="{DynamicResource IconSizeSmall}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !IsTaskQueueSearchPanelVisible}"
                            Kind="Search" />
                          <icons:AppIcon
                            Width="{DynamicResource IconSizeSmall}"
                            Height="{DynamicResource IconSizeSmall}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsTaskQueueSearchPanelVisible}"
                            Kind="SearchX" />
                        </Panel>
                      </Button>
                      <Button
                        Width="{StaticResource ControlHeightCompact}"
                        Height="{StaticResource ControlHeightCompact}"
                        MinWidth="{StaticResource ControlHeightCompact}"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        behaviors:FocusClearBehavior.SuppressGridClear="True"
                        Classes="Ghost"
                        Command="{Binding ToggleAutoPanelExpandCommand}"
                        CommandParameter="{Binding AutoExpandedPanel}">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeCompact}"
                          Height="{DynamicResource IconSizeCompact}"
                          Kind="Minimize" />
                      </Button>
                    </StackPanel>
                  </Grid>

                  <Grid
                    Grid.Row="1"
                    IsVisible="{Binding IsPullPanelExpanded}"
                    RowDefinitions="Auto,*"
                    RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                    <Grid ColumnDefinitions="Auto,*,Auto,120,Auto,Auto" ColumnSpacing="{DynamicResource SpacingInlineMd}">
                      <TextBlock
                        VerticalAlignment="Center"
                        Classes="SectionHint"
                        Text="{Binding PullBatchPageText}" />
                      <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Opacity="0.8"
                        Text="每页" />
                      <ComboBox
                        Grid.Column="3"
                        Height="{StaticResource ControlHeightCompact}"
                        MinWidth="120"
                        ItemsSource="{Binding PullBatchPageSizeOptions}"
                        SelectedItem="{Binding PullBatchPageSize, Mode=TwoWay}" />
                      <Button
                        Grid.Column="4"
                        Height="{StaticResource ControlHeightCompact}"
                        Classes="Ghost"
                        Command="{Binding PrevPullBatchPageCommand}"
                        IsEnabled="{Binding HasPullBatchPrevPage}">
                        <TextBlock Text="上页" />
                      </Button>
                      <Button
                        Grid.Column="5"
                        Height="{StaticResource ControlHeightCompact}"
                        Classes="Ghost"
                        Command="{Binding NextPullBatchPageCommand}"
                        IsEnabled="{Binding HasPullBatchNextPage}">
                        <TextBlock Text="下页" />
                      </Button>
                    </Grid>
                    <suki:BusyArea
                      Grid.Row="1"
                      BusyText="加载中..."
                      IsBusy="{Binding IsPullPanelBusy}">
                      <controls:EmptyStatePanel
                        EmptyHint="执行一次巡检后查看最近批次详情"
                        EmptyText="暂无拉取批次数据"
                        IsEmpty="{Binding IsAutoPullBatchEmpty}">
                        <DataGrid
                          x:Name="AutoPullBatchFullGrid"
                          Classes="SectionGrid InventoryGrid LowToneGrid TraceStateGrid MsfxIndexedGrid"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          HorizontalScrollBarVisibility="Auto"
                          ItemsSource="{Binding AutoPullBatchRows}"
                          SelectedItem="{Binding SelectedAutoPullBatchRow, Mode=TwoWay}">
                          <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <Border
                                    Width="24"
                                    Height="24"
                                    Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                                    CornerRadius="12">
                                    <icons:AppIcon
                                      Width="{DynamicResource IconSizeSmall}"
                                      Height="{DynamicResource IconSizeSmall}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                                      Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                                  </Border>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                              Width="110"
                              Binding="{Binding BatchId}"
                              Header="批次ID" />
                            <DataGridTextColumn
                              Width="120"
                              Binding="{Binding SourceApi}"
                              Header="源接口" />
                            <DataGridTextColumn
                              Width="220"
                              Binding="{Binding Window}"
                              Header="日期窗口" />
                            <DataGridTextColumn
                              Width="100"
                              Binding="{Binding Status}"
                              Header="状态" />
                            <DataGridTextColumn
                              Width="80"
                              Binding="{Binding SuccessCount}"
                              Header="成功" />
                            <DataGridTextColumn
                              Width="80"
                              Binding="{Binding FailCount}"
                              Header="失败" />
                            <DataGridTextColumn
                              Width="165"
                              Binding="{Binding StartedAt}"
                              Header="开始时间" />
                            <DataGridTextColumn
                              Width="165"
                              Binding="{Binding FinishedAt}"
                              Header="结束时间" />
                            <DataGridTextColumn
                              Width="260"
                              Binding="{Binding ErrMsg}"
                              Header="错误信息" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </controls:EmptyStatePanel>
                    </suki:BusyArea>
                  </Grid>

                  <Grid
                    Grid.Row="1"
                    IsVisible="{Binding IsMapPanelExpanded}"
                    RowDefinitions="Auto,*"
                    RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                      <Grid ColumnDefinitions="Auto,Auto,*,180,240,Auto,Auto" ColumnSpacing="{DynamicResource SpacingInlineMd}">
                        <TextBlock
                          VerticalAlignment="Center"
                          Classes="SectionHint"
                          Text="{Binding MapQueueDisplayText}" />
                        <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Classes="SectionHint"
                          Text="{Binding MapQueueRangeText}" />
                        <ComboBox
                          Grid.Column="3"
                          Width="180"
                          Height="{StaticResource ControlHeightCompact}"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding MapQueueSearchScopeOptions}"
                          SelectedItem="{Binding MapQueueSearchScope, Mode=TwoWay}" />
                        <TextBox
                          Grid.Column="4"
                          Classes="MsfxInput"
                          PlaceholderText="搜索..."
                          Text="{Binding MapQueueKeyword, UpdateSourceTrigger=PropertyChanged}">
                          <TextBox.KeyBindings>
                            <KeyBinding Command="{Binding SearchMapQueueCommand}" Gesture="Enter" />
                          </TextBox.KeyBindings>
                        </TextBox>
                        <Button
                          Grid.Column="5"
                          MinWidth="76"
                          Classes="Action"
                          Command="{Binding SearchMapQueueCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                            <icons:AppIcon
                              Width="{DynamicResource IconSizeSmall}"
                              Height="{DynamicResource IconSizeSmall}"
                              Kind="Search" />
                            <TextBlock Text="搜索" />
                          </StackPanel>
                        </Button>
                        <Button
                          Grid.Column="6"
                          Height="{StaticResource ControlHeightCompact}"
                          MinWidth="104"
                          Classes="Ghost"
                          Command="{Binding ResetMapQueueFiltersCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                            <icons:AppIcon
                              Width="{DynamicResource IconSizeSmall}"
                              Height="{DynamicResource IconSizeSmall}"
                              Kind="Eraser" />
                            <TextBlock Text="重置筛选" />
                          </StackPanel>
                        </Button>
                      </Grid>

                      <Grid
                        Grid.Row="1"
                        ColumnDefinitions="Auto,220,Auto,190,*,Auto,Auto,Auto"
                        ColumnSpacing="{DynamicResource SpacingInlineMd}">
                        <TextBlock
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          Opacity="0.8"
                          Text="映射状态" />
                        <ComboBox
                          Grid.Column="1"
                          Height="{StaticResource ControlHeightCompact}"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding MapStatusFilterOptions}"
                          SelectedItem="{Binding MapQueueMapStatusFilter, Mode=TwoWay}" />
                        <TextBlock
                          Grid.Column="2"
                          VerticalAlignment="Center"
                          Opacity="0.8"
                          Text="码状态" />
                        <ComboBox
                          Grid.Column="3"
                          Height="{StaticResource ControlHeightCompact}"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding CodeStatusFilterOptions}"
                          SelectedItem="{Binding MapQueueCodeStatusFilter, Mode=TwoWay}" />
                        <Button
                          Grid.Column="5"
                          Height="{StaticResource ControlHeightCompact}"
                          Classes="Ghost"
                          Command="{Binding PrevMapQueuePageCommand}"
                          IsEnabled="{Binding HasMapQueuePrevPage}">
                          <TextBlock Text="上页" />
                        </Button>
                        <Border
                          Grid.Column="6"
                          MinWidth="120"
                          Padding="8,0"
                          VerticalAlignment="Center">
                          <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.78"
                            Text="{Binding MapQueuePageText}"
                            TextAlignment="Center" />
                        </Border>
                        <Button
                          Grid.Column="7"
                          Height="{StaticResource ControlHeightCompact}"
                          Classes="Ghost"
                          Command="{Binding NextMapQueuePageCommand}"
                          IsEnabled="{Binding HasMapQueueNextPage}">
                          <TextBlock Text="下页" />
                        </Button>
                      </Grid>
                    </Grid>

                    <suki:BusyArea
                      Grid.Row="1"
                      BusyText="加载中..."
                      IsBusy="{Binding IsMapPanelBusy}">
                      <controls:EmptyStatePanel
                        EmptyHint="调整筛选后可继续查询"
                        EmptyText="暂无映射队列数据"
                        IsEmpty="{Binding IsAutoMapQueueEmpty}">
                        <DataGrid
                          x:Name="MapQueueFullGrid"
                          Classes="SectionGrid InventoryGrid LowToneGrid TraceStateGrid MsfxIndexedGrid CellTemplateHighlightGrid MapIndexedGrid"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          HorizontalScrollBarVisibility="Auto"
                          ItemsSource="{Binding AutoMapQueueRows}"
                          SelectedItem="{Binding SelectedAutoMapQueueRow, Mode=TwoWay}">
                          <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <Border
                                    Width="24"
                                    Height="24"
                                    Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                                    CornerRadius="12">
                                    <icons:AppIcon
                                      Width="{DynamicResource IconSizeSmall}"
                                      Height="{DynamicResource IconSizeSmall}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                                      Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                                  </Border>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                              Width="120"
                              Binding="{Binding SourceBillTime}"
                              Header="单据时间" />
                            <DataGridTextColumn
                              Width="220"
                              Binding="{Binding SourceBillCode}"
                              Header="单据编码" />
                            <DataGridTextColumn
                              Width="140"
                              Binding="{Binding ProduceBatchNo}"
                              Header="批号" />
                            <DataGridTextColumn
                              Width="220"
                              Binding="{Binding LeafCode}"
                              Header="最小包装码" />
                            <DataGridTextColumn
                              Width="220"
                              Binding="{Binding SourceDrugNameRaw}"
                              Header="药名(原始)" />
                            <DataGridTextColumn
                              Width="200"
                              Binding="{Binding SourceSpecRaw}"
                              Header="规格(原始)" />
                            <DataGridTextColumn
                              Width="200"
                              Binding="{Binding SourceNameNorm}"
                              Header="药名(归一化)" />
                            <DataGridTextColumn
                              Width="200"
                              Binding="{Binding SourceSpecNorm}"
                              Header="规格(归一化)" />
                            <DataGridTextColumn
                              Width="200"
                              Binding="{Binding SourceCodeLevel1}"
                              Header="一级码" />
                            <DataGridTextColumn
                              Width="200"
                              Binding="{Binding SourceCodeLevel2}"
                              Header="二级码" />
                            <DataGridTextColumn
                              Width="200"
                              Binding="{Binding SourceCodeLevel3}"
                              Header="三级码" />
                            <DataGridTextColumn
                              Width="200"
                              Binding="{Binding SourceCodeLevel4}"
                              Header="四级码" />
                            <DataGridTextColumn
                              Width="200"
                              Binding="{Binding SourceCodeLevel5}"
                              Header="五级码" />
                            <DataGridTextColumn
                              Width="170"
                              Binding="{Binding MapReasonCode}"
                              Header="原因编码" />
                            <DataGridTextColumn
                              Width="260"
                              Binding="{Binding MapReasonDetail}"
                              Header="原因详情" />
                            <DataGridTextColumn
                              Width="170"
                              Binding="{Binding MappedDrugId}"
                              Header="映射药品ID" />
                            <DataGridTextColumn
                              Width="170"
                              Binding="{Binding MappedSpec}"
                              Header="映射规格" />
                            <DataGridTextColumn
                              Width="130"
                              Binding="{Binding MapStatus}"
                              Header="映射状态" />
                            <DataGridTextColumn
                              Width="120"
                              Binding="{Binding CodeStatus}"
                              Header="码状态" />
                            <DataGridTextColumn
                              Width="170"
                              Binding="{Binding UpdatedAt}"
                              Header="更新时间" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </controls:EmptyStatePanel>
                    </suki:BusyArea>
                  </Grid>

                  <Grid
                    Grid.Row="1"
                    IsVisible="{Binding IsTaskPanelExpanded}"
                    RowDefinitions="Auto,Auto,*"
                    RowSpacing="{DynamicResource FormRowSpacing}">
                    <suki:GlassCard
                      Grid.Row="0"
                      Classes="FilterHintCard"
                      IsVisible="{Binding IsTaskQueueBatchModeActive}">
                      <Grid
                        VerticalAlignment="Center"
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        ColumnSpacing="{DynamicResource PageColumnSpacing}">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeSmall}"
                          Height="{DynamicResource IconSizeSmall}"
                          VerticalAlignment="Center"
                          Kind="ListChecks" />
                        <StackPanel
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Spacing="2">
                          <TextBlock FontWeight="SemiBold" Text="{Binding TaskQueueBatchModeTitle}" />
                          <TextBlock Classes="SectionHint" Text="{Binding TaskQueueBatchModeHint}" />
                        </StackPanel>
                        <Button
                          Grid.Column="2"
                          Classes="Action"
                          Command="{Binding ConfirmTaskQueueBatchActionCommand}"
                          IsEnabled="{Binding CanConfirmTaskQueueBatchAction}">
                          <TextBlock Text="{Binding TaskQueueBatchConfirmText}" />
                        </Button>
                        <Button
                          Grid.Column="3"
                          Classes="Ghost"
                          Command="{Binding CancelTaskQueueBatchSelectionCommand}">
                          <TextBlock Text="取消" />
                        </Button>
                      </Grid>
                    </suki:GlassCard>
                    <suki:GlassCard
                      Grid.Row="1"
                      Classes="FilterHintCard"
                      IsVisible="{Binding IsTaskQueueSearchPanelVisible}">
                      <Grid
                        VerticalAlignment="Center"
                        ColumnDefinitions="160,180,*,Auto,Auto"
                        ColumnSpacing="{DynamicResource PageColumnSpacing}">
                        <ComboBox
                          MinWidth="160"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding TaskQueueStatusFilterOptions}"
                          SelectedItem="{Binding TaskQueueStatusFilter, Mode=TwoWay}" />
                        <ComboBox
                          Grid.Column="1"
                          MinWidth="180"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding TaskQueueSearchScopeOptions}"
                          SelectedItem="{Binding TaskQueueSearchScope, Mode=TwoWay}" />
                        <TextBox
                          Grid.Column="2"
                          VerticalContentAlignment="Center"
                          AcceptsReturn="False"
                          Classes="FilterSearchTextBox"
                          PlaceholderText="搜索：单据编号 / 药品 / 规格"
                          Text="{Binding TaskQueueKeyword, Mode=TwoWay}"
                          TextWrapping="NoWrap">
                          <TextBox.KeyBindings>
                            <KeyBinding Command="{Binding SearchTaskQueueCommand}" Gesture="Enter" />
                          </TextBox.KeyBindings>
                        </TextBox>
                        <Button
                          Grid.Column="3"
                          Classes="Action"
                          Command="{Binding SearchTaskQueueCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                            <icons:AppIcon
                              Width="{DynamicResource IconSizeDefault}"
                              Height="{DynamicResource IconSizeDefault}"
                              Kind="Search" />
                            <TextBlock Text="搜索" />
                          </StackPanel>
                        </Button>
                        <Button
                          Grid.Column="4"
                          Classes="Action"
                          Command="{Binding ClearTaskQueueSearchCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                            <icons:AppIcon
                              Width="{DynamicResource IconSizeDefault}"
                              Height="{DynamicResource IconSizeDefault}"
                              Kind="Delete" />
                            <TextBlock Text="清空" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </suki:GlassCard>
                    <suki:BusyArea
                      Grid.Row="2"
                      BusyText="加载中..."
                      IsBusy="{Binding IsTaskPanelBusy}">
                      <controls:EmptyStatePanel
                        EmptyHint="仅 MAPPED + NEW 的码会创建任务"
                        EmptyText="暂无 Agent 任务队列"
                        IsEmpty="{Binding IsAutoTaskQueueEmpty}">
                        <DataGrid
                          x:Name="AutoTaskQueueFullGrid"
                          Classes="SectionGrid InventoryGrid LowToneGrid TraceStateGrid MsfxIndexedGrid CellTemplateHighlightGrid"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          HorizontalScrollBarVisibility="Auto"
                          ItemsSource="{Binding AutoTaskQueueRows}"
                          SelectedItem="{Binding SelectedAutoTaskQueueRow, Mode=TwoWay}"
                          SelectionChanged="OnTaskQueueSelectionChanged"
                          SelectionMode="Single">
                          <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" IsVisible="{Binding #AutoTaskQueueFullGrid.((vm:MsfxLinkViewModel)DataContext).IsTaskQueueBatchModeActive}">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <CheckBox
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      IsCheckedChanged="OnTaskQueueCheckChanged" />
                                  </Grid>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="44">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <Border
                                    Width="24"
                                    Height="24"
                                    Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                                    CornerRadius="12">
                                    <icons:AppIcon
                                      Width="{DynamicResource IconSizeSmall}"
                                      Height="{DynamicResource IconSizeSmall}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                                      Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                                  </Border>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                              Width="110"
                              Binding="{Binding TaskId}"
                              Header="任务ID" />
                            <DataGridTextColumn
                              Width="220"
                              Binding="{Binding SourceBillCode}"
                              Header="单据编码" />
                            <DataGridTextColumn
                              Width="180"
                              Binding="{Binding BatchNos}"
                              Header="批号" />
                            <DataGridTextColumn
                              Width="260"
                              Binding="{Binding Target}"
                              Header="目标药品/规格" />
                            <DataGridTextColumn
                              Width="100"
                              Binding="{Binding Status}"
                              Header="状态" />
                            <DataGridTextColumn
                              Width="170"
                              Binding="{Binding Progress}"
                              Header="进度" />
                            <DataGridTextColumn
                              Width="80"
                              Binding="{Binding RetryCount}"
                              Header="重试" />
                            <DataGridTextColumn
                              Width="160"
                              Binding="{Binding CreatedAt}"
                              Header="创建时间" />
                            <DataGridTextColumn
                              Width="160"
                              Binding="{Binding PickedAt}"
                              Header="抢占时间" />
                            <DataGridTextColumn
                              Width="165"
                              Binding="{Binding FinishedAt}"
                              Header="完成时间" />
                            <DataGridTextColumn
                              Width="260"
                              Binding="{Binding ErrMsg}"
                              Header="错误信息" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </controls:EmptyStatePanel>
                    </suki:BusyArea>
                  </Grid>

                  <controls:EmptyStatePanel
                    Grid.Row="1"
                    EmptyHint="点击“立即巡检”或开启自动监控后将显示执行日志"
                    EmptyText="暂无自动化日志"
                    IsEmpty="{Binding IsAutoLogsEmpty}"
                    IsVisible="{Binding IsLogPanelExpanded}">
                    <DataGrid
                      x:Name="AutoLogFullGrid"
                      CanUserResizeColumns="False"
                      Classes="SectionGrid InventoryGrid LowToneGrid TraceStateGrid MsfxIndexedGrid"
                      ColumnWidth="*"
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      HorizontalScrollBarVisibility="Disabled"
                      ItemsSource="{Binding AutoLogs}"
                      SelectedItem="{Binding SelectedAutoLogRow, Mode=TwoWay}">
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Border
                                Width="24"
                                Height="24"
                                Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                                CornerRadius="12">
                                <icons:AppIcon
                                  Width="{DynamicResource IconSizeSmall}"
                                  Height="{DynamicResource IconSizeSmall}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                                  Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                              </Border>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                          Width="140"
                          Binding="{Binding At}"
                          Header="时间" />
                        <DataGridTextColumn
                          Width="160"
                          Binding="{Binding Stage}"
                          Header="流程阶段" />
                        <DataGridTextColumn
                          Width="*"
                          Binding="{Binding Message}"
                          Header="详细信息" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </controls:EmptyStatePanel>
                </Grid>
              </suki:GlassCard>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeMini}"
                Height="{DynamicResource IconSizeMini}"
                Kind="ClipboardList" />
              <TextBlock Text="上游出库单查询" />
            </StackPanel>
          </TabItem.Header>

          <Grid
            Margin="{DynamicResource MarginTopLg}"
            RowDefinitions="Auto,*"
            RowSpacing="{DynamicResource FormRowSpacing}">
            <suki:GlassCard Grid.Row="0" Classes="SectionCard CompactCard">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
                <Grid
                  Grid.Row="0"
                  ColumnDefinitions="72,360,86,320,*,Auto,Auto"
                  ColumnSpacing="{DynamicResource PageColumnSpacing}">
                  <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="日期" />
                  <Grid
                    Grid.Column="1"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="{DynamicResource PageColumnSpacing}">
                    <CalendarDatePicker
                      Grid.Column="0"
                      Classes="MsfxInput"
                      DisplayDateEnd="{Binding UpoutFromMaxDate}"
                      IsTodayHighlighted="True"
                      SelectedDate="{Binding UpoutFromDate}" />
                    <CalendarDatePicker
                      Grid.Column="1"
                      Classes="MsfxInput"
                      DisplayDateEnd="{Binding UpoutToMaxDate}"
                      DisplayDateStart="{Binding UpoutToMinDate}"
                      IsTodayHighlighted="True"
                      SelectedDate="{Binding UpoutToDate}" />
                  </Grid>

                  <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="单据编码" />
                  <TextBox
                    Grid.Column="3"
                    Classes="MsfxInput"
                    PlaceholderText="可选：按 bill_code 过滤"
                    Text="{Binding UpoutBillCodeKeyword}" />

                  <Button
                    Grid.Column="5"
                    Classes="Action"
                    Command="{Binding QueryUpoutCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeCompact}"
                        Height="{DynamicResource IconSizeCompact}"
                        Kind="Search" />
                      <TextBlock Text="查询" />
                    </StackPanel>
                  </Button>

                  <Button
                    Grid.Column="6"
                    Classes="Ghost"
                    Command="{Binding ResetUpoutFiltersCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeCompact}"
                        Height="{DynamicResource IconSizeCompact}"
                        Kind="RefreshCw" />
                      <TextBlock Text="重置" />
                    </StackPanel>
                  </Button>
                </Grid>

                <Grid
                  Grid.Row="1"
                  ColumnDefinitions="72,360,86,320,*"
                  ColumnSpacing="{DynamicResource PageColumnSpacing}">
                  <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="药品" />
                  <TextBox
                    Grid.Column="1"
                    Classes="MsfxInput"
                    PlaceholderText="可选：药品关键字"
                    Text="{Binding UpoutDrugKeyword}" />

                  <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="发货单位" />
                  <TextBox
                    Grid.Column="3"
                    Classes="MsfxInput"
                    PlaceholderText="可选：发货单位关键字"
                    Text="{Binding UpoutFromEntKeyword}" />

                  <WrapPanel
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ItemSpacing="10"
                    Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="每页" />
                    <ComboBox
                      Width="136"
                      Height="40"
                      MinHeight="40"
                      MaxHeight="40"
                      ItemsSource="{Binding UpoutPageSizeOptions}"
                      SelectedItem="{Binding UpoutPageSize}" />
                    <TextBlock VerticalAlignment="Center" Text="提示" />
                    <suki:InfoBadge VerticalAlignment="Center" Content="默认显示最近 7 天" />
                  </WrapPanel>
                </Grid>
              </Grid>
            </suki:GlassCard>

            <suki:GlassCard Grid.Row="1" Classes="SectionCard CompactCard">
              <Grid
                Margin="{DynamicResource MarginHorizontalTiny}"
                RowDefinitions="Auto,*"
                RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                <Grid
                  VerticalAlignment="Center"
                  Classes="ToolbarPairRow"
                  ColumnDefinitions="*,Auto">
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="SectionHint"
                    Text="{Binding UpoutStatus}" />
                  <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingInlineMd}">
                    <Button
                      Classes="Ghost"
                      Command="{Binding PrevUpoutPageCommand}"
                      IsEnabled="{Binding HasUpoutPrevPage}">
                      <TextBlock Text="上一页" />
                    </Button>
                    <Border
                      MinWidth="120"
                      Padding="8,0"
                      VerticalAlignment="Center">
                      <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.75"
                        Text="{Binding UpoutPageText}"
                        TextAlignment="Center" />
                    </Border>
                    <Button
                      Classes="Ghost"
                      Command="{Binding NextUpoutPageCommand}"
                      IsEnabled="{Binding HasUpoutNextPage}">
                      <TextBlock Text="下一页" />
                    </Button>
                  </StackPanel>
                </Grid>

                <suki:BusyArea Grid.Row="1" IsBusy="{Binding IsUpoutBusy}">
                  <controls:EmptyStatePanel
                    EmptyHint="请调整筛选条件并执行查询"
                    EmptyText="暂无上游出库单"
                    IsEmpty="{Binding IsUpoutEmpty}">
                    <DataGrid
                      Classes="SectionGrid InventoryGrid LowToneGrid MsfxIndexedGrid CellTemplateHighlightGrid"
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      HorizontalScrollBarVisibility="Auto"
                      ItemsSource="{Binding UpoutRows}">
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Border
                                Width="24"
                                Height="24"
                                Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                                CornerRadius="12">
                                <icons:AppIcon
                                  Width="{DynamicResource IconSizeSmall}"
                                  Height="{DynamicResource IconSizeSmall}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                                  Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                              </Border>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                          Width="240"
                          Binding="{Binding BillCode}"
                          Header="单据编码" />
                        <DataGridTextColumn
                          Width="120"
                          Binding="{Binding BillType}"
                          Header="单据类型" />
                        <DataGridTextColumn
                          Width="170"
                          Binding="{Binding BillTime}"
                          Header="时间" />
                        <DataGridTextColumn
                          Width="260"
                          Binding="{Binding DrugName}"
                          Header="药品" />
                        <DataGridTextColumn
                          Width="130"
                          Binding="{Binding PackageSpec}"
                          Header="包装规格" />
                        <DataGridTextColumn
                          Width="180"
                          Binding="{Binding PrepnSpec}"
                          Header="制剂规格" />
                        <DataGridTextColumn
                          Width="110"
                          Binding="{Binding CodeCount}"
                          Header="追溯码数" />
                        <DataGridTextColumn
                          Width="100"
                          Binding="{Binding PrepnCount}"
                          Header="数量" />
                        <DataGridTextColumn
                          Width="120"
                          Binding="{Binding ProduceBatchNo}"
                          Header="批号" />
                        <DataGridTextColumn
                          Width="120"
                          Binding="{Binding ExpireDate}"
                          Header="有效期" />
                        <DataGridTextColumn
                          Width="240"
                          Binding="{Binding FromEntName}"
                          Header="发货单位" />
                        <DataGridTextColumn
                          Width="230"
                          Binding="{Binding FromRefUserId}"
                          Header="发货RefId" />
                        <DataGridTextColumn
                          Width="220"
                          Binding="{Binding ProduceEntName}"
                          Header="生产企业" />
                        <DataGridTextColumn
                          Width="130"
                          Binding="{Binding LogisticsStatus}"
                          Header="入库状态" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </controls:EmptyStatePanel>
                </suki:BusyArea>
              </Grid>
            </suki:GlassCard>
          </Grid>
        </TabItem>

        <TabItem Classes="NoDivider">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeMini}"
                Height="{DynamicResource IconSizeMini}"
                Kind="ScanBarcode" />
              <TextBlock Text="子码查询" />
            </StackPanel>
          </TabItem.Header>

          <Grid
            Margin="{DynamicResource MarginTopLg}"
            RowDefinitions="Auto,*"
            RowSpacing="{DynamicResource FormRowSpacing}">
            <suki:GlassCard Grid.Row="0" Classes="SectionCard CompactCard">
              <Grid ColumnDefinitions="Auto,1.4*,2.0*,Auto,Auto" ColumnSpacing="{DynamicResource PageColumnSpacing}">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Text="单据编码" />
                <TextBox
                  Grid.Column="1"
                  Classes="MsfxInput"
                  PlaceholderText="必填：订单编码"
                  Text="{Binding SubcodeBillCode}">
                  <TextBox.KeyBindings>
                    <KeyBinding Command="{Binding QuerySubCodesCommand}" Gesture="Enter" />
                  </TextBox.KeyBindings>
                </TextBox>
                <Border Grid.Column="2" />
                <Button
                  Grid.Column="3"
                  Classes="Action"
                  Command="{Binding QuerySubCodesCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="ScanSearch" />
                    <TextBlock Text="查询子码" />
                  </StackPanel>
                </Button>
                <Button
                  Grid.Column="4"
                  Classes="Ghost"
                  Command="{Binding ClearSubcodeQueryCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="Delete" />
                    <TextBlock Text="清除" />
                  </StackPanel>
                </Button>
              </Grid>
            </suki:GlassCard>

            <suki:GlassCard Grid.Row="1" Classes="SectionCard CompactCard">
              <Grid
                Margin="{DynamicResource MarginHorizontalTiny}"
                RowDefinitions="Auto,*"
                RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                <Grid
                  VerticalAlignment="Center"
                  Classes="ToolbarPairRow"
                  ColumnDefinitions="*,Auto">
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="SectionHint"
                    Text="{Binding SubcodeStatus}" />
                  <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingInlineMd}">
                    <TextBlock VerticalAlignment="Center" Text="每页" />
                    <ComboBox
                      Width="136"
                      Height="40"
                      MinHeight="40"
                      MaxHeight="40"
                      ItemsSource="{Binding SubcodePageSizeOptions}"
                      SelectedItem="{Binding SubcodePageSize}" />
                    <Button
                      Classes="Ghost"
                      Command="{Binding PrevSubcodePageCommand}"
                      IsEnabled="{Binding HasSubcodePrevPage}">
                      <TextBlock Text="上一页" />
                    </Button>
                    <Border
                      MinWidth="120"
                      Padding="8,0"
                      VerticalAlignment="Center">
                      <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.75"
                        Text="{Binding SubcodePageText}"
                        TextAlignment="Center" />
                    </Border>
                    <Button
                      Classes="Ghost"
                      Command="{Binding NextSubcodePageCommand}"
                      IsEnabled="{Binding HasSubcodeNextPage}">
                      <TextBlock Text="下一页" />
                    </Button>
                  </StackPanel>
                </Grid>

                <suki:BusyArea Grid.Row="1" IsBusy="{Binding IsSubcodeBusy}">
                  <controls:EmptyStatePanel
                    EmptyHint="请输入单据编码并执行查询"
                    EmptyText="暂无子码结果"
                    IsEmpty="{Binding IsSubCodeEmpty}">
                    <DataGrid
                      Classes="SectionGrid InventoryGrid LowToneGrid MsfxIndexedGrid CellTemplateHighlightGrid"
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      HorizontalScrollBarVisibility="Auto"
                      ItemsSource="{Binding SubCodeRows}">
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Border
                                Width="24"
                                Height="24"
                                Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                                CornerRadius="12">
                                <icons:AppIcon
                                  Width="{DynamicResource IconSizeSmall}"
                                  Height="{DynamicResource IconSizeSmall}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                                  Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                              </Border>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                          Width="220"
                          Binding="{Binding BillCode}"
                          Header="单据编码" />
                        <DataGridTextColumn
                          Width="280"
                          Binding="{Binding DrugName}"
                          Header="药品" />
                        <DataGridTextColumn
                          Width="140"
                          Binding="{Binding PackageSpec}"
                          Header="包装规格" />
                        <DataGridTextColumn
                          Width="180"
                          Binding="{Binding PrepnSpec}"
                          Header="制剂规格" />
                        <DataGridTextColumn
                          Width="130"
                          Binding="{Binding BatchNo}"
                          Header="批号" />
                        <DataGridTextColumn
                          Width="240"
                          Binding="{Binding Code}"
                          Header="追溯码" />
                        <DataGridTextColumn
                          Width="220"
                          Binding="{Binding Level1Code}"
                          Header="一级码" />
                        <DataGridTextColumn
                          Width="220"
                          Binding="{Binding Level2Code}"
                          Header="二级码" />
                        <DataGridTextColumn
                          Width="220"
                          Binding="{Binding Level3Code}"
                          Header="三级码" />
                        <DataGridTextColumn
                          Width="220"
                          Binding="{Binding Level4Code}"
                          Header="四级码" />
                        <DataGridTextColumn
                          Width="220"
                          Binding="{Binding Level5Code}"
                          Header="五级码" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </controls:EmptyStatePanel>
                </suki:BusyArea>
              </Grid>
            </suki:GlassCard>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </controls:PageDataShell>
</UserControl>
