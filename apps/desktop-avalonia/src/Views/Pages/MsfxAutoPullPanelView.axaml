<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.MsfxAutoPullPanelView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:Name="Root"
  MinHeight="0"
  HorizontalAlignment="Stretch"
  VerticalAlignment="Stretch"
  x:DataType="vm:MsfxLink">
  <shad:Card
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource DialogRowSpacing}">
      <Grid
        ColumnDefinitions="Auto,*,Auto"
        ColumnSpacing="{DynamicResource PageColumnSpacing}"
        IsVisible="{Binding !IsPullPanelExpanded}">
        <StackPanel
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="{DynamicResource SpacingInlineMd}">
          <icons:AppIcon
            Width="{DynamicResource IconSizeDefault}"
            Height="{DynamicResource IconSizeDefault}"
            Foreground="{Binding AutoPullState, Converter={StaticResource TraceEntryStateToFgBrush}}"
            Kind="{Binding AutoPullState, Converter={StaticResource TraceEntryStateToIconKind}}" />
          <TextBlock
            VerticalAlignment="Center"
            Classes="SectionTitle"
            Text="拉取批次明细" />
          <TextBlock
            VerticalAlignment="Center"
            Classes="Caption Muted"
            Text="{Binding AutoPullSummary}" />
        </StackPanel>
        <StackPanel
          Grid.Column="2"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="{DynamicResource SpacingInlineSm}">
          <shad:Badge
            VerticalAlignment="Center"
            Content="{Binding AutoPullBatchRows.Count, StringFormat=共 {0} 条}"
            Variant="Secondary" />
          <Button
            Classes="Ghost MsfxMiniIconBtn"
            Command="{Binding ToggleAutoPanelExpandCommand}"
            CommandParameter="PULL">
            <icons:AppIcon
              Width="{DynamicResource IconSizeCompact}"
              Height="{DynamicResource IconSizeCompact}"
              Kind="Fullscreen" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid
        ColumnDefinitions="Auto,*,Auto"
        ColumnSpacing="{DynamicResource PageColumnSpacing}"
        IsVisible="{Binding IsPullPanelExpanded}">
        <StackPanel
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="{DynamicResource SpacingInlineMd}">
          <icons:AppIcon
            Width="{DynamicResource IconSizeDefault}"
            Height="{DynamicResource IconSizeDefault}"
            Kind="{Binding AutoExpandedPanelIcon}" />
          <TextBlock
            VerticalAlignment="Center"
            Classes="SectionTitle"
            Text="{Binding AutoExpandedPanelTitle}" />
        </StackPanel>
        <StackPanel
          Grid.Column="2"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="{DynamicResource SpacingInlineSm}">
          <Button
            Width="{StaticResource ControlHeightCompact}"
            Height="{StaticResource ControlHeightCompact}"
            MinWidth="{StaticResource ControlHeightCompact}"
            Padding="0"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Classes="Ghost"
            Command="{Binding ToggleAutoPanelExpandCommand}"
            CommandParameter="{Binding AutoExpandedPanel}">
            <icons:AppIcon
              Width="{DynamicResource IconSizeCompact}"
              Height="{DynamicResource IconSizeCompact}"
              Kind="Minimize" />
          </Button>
        </StackPanel>
      </Grid>

      <controls:DataGridPager
        Grid.Row="1"
        ClearTarget="{Binding #AutoPullBatchGrid}"
        FirstPageCommand="{Binding FirstPullBatchPageCommand}"
        IsContentEmpty="{Binding IsAutoPullBatchEmpty}"
        IsVisible="{Binding IsPullPanelExpanded}"
        LastPageCommand="{Binding LastPullBatchPageCommand}"
        NextPageCommand="{Binding NextPullBatchPageCommand}"
        PageSizeOptions="{Binding PullBatchPageSizeOptions}"
        Placement="Top"
        PrevPageCommand="{Binding PrevPullBatchPageCommand}"
        SelectedPageSize="{Binding PullBatchPageSize, Mode=TwoWay}"
        TotalPages="{Binding PullBatchTotalPages}"
        PageIndex="{Binding PullBatchPage}" />

      <shad:BusyArea
        Grid.Row="2"
        MinHeight="120"
        IsBusy="{Binding IsPullPanelBusy}">
        <controls:EmptyStatePanel
          EmptyHint="执行一次巡检后查看最近批次详情"
          EmptyText="暂无拉取批次数据"
          IsEmpty="{Binding IsAutoPullBatchEmpty}">
          <DataGrid
            x:Name="AutoPullBatchGrid"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Classes="SectionGrid InventoryGrid IndexedGrid"
            HorizontalScrollBarVisibility="Auto"
            ItemsSource="{Binding AutoPullBatchRows}"
            SelectedItem="{Binding SelectedAutoPullBatchRow, Mode=TwoWay}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="44">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border
                      Width="24"
                      Height="24"
                      Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                      Classes="DgStatusBadge"
                      CornerRadius="12">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeSmall}"
                        Height="{DynamicResource IconSizeSmall}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                        Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn
                Width="110"
                Binding="{Binding BatchId}"
                Header="批次ID" />
              <DataGridTextColumn
                Width="120"
                Binding="{Binding SourceApi}"
                Header="源接口" />
              <DataGridTextColumn
                Width="220"
                Binding="{Binding Window}"
                Header="日期窗口" />
              <DataGridTextColumn
                Width="100"
                Binding="{Binding Status}"
                Header="状态" />
              <DataGridTextColumn
                Width="80"
                Binding="{Binding SuccessCount}"
                Header="成功" />
              <DataGridTextColumn
                Width="80"
                Binding="{Binding FailCount}"
                Header="失败" />
              <DataGridTextColumn
                Width="165"
                Binding="{Binding StartedAt}"
                Header="开始时间" />
              <DataGridTextColumn
                Width="165"
                Binding="{Binding FinishedAt}"
                Header="结束时间" />
              <DataGridTextColumn
                Width="260"
                Binding="{Binding ErrMsg}"
                Header="错误信息" />
            </DataGrid.Columns>
          </DataGrid>
        </controls:EmptyStatePanel>
      </shad:BusyArea>
    </Grid>
  </shad:Card>
</UserControl>
