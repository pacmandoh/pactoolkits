<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.ScanCodeView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:conv="clr-namespace:PacToolkits.Desktop.Avalonia.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:Name="Root"
  d:DesignHeight="800"
  d:DesignWidth="1200"
  x:DataType="vm:ScanCode"
  Classes="ScanCodePage"
  Focusable="True"
  mc:Ignorable="d">
  <UserControl.Resources>
    <conv:ContextStatusToBrushConverter x:Key="ContextStatusToBrush" />
    <conv:FetchStateToBgBrushConverter x:Key="FetchStateToBgBrush" />
    <conv:FetchStateToFgBrushConverter x:Key="FetchStateToFgBrush" />
    <conv:FetchStateToIconKindConverter x:Key="FetchStateToIconKind" />
    <conv:HighlightFilterActiveConverter x:Key="HighlightFilterActive" />
  </UserControl.Resources>

  <controls:PageDataShell
    IsLoadingData="{Binding IsBusy}"
    ShowStale="{Binding IsShowingStaleData}"
    ShowUnavailable="{Binding ShowPageUnavailable}"
    StaleHint="{Binding PageStaleHint}"
    UnavailableHint="{Binding PageUnavailableHint}"
    UnavailableIcon="{Binding PageUnavailableIcon}"
    UnavailableTitle="{Binding PageUnavailableTitle}">
    <Grid
      MinHeight="0"
      Classes="DashboardLayout"
      RowDefinitions="Auto,*"
      RowSpacing="0">
      <Border
        Grid.Row="0"
        Classes="FilterBarChrome"
        IsVisible="{Binding IsManualEntryTab}">
        <Grid Classes="FilterBarColumns" ColumnDefinitions="1.1*,Auto,0.95*,Auto,0.55*">
          <Grid
            Grid.Column="0"
            Classes="FilterBarColumn"
            ColumnDefinitions="Auto,*,Auto">
            <TextBlock
              Grid.Column="0"
              Classes="Caption Muted"
              Text="药品" />
            <AutoCompleteBox
              x:Name="DrugBox"
              Grid.Column="1"
              HorizontalAlignment="Stretch"
              IsDropDownOpen="{Binding IsDrugSuggestOpen, Mode=TwoWay}"
              ItemsSource="{Binding DrugOptions}"
              KeyDown="DrugBox_OnKeyDown"
              PlaceholderText="输入药品名并回车"
              Text="{Binding DrugText, Mode=TwoWay, TargetNullValue='', FallbackValue=''}">
              <AutoCompleteBox.ItemTemplate>
                <DataTemplate x:DataType="vm:OptionItem">
                  <TextBlock Text="{Binding Display}" />
                </DataTemplate>
              </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
            <Button
              Grid.Column="2"
              Classes="MicroClear DrugAutoCompleteClear"
              Command="{Binding ClearDrugSpecFilterCommand}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeSmall}"
                Height="{DynamicResource IconSizeSmall}"
                Kind="CircleX" />
            </Button>
          </Grid>

          <Border Grid.Column="1" Classes="FilterBarDivider" />

          <Grid
            Grid.Column="2"
            Classes="FilterBarColumn"
            ColumnDefinitions="Auto,*">
            <TextBlock
              Grid.Column="0"
              Classes="Caption Muted"
              Text="规格" />
            <controls:FilterFieldInput Grid.Column="1">
              <Grid>
                <ComboBox
                  x:Name="SpecBox"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  DisplayMemberBinding="{Binding Display}"
                  ItemsSource="{Binding SpecOptions}"
                  SelectedItem="{Binding SelectedSpec}" />
                <TextBlock
                  Classes="InputPlaceholder"
                  IsVisible="{Binding !IsSpecSelected}"
                  Text="请选择规格" />
              </Grid>
            </controls:FilterFieldInput>
          </Grid>

          <Border Grid.Column="3" Classes="FilterBarDivider" />

          <Grid
            Grid.Column="4"
            Classes="FilterBarColumn"
            ColumnDefinitions="Auto,*">
            <TextBlock
              Grid.Column="0"
              Classes="Caption Muted"
              Text="单条数量" />
            <controls:FilterFieldInput Grid.Column="1">
              <Grid>
                <TextBox IsEnabled="False" Text="{Binding SelectedQtyText, Mode=OneWay}" />
                <TextBlock
                  Classes="InputPlaceholder"
                  IsVisible="{Binding !IsSpecSelected}"
                  Text="自动" />
              </Grid>
            </controls:FilterFieldInput>
          </Grid>
        </Grid>
      </Border>

      <Grid
        Grid.Row="1"
        MinHeight="0"
        Margin="0">
        <Grid
          MinHeight="0"
          Classes="DashboardTabPanel"
          IsVisible="{Binding IsManualEntryTab}"
          RowDefinitions="Auto,*"
          RowSpacing="14">
          <Grid
            Grid.Row="0"
            ColumnDefinitions="*,*,*,*,*"
            ColumnSpacing="{DynamicResource MetricTileColSpacing}">
            <controls:OverviewCard
              Title="有效"
              Grid.Column="0"
              Classes="Success"
              Command="{Binding SelectHighlightCommand}"
              CommandParameter="valid"
              Hint="通过校验，可提交入库；"
              IsActive="{Binding HighlightFilter, Converter={StaticResource HighlightFilterActive}, ConverterParameter=valid}"
              Value="{Binding ValidCodeCount}">
              <controls:OverviewCard.Icon>
                <icons:AppIcon Classes="OverviewCardIcon" Kind="CircleCheck" />
              </controls:OverviewCard.Icon>
            </controls:OverviewCard>
            <controls:OverviewCard
              Title="重复"
              Grid.Column="1"
              Classes="Warning"
              Command="{Binding SelectHighlightCommand}"
              CommandParameter="duplicate"
              Hint="本次录入内重复行；"
              IsActive="{Binding HighlightFilter, Converter={StaticResource HighlightFilterActive}, ConverterParameter=duplicate}"
              Value="{Binding DuplicateCodeCount}">
              <controls:OverviewCard.Icon>
                <icons:AppIcon Classes="OverviewCardIcon" Kind="Copy" />
              </controls:OverviewCard.Icon>
            </controls:OverviewCard>
            <controls:OverviewCard
              Title="跳过入库"
              Grid.Column="2"
              Classes="Warning"
              Command="{Binding SelectHighlightCommand}"
              CommandParameter="pool"
              Hint="库存中已存在；"
              IsActive="{Binding HighlightFilter, Converter={StaticResource HighlightFilterActive}, ConverterParameter=pool}"
              Value="{Binding PoolSkipCount}">
              <controls:OverviewCard.Icon>
                <icons:AppIcon Classes="OverviewCardIcon" Kind="PackageMinus" />
              </controls:OverviewCard.Icon>
            </controls:OverviewCard>
            <controls:OverviewCard
              Title="无效"
              Grid.Column="3"
              Classes="Danger"
              Command="{Binding SelectHighlightCommand}"
              CommandParameter="invalid"
              Hint="不符合校验规则；"
              IsActive="{Binding HighlightFilter, Converter={StaticResource HighlightFilterActive}, ConverterParameter=invalid}"
              Value="{Binding InvalidCodeCount}">
              <controls:OverviewCard.Icon>
                <icons:AppIcon Classes="OverviewCardIcon" Kind="CircleAlert" />
              </controls:OverviewCard.Icon>
            </controls:OverviewCard>
            <controls:OverviewCard
              Title="总计"
              Grid.Column="4"
              Command="{Binding SelectHighlightCommand}"
              CommandParameter="total"
              Hint="非空行合计；"
              IsActive="{Binding HighlightFilter, Converter={StaticResource HighlightFilterActive}, ConverterParameter=total}"
              Value="{Binding TotalCodeCount}">
              <controls:OverviewCard.Icon>
                <icons:AppIcon Classes="OverviewCardIcon" Kind="Hash" />
              </controls:OverviewCard.Icon>
            </controls:OverviewCard>
          </Grid>

          <Grid
            Grid.Row="1"
            MinHeight="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="{DynamicResource PageColumnSpacingWide}">
            <shad:Card
              Grid.Column="0"
              MinHeight="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Stretch"
              Classes="SectionCard StretchBody">
              <shad:Card.Header>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="SectionTitle" Text="追溯码录入" />
                    <TextBlock Classes="Caption Muted" Text="每行一条追溯码，支持批量粘贴与扫码枪连续录入" />
                  </StackPanel>
                  <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingInlineSm}">
                    <shad:Badge Content="{Binding TotalCodeCount, StringFormat=共 {0} 条}" Variant="Secondary" />
                    <controls:StatusPill
                      Classes="ToneDone15"
                      Icon="CircleCheck"
                      IconSize="12"
                      IsVisible="{Binding ShowValidRate}"
                      PillPadding="8,4"
                      Text="{Binding ValidRatePct, StringFormat=有效率 {0:F0}%}"
                      TextSize="12" />
                  </StackPanel>
                </Grid>
              </shad:Card.Header>
              <controls:EmptyStatePanel
                MinHeight="0"
                EmptyHint="{Binding EntryEmptyHint}"
                EmptyText="{Binding EntryEmptyText}"
                Icon="PackageSearch"
                IsEmpty="{Binding IsEntryContextEmpty}"
                SlotMode="Always">
                <controls:TraceCodeEditor
                  x:Name="TraceCodeInput"
                  VerticalAlignment="Stretch"
                  EditorGotFocus="CodeEditor_OnGotFocus"
                  HighlightFilter="{Binding HighlightFilter}"
                  IsEnabled="{Binding IsTraceCodeInputEnabled}"
                  LineKinds="{Binding LineKinds}"
                  PlaceholderText="示例：&#10;89012345678901234567&#10;89012345678901234568&#10;89012345678901234569"
                  Text="{Binding TraceCodesText, Mode=TwoWay}" />
              </controls:EmptyStatePanel>
              <shad:Card.Footer>
                <Grid Classes="SectionCardFoot" ColumnDefinitions="*,Auto">
                  <Grid
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="{DynamicResource SpacingInlineMd}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      VerticalAlignment="Center"
                      Foreground="{Binding ContextStatusLevel, Converter={StaticResource ContextStatusToBrush}}"
                      Kind="Info" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Classes="Caption Muted"
                      Text="{Binding Status}"
                      TextTrimming="CharacterEllipsis"
                      TextWrapping="NoWrap" />
                  </Grid>
                  <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingInlineSm}">
                    <Button Classes="Primary" Command="{Binding SubmitCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeDefault}"
                          Height="{DynamicResource IconSizeDefault}"
                          Kind="Save" />
                        <TextBlock Text="保存录入" />
                      </StackPanel>
                    </Button>
                    <Button Classes="Outline" Command="{Binding ClearCodesCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeDefault}"
                          Height="{DynamicResource IconSizeDefault}"
                          Kind="Delete" />
                        <TextBlock Text="清空输入" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </shad:Card.Footer>
            </shad:Card>

            <shad:Card
              Grid.Column="1"
              Width="{DynamicResource ScanCodeContextWidth}"
              MinHeight="0"
              VerticalAlignment="Stretch"
              Classes="SectionCard ScrollHostCard">
              <shad:Card.Header>
                <TextBlock Classes="SectionTitle" Text="录入上下文" />
              </shad:Card.Header>
              <StackPanel Spacing="{DynamicResource PageSectionSpacing}">
                <StackPanel Spacing="{DynamicResource FormRowSpacing}">
                  <TextBlock Classes="SubsectionTitle" Text="当前选择" />
                  <StackPanel Spacing="8">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="Caption Muted" Text="药品" />
                      <TextBlock
                        Classes="Small"
                        Text="{Binding SelectedDrugDisplay}"
                        TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Classes="Caption Muted" Text="规格" />
                      <TextBlock
                        Classes="Small"
                        Text="{Binding SelectedSpecDisplay}"
                        TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Classes="Caption Muted" Text="单条数量" />
                      <TextBlock Classes="Small" Text="{Binding SelectedQtyDisplay}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="{DynamicResource FormRowSpacing}">
                  <TextBlock Classes="SubsectionTitle" Text="校验规则" />
                  <StackPanel Spacing="6">
                    <controls:StatusPill
                      Classes="ToneInfo15"
                      Icon="ListOrdered"
                      IconSize="12"
                      PillPadding="8,4"
                      Text="{Binding TraceCodeRuleLength, StringFormat=固定长度 {0} 位}"
                      TextSize="12" />
                    <TextBlock
                      Classes="Caption Muted"
                      FontFamily="{DynamicResource TraceCodeInputFontFamily}"
                      Text="{Binding TraceCodeRulePattern, StringFormat=正则：{0}}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="{DynamicResource FormRowSpacing}">
                  <TextBlock Classes="SubsectionTitle" Text="录入说明" />
                  <StackPanel Spacing="4">
                    <TextBlock Classes="Caption Muted" Text="· 每行仅录入一条追溯码，空行自动忽略" />
                    <TextBlock Classes="Caption Muted" Text="· 保存时仅写入有效且不重复的新码" />
                    <TextBlock Classes="Caption Muted" Text="· 已在库存中的码会计入「跳过入库」" />
                    <TextBlock Classes="Caption Muted" Text="· 可在设置中调整追溯码校验规则" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </shad:Card>
          </Grid>
        </Grid>

        <controls:DeferredContentHost
          MinHeight="0"
          IsActive="{Binding IsAutoFetchTab}"
          IsVisible="{Binding IsAutoFetchTab}">
          <controls:DeferredContentHost.ContentTemplate>
            <DataTemplate x:DataType="vm:ScanCode">
              <Grid
                MinHeight="0"
                Classes="AutoFetchWorkspace"
                RowDefinitions="Auto,*">
                <Grid
                  Grid.Row="0"
                  Classes="AutoFetchMetrics"
                  ColumnDefinitions="*,*,*,*">
                  <controls:OverviewCard
                    Title="已编排任务"
                    Grid.Column="0"
                    Classes="ReadOnly"
                    Hint="全量、增量与回补策略"
                    Value="{Binding AutoTasks.Count}">
                    <controls:OverviewCard.Icon>
                      <icons:AppIcon Classes="OverviewCardIcon" Kind="ListChecks" />
                    </controls:OverviewCard.Icon>
                  </controls:OverviewCard>
                  <controls:OverviewCard
                    Title="正在运行"
                    Grid.Column="1"
                    Classes="ReadOnly Success"
                    Hint="当前活动执行上下文"
                    Value="{Binding ActiveAutoTaskCount}">
                    <controls:OverviewCard.Icon>
                      <icons:AppIcon Classes="OverviewCardIcon" Kind="Activity" />
                    </controls:OverviewCard.Icon>
                  </controls:OverviewCard>
                  <controls:OverviewCard
                    Title="近期成功率"
                    Grid.Column="2"
                    Classes="ReadOnly Success"
                    Hint="按最近执行记录计算"
                    Value="{Binding AutoFetchSuccessRateText}">
                    <controls:OverviewCard.Icon>
                      <icons:AppIcon Classes="OverviewCardIcon" Kind="ChartNoAxesCombined" />
                    </controls:OverviewCard.Icon>
                  </controls:OverviewCard>
                  <controls:OverviewCard
                    Title="待重试"
                    Grid.Column="3"
                    Classes="ReadOnly Warning"
                    Hint="失败恢复队列"
                    Value="{Binding RetryQueue.Count}">
                    <controls:OverviewCard.Icon>
                      <icons:AppIcon Classes="OverviewCardIcon" Kind="RotateCcw" />
                    </controls:OverviewCard.Icon>
                  </controls:OverviewCard>
                </Grid>

                <Grid
                  Grid.Row="1"
                  MinHeight="0"
                  Classes="AutoFetchBoard"
                  ColumnDefinitions="1.25*,1*">
                  <controls:CardPanel
                    Title="任务编排"
                    Grid.Column="0"
                    MinHeight="0"
                    AccentBrush="{DynamicResource InfoColor}"
                    Chrome="Card"
                    Classes="FlushBody"
                    HeaderHint="{Binding AutoFetchNextRunText}">
                    <controls:CardPanel.HeaderContent>
                      <shad:Badge Content="{Binding AutoTasks.Count, StringFormat=共 {0} 项}" Variant="Secondary" />
                    </controls:CardPanel.HeaderContent>
                    <DataGrid
                      x:Name="AutoTaskGrid"
                      MinHeight="0"
                      Background="Transparent"
                      CanUserResizeColumns="True"
                      Classes="SectionGrid IndexedGrid"
                      ItemsSource="{Binding AutoTasks}"
                      SelectionChanged="OnBrowsingGridSelectionChanged">
                      <DataGrid.Columns>
                        <DataGridTemplateColumn
                          Width="{StaticResource DgWIcon}"
                          Header="状态"
                          SortMemberPath="StateText">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:AutoFetchTaskItem">
                              <Border
                                Width="{DynamicResource IconBadgeSize}"
                                Height="{DynamicResource IconBadgeSize}"
                                Background="{Binding State, Converter={StaticResource FetchStateToBgBrush}}"
                                Classes="DgStatusBadge"
                                CornerRadius="{DynamicResource TraceBadgeRadius}"
                                ToolTip.Tip="{Binding StateText}">
                                <icons:AppIcon
                                  Width="{DynamicResource IconSizeDefault}"
                                  Height="{DynamicResource IconSizeDefault}"
                                  Foreground="{Binding State, Converter={StaticResource FetchStateToFgBrush}}"
                                  Kind="{Binding State, Converter={StaticResource FetchStateToIconKind}}" />
                              </Border>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                          Width="1.2*"
                          Binding="{Binding Name}"
                          Header="任务"
                          SortMemberPath="Name" />
                        <DataGridTextColumn
                          Width="0.8*"
                          Binding="{Binding Schedule}"
                          Header="触发策略"
                          SortMemberPath="Schedule" />
                        <DataGridTextColumn
                          Width="1.7*"
                          Binding="{Binding Detail}"
                          Header="处理范围"
                          SortMemberPath="Detail" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </controls:CardPanel>

                  <Grid
                    Grid.Column="1"
                    MinHeight="0"
                    Classes="AutoFetchSide"
                    RowDefinitions="*,*">
                    <controls:CardPanel
                      Title="最近执行"
                      Grid.Row="0"
                      MinHeight="0"
                      AccentBrush="{DynamicResource SuccessColor}"
                      Chrome="Card"
                      Classes="FlushBody">
                      <controls:CardPanel.HeaderContent>
                        <shad:Badge Content="{Binding RecentRuns.Count, StringFormat=近 {0} 条}" Variant="Secondary" />
                      </controls:CardPanel.HeaderContent>
                      <DataGrid
                        x:Name="RecentRunGrid"
                        MinHeight="0"
                        Background="Transparent"
                        CanUserResizeColumns="True"
                        Classes="SectionGrid IndexedGrid"
                        ItemsSource="{Binding RecentRuns}"
                        SelectionChanged="OnBrowsingGridSelectionChanged">
                        <DataGrid.Columns>
                          <DataGridTemplateColumn
                            Width="{StaticResource DgWIcon}"
                            Header="状态"
                            SortMemberPath="StateText">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate x:DataType="vm:AutoFetchRunItem">
                                <Border
                                  Width="{DynamicResource IconBadgeSize}"
                                  Height="{DynamicResource IconBadgeSize}"
                                  Background="{Binding State, Converter={StaticResource FetchStateToBgBrush}}"
                                  Classes="DgStatusBadge"
                                  CornerRadius="{DynamicResource TraceBadgeRadius}"
                                  ToolTip.Tip="{Binding StateText}">
                                  <icons:AppIcon
                                    Width="{DynamicResource IconSizeDefault}"
                                    Height="{DynamicResource IconSizeDefault}"
                                    Foreground="{Binding State, Converter={StaticResource FetchStateToFgBrush}}"
                                    Kind="{Binding State, Converter={StaticResource FetchStateToIconKind}}" />
                                </Border>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn
                            Width="1*"
                            Binding="{Binding Name}"
                            Header="任务"
                            SortMemberPath="Name" />
                          <DataGridTextColumn
                            Width="1.15*"
                            Binding="{Binding StartedAtText}"
                            Header="开始时间"
                            SortMemberPath="StartedAtText" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </controls:CardPanel>

                    <controls:CardPanel
                      Title="失败恢复"
                      Grid.Row="1"
                      MinHeight="0"
                      AccentBrush="{DynamicResource WarningColor}"
                      Chrome="Card"
                      Classes="FlushBody">
                      <controls:CardPanel.HeaderContent>
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                          <shad:Badge Content="{Binding RetryQueue.Count, StringFormat=待处理 {0}}" Variant="Secondary" />
                          <Button Classes="Ghost" Command="{Binding RetryFailedCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                              <icons:AppIcon
                                Width="{DynamicResource IconSizeSmall}"
                                Height="{DynamicResource IconSizeSmall}"
                                Kind="RotateCcw" />
                              <TextBlock Text="重试一项" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </controls:CardPanel.HeaderContent>
                      <DataGrid
                        x:Name="RetryQueueGrid"
                        MinHeight="0"
                        Background="Transparent"
                        CanUserResizeColumns="True"
                        Classes="SectionGrid IndexedGrid"
                        ItemsSource="{Binding RetryQueue}"
                        SelectionChanged="OnBrowsingGridSelectionChanged">
                        <DataGrid.Columns>
                          <DataGridTemplateColumn
                            Width="{StaticResource DgWIcon}"
                            Header="状态"
                            SortMemberPath="StateText">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate x:DataType="vm:AutoFetchRetryItem">
                                <Border
                                  Width="{DynamicResource IconBadgeSize}"
                                  Height="{DynamicResource IconBadgeSize}"
                                  Background="{Binding State, Converter={StaticResource FetchStateToBgBrush}}"
                                  Classes="DgStatusBadge"
                                  CornerRadius="{DynamicResource TraceBadgeRadius}"
                                  ToolTip.Tip="{Binding StateText}">
                                  <icons:AppIcon
                                    Width="{DynamicResource IconSizeDefault}"
                                    Height="{DynamicResource IconSizeDefault}"
                                    Foreground="{Binding State, Converter={StaticResource FetchStateToFgBrush}}"
                                    Kind="{Binding State, Converter={StaticResource FetchStateToIconKind}}" />
                                </Border>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn
                            Width="1*"
                            Binding="{Binding Name}"
                            Header="任务"
                            SortMemberPath="Name" />
                          <DataGridTextColumn
                            Width="1.3*"
                            Binding="{Binding Reason}"
                            Header="失败原因"
                            SortMemberPath="Reason" />
                          <DataGridTextColumn
                            Width="0.65*"
                            Binding="{Binding RetryCountText}"
                            Header="次数"
                            SortMemberPath="RetryCountText" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </controls:CardPanel>
                  </Grid>
                </Grid>
              </Grid>
            </DataTemplate>
          </controls:DeferredContentHost.ContentTemplate>
        </controls:DeferredContentHost>
      </Grid>
    </Grid>
  </controls:PageDataShell>
</UserControl>
