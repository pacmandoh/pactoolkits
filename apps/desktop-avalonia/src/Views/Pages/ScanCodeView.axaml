<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.ScanCodeView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:conv="clr-namespace:PacToolkits.Desktop.Avalonia.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:Name="Root"
  d:DesignHeight="800"
  d:DesignWidth="1200"
  x:DataType="vm:ScanCode"
  Focusable="True"
  mc:Ignorable="d">
  <UserControl.Resources>
    <conv:ContextStatusToBrushConverter x:Key="ContextStatusToBrush" />
    <conv:HighlightFilterActiveConverter x:Key="HighlightFilterActive" />
  </UserControl.Resources>

  <controls:PageDataShell
    IsLoadingData="{Binding IsBusy}"
    ShowStale="{Binding IsShowingStaleData}"
    ShowUnavailable="{Binding ShowPageUnavailable}"
    StaleHint="{Binding PageStaleHint}"
    UnavailableHint="{Binding PageUnavailableHint}"
    UnavailableIcon="{Binding PageUnavailableIcon}"
    UnavailableTitle="{Binding PageUnavailableTitle}">
    <Grid Classes="DashboardLayout" MinHeight="0" RowDefinitions="Auto,*" RowSpacing="0">
      <Border Grid.Row="0" Classes="FilterBarChrome">
        <Grid Classes="FilterBarColumns" ColumnDefinitions="1.1*,Auto,0.95*,Auto,0.55*">
            <Grid
              Grid.Column="0"
              Classes="FilterBarColumn"
              ColumnDefinitions="Auto,*,Auto">
              <TextBlock
                Grid.Column="0"
                Classes="Caption Muted"
                Text="药品" />
              <AutoCompleteBox
                x:Name="DrugBox"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                IsDropDownOpen="{Binding IsDrugSuggestOpen, Mode=TwoWay}"
                ItemsSource="{Binding DrugOptions}"
                KeyDown="DrugBox_OnKeyDown"
                PlaceholderText="输入药品名并回车"
                Text="{Binding DrugText, Mode=TwoWay, TargetNullValue='', FallbackValue=''}">
                <AutoCompleteBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionItem">
                    <TextBlock Text="{Binding Display}" />
                  </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
              </AutoCompleteBox>
              <Button
                Grid.Column="2"
                Classes="MicroClear DrugAutoCompleteClear"
                Command="{Binding ClearDrugSpecFilterCommand}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeSmall}"
                  Height="{DynamicResource IconSizeSmall}"
                  Kind="CircleX" />
              </Button>
            </Grid>

            <Border Grid.Column="1" Classes="FilterBarDivider" />

            <Grid
              Grid.Column="2"
              Classes="FilterBarColumn"
              ColumnDefinitions="Auto,*">
              <TextBlock
                Grid.Column="0"
                Classes="Caption Muted"
                Text="规格" />
              <controls:FilterFieldInput Grid.Column="1">
                <Grid>
                  <ComboBox
                    x:Name="SpecBox"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    DisplayMemberBinding="{Binding Display}"
                    ItemsSource="{Binding SpecOptions}"
                    SelectedItem="{Binding SelectedSpec}" />
                  <TextBlock
                    Classes="InputPlaceholder"
                    IsVisible="{Binding !IsSpecSelected}"
                    Text="请选择规格" />
                </Grid>
              </controls:FilterFieldInput>
            </Grid>

            <Border Grid.Column="3" Classes="FilterBarDivider" />

            <Grid
              Grid.Column="4"
              Classes="FilterBarColumn"
              ColumnDefinitions="Auto,*">
              <TextBlock
                Grid.Column="0"
                Classes="Caption Muted"
                Text="单条数量" />
              <controls:FilterFieldInput Grid.Column="1">
                <Grid>
                  <TextBox IsEnabled="False" Text="{Binding SelectedQtyText, Mode=OneWay}" />
                  <TextBlock
                    Classes="InputPlaceholder"
                    IsVisible="{Binding !IsSpecSelected}"
                    Text="自动" />
                </Grid>
              </controls:FilterFieldInput>
            </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="1" MinHeight="0" Margin="0">
        <Grid
          MinHeight="0"
          Classes="DashboardTabPanel"
          IsVisible="{Binding IsManualEntryTab}"
          RowDefinitions="Auto,*"
          RowSpacing="14">
          <Grid
            Grid.Row="0"
            ColumnDefinitions="*,*,*,*,*"
            ColumnSpacing="{DynamicResource MetricTileColSpacing}">
            <controls:OverviewCard
              Grid.Column="0"
              Classes="Success"
              Title="有效"
              Hint="通过校验，可提交入库；"
              Value="{Binding ValidCodeCount}"
              Command="{Binding SelectHighlightCommand}"
              CommandParameter="valid"
              IsActive="{Binding HighlightFilter, Converter={StaticResource HighlightFilterActive}, ConverterParameter=valid}">
              <controls:OverviewCard.Icon>
                <icons:AppIcon Classes="OverviewCardIcon" Kind="CircleCheck" />
              </controls:OverviewCard.Icon>
            </controls:OverviewCard>
            <controls:OverviewCard
              Grid.Column="1"
              Classes="Warning"
              Title="重复"
              Hint="本次录入内重复行；"
              Value="{Binding DuplicateCodeCount}"
              Command="{Binding SelectHighlightCommand}"
              CommandParameter="duplicate"
              IsActive="{Binding HighlightFilter, Converter={StaticResource HighlightFilterActive}, ConverterParameter=duplicate}">
              <controls:OverviewCard.Icon>
                <icons:AppIcon Classes="OverviewCardIcon" Kind="Copy" />
              </controls:OverviewCard.Icon>
            </controls:OverviewCard>
            <controls:OverviewCard
              Grid.Column="2"
              Classes="Warning"
              Title="跳过入库"
              Hint="库存中已存在；"
              Value="{Binding PoolSkipCount}"
              Command="{Binding SelectHighlightCommand}"
              CommandParameter="pool"
              IsActive="{Binding HighlightFilter, Converter={StaticResource HighlightFilterActive}, ConverterParameter=pool}">
              <controls:OverviewCard.Icon>
                <icons:AppIcon Classes="OverviewCardIcon" Kind="PackageMinus" />
              </controls:OverviewCard.Icon>
            </controls:OverviewCard>
            <controls:OverviewCard
              Grid.Column="3"
              Classes="Danger"
              Title="无效"
              Hint="不符合校验规则；"
              Value="{Binding InvalidCodeCount}"
              Command="{Binding SelectHighlightCommand}"
              CommandParameter="invalid"
              IsActive="{Binding HighlightFilter, Converter={StaticResource HighlightFilterActive}, ConverterParameter=invalid}">
              <controls:OverviewCard.Icon>
                <icons:AppIcon Classes="OverviewCardIcon" Kind="CircleAlert" />
              </controls:OverviewCard.Icon>
            </controls:OverviewCard>
            <controls:OverviewCard
              Grid.Column="4"
              Title="总计"
              Hint="非空行合计；"
              Value="{Binding TotalCodeCount}"
              Command="{Binding SelectHighlightCommand}"
              CommandParameter="total"
              IsActive="{Binding HighlightFilter, Converter={StaticResource HighlightFilterActive}, ConverterParameter=total}">
              <controls:OverviewCard.Icon>
                <icons:AppIcon Classes="OverviewCardIcon" Kind="Hash" />
              </controls:OverviewCard.Icon>
            </controls:OverviewCard>
          </Grid>

          <Grid
            Grid.Row="1"
            MinHeight="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="{DynamicResource PageColumnSpacingWide}">
            <shad:Card
              Grid.Column="0"
              MinHeight="0"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Stretch"
              Classes="SectionCard StretchBody">
              <shad:Card.Header>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="SectionTitle" Text="追溯码录入" />
                    <TextBlock
                      Classes="Caption Muted"
                      Text="每行一条追溯码，支持批量粘贴与扫码枪连续录入" />
                  </StackPanel>
                  <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingInlineSm}">
                    <shad:Badge Content="{Binding TotalCodeCount, StringFormat=共 {0} 条}" Variant="Secondary" />
                    <controls:StatusPill
                      Classes="ToneDone15"
                      Icon="CircleCheck"
                      IconSize="12"
                      IsVisible="{Binding ShowValidRate}"
                      PillPadding="8,4"
                      Text="{Binding ValidRatePct, StringFormat=有效率 {0:F0}%}"
                      TextSize="12" />
                  </StackPanel>
                </Grid>
              </shad:Card.Header>
              <controls:EmptyStatePanel
                MinHeight="0"
                EmptyHint="{Binding EntryEmptyHint}"
                EmptyText="{Binding EntryEmptyText}"
                Icon="PackageSearch"
                IsEmpty="{Binding IsEntryContextEmpty}"
                SlotMode="Always">
                <controls:TraceCodeEditor
                  x:Name="TraceCodeInput"
                  VerticalAlignment="Stretch"
                  EditorGotFocus="CodeEditor_OnGotFocus"
                  HighlightFilter="{Binding HighlightFilter}"
                  IsEnabled="{Binding IsTraceCodeInputEnabled}"
                  LineKinds="{Binding LineKinds}"
                  PlaceholderText="示例：&#10;89012345678901234567&#10;89012345678901234568&#10;89012345678901234569"
                  Text="{Binding TraceCodesText, Mode=TwoWay}" />
              </controls:EmptyStatePanel>
              <shad:Card.Footer>
                <Grid Classes="SectionCardFoot" ColumnDefinitions="*,Auto">
                  <Grid
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="{DynamicResource SpacingInlineMd}">
                    <icons:AppIcon
                      VerticalAlignment="Center"
                      Foreground="{Binding ContextStatusLevel, Converter={StaticResource ContextStatusToBrush}}"
                      Kind="Info"
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Classes="Caption Muted"
                      Text="{Binding Status}"
                      TextTrimming="CharacterEllipsis"
                      TextWrapping="NoWrap" />
                  </Grid>
                  <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingInlineSm}">
                    <Button Classes="Primary" Command="{Binding SubmitCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeDefault}"
                          Height="{DynamicResource IconSizeDefault}"
                          Kind="Save" />
                        <TextBlock Text="保存录入" />
                      </StackPanel>
                    </Button>
                    <Button Classes="Outline" Command="{Binding ClearCodesCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeDefault}"
                          Height="{DynamicResource IconSizeDefault}"
                          Kind="Delete" />
                        <TextBlock Text="清空输入" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </shad:Card.Footer>
            </shad:Card>

            <shad:Card
              Grid.Column="1"
              MinHeight="0"
              VerticalAlignment="Stretch"
              Width="{DynamicResource ScanCodeContextWidth}"
              Classes="SectionCard ScrollHostCard">
              <shad:Card.Header>
                <TextBlock Classes="SectionTitle" Text="录入上下文" />
              </shad:Card.Header>
              <StackPanel Spacing="{DynamicResource PageSectionSpacing}">
                <StackPanel Spacing="{DynamicResource FormRowSpacing}">
                  <TextBlock Classes="SubsectionTitle" Text="当前选择" />
                  <StackPanel Spacing="8">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="Caption Muted" Text="药品" />
                      <TextBlock Classes="Small" Text="{Binding SelectedDrugDisplay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Classes="Caption Muted" Text="规格" />
                      <TextBlock Classes="Small" Text="{Binding SelectedSpecDisplay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Classes="Caption Muted" Text="单条数量" />
                      <TextBlock Classes="Small" Text="{Binding SelectedQtyDisplay}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="{DynamicResource FormRowSpacing}">
                  <TextBlock Classes="SubsectionTitle" Text="校验规则" />
                  <StackPanel Spacing="6">
                    <controls:StatusPill
                      Classes="ToneInfo15"
                      Icon="ListOrdered"
                      IconSize="12"
                      PillPadding="8,4"
                      Text="{Binding TraceCodeRuleLength, StringFormat=固定长度 {0} 位}"
                      TextSize="12" />
                    <TextBlock
                      Classes="Caption Muted"
                      FontFamily="{DynamicResource TraceCodeInputFontFamily}"
                      Text="{Binding TraceCodeRulePattern, StringFormat=正则：{0}}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="{DynamicResource FormRowSpacing}">
                  <TextBlock Classes="SubsectionTitle" Text="录入说明" />
                  <StackPanel Spacing="4">
                    <TextBlock Classes="Caption Muted" Text="· 每行仅录入一条追溯码，空行自动忽略" />
                    <TextBlock Classes="Caption Muted" Text="· 保存时仅写入有效且不重复的新码" />
                    <TextBlock Classes="Caption Muted" Text="· 已在库存中的码会计入「跳过入库」" />
                    <TextBlock Classes="Caption Muted" Text="· 可在设置中调整追溯码校验规则" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </shad:Card>
          </Grid>
        </Grid>

        <controls:DeferredContentHost
          x:Name="AutoFetchTabHost"
          MinHeight="0"
          IsActive="{Binding IsAutoFetchTab}"
          IsVisible="{Binding IsAutoFetchTab}">
              <controls:DeferredContentHost.ContentTemplate>
                <DataTemplate x:DataType="vm:ScanCode">
                  <Grid MinHeight="0" Margin="0" RowDefinitions="Auto,*" RowSpacing="0">
                    <Border Grid.Row="0" Classes="FilterBarChrome">
                      <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource FilterBarGroupSpacing}">
                        <TextBlock
                          Grid.Row="0"
                          Classes="Caption Muted"
                          Text="任务面板为占位实现：可演示调度、运行记录和失败重试交互，后续接入真实拉取链路" />
                        <Grid
                          Grid.Row="1"
                          Classes="FilterBarColumns"
                          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                        <Grid
                          Grid.Column="0"
                          Classes="FilterBarColumn"
                          ColumnDefinitions="Auto,Auto">
                          <TextBlock
                            Grid.Column="0"
                            Classes="Caption Muted"
                            Text="自动拉取" />
                          <ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsAutoFetchEnabled}" />
                        </Grid>

                        <Border Grid.Column="1" Classes="FilterBarDivider" />

                        <Button
                          Grid.Column="2"
                          Classes="Action"
                          Command="{Binding StartAutoFetchCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                            <icons:AppIcon
                              Width="{DynamicResource IconSizeDefault}"
                              Height="{DynamicResource IconSizeDefault}"
                              Kind="CirclePlay" />
                            <TextBlock Text="开始任务" />
                          </StackPanel>
                        </Button>

                        <Border Grid.Column="3" Classes="FilterBarDivider" />

                        <Button
                          Grid.Column="4"
                          Classes="Outline"
                          Command="{Binding StopAutoFetchCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                            <icons:AppIcon
                              Width="{DynamicResource IconSizeDefault}"
                              Height="{DynamicResource IconSizeDefault}"
                              Kind="CircleStop" />
                            <TextBlock Text="停止任务" />
                          </StackPanel>
                        </Button>

                        <Border Grid.Column="5" Classes="FilterBarDivider" />

                        <Grid
                          Grid.Column="6"
                          Classes="FilterBarColumn"
                          ColumnDefinitions="Auto,Auto,*">
                          <Button
                            Grid.Column="0"
                            Classes="Outline"
                            Command="{Binding RetryFailedCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                              <icons:AppIcon
                                Width="{DynamicResource IconSizeDefault}"
                                Height="{DynamicResource IconSizeDefault}"
                                Kind="RotateCcw" />
                              <TextBlock Text="重试失败" />
                            </StackPanel>
                          </Button>
                          <Border Grid.Column="1" Classes="FilterBarDivider" />
                          <Grid
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="{DynamicResource SpacingInlineMd}">
                            <icons:AppIcon
                              Grid.Column="0"
                              Width="{DynamicResource IconSizeDefault}"
                              Height="{DynamicResource IconSizeDefault}"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource SuccessColor}"
                              Kind="Info" />
                            <TextBlock
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Classes="Caption Muted"
                              Text="{Binding AutoFetchStatus}"
                              TextTrimming="CharacterEllipsis"
                              TextWrapping="NoWrap" />
                          </Grid>
                        </Grid>
                        <Button
                          Grid.Column="7"
                          Classes="Outline"
                          Command="{Binding OpenAutoFetchSettingsCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                            <icons:AppIcon
                              Width="{DynamicResource IconSizeDefault}"
                              Height="{DynamicResource IconSizeDefault}"
                              Kind="SlidersHorizontal" />
                            <TextBlock Text="参数设置" />
                          </StackPanel>
                        </Button>
                      </Grid>
                      </Grid>
                    </Border>

                    <Grid
                      Grid.Row="1"
                      MinHeight="0"
                      ColumnDefinitions="1.3*,1.4*,1.1*"
                      ColumnSpacing="0">
                      <controls:CardPanel
                        Title="任务列表"
                        Grid.Column="0"
                        MinHeight="0"
                        Chrome="Card"
                        Classes="FlushBody">
                        <controls:CardPanel.HeaderContent>
                          <shad:Badge Content="{Binding AutoTasks.Count, StringFormat=共 {0} 项}" Variant="Secondary" />
                        </controls:CardPanel.HeaderContent>
                        <controls:EmptyStatePanel
                          MinHeight="0"
                          EmptyHint="{Binding AutoTasksEmptyHint}"
                          EmptyText="{Binding AutoTasksEmptyText}"
                          Icon="{Binding SectionEmptyIcon}"
                          IsEmpty="{Binding IsAutoTasksEmpty}"
                          IsPending="{Binding IsSectionPending}"
                          SlotMinHeight="{DynamicResource DgH10Rows}"
                          SlotMode="Always">
                          <shad:BusyArea IsBusy="{Binding IsBusy}">
                            <controls:DeferredGridSlot
                              x:Name="AutoTaskGridSlot"
                              SlotMinHeight="{DynamicResource DgH10Rows}"
                              SlotName="AutoTaskGrid">
                              <controls:DeferredGridSlot.GridTemplate>
                                <DataTemplate x:DataType="vm:ScanCode">
                                  <DataGrid
                                    CanUserResizeColumns="True"
                                    Classes="SectionGrid"
                                    ItemsSource="{Binding AutoTasks}">
                                    <DataGrid.Columns>
                                      <DataGridTextColumn
                                        Width="1.3*"
                                        Binding="{Binding Name}"
                                        Header="任务" />
                                      <DataGridTextColumn
                                        Width="1*"
                                        Binding="{Binding Schedule}"
                                        Header="计划" />
                                      <DataGridTextColumn
                                        Width="0.8*"
                                        Binding="{Binding State}"
                                        Header="状态" />
                                    </DataGrid.Columns>
                                  </DataGrid>
                                </DataTemplate>
                              </controls:DeferredGridSlot.GridTemplate>
                            </controls:DeferredGridSlot>
                          </shad:BusyArea>
                        </controls:EmptyStatePanel>
                      </controls:CardPanel>

                      <controls:CardPanel
                        Title="最近执行记录"
                        Grid.Column="1"
                        MinHeight="0"
                        Chrome="Card"
                        Classes="FlushBody">
                        <controls:CardPanel.HeaderContent>
                          <shad:Badge Content="{Binding RecentRuns.Count, StringFormat=近 {0} 条}" Variant="Secondary" />
                        </controls:CardPanel.HeaderContent>
                        <controls:EmptyStatePanel
                          MinHeight="0"
                          EmptyHint="{Binding RecentRunsEmptyHint}"
                          EmptyText="{Binding RecentRunsEmptyText}"
                          Icon="{Binding SectionEmptyIcon}"
                          IsEmpty="{Binding IsRecentRunsEmpty}"
                          IsPending="{Binding IsSectionPending}"
                          SlotMinHeight="{DynamicResource DgH10Rows}"
                          SlotMode="Always">
                          <shad:BusyArea IsBusy="{Binding IsBusy}">
                            <controls:DeferredGridSlot
                              x:Name="RecentRunGridSlot"
                              SlotMinHeight="{DynamicResource DgH10Rows}"
                              SlotName="RecentRunGrid">
                              <controls:DeferredGridSlot.GridTemplate>
                                <DataTemplate x:DataType="vm:ScanCode">
                                  <DataGrid
                                    CanUserResizeColumns="True"
                                    Classes="SectionGrid"
                                    ItemsSource="{Binding RecentRuns}">
                                    <DataGrid.Columns>
                                      <DataGridTextColumn
                                        Width="1.1*"
                                        Binding="{Binding Name}"
                                        Header="任务" />
                                      <DataGridTextColumn
                                        Width="1.2*"
                                        Binding="{Binding StartedAtText}"
                                        Header="开始时间" />
                                      <DataGridTextColumn
                                        Width="0.8*"
                                        Binding="{Binding Result}"
                                        Header="结果" />
                                    </DataGrid.Columns>
                                  </DataGrid>
                                </DataTemplate>
                              </controls:DeferredGridSlot.GridTemplate>
                            </controls:DeferredGridSlot>
                          </shad:BusyArea>
                        </controls:EmptyStatePanel>
                      </controls:CardPanel>

                      <controls:CardPanel
                        Title="失败重试队列"
                        Grid.Column="2"
                        MinHeight="0"
                        Chrome="Card"
                        Classes="FlushBody">
                        <controls:CardPanel.HeaderContent>
                          <shad:Badge Content="{Binding RetryQueue.Count, StringFormat=待重试 {0}}" Variant="Secondary" />
                        </controls:CardPanel.HeaderContent>
                        <controls:EmptyStatePanel
                          MinHeight="0"
                          EmptyHint="{Binding RetryQueueEmptyHint}"
                          EmptyText="{Binding RetryQueueEmptyText}"
                          Icon="{Binding SectionEmptyIcon}"
                          IsEmpty="{Binding IsRetryQueueEmpty}"
                          IsPending="{Binding IsSectionPending}"
                          SlotMinHeight="{DynamicResource DgH10Rows}"
                          SlotMode="Always">
                          <shad:BusyArea IsBusy="{Binding IsBusy}">
                            <controls:DeferredGridSlot
                              x:Name="RetryQueueGridSlot"
                              SlotMinHeight="{DynamicResource DgH10Rows}"
                              SlotName="RetryQueueGrid">
                              <controls:DeferredGridSlot.GridTemplate>
                                <DataTemplate x:DataType="vm:ScanCode">
                                  <DataGrid
                                    CanUserResizeColumns="True"
                                    Classes="SectionGrid"
                                    ItemsSource="{Binding RetryQueue}">
                                    <DataGrid.Columns>
                                      <DataGridTextColumn
                                        Width="1.1*"
                                        Binding="{Binding Name}"
                                        Header="任务" />
                                      <DataGridTextColumn
                                        Width="1.2*"
                                        Binding="{Binding Reason}"
                                        Header="原因" />
                                      <DataGridTextColumn
                                        Width="0.8*"
                                        Binding="{Binding RetryCountText}"
                                        Header="重试" />
                                    </DataGrid.Columns>
                                  </DataGrid>
                                </DataTemplate>
                              </controls:DeferredGridSlot.GridTemplate>
                            </controls:DeferredGridSlot>
                          </shad:BusyArea>
                        </controls:EmptyStatePanel>
                      </controls:CardPanel>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </controls:DeferredContentHost.ContentTemplate>
            </controls:DeferredContentHost>
      </Grid>
    </Grid>
  </controls:PageDataShell>
</UserControl>
