<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.ScanCodeView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:conv="clr-namespace:PacToolkits.Desktop.Avalonia.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:Name="Root"
  d:DesignHeight="800"
  d:DesignWidth="1200"
  x:DataType="vm:ScanCodeViewModel"
  Focusable="True"
  mc:Ignorable="d">
  <UserControl.Resources>
    <conv:ContextStatusToBrushConverter x:Key="ContextStatusToBrush" />
  </UserControl.Resources>

  <controls:PageDataShell
    IsLoadingData="{Binding IsBusy}"
    ShowStale="{Binding IsShowingStaleData}"
    ShowUnavailable="{Binding ShowPageUnavailable}"
    StaleHint="{Binding PageStaleHint}"
    UnavailableHint="{Binding PageUnavailableHint}"
    UnavailableIcon="{Binding PageUnavailableIcon}"
    UnavailableTitle="{Binding PageUnavailableTitle}">
    <Grid Classes="PageRootLayout" RowDefinitions="Auto,*">
      <suki:GlassCard Grid.Row="0" Classes="SectionCard ScanCodeHeroCard">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
          <Grid
            Grid.Row="0"
            VerticalAlignment="Center"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="{DynamicResource SpacingInlineMd}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeSectionHeader}"
                Height="{DynamicResource IconSizeSectionHeader}"
                Kind="ScanBarcode" />
              <TextBlock Classes="SectionTitle" Text="录入药品选择" />
            </StackPanel>
            <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              Classes="SectionHint"
              Text="先选药品与规格，再在下方选择录入方式" />
          </Grid>

          <Grid
            Grid.Row="1"
            VerticalAlignment="Stretch"
            ColumnDefinitions="320,260,150,*"
            ColumnSpacing="{DynamicResource FormColumnSpacing}">
            <suki:GlassCard
              Grid.Column="0"
              VerticalAlignment="Stretch"
              Classes="FilterFieldCard">
              <Grid
                VerticalAlignment="Stretch"
                RowDefinitions="Auto,*"
                RowSpacing="{DynamicResource FilterFieldRowSpacing}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource SpacingInlineSm}">
                  <icons:AppIcon
                    Grid.Column="0"
                    Width="{DynamicResource IconSizeSmall}"
                    Height="{DynamicResource IconSizeSmall}"
                    VerticalAlignment="Center"
                    Kind="Pill"
                    Opacity="{StaticResource SectionHintOpacity}" />
                  <TextBlock
                    Grid.Column="1"
                    Classes="FilterLabel"
                    Text="药品" />
                  <Button
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Classes="Basic MicroClear"
                    Command="{Binding ClearDrugSpecFilterCommand}"
                    ToolTip.Tip="清空药品和规格">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="CircleX" />
                  </Button>
                </Grid>
                <controls:PlainAutoCompleteBox
                  x:Name="DrugBox"
                  Grid.Row="1"
                  VerticalAlignment="Bottom"
                  IsDropDownOpen="{Binding IsDrugSuggestOpen, Mode=TwoWay}"
                  ItemsSource="{Binding DrugOptions}"
                  KeyDown="DrugBox_OnKeyDown"
                  PlaceholderText="输入药品名并回车"
                  Text="{Binding DrugText, Mode=TwoWay, TargetNullValue='', FallbackValue=''}">
                  <controls:PlainAutoCompleteBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OptionItem">
                      <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                  </controls:PlainAutoCompleteBox.ItemTemplate>
                </controls:PlainAutoCompleteBox>
              </Grid>
            </suki:GlassCard>

            <suki:GlassCard
              Grid.Column="1"
              VerticalAlignment="Stretch"
              Classes="FilterFieldCard">
              <Grid
                VerticalAlignment="Stretch"
                RowDefinitions="Auto,*"
                RowSpacing="{DynamicResource FilterFieldRowSpacing}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeSmall}"
                    Height="{DynamicResource IconSizeSmall}"
                    Kind="SlidersHorizontal" />
                  <TextBlock Classes="FilterLabel" Text="规格" />
                </StackPanel>
                <Grid Grid.Row="1" VerticalAlignment="Bottom">
                  <controls:FilterFieldInput>
                    <Grid>
                      <ComboBox
                        x:Name="SpecBox"
                        DisplayMemberBinding="{Binding Display}"
                        ItemsSource="{Binding SpecOptions}"
                        SelectedItem="{Binding SelectedSpec}" />
                      <TextBlock
                        Margin="{DynamicResource MarginLeftMd}"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        IsVisible="{Binding !IsSpecSelected}"
                        Opacity="0.55"
                        Text="请选择规格" />
                    </Grid>
                  </controls:FilterFieldInput>
                </Grid>
              </Grid>
            </suki:GlassCard>

            <suki:GlassCard
              Grid.Column="2"
              VerticalAlignment="Stretch"
              Classes="FilterFieldCard">
              <Grid
                VerticalAlignment="Stretch"
                RowDefinitions="Auto,*"
                RowSpacing="{DynamicResource FilterFieldRowSpacing}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeSmall}"
                    Height="{DynamicResource IconSizeSmall}"
                    Kind="PillBottle" />
                  <TextBlock Classes="FilterLabel" Text="单条数量" />
                </StackPanel>
                <Grid Grid.Row="1" VerticalAlignment="Bottom">
                  <controls:FilterFieldInput>
                    <Grid>
                      <TextBox IsEnabled="False" Text="{Binding SelectedQtyText, Mode=OneWay}" />
                      <TextBlock
                        Margin="{DynamicResource MarginLeftMd}"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        IsVisible="{Binding !IsSpecSelected}"
                        Opacity="0.55"
                        Text="自动" />
                    </Grid>
                  </controls:FilterFieldInput>
                </Grid>
              </Grid>
            </suki:GlassCard>

            <suki:GlassCard
              Grid.Column="3"
              MinHeight="56"
              Padding="{StaticResource CompactPadding}"
              HorizontalContentAlignment="Center"
              Opacity="0.92">
              <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="{DynamicResource SpacingInlineMd}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeDefault}"
                  Height="{DynamicResource IconSizeDefault}"
                  VerticalAlignment="Center"
                  Foreground="{Binding ContextStatusLevel, Converter={StaticResource ContextStatusToBrush}}"
                  Kind="Info" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="SectionHint"
                  Text="{Binding Status}"
                  TextAlignment="Center"
                  TextTrimming="None"
                  TextWrapping="Wrap" />
              </Grid>
            </suki:GlassCard>
          </Grid>
        </Grid>
      </suki:GlassCard>

      <suki:GlassCard Grid.Row="1" Classes="SectionCard">
        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeCompact}"
                  Height="{DynamicResource IconSizeCompact}"
                  Kind="Keyboard" />
                <TextBlock Text="手动录入" />
              </StackPanel>
            </TabItem.Header>

            <Grid
              Margin="{DynamicResource MarginTopMd}"
              RowDefinitions="Auto,*,Auto,Auto"
              RowSpacing="{DynamicResource FormRowSpacing}">
              <suki:GlassCard
                Grid.Row="0"
                Padding="{StaticResource CompactPadding}"
                Opacity="0.95">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeDefault}"
                    Height="{DynamicResource IconSizeDefault}"
                    Kind="Clipboard" />
                  <TextBlock Classes="SectionHint" Text="左侧录入追溯码，右侧实时预览；有效条码为绿色，其余标注具体原因" />
                </StackPanel>
              </suki:GlassCard>

              <Grid
                Grid.Row="1"
                ColumnDefinitions="*,*"
                ColumnSpacing="{DynamicResource TraceCodeColumnSpacing}">
                <Grid
                  Grid.Column="0"
                  RowDefinitions="Auto,*"
                  RowSpacing="{DynamicResource FilterFieldRowSpacing}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="Keyboard"
                      Opacity="{StaticResource SectionHintOpacity}" />
                    <TextBlock Classes="FilterLabel" Text="录入追溯码区域" />
                  </StackPanel>
                  <Grid Grid.Row="1">
                    <TextBox
                      x:Name="TraceCodeInput"
                      Classes="TraceCodeInput"
                      GotFocus="CodeEditor_OnGotFocus"
                      IsEnabled="{Binding IsTraceCodeInputEnabled}"
                      PlaceholderText="示例：&#10;89012345678901234567&#10;89012345678901234568&#10;89012345678901234569"
                      Text="{Binding TraceCodesText, Mode=TwoWay}" />
                    <Border
                      Background="Transparent"
                      CornerRadius="{DynamicResource RowRadius}"
                      IsVisible="{Binding IsTraceCodeInputBlocked}"
                      PointerPressed="TraceCodeInputBlocked_OnPointerPressed" />
                  </Grid>
                </Grid>

                <Grid
                  Grid.Column="1"
                  RowDefinitions="Auto,*"
                  RowSpacing="{DynamicResource FilterFieldRowSpacing}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="ListChecks"
                      Opacity="{StaticResource SectionHintOpacity}" />
                    <TextBlock Classes="FilterLabel" Text="预览区域" />
                  </StackPanel>
                  <suki:GlassCard
                    Grid.Row="1"
                    VerticalAlignment="Stretch"
                    Classes="TraceCodePreviewCard">
                    <controls:EmptyStatePanel
                      EmptyHint="左侧录入追溯码后，将在此显示逐行校验结果"
                      EmptyText="等待录入"
                      Icon="ListChecks"
                      IsEmpty="{Binding IsTraceCodePreviewEmpty}"
                      SlotMinHeight="120">
                      <ScrollViewer
                        x:Name="TraceCodePreviewScroll"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                          Padding="{DynamicResource TraceCodeInputPadding}"
                          ItemsSource="{Binding TraceCodeLines}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="0" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TraceCodeLineItemViewModel">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                  Grid.Column="0"
                                  Height="{DynamicResource TraceCodeLineHeight}"
                                  VerticalAlignment="Top"
                                  Classes="TraceCodeText"
                                  Classes.Duplicate="{Binding IsDuplicate}"
                                  Classes.Invalid="{Binding IsInvalid}"
                                  Classes.Valid="{Binding IsValid}"
                                  FontFamily="{DynamicResource TraceCodeInputFontFamily}"
                                  FontSize="{DynamicResource TraceCodeInputFontSize}"
                                  LineHeight="{DynamicResource TraceCodeLineHeight}"
                                  Text="{Binding DisplayText}"
                                  TextWrapping="NoWrap" />
                                <TextBlock
                                  Grid.Column="1"
                                  Height="{DynamicResource TraceCodeLineHeight}"
                                  VerticalAlignment="Top"
                                  Classes="TraceCodeStatusHint"
                                  Classes.Duplicate="{Binding IsDuplicate}"
                                  Classes.Invalid="{Binding IsInvalid}"
                                  IsVisible="{Binding ShowStatusHint}"
                                  LineHeight="{DynamicResource TraceCodeLineHeight}"
                                  Text="{Binding StatusHint}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </controls:EmptyStatePanel>
                  </suki:GlassCard>
                </Grid>
              </Grid>

              <Grid
                Grid.Row="2"
                ColumnDefinitions="*,*,*,*,*"
                ColumnSpacing="{DynamicResource SpacingInlineSm}">
                <suki:GlassCard Grid.Column="0" Classes="CounterPillCard">
                  <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingInlineMd}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      Foreground="{StaticResource BrushDone}"
                      Kind="CircleCheck" />
                    <TextBlock Opacity="0.8" Text="有效条码数" />
                    <TextBlock
                      FontWeight="Bold"
                      Foreground="{StaticResource BrushDone}"
                      Text="{Binding ValidCodeCount}" />
                  </StackPanel>
                </suki:GlassCard>

                <suki:GlassCard Grid.Column="1" Classes="CounterPillCard">
                  <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingInlineMd}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      Foreground="{StaticResource BrushWarning}"
                      Kind="CopyPlus" />
                    <TextBlock Opacity="0.8" Text="重复数" />
                    <TextBlock
                      FontWeight="Bold"
                      Foreground="{StaticResource BrushWarning}"
                      Text="{Binding DuplicateCodeCount}" />
                  </StackPanel>
                </suki:GlassCard>

                <suki:GlassCard Grid.Column="2" Classes="CounterPillCard">
                  <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      Foreground="{StaticResource BrushWarning}"
                      Kind="Ban" />
                    <TextBlock Opacity="0.8" Text="跳过入库" />
                    <TextBlock
                      FontWeight="Bold"
                      Foreground="{StaticResource BrushWarning}"
                      Text="{Binding PoolSkipCount}" />
                  </StackPanel>
                </suki:GlassCard>

                <suki:GlassCard Grid.Column="3" Classes="CounterPillCard">
                  <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      Foreground="{StaticResource BrushDanger}"
                      Kind="CircleAlert" />
                    <TextBlock Opacity="0.8" Text="无效数" />
                    <TextBlock
                      FontWeight="Bold"
                      Foreground="{StaticResource BrushDanger}"
                      Text="{Binding InvalidCodeCount}" />
                  </StackPanel>
                </suki:GlassCard>

                <suki:GlassCard Grid.Column="4" Classes="CounterPillCard">
                  <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      Kind="ListOrdered" />
                    <TextBlock Opacity="0.8" Text="总数" />
                    <TextBlock FontWeight="Bold" Text="{Binding TotalCodeCount}" />
                  </StackPanel>
                </suki:GlassCard>
              </Grid>

              <Grid
                Grid.Row="3"
                ColumnDefinitions="Auto,Auto,Auto,*"
                ColumnSpacing="{DynamicResource PageColumnSpacing}">
                <Button
                  Grid.Column="0"
                  Classes="Action"
                  Command="{Binding SubmitCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      Kind="Save" />
                    <TextBlock Text="保存录入" />
                  </StackPanel>
                </Button>

                <Button
                  Grid.Column="1"
                  Classes="Action"
                  Command="{Binding ClearCodesCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      Kind="Delete" />
                    <TextBlock Text="清空输入" />
                  </StackPanel>
                </Button>

                <suki:InfoBadge
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Content="{Binding InputLineCount, StringFormat=行数 {0}}" />
              </Grid>
            </Grid>
          </TabItem>

          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeCompact}"
                  Height="{DynamicResource IconSizeCompact}"
                  Kind="Cloud" />
                <TextBlock Text="自动拉取" />
              </StackPanel>
            </TabItem.Header>

            <Grid
              Margin="{DynamicResource MarginTopMd}"
              RowDefinitions="Auto,Auto,*,Auto"
              RowSpacing="{DynamicResource FormRowSpacing}">
              <suki:GlassCard Grid.Row="0" Classes="CompactCard">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeDefault}"
                    Height="{DynamicResource IconSizeDefault}"
                    Kind="Lightbulb" />
                  <TextBlock Classes="SectionHint" Text="任务面板为占位实现：可演示调度、运行记录和失败重试交互，后续接入真实拉取链路" />
                </StackPanel>
              </suki:GlassCard>

              <Grid
                Grid.Row="1"
                VerticalAlignment="Center"
                ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                ColumnSpacing="{DynamicResource PageColumnSpacing}">
                <suki:GlassCard HorizontalContentAlignment="Center" Classes="CompactCard">
                  <Grid
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="{DynamicResource PageColumnSpacing}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      VerticalAlignment="Center"
                      Foreground="{Binding IsAutoFetchEnabled, Converter={StaticResource BoolToDoneDangerBrush}}"
                      Kind="Power" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Opacity="0.82"
                      Text="自动拉取开关" />
                    <ToggleSwitch
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsAutoFetchEnabled}" />
                  </Grid>
                </suki:GlassCard>

                <suki:GlassCard Grid.Column="1" Classes="CompactCard">
                  <Button Classes="Action" Command="{Binding StartAutoFetchCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeDefault}"
                        Height="{DynamicResource IconSizeDefault}"
                        Kind="CirclePlay" />
                      <TextBlock Text="开始任务" />
                    </StackPanel>
                  </Button>
                </suki:GlassCard>

                <suki:GlassCard Grid.Column="2" Classes="CompactCard">
                  <Button Classes="Action" Command="{Binding StopAutoFetchCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeDefault}"
                        Height="{DynamicResource IconSizeDefault}"
                        Kind="CircleStop" />
                      <TextBlock Text="停止任务" />
                    </StackPanel>
                  </Button>
                </suki:GlassCard>

                <suki:GlassCard Grid.Column="3" Classes="CompactCard">
                  <Button Classes="Action" Command="{Binding RetryFailedCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeDefault}"
                        Height="{DynamicResource IconSizeDefault}"
                        Kind="RotateCcw" />
                      <TextBlock Text="重试失败" />
                    </StackPanel>
                  </Button>
                </suki:GlassCard>

                <suki:GlassCard
                  Grid.Column="4"
                  MinHeight="56"
                  Padding="{StaticResource CompactPadding}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Opacity="0.9">
                  <Grid
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="{DynamicResource SpacingInlineMd}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      VerticalAlignment="Center"
                      Foreground="{StaticResource BrushDone}"
                      Kind="Info" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Classes="SectionHint"
                      Text="{Binding AutoFetchStatus}"
                      TextAlignment="Center"
                      TextTrimming="None"
                      TextWrapping="Wrap" />
                  </Grid>
                </suki:GlassCard>
              </Grid>

              <Grid
                Grid.Row="2"
                ColumnDefinitions="1.3*,1.4*,1.1*"
                ColumnSpacing="{DynamicResource PageColumnSpacing}">
                <suki:GlassCard Grid.Column="0" Classes="CompactCard">
                  <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeDefault}"
                        Height="{DynamicResource IconSizeDefault}"
                        Kind="List" />
                      <TextBlock Classes="SectionTitle" Text="任务列表" />
                      <suki:InfoBadge Content="{Binding AutoTasks.Count, StringFormat=共 {0} 项}" />
                    </StackPanel>

                    <controls:EmptyStatePanel
                      Grid.Row="1"
                      EmptyHint="{Binding AutoTasksEmptyHint}"
                      EmptyText="{Binding AutoTasksEmptyText}"
                      Icon="{Binding SectionEmptyIcon}"
                      IsEmpty="{Binding IsAutoTasksEmpty}"
                      IsPending="{Binding IsSectionPending}"
                      SlotMinHeight="{DynamicResource DgH10Rows}">
                      <suki:BusyArea IsBusy="{Binding IsBusy}">
                        <DataGrid
                          x:Name="AutoTaskGrid"
                          CanUserResizeColumns="True"
                          Classes="SectionGrid"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          ItemsSource="{Binding AutoTasks}"
                          SelectionChanged="OnBrowsingGridSelectionChanged">
                          <DataGrid.Columns>
                            <DataGridTextColumn
                              Width="1.3*"
                              Binding="{Binding Name}"
                              Header="任务" />
                            <DataGridTextColumn
                              Width="1*"
                              Binding="{Binding Schedule}"
                              Header="计划" />
                            <DataGridTextColumn
                              Width="0.8*"
                              Binding="{Binding State}"
                              Header="状态" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </suki:BusyArea>
                    </controls:EmptyStatePanel>
                  </Grid>
                </suki:GlassCard>

                <suki:GlassCard Grid.Column="1" Classes="CompactCard">
                  <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeDefault}"
                        Height="{DynamicResource IconSizeDefault}"
                        Kind="History" />
                      <TextBlock Classes="SectionTitle" Text="最近执行记录" />
                      <suki:InfoBadge Content="{Binding RecentRuns.Count, StringFormat=近 {0} 条}" />
                    </StackPanel>

                    <controls:EmptyStatePanel
                      Grid.Row="1"
                      EmptyHint="{Binding RecentRunsEmptyHint}"
                      EmptyText="{Binding RecentRunsEmptyText}"
                      Icon="{Binding SectionEmptyIcon}"
                      IsEmpty="{Binding IsRecentRunsEmpty}"
                      IsPending="{Binding IsSectionPending}"
                      SlotMinHeight="{DynamicResource DgH10Rows}">
                      <suki:BusyArea IsBusy="{Binding IsBusy}">
                        <DataGrid
                          x:Name="RecentRunGrid"
                          CanUserResizeColumns="True"
                          Classes="SectionGrid"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          ItemsSource="{Binding RecentRuns}"
                          SelectionChanged="OnBrowsingGridSelectionChanged">
                          <DataGrid.Columns>
                            <DataGridTextColumn
                              Width="1.1*"
                              Binding="{Binding Name}"
                              Header="任务" />
                            <DataGridTextColumn
                              Width="1.2*"
                              Binding="{Binding StartedAtText}"
                              Header="开始时间" />
                            <DataGridTextColumn
                              Width="0.8*"
                              Binding="{Binding Result}"
                              Header="结果" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </suki:BusyArea>
                    </controls:EmptyStatePanel>
                  </Grid>
                </suki:GlassCard>

                <suki:GlassCard Grid.Column="2" Classes="CompactCard">
                  <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeDefault}"
                        Height="{DynamicResource IconSizeDefault}"
                        Kind="CircleAlert" />
                      <TextBlock Classes="SectionTitle" Text="失败重试队列" />
                      <suki:InfoBadge Content="{Binding RetryQueue.Count, StringFormat=待重试 {0}}" />
                    </StackPanel>

                    <controls:EmptyStatePanel
                      Grid.Row="1"
                      EmptyHint="{Binding RetryQueueEmptyHint}"
                      EmptyText="{Binding RetryQueueEmptyText}"
                      Icon="{Binding SectionEmptyIcon}"
                      IsEmpty="{Binding IsRetryQueueEmpty}"
                      IsPending="{Binding IsSectionPending}"
                      SlotMinHeight="{DynamicResource DgH10Rows}">
                      <suki:BusyArea IsBusy="{Binding IsBusy}">
                        <DataGrid
                          x:Name="RetryQueueGrid"
                          CanUserResizeColumns="True"
                          Classes="SectionGrid"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          ItemsSource="{Binding RetryQueue}"
                          SelectionChanged="OnBrowsingGridSelectionChanged">
                          <DataGrid.Columns>
                            <DataGridTextColumn
                              Width="1.1*"
                              Binding="{Binding Name}"
                              Header="任务" />
                            <DataGridTextColumn
                              Width="1.2*"
                              Binding="{Binding Reason}"
                              Header="原因" />
                            <DataGridTextColumn
                              Width="0.8*"
                              Binding="{Binding RetryCountText}"
                              Header="重试" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </suki:BusyArea>
                    </controls:EmptyStatePanel>
                  </Grid>
                </suki:GlassCard>
              </Grid>

              <Grid
                Grid.Row="3"
                ColumnDefinitions="Auto,Auto,*"
                ColumnSpacing="{DynamicResource PageColumnSpacing}">
                <Button
                  Grid.Column="0"
                  Classes="Action"
                  Command="{Binding OpenAutoFetchSettingsCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeDefault}"
                      Height="{DynamicResource IconSizeDefault}"
                      Kind="SlidersHorizontal" />
                    <TextBlock Text="参数设置" />
                  </StackPanel>
                </Button>

                <StackPanel
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Orientation="Horizontal"
                  Spacing="{DynamicResource SpacingInlineSm}">
                  <Border
                    Width="{DynamicResource LegendDotSize}"
                    Height="{DynamicResource LegendDotSize}"
                    VerticalAlignment="Center"
                    Background="{Binding IsAutoFetchRunning, Converter={StaticResource BoolToDoneDangerBrush}}"
                    CornerRadius="999" />
                  <TextBlock Opacity="{StaticResource SectionHintOpacity}" Text="运行状态：" />
                  <TextBlock
                    FontWeight="SemiBold"
                    IsVisible="{Binding IsAutoFetchRunning}"
                    Text="运行中" />
                  <TextBlock
                    FontWeight="SemiBold"
                    IsVisible="{Binding !IsAutoFetchRunning}"
                    Text="已停止" />
                </StackPanel>
              </Grid>
            </Grid>
          </TabItem>
        </TabControl>
      </suki:GlassCard>
    </Grid>
  </controls:PageDataShell>
</UserControl>
