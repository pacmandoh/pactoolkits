<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.AboutView"
  xmlns="https://github.com/avaloniaui"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  d:DesignHeight="820"
  d:DesignWidth="1200"
  x:DataType="vm:AboutViewModel"
  mc:Ignorable="d">
  <ScrollViewer
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Visible">
    <Grid Classes="PageRootLayout" RowDefinitions="Auto,Auto,Auto,Auto">

      <!--  Hero  -->
      <shad:Card Grid.Row="0">
        <StackPanel Spacing="0">
          <Border Classes="AboutHeroAccent" />
          <Grid
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="{DynamicResource PageColumnSpacingWide}"
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="6">
            <Image
              Grid.Row="0"
              Grid.RowSpan="3"
              Width="72"
              Height="72"
              VerticalAlignment="Center"
              Source="avares://pactoolkits-desktop/Assets/icon-128.png"
              Stretch="Uniform" />

            <TextBlock
              Grid.Row="0"
              Grid.Column="1"
              VerticalAlignment="Center"
              Classes="AboutHeroKicker"
              Text="ABOUT · PACTOOLKITS" />
            <TextBlock
              Grid.Row="1"
              Grid.Column="1"
              VerticalAlignment="Center"
              FontSize="{DynamicResource AboutHeroTitleSize}"
              FontWeight="Bold"
              Text="PacToolkits" />
            <TextBlock
              Grid.Row="2"
              Grid.Column="1"
              VerticalAlignment="Center"
              FontSize="{DynamicResource AboutSubtitleSize}"
              Opacity="0.84"
              Text="自动化套件" />

            <TextBlock
              Grid.Row="0"
              Grid.Column="2"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Classes="AboutMetaLabel"
              Text="当前版本" />
            <TextBlock
              Grid.Row="1"
              Grid.Column="2"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Classes="AboutHeroVersion"
              Text="{Binding ProductVersion}" />
            <shad:Badge Variant="Secondary"
              Grid.Row="2"
              Grid.Column="2"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Content="{Binding VersionStatus}"
              Foreground="{DynamicResource BrushInfo}" />
          </Grid>
        </StackPanel>
      </shad:Card>

      <!--  Maintainer + Version  -->
      <Grid
        Grid.Row="1"
        ColumnDefinitions="1.05*,0.95*"
        ColumnSpacing="{DynamicResource PageColumnSpacing}">
        <shad:Card>
          <StackPanel Spacing="{DynamicResource FormRowSpacing}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeSectionHeader}"
                Height="{DynamicResource IconSizeSectionHeader}"
                Kind="IdCardLanyard" />
              <TextBlock
                VerticalAlignment="Center"
                Classes="SectionTitle"
                Text="项目与维护者" />
            </StackPanel>

            <Border Classes="AboutPanelDivider" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource FormColumnSpacing}">
              <shad:Card
                Width="52"
                Height="52"
                CornerRadius="14"
                Opacity="0.94">
                <icons:AppIcon
                  Width="24"
                  Height="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Kind="UserRound" />
              </shad:Card>
              <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="4">
                <TextBlock Classes="AboutAuthor" Text="窦皓 · PacmanDoh" />
                <TextBlock Opacity="0.86" Text="产品设计 / 自动化开发 / 业务落地" />
                <TextBlock
                  Classes="SectionHint"
                  Text="井研县中医医院药剂科项目维护者，聚焦追溯码录入效率、库存一致性与流程稳定性"
                  TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <WrapPanel ItemSpacing="{DynamicResource SpacingInlineSm}" LineSpacing="{DynamicResource SpacingInlineSm}">
              <controls:StatusPill
                Classes="ToneInfo15"
                Icon="UserRound"
                Text="Owner" />
              <controls:StatusPill
                Classes="ToneDone25"
                Icon="ShieldCheck"
                Text="Maintainer" />
              <controls:StatusPill
                Classes="ToneInfo15"
                Icon="Calendar"
                Text="2026" />
            </WrapPanel>

            <shad:Card>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SpacingInlineMd}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeDefault}"
                  Height="{DynamicResource IconSizeDefault}"
                  VerticalAlignment="Center"
                  Kind="Hospital" />
                <StackPanel
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Classes="AboutMetaLabel" Text="服务单位" />
                  <TextBlock Classes="AboutMetaValue" Text="井研县中医医院 · 药剂科" />
                </StackPanel>
              </Grid>
            </shad:Card>
          </StackPanel>
        </shad:Card>

        <shad:Card Grid.Column="1">
          <StackPanel Spacing="{DynamicResource FormRowSpacing}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeSectionHeader}"
                Height="{DynamicResource IconSizeSectionHeader}"
                Kind="Tags" />
              <TextBlock
                VerticalAlignment="Center"
                Classes="SectionTitle"
                Text="版本与构建" />
            </StackPanel>

            <Border Classes="AboutPanelDivider" />

            <TextBlock
              Classes="SectionHint"
              Text="{Binding VersionHint}"
              TextWrapping="Wrap" />

            <Grid
              ColumnDefinitions="*,*"
              ColumnSpacing="{DynamicResource PageColumnSpacing}"
              RowDefinitions="Auto,Auto,Auto"
              RowSpacing="{DynamicResource DialogInnerRowSpacing}">
              <TextBlock Classes="AboutMetaLabel" Text="发布通道" />
              <TextBlock
                Grid.Column="1"
                Classes="AboutMetaValue"
                Text="{Binding BuildChannel}" />
              <TextBlock
                Grid.Row="1"
                Classes="AboutMetaLabel"
                Text="构建日期" />
              <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Classes="AboutMetaValue"
                Text="{Binding BuildDate}" />
              <TextBlock
                Grid.Row="2"
                Classes="AboutMetaLabel"
                Text="Desktop DB" />
              <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                Classes="SectionHint"
                Text="{Binding CompatDesktopDbRangeText}" />
            </Grid>

            <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="{DynamicResource SpacingInlineMd}">
              <shad:Card Grid.Column="0">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="Database" />
                    <TextBlock Classes="AboutMetricLabel" Text="DB Schema" />
                  </StackPanel>
                  <TextBlock Classes="AboutMetricValue" Text="{Binding DatabasePostgresVersion}" />
                  <TextBlock Classes="SectionHint" Text="结构兼容性校验" />
                </StackPanel>
              </shad:Card>
              <shad:Card Grid.Column="1">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="Keyboard" />
                    <TextBlock Classes="AboutMetricLabel" Text="Agent AHK" />
                  </StackPanel>
                  <TextBlock Classes="AboutMetricValue" Text="{Binding AgentInjectorAhkVersion}" />
                  <TextBlock Classes="SectionHint" Text="自动化执行层" />
                </StackPanel>
              </shad:Card>
              <shad:Card Grid.Column="2">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Kind="AppWindow" />
                    <TextBlock Classes="AboutMetricLabel" Text="Desktop" />
                  </StackPanel>
                  <TextBlock Classes="AboutMetricValue" Text="{Binding DesktopVersion}" />
                  <TextBlock Classes="SectionHint" Text="components.desktop" />
                </StackPanel>
              </shad:Card>
            </Grid>

            <ItemsControl ItemsSource="{Binding VersionBadges}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="{DynamicResource SpacingInlineSm}" LineSpacing="{DynamicResource SpacingInlineSm}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VersionBadgeItem">
                  <shad:Badge Variant="Secondary" Content="{Binding Display}" Foreground="{DynamicResource MutedColor}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </shad:Card>
      </Grid>

      <!--  Architecture  -->
      <shad:Card Grid.Row="2">
        <StackPanel Spacing="{DynamicResource FormRowSpacing}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineMd}">
            <icons:AppIcon
              Width="{DynamicResource IconSizeSectionHeader}"
              Height="{DynamicResource IconSizeSectionHeader}"
              Kind="Workflow" />
            <TextBlock
              VerticalAlignment="Center"
              Classes="SectionTitle"
              Text="系统架构" />
          </StackPanel>

          <Border Classes="AboutPanelDivider" />

          <Grid ColumnDefinitions="1*,Auto,1*,Auto,1*" ColumnSpacing="{DynamicResource SpacingInlineMd}">
            <shad:Card Grid.Column="0">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeDefault}"
                    Height="{DynamicResource IconSizeDefault}"
                    Kind="MonitorCog" />
                  <TextBlock Classes="AboutMetricLabel" Text="桌面编排" />
                </StackPanel>
                <TextBlock Classes="AboutTechTitle" Text="Avalonia + .NET" />
                <TextBlock
                  Classes="SectionHint"
                  Text="业务配置、任务调度与 UI 交互"
                  TextWrapping="Wrap" />
              </StackPanel>
            </shad:Card>

            <icons:AppIcon
              Grid.Column="1"
              Width="{DynamicResource IconSizeDefault}"
              Height="{DynamicResource IconSizeDefault}"
              VerticalAlignment="Center"
              Kind="ChevronRight"
              Opacity="0.45" />

            <shad:Card Grid.Column="2">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeDefault}"
                    Height="{DynamicResource IconSizeDefault}"
                    Kind="Bot" />
                  <TextBlock Classes="AboutMetricLabel" Text="自动化执行" />
                </StackPanel>
                <TextBlock Classes="AboutTechTitle" Text="AHK + Python" />
                <TextBlock
                  Classes="SectionHint"
                  Text="追溯码注入、自动拉取与桥接流程"
                  TextWrapping="Wrap" />
              </StackPanel>
            </shad:Card>

            <icons:AppIcon
              Grid.Column="3"
              Width="{DynamicResource IconSizeDefault}"
              Height="{DynamicResource IconSizeDefault}"
              VerticalAlignment="Center"
              Kind="ChevronRight"
              Opacity="0.45" />

            <shad:Card Grid.Column="4">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeDefault}"
                    Height="{DynamicResource IconSizeDefault}"
                    Kind="Database" />
                  <TextBlock Classes="AboutMetricLabel" Text="数据落库" />
                </StackPanel>
                <TextBlock Classes="AboutTechTitle" Text="PostgreSQL" />
                <TextBlock
                  Classes="SectionHint"
                  Text="追溯码、库存与配置的统一数据源"
                  TextWrapping="Wrap" />
              </StackPanel>
            </shad:Card>
          </Grid>

          <Grid ColumnDefinitions="1*,1*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
            <shad:Card Grid.Column="0">
              <StackPanel Spacing="{DynamicResource DialogInnerRowSpacing}">
                <TextBlock Classes="AboutSectionKicker" Text="界面与运行时" />
                <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
                  <Grid ColumnDefinitions="Auto,Auto,*">
                    <Border Background="{DynamicResource TechBrandAvalonia}" Classes="AboutTechAccent" />
                    <icons:AppIcon
                      Grid.Column="1"
                      Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Kind="AppWindow" />
                    <StackPanel Grid.Column="2" Spacing="1">
                      <TextBlock Classes="AboutTechTitle" Text="Avalonia UI" />
                      <TextBlock Classes="SectionHint" Text="跨平台桌面 UI 主框架" />
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*">
                    <Border Background="{DynamicResource TechBrandDotNet}" Classes="AboutTechAccent" />
                    <icons:AppIcon
                      Grid.Column="1"
                      Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Kind="Braces" />
                    <StackPanel Grid.Column="2" Spacing="1">
                      <TextBlock Classes="AboutTechTitle" Text="C# / .NET" />
                      <TextBlock Classes="SectionHint" Text="业务编排与应用生命周期" />
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto,*">
                    <Border Background="{DynamicResource TechBrandMac}" Classes="AboutTechAccent" />
                    <icons:AppIcon
                      Grid.Column="1"
                      Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Kind="Laptop" />
                    <StackPanel Grid.Column="2" Spacing="1">
                      <TextBlock Classes="AboutTechTitle" Text="macOS" />
                      <TextBlock Classes="SectionHint" Text="主要开发与测试平台" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </StackPanel>
            </shad:Card>

            <shad:Card Grid.Column="1">
              <StackPanel Spacing="{DynamicResource DialogInnerRowSpacing}">
                <TextBlock Classes="AboutSectionKicker" Text="数据与自动化" />
                <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
                  <Grid ColumnDefinitions="Auto,Auto,*">
                    <Border Background="{DynamicResource TechBrandPostgre}" Classes="AboutTechAccent" />
                    <icons:AppIcon
                      Grid.Column="1"
                      Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Kind="Database" />
                    <StackPanel Grid.Column="2" Spacing="1">
                      <TextBlock Classes="AboutTechTitle" Text="PostgreSQL" />
                      <TextBlock Classes="SectionHint" Text="追溯码与库存核心数据库" />
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*">
                    <Border Background="{DynamicResource TechBrandPython}" Classes="AboutTechAccent" />
                    <icons:AppIcon
                      Grid.Column="1"
                      Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Kind="Terminal" />
                    <StackPanel Grid.Column="2" Spacing="1">
                      <TextBlock Classes="AboutTechTitle" Text="Python" />
                      <TextBlock Classes="SectionHint" Text="自动拉取与数据桥接流程" />
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto,*">
                    <Border Background="{DynamicResource TechBrandAhk}" Classes="AboutTechAccent" />
                    <icons:AppIcon
                      Grid.Column="1"
                      Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Kind="Keyboard" />
                    <StackPanel Grid.Column="2" Spacing="1">
                      <TextBlock Classes="AboutTechTitle" Text="AutoHotkey" />
                      <TextBlock Classes="SectionHint" Text="追溯码自动注入执行层" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </StackPanel>
            </shad:Card>
          </Grid>

          <Border Classes="AboutPanelDivider" />

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource PageColumnSpacing}">
            <shad:Card>
              <StackPanel Spacing="{DynamicResource DialogInnerRowSpacing}">
                <TextBlock Classes="AboutSectionKicker" Text="开发与工具链" />
                <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
                  <Grid ColumnDefinitions="Auto,Auto,*">
                    <Border Background="{DynamicResource TechBrandRider}" Classes="AboutTechAccent" />
                    <icons:AppIcon
                      Grid.Column="1"
                      Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Kind="SquareCode" />
                    <StackPanel Grid.Column="2" Spacing="1">
                      <TextBlock Classes="AboutTechTitle" Text="JetBrains Rider" />
                      <TextBlock Classes="SectionHint" Text="C#/.NET 主力 IDE" />
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*">
                    <Border Background="{DynamicResource TechBrandDataGrip}" Classes="AboutTechAccent" />
                    <icons:AppIcon
                      Grid.Column="1"
                      Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Kind="TableProperties" />
                    <StackPanel Grid.Column="2" Spacing="1">
                      <TextBlock Classes="AboutTechTitle" Text="JetBrains DataGrip" />
                      <TextBlock Classes="SectionHint" Text="SQL 调试与数据校验" />
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto,*">
                    <Border Background="{DynamicResource TechBrandVsCode}" Classes="AboutTechAccent" />
                    <icons:AppIcon
                      Grid.Column="1"
                      Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Kind="Code" />
                    <StackPanel Grid.Column="2" Spacing="1">
                      <TextBlock Classes="AboutTechTitle" Text="Visual Studio Code" />
                      <TextBlock Classes="SectionHint" Text="脚本与轻量编辑工具" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </StackPanel>
            </shad:Card>

            <StackPanel
              Grid.Column="1"
              MinWidth="220"
              VerticalAlignment="Bottom"
              Spacing="{DynamicResource DialogInnerRowSpacing}">
              <shad:Card>
                <StackPanel Spacing="4">
                  <TextBlock Classes="AboutMetaLabel" Text="当前阶段" />
                  <TextBlock Classes="AboutMetaValue" Text="M3 · 自动化能力稳定化" />
                  <TextBlock
                    Classes="SectionHint"
                    Text="重点：追溯码注入成功率、并发一致性与配置可维护性"
                    TextWrapping="Wrap" />
                </StackPanel>
              </shad:Card>
              <WrapPanel ItemSpacing="{DynamicResource SpacingInlineSm}" LineSpacing="{DynamicResource SpacingInlineSm}">
                <controls:StatusPill
                  Classes="ToneInfo15"
                  Icon="MonitorCog"
                  Text="Desktop Native" />
                <controls:StatusPill
                  Classes="ToneDone25"
                  Icon="Bot"
                  Text="Automation First" />
                <controls:StatusPill
                  Classes="ToneInfo15"
                  Icon="Database"
                  Text="Data Driven" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </StackPanel>
      </shad:Card>

      <!--  Dev lab (DEBUG only)  -->
      <shad:Card
        Grid.Row="3"
        IsVisible="{Binding IsDevLabVisible}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SpacingInlineMd}">
            <icons:AppIcon
              Width="{DynamicResource IconSizeDefault}"
              Height="{DynamicResource IconSizeDefault}"
              VerticalAlignment="Center"
              Kind="FlaskConical" />
            <TextBlock
              Grid.Column="1"
              Classes="SectionTitle"
              Text="交互实验室" />
          </Grid>

          <Grid
            Grid.Row="1"
            ColumnDefinitions="1.2*,1.2*,1.2*"
            ColumnSpacing="{DynamicResource PageColumnSpacing}">
            <shad:Card
              Grid.Column="0"
              Padding="{StaticResource CompactPadding}"
              Opacity="0.95">
              <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource DialogFormRowSpacing}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeSmall}"
                    Height="{DynamicResource IconSizeSmall}"
                    Kind="ShieldCheck" />
                  <TextBlock Opacity="0.8" Text="稳定性指数" />
                </StackPanel>
                <TextBlock
                  Grid.Row="1"
                  Classes="AboutStat"
                  Text="96%" />
                <ProgressBar
                  Grid.Row="2"
                  Height="{DynamicResource LegendDotSize}"
                  Maximum="100"
                  Minimum="0"
                  Value="96" />
              </Grid>
            </shad:Card>

            <shad:Card
              Grid.Column="1"
              Padding="{StaticResource CompactPadding}"
              Opacity="0.95">
              <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource DialogFormRowSpacing}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeSmall}"
                    Height="{DynamicResource IconSizeSmall}"
                    Kind="Zap" />
                  <TextBlock Opacity="0.8" Text="响应效率" />
                </StackPanel>
                <TextBlock
                  Grid.Row="1"
                  Classes="AboutStat"
                  Text="89%" />
                <ProgressBar
                  Grid.Row="2"
                  Height="{DynamicResource LegendDotSize}"
                  Maximum="100"
                  Minimum="0"
                  Value="89" />
              </Grid>
            </shad:Card>

            <shad:Card
              Grid.Column="2"
              Padding="{StaticResource CompactPadding}"
              Opacity="0.95">
              <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource DialogFormRowSpacing}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeSmall}"
                    Height="{DynamicResource IconSizeSmall}"
                    Kind="DatabaseBackup" />
                  <TextBlock Opacity="0.8" Text="数据一致性" />
                </StackPanel>
                <TextBlock
                  Grid.Row="1"
                  Classes="AboutStat"
                  Text="92%" />
                <ProgressBar
                  Grid.Row="2"
                  Height="{DynamicResource LegendDotSize}"
                  Maximum="100"
                  Minimum="0"
                  Value="92" />
              </Grid>
            </shad:Card>
          </Grid>

          <Grid
            Grid.Row="2"
            ColumnDefinitions="1.1*,1.1*,1.1*"
            ColumnSpacing="{DynamicResource PageColumnSpacing}">
            <StackPanel Spacing="{DynamicResource FormRowSpacing}">
              <TextBlock Classes="Small" FontWeight="SemiBold" Text="视觉标记样例" />
              <WrapPanel
                Margin="{DynamicResource AboutSectionInset}"
                ItemSpacing="{DynamicResource SpacingInlineMd}"
                LineSpacing="{DynamicResource SpacingInlineMd}">
                <controls:StatusPill
                  Classes="ToneDone25"
                  Icon="CircleCheck"
                  Text="Online" />
                <controls:StatusPill
                  Classes="ToneDone25"
                  Icon="Bot"
                  Text="AutoFetch" />
                <controls:StatusPill
                  Classes="ToneWarning25"
                  Icon="Clock"
                  Text="Pending" />
                <controls:StatusPill
                  Classes="ToneDanger15"
                  Icon="Undo"
                  Text="Rollback" />
              </WrapPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="{DynamicResource FormRowSpacing}">
              <TextBlock Classes="Small" FontWeight="SemiBold" Text="Settings Layout（演示）" />
              <Grid
                Margin="{DynamicResource AboutSectionInset}"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="{DynamicResource PageColumnSpacing}"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="{DynamicResource DialogInnerRowSpacing}">
                <TextBlock VerticalAlignment="Center" Text="主题模式" />
                <ComboBox
                  Grid.Row="0"
                  Grid.Column="1"
                  SelectedIndex="0">
                  <ComboBoxItem Content="System" />
                  <ComboBoxItem Content="Light" />
                  <ComboBoxItem Content="Dark" />
                </ComboBox>

                <TextBlock
                  Grid.Row="1"
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Text="启用动画" />
                <ToggleSwitch
                  Grid.Row="1"
                  Grid.Column="1"
                  IsChecked="True" />

                <TextBlock
                  Grid.Row="2"
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Text="密度" />
                <Slider
                  Grid.Row="2"
                  Grid.Column="1"
                  Maximum="100"
                  Minimum="0"
                  Value="68" />

                <TextBlock
                  Grid.Row="3"
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Text="刷新间隔" />
                <NumericUpDown
                  Grid.Row="3"
                  Grid.Column="1"
                  Maximum="60"
                  Minimum="1"
                  Value="10" />
              </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="{DynamicResource FormRowSpacing}">
              <TextBlock Classes="Small" FontWeight="SemiBold" Text="Button 样式（实验）" />
              <WrapPanel
                Margin="{DynamicResource AboutSectionInset}"
                ItemSpacing="{DynamicResource SpacingInlineMd}"
                LineSpacing="{DynamicResource SpacingInlineMd}">
                <Button Content="Standard" />
                <Button Classes="Flat" Content="Flat" />
                <Button Classes="Rounded" Content="Rounded" />
                <Button Classes="Outlined" Content="Outlined" />
                <Button Classes="Basic" Content="Basic" />
                <Button Classes="Flat Accent" Content="Flat Accent" />
                <Button Classes="Large" Content="Large" />
              </WrapPanel>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="3" Spacing="{DynamicResource FormRowSpacing}">
              <TextBlock Classes="Small" FontWeight="SemiBold" Text="WaveProgress（可调演示）" />
            <Grid
              MinHeight="250"
              Margin="{DynamicResource AboutSectionInset}"
              VerticalAlignment="Center"
              ColumnDefinitions="280,*"
              ColumnSpacing="18">
              <Grid VerticalAlignment="Center" RowDefinitions="*,Auto">
                <ProgressBar
                  Grid.Row="0"
                  Width="220"
                  HorizontalAlignment="Center"
                  Maximum="100"
                  VerticalAlignment="Center"
                  Value="{Binding WaveDemoValue}" />
                <TextBlock
                  Grid.Row="1"
                  Margin="{DynamicResource AboutSectionInsetTop}"
                  HorizontalAlignment="Center"
                  Classes="AboutStat"
                  Text="{Binding WaveDemoValue, StringFormat={}{0:0}%}" />
              </Grid>

              <Grid
                Grid.Column="1"
                VerticalAlignment="Center"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="{DynamicResource FormRowSpacing}">
                <TextBlock FontWeight="SemiBold" Text="拖动滑块可实时调节水波高度" />
                <Slider
                  Grid.Row="1"
                  Maximum="100"
                  Minimum="0"
                  Value="{Binding WaveDemoValue, Mode=TwoWay}" />
                <TextBlock
                  Grid.Row="2"
                  Classes="SectionHint"
                  Text="样式参考 WaveProgress 演示：WaveProgress + 拖动调节 + 实时数值" />
              </Grid>
            </Grid>
          </StackPanel>

          <StackPanel Grid.Row="4" Spacing="{DynamicResource FormRowSpacing}">
              <TextBlock Classes="Small" FontWeight="SemiBold" Text="交互组件预览" />
            <TabControl Margin="{DynamicResource AboutSectionInset}" SelectedIndex="0">
              <TabItem Header="布局">
                <Grid
                  Margin="{DynamicResource AboutSectionInset}"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="{DynamicResource PageColumnSpacing}">
                  <TextBlock VerticalAlignment="Center" Text="主机名" />
                  <TextBox Grid.Column="1" PlaceholderText="例如：127.0.0.1" />
                </Grid>
              </TabItem>
              <TabItem Header="信息">
                <Expander
                  Margin="{DynamicResource AboutSectionInset}"
                  Header="展开查看说明"
                  IsExpanded="True">
                  <TextBlock
                    Margin="{DynamicResource AboutExpanderContentMargin}"
                    Classes="SectionHint"
                    Text="这里可放置系统能力说明、版本策略或排障建议，作为可折叠信息块"
                    TextWrapping="Wrap" />
                </Expander>
              </TabItem>
            </TabControl>
          </StackPanel>
        </Grid>
      </shad:Card>
    </Grid>
  </ScrollViewer>
</UserControl>
