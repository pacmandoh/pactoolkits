<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.MsfxLinkUpstreamTabView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:DataType="vm:MsfxLink"
  Focusable="True">
  <Grid
    Margin="{DynamicResource MarginTopLg}"
    RowDefinitions="Auto,*"
    RowSpacing="{DynamicResource FormRowSpacing}">
    <shad:Card Grid.Row="0">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
        <Grid
          Grid.Row="0"
          ColumnDefinitions="72,360,86,320,*,Auto,Auto"
          ColumnSpacing="{DynamicResource PageColumnSpacing}">
          <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="日期" />
          <Grid
            Grid.Column="1"
            ColumnDefinitions="*,*"
            ColumnSpacing="{DynamicResource PageColumnSpacing}">
            <CalendarDatePicker
              Grid.Column="0"
              Classes="MsfxInput"
              DisplayDateEnd="{Binding UpoutFromMaxDate}"
              IsTodayHighlighted="True"
              SelectedDate="{Binding UpoutFromDate}" />
            <CalendarDatePicker
              Grid.Column="1"
              Classes="MsfxInput"
              DisplayDateEnd="{Binding UpoutToMaxDate}"
              DisplayDateStart="{Binding UpoutToMinDate}"
              IsTodayHighlighted="True"
              SelectedDate="{Binding UpoutToDate}" />
          </Grid>

          <TextBlock
            Grid.Column="2"
            VerticalAlignment="Center"
            Text="单据编码" />
          <TextBox
            Grid.Column="3"
            Classes="MsfxInput"
            PlaceholderText="可选：按 bill_code 过滤"
            Text="{Binding UpoutBillCodeKeyword, Mode=TwoWay}" />

          <Button
            Grid.Column="5"
            Classes="Action"
            Command="{Binding QueryUpoutCommand}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeCompact}"
                Height="{DynamicResource IconSizeCompact}"
                Kind="Search" />
              <TextBlock Text="查询" />
            </StackPanel>
          </Button>

          <Button
            Grid.Column="6"
            Classes="Ghost"
            Command="{Binding ResetUpoutFiltersCommand}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeCompact}"
                Height="{DynamicResource IconSizeCompact}"
                Kind="RefreshCw" />
              <TextBlock Text="重置" />
            </StackPanel>
          </Button>
        </Grid>

        <Grid
          Grid.Row="1"
          ColumnDefinitions="72,360,86,320,*"
          ColumnSpacing="{DynamicResource PageColumnSpacing}">
          <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="药品" />
          <TextBox
            Grid.Column="1"
            Classes="MsfxInput"
            PlaceholderText="可选：药品关键字"
            Text="{Binding UpoutDrugKeyword, Mode=TwoWay}" />

          <TextBlock
            Grid.Column="2"
            VerticalAlignment="Center"
            Text="发货单位" />
          <TextBox
            Grid.Column="3"
            Classes="MsfxInput"
            PlaceholderText="可选：发货单位关键字"
            Text="{Binding UpoutFromEntKeyword, Mode=TwoWay}" />

          <WrapPanel
            Grid.Column="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            ItemSpacing="10"
            Orientation="Horizontal">
            <shad:Badge
              VerticalAlignment="Center"
              Content="默认显示最近 7 天"
              Variant="Secondary" />
          </WrapPanel>
        </Grid>
      </Grid>
    </shad:Card>

    <shad:Card Grid.Row="1">
      <Grid
        Margin="{DynamicResource MarginHorizontalTiny}"
        RowDefinitions="Auto,*"
        RowSpacing="{DynamicResource DialogRowSpacing}">
        <controls:DataGridPager
          FirstPageCommand="{Binding FirstUpoutPageCommand}"
          IsContentEmpty="{Binding IsUpoutEmpty}"
          LastPageCommand="{Binding LastUpoutPageCommand}"
          NextPageCommand="{Binding NextUpoutPageCommand}"
          PageSizeOptions="{Binding UpoutPageSizeOptions}"
          Placement="Top"
          PrevPageCommand="{Binding PrevUpoutPageCommand}"
          SelectedPageSize="{Binding UpoutPageSize, Mode=TwoWay}"
          StatusText="{Binding UpoutStatus}"
          TotalCount="{Binding UpoutTotal}"
          TotalPages="{Binding UpoutTotalPages}"
          PageIndex="{Binding UpoutPage}" />

        <shad:BusyArea Grid.Row="1" IsBusy="{Binding IsUpoutBusy}">
          <controls:EmptyStatePanel
            EmptyHint="请调整筛选条件并执行查询"
            EmptyText="暂无上游出库单"
            IsEmpty="{Binding IsUpoutEmpty}">
            <DataGrid
              Classes="SectionGrid InventoryGrid IndexedGrid"
              HorizontalScrollBarVisibility="Auto"
              ItemsSource="{Binding UpoutRows}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="44">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border
                        Width="24"
                        Height="24"
                        Background="{Binding State, Converter={StaticResource TraceEntryStateToBgBrush}}"
                        Classes="DgStatusBadge"
                        CornerRadius="12">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeSmall}"
                          Height="{DynamicResource IconSizeSmall}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{Binding State, Converter={StaticResource TraceEntryStateToFgBrush}}"
                          Kind="{Binding State, Converter={StaticResource TraceEntryStateToIconKind}}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                  Width="240"
                  Binding="{Binding BillCode}"
                  Header="单据编码" />
                <DataGridTextColumn
                  Width="120"
                  Binding="{Binding BillType}"
                  Header="单据类型" />
                <DataGridTextColumn
                  Width="170"
                  Binding="{Binding BillTime}"
                  Header="时间" />
                <DataGridTextColumn
                  Width="260"
                  Binding="{Binding DrugName}"
                  Header="药品" />
                <DataGridTextColumn
                  Width="130"
                  Binding="{Binding PackageSpec}"
                  Header="包装规格" />
                <DataGridTextColumn
                  Width="180"
                  Binding="{Binding PrepnSpec}"
                  Header="制剂规格" />
                <DataGridTextColumn
                  Width="110"
                  Binding="{Binding CodeCount}"
                  Header="追溯码数" />
                <DataGridTextColumn
                  Width="100"
                  Binding="{Binding PrepnCount}"
                  Header="数量" />
                <DataGridTextColumn
                  Width="120"
                  Binding="{Binding ProduceBatchNo}"
                  Header="批号" />
                <DataGridTextColumn
                  Width="120"
                  Binding="{Binding ExpireDate}"
                  Header="有效期" />
                <DataGridTextColumn
                  Width="240"
                  Binding="{Binding FromEntName}"
                  Header="发货单位" />
                <DataGridTextColumn
                  Width="230"
                  Binding="{Binding FromRefUserId}"
                  Header="发货RefId" />
                <DataGridTextColumn
                  Width="220"
                  Binding="{Binding ProduceEntName}"
                  Header="生产企业" />
                <DataGridTextColumn
                  Width="130"
                  Binding="{Binding LogisticsStatus}"
                  Header="入库状态" />
              </DataGrid.Columns>
            </DataGrid>
          </controls:EmptyStatePanel>
        </shad:BusyArea>
      </Grid>
    </shad:Card>
  </Grid>
</UserControl>
