<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.MsfxLinkHeader"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:vm="using:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:DataType="vm:MsfxLink"
  Classes="PageHeaderContent">
  <Grid ColumnDefinitions="Auto,Auto,*,Auto">
    <StackPanel
      Margin="4,0,0,0"
      Orientation="Horizontal"
      Spacing="4">
      <Button
        Classes="Icon ghost-states"
        Classes.active="{Binding IsRunConfigBarVisible}"
        Command="{Binding ToggleRunConfigBarCommand}"
        IsVisible="{Binding IsRunPage}"
        ToolTip.Tip="{Binding RunConfigBarToggleToolTip}">
        <icons:AppIcon Kind="{Binding RunConfigBarToggleIconKind}" />
      </Button>
      <Button
        Classes="Icon ghost-states"
        Classes.active="{Binding IsQueueSearchBarVisible}"
        Command="{Binding ToggleQueueSearchBarCommand}"
        IsVisible="{Binding ShowQueueSearchHeaderAction}"
        ToolTip.Tip="{Binding QueueSearchBarToggleToolTip}">
        <icons:AppIcon Kind="{Binding QueueSearchBarToggleIconKind}" />
      </Button>
      <Button
        Classes="Icon ghost-states"
        Classes.active="{Binding IsMappingConfigBarVisible}"
        Command="{Binding ToggleMappingConfigBarCommand}"
        IsVisible="{Binding ShowMappingConfigHeaderAction}"
        ToolTip.Tip="{Binding MappingConfigBarToggleToolTip}">
        <icons:AppIcon Kind="{Binding MappingConfigBarToggleIconKind}" />
      </Button>
      <Button
        Classes="Icon ghost-states"
        Command="{Binding UnlockCommand}"
        IsVisible="{Binding ShowUnlock}"
        ToolTip.Tip="解锁">
        <icons:AppIcon Foreground="{DynamicResource WarningColor}" Kind="LockKeyhole" />
      </Button>
      <Button
        Classes="Icon ghost-states"
        Command="{Binding LockCommand}"
        IsVisible="{Binding ShowLock}"
        ToolTip.Tip="锁定">
        <icons:AppIcon Foreground="{DynamicResource ErrorColor}" Kind="LockKeyholeOpen" />
      </Button>
    </StackPanel>
    <Rectangle Grid.Column="1" Classes="HeaderDivider" />
    <StackPanel
      Grid.Column="2"
      Classes="HeaderTitleRail"
      Orientation="Horizontal">
      <TextBlock Classes="Small Muted" Text="{Binding DisplayName}" />
      <icons:AppIcon Classes="HeaderTitleChevron" Kind="ChevronRight" />
      <TabControl
        shad:TabControlBehaviors.UseSlidingPill="True"
        Classes="ContentHeaderTabs"
        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabItem>
          <TabItem.Header>
            <StackPanel Classes="TabItemHeader">
              <icons:AppIcon Kind="Gauge" />
              <TextBlock Text="运行中心" />
            </StackPanel>
          </TabItem.Header>
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Classes="TabItemHeader">
              <icons:AppIcon Kind="ListTodo" />
              <TextBlock Text="处理队列" />
            </StackPanel>
          </TabItem.Header>
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Classes="TabItemHeader">
              <icons:AppIcon Kind="ClipboardSearch" />
              <TextBlock Text="上游核查" />
            </StackPanel>
          </TabItem.Header>
        </TabItem>
      </TabControl>
    </StackPanel>
    <Menu
      Grid.Column="3"
      Classes="HeaderMenu"
      IsVisible="{Binding IsRunPage}">
      <MenuItem Command="{Binding RunAutoOnceCommand}">
        <MenuItem.Header>
          <StackPanel Classes="HeaderMenuItem">
            <icons:AppIcon Kind="CirclePlay" />
            <TextBlock Text="立即巡检" />
          </StackPanel>
        </MenuItem.Header>
      </MenuItem>
      <MenuItem Command="{Binding ClearAutoLogsCommand}">
        <MenuItem.Header>
          <StackPanel Classes="HeaderMenuItem">
            <icons:AppIcon Kind="Eraser" />
            <TextBlock Text="清空日志" />
          </StackPanel>
        </MenuItem.Header>
      </MenuItem>
    </Menu>
    <Menu
      Grid.Column="3"
      Classes="HeaderMenu"
      IsVisible="{Binding IsQueuePage}">
      <MenuItem Command="{Binding ToggleQueueWorkspaceCommand}">
        <MenuItem.Header>
          <StackPanel Classes="HeaderMenuItem">
            <icons:AppIcon Kind="{Binding QueueWorkspaceToggleIcon}" />
            <TextBlock Text="{Binding QueueWorkspaceToggleText}" />
          </StackPanel>
        </MenuItem.Header>
      </MenuItem>
    </Menu>
  </Grid>
</UserControl>
