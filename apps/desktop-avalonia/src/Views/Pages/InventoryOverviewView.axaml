<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Views.Pages.InventoryOverviewView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:PacToolkits.Desktop.Avalonia.Behaviors"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:vm="clr-namespace:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  x:Name="Root"
  d:DesignHeight="800"
  d:DesignWidth="1200"
  x:DataType="vm:InventoryOverview"
  Focusable="True"
  mc:Ignorable="d">
  <controls:PageDataShell
    ShowStale="{Binding IsShowingStaleData}"
    ShowUnavailable="{Binding ShowPageUnavailable}"
    StaleHint="{Binding PageStaleHint}"
    UnavailableHint="{Binding PageUnavailableHint}"
    UnavailableIcon="{Binding PageUnavailableIcon}"
    UnavailableTitle="{Binding PageUnavailableTitle}">
    <Grid
      MinHeight="0"
      Margin="0"
      RowDefinitions="Auto,*">
      <controls:DeferredContentHost
        x:Name="ReassignPanelHost"
        Grid.Row="0"
        IsActive="{Binding IsReassignOpen}"
        IsVisible="{Binding IsReassignOpen}">
        <controls:DeferredContentHost.ContentTemplate>
          <DataTemplate x:DataType="vm:InventoryOverview">
            <Grid
              behaviors:FocusClear.SuppressGridClear="{Binding SuppressGridClear}"
              ClipToBounds="True"
              RowDefinitions="Auto,Auto"
              RowSpacing="0">
              <Border Grid.Row="0" Classes="FilterBarChrome">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource FilterBarGroupSpacing}">
                  <Grid
                    Grid.Row="0"
                    Classes="FilterBarColumns"
                    ColumnDefinitions="1*,Auto,1*,Auto,1*">
                    <Grid
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Classes="FilterBarColumn"
                      ColumnDefinitions="Auto,Auto,Auto,*">
                      <TextBlock
                        Grid.Column="0"
                        Classes="Caption Muted"
                        Text="范围" />
                      <ComboBox
                        Grid.Column="1"
                        MinWidth="100"
                        HorizontalAlignment="Left"
                        Classes="FilterBarComboAuto"
                        IsEnabled="{Binding !IsUiBusy}"
                        SelectedIndex="{Binding ScopeIndex}">
                        <ComboBoxItem Content="选中行" />
                        <ComboBoxItem Content="筛选批量" />
                      </ComboBox>
                      <TextBlock
                        Grid.Column="2"
                        Margin="{DynamicResource MarginLeftMd}"
                        VerticalAlignment="Center"
                        Classes="Caption Muted"
                        IsVisible="{Binding IsSingleScope}"
                        Text="按当前选中库存行纠错" />
                      <TextBlock
                        Grid.Column="2"
                        Margin="{DynamicResource MarginLeftMd}"
                        VerticalAlignment="Center"
                        Classes="Caption Muted"
                        IsVisible="{Binding IsFilterScope}"
                        Text="按搜索框关键字命中记录批量纠错" />
                    </Grid>

                    <Grid
                      Grid.Column="4"
                      Classes="FilterBarColumn"
                      ColumnDefinitions="*,Auto">
                      <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingInlineMd}">
                        <Button
                          Classes="Outline"
                          Command="{Binding PreviewReassignCommand}"
                          IsEnabled="{Binding !IsUiBusy}">
                          <TextBlock Text="{Binding ReassignPreviewToggleText}" />
                        </Button>
                        <Button
                          Classes="Outline"
                          Command="{Binding ApplyReassignCommand}"
                          IsEnabled="{Binding !IsUiBusy}">
                          <TextBlock Text="确认纠错" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Grid>

                  <Grid
                    Grid.Row="1"
                    Classes="FilterBarColumns"
                    ColumnDefinitions="1*,Auto,1*,Auto,1*">
                    <Grid
                      Grid.Column="0"
                      Classes="FilterBarColumn"
                      ColumnDefinitions="Auto,*,Auto">
                      <TextBlock
                        Grid.Column="0"
                        Classes="Caption Muted"
                        Text="药品" />
                      <AutoCompleteBox
                        x:Name="ReassignDrugBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        IsDropDownOpen="{Binding IsDrugSuggestOpen, Mode=TwoWay}"
                        IsEnabled="{Binding !IsUiBusy}"
                        ItemsSource="{Binding DrugOptions}"
                        KeyDown="ReassignDrugBox_OnKeyDown"
                        PlaceholderText="目标药品名"
                        Text="{Binding DrugText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue='', FallbackValue=''}">
                        <AutoCompleteBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:OptionItem">
                            <TextBlock Text="{Binding Display}" />
                          </DataTemplate>
                        </AutoCompleteBox.ItemTemplate>
                      </AutoCompleteBox>
                      <Button
                        Grid.Column="2"
                        Classes="MicroClear DrugAutoCompleteClear"
                        Command="{Binding ClearDrugSpecFilterCommand}">
                        <icons:AppIcon
                          Width="{DynamicResource IconSizeSmall}"
                          Height="{DynamicResource IconSizeSmall}"
                          Kind="CircleX" />
                      </Button>
                    </Grid>

                    <Border Grid.Column="1" Classes="FilterBarDivider" />

                    <Grid
                      Grid.Column="2"
                      Classes="FilterBarColumn"
                      ColumnDefinitions="Auto,*">
                      <TextBlock
                        Grid.Column="0"
                        Classes="Caption Muted"
                        Text="规格" />
                      <controls:FilterFieldInput Grid.Column="1">
                        <Grid>
                          <ComboBox
                            x:Name="ReassignSpecBox"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            DisplayMemberBinding="{Binding Display}"
                            IsEnabled="{Binding !IsUiBusy}"
                            ItemsSource="{Binding SpecOptions}"
                            SelectedItem="{Binding SelectedSpec}" />
                          <TextBlock
                            Classes="InputPlaceholder"
                            IsVisible="{Binding !IsSpecSelected}"
                            Text="目标规格" />
                        </Grid>
                      </controls:FilterFieldInput>
                    </Grid>

                    <Border Grid.Column="3" Classes="FilterBarDivider" />

                    <Grid
                      Grid.Column="4"
                      Classes="FilterBarColumn"
                      ColumnDefinitions="Auto,*">
                      <TextBlock
                        Grid.Column="0"
                        Classes="Caption Muted"
                        Text="原因" />
                      <controls:FilterFieldInput Grid.Column="1">
                        <TextBox
                          AcceptsReturn="False"
                          IsEnabled="{Binding !IsUiBusy}"
                          PlaceholderText="必填"
                          Text="{Binding CorrectionReason, Mode=TwoWay}"
                          TextWrapping="NoWrap" />
                      </controls:FilterFieldInput>
                    </Grid>
                  </Grid>
                </Grid>
              </Border>

              <Border
                Grid.Row="1"
                Classes="FilterBarChrome"
                IsVisible="{Binding ShowReassignPreview}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource FilterBarGroupSpacing}">
                  <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock
                      Classes="Caption"
                      IsVisible="{Binding HasPreviewStatsText}"
                      Text="{Binding PreviewStatsText}" />
                    <TextBlock
                      Classes="Caption Muted"
                      IsVisible="{Binding HasPreviewNoticeText}"
                      Text="{Binding PreviewNoticeText}"
                      TextWrapping="Wrap" />
                  </StackPanel>

                  <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,Auto,*"
                    ColumnSpacing="{DynamicResource FilterBarGroupSpacing}">
                    <DataGrid
                      Grid.Column="0"
                      HorizontalAlignment="Stretch"
                      behaviors:DataGridDisplayOnly.Enabled="True"
                      Classes="SectionGrid ReassignPreviewGrid"
                      ItemsSource="{Binding PreviewRows}">
                      <DataGrid.Columns>
                        <DataGridTextColumn
                          Width="1.2*"
                          Binding="{Binding CurrentDrugId}"
                          Header="药品"
                          IsReadOnly="True" />
                        <DataGridTextColumn
                          Width="0.9*"
                          Binding="{Binding CurrentSpec}"
                          Header="规格"
                          IsReadOnly="True" />
                        <DataGridTextColumn
                          Width="1.3*"
                          Binding="{Binding TraceCode}"
                          Header="追溯码"
                          IsReadOnly="True" />
                        <DataGridTextColumn
                          Width="{StaticResource DgWQtyCompact}"
                          Binding="{Binding CurrentQty}"
                          Header="数量"
                          IsReadOnly="True" />
                        <DataGridTextColumn
                          Width="{StaticResource DgWQtyCompact}"
                          Binding="{Binding CurrentRemain}"
                          Header="剩余"
                          IsReadOnly="True" />
                      </DataGrid.Columns>
                    </DataGrid>

                    <icons:AppIcon
                      Grid.Column="1"
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource MutedColor}"
                      Kind="ArrowRight" />

                    <DataGrid
                      Grid.Column="2"
                      HorizontalAlignment="Stretch"
                      behaviors:DataGridDisplayOnly.Enabled="True"
                      Classes="SectionGrid ReassignPreviewGrid"
                      ItemsSource="{Binding PreviewRows}">
                      <DataGrid.Columns>
                        <DataGridTextColumn
                          Width="1.2*"
                          Binding="{Binding TargetDrugId}"
                          Header="药品"
                          IsReadOnly="True" />
                        <DataGridTextColumn
                          Width="0.9*"
                          Binding="{Binding TargetSpec}"
                          Header="规格"
                          IsReadOnly="True" />
                        <DataGridTextColumn
                          Width="1.3*"
                          Binding="{Binding TraceCode}"
                          Header="追溯码"
                          IsReadOnly="True" />
                        <DataGridTextColumn
                          Width="{StaticResource DgWQtyCompact}"
                          Binding="{Binding TargetQty}"
                          Header="数量"
                          IsReadOnly="True" />
                        <DataGridTextColumn
                          Width="{StaticResource DgWQtyCompact}"
                          Binding="{Binding TargetRemain}"
                          Header="剩余"
                          IsReadOnly="True" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </DataTemplate>
        </controls:DeferredContentHost.ContentTemplate>
      </controls:DeferredContentHost>

      <controls:CardPanel
        Grid.Row="1"
        MinHeight="0"
        Chrome="Card"
        Classes="FlushBody SquareChrome">
        <controls:CardPanel.Title>
          <TextBox
            shad:TextBoxAssist.Clearable="True"
            AcceptsReturn="False"
            Classes="SearchBox Clearable"
            IsEnabled="{Binding !IsUiBusy}"
            PlaceholderText="搜索：药品名 / 规格 / 追溯码"
            Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="NoWrap">
            <TextBox.KeyBindings>
              <KeyBinding Command="{Binding SearchCommand}" Gesture="Enter" />
            </TextBox.KeyBindings>
          </TextBox>
        </controls:CardPanel.Title>
        <controls:CardPanel.HeaderContent>
          <WrapPanel
            VerticalAlignment="Center"
            ItemSpacing="{DynamicResource PageSectionSpacing}"
            Orientation="Horizontal">
            <controls:StatusPill
              Classes.ToneDone25="{Binding !HasPendingChanges}"
              Classes.ToneWarning25="{Binding HasPendingChanges}"
              Icon="SaveAll"
              IconSize="14"
              IsVisible="{Binding ShowEditState}"
              PillPadding="8,4"
              Text="{Binding EditStateText}"
              TextSize="12" />

            <ComboBox
              x:Name="InventoryModeBox"
              MinWidth="180"
              IsEnabled="{Binding !IsUiBusy}"
              SelectedIndex="{Binding ModeIndex}">
              <ComboBoxItem Content="库存明细" />
              <ComboBoxItem Content="按药品汇总" />
              <ComboBoxItem Content="低库存" />
              <ComboBoxItem Content="缺失" />
            </ComboBox>
          </WrapPanel>
        </controls:CardPanel.HeaderContent>

        <Grid
          MinHeight="0"
          RowDefinitions="*,Auto"
          RowSpacing="0">
          <Grid
            Grid.Row="0"
            MinHeight="0"
            VerticalAlignment="Stretch"
            ClipToBounds="True">
            <Grid
              MinHeight="0"
              VerticalAlignment="Stretch"
              IsVisible="{Binding IsDetailMode}">
              <shad:BusyArea IsBusy="{Binding IsDetailSectionPending}">
                <controls:EmptyStatePanel
                  MinHeight="0"
                  VerticalAlignment="Stretch"
                  EmptyHint="{Binding StockEmptyHint}"
                  EmptyText="{Binding StockEmptyText}"
                  Icon="{Binding SectionEmptyIcon}"
                  IsEmpty="{Binding IsStockEmpty}"
                  IsPending="{Binding IsDetailSectionPending}"
                  SlotMinHeight="{DynamicResource DgH10Rows}"
                  SlotMode="PendingOnly">
                  <controls:DeferredGridSlot
                    x:Name="StockDetailGridSlot"
                    PagerPageIndex="{Binding PageIndex}"
                    SlotMinHeight="{DynamicResource DgH10Rows}"
                    SlotName="StockDetailGrid">
                    <controls:DeferredGridSlot.GridTemplate>
                      <DataTemplate x:DataType="vm:InventoryOverview">
                        <DataGrid
                          MinHeight="0"
                          HorizontalAlignment="Stretch"
                          behaviors:DataGridRowSelection.Enabled="{Binding ShowReassignRowSelection}"
                          behaviors:DataGridRowSelection.IsVisible="{Binding ShowReassignRowSelection}"
                          behaviors:DataGridSortReset.ClearFilterCommand="{Binding ClearSearchCommand}"
                          behaviors:DataGridSortReset.FilterActive="{Binding HasActiveKeyword}"
                          Classes="SectionGrid IndexedGrid StickyIndexRowNo"
                          HorizontalScrollBarVisibility="Disabled"
                          IsReadOnly="{Binding !IsStockEditEnabled}"
                          ItemsSource="{Binding StockRows}"
                          VerticalScrollBarVisibility="Auto">
                          <DataGrid.Columns>
                            <DataGridTextColumn
                              Width="1.4*"
                              Binding="{Binding DrugId}"
                              Header="药品名"
                              IsReadOnly="True" />
                            <DataGridTextColumn
                              Width="1.4*"
                              Binding="{Binding Spec}"
                              Header="规格"
                              IsReadOnly="True" />
                            <DataGridTextColumn
                              Width="1.4*"
                              Binding="{Binding TraceCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Header="追溯码" />
                            <DataGridTextColumn
                              Width="{StaticResource DgWRightSmall}"
                              Binding="{Binding Qty}"
                              Header="数量"
                              IsReadOnly="True" />
                            <DataGridTextColumn
                              Width="{StaticResource DgWRightSmall}"
                              Binding="{Binding Remain}"
                              Header="剩余" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DataTemplate>
                    </controls:DeferredGridSlot.GridTemplate>
                  </controls:DeferredGridSlot>
                </controls:EmptyStatePanel>
              </shad:BusyArea>
            </Grid>


            <Grid
              MinHeight="0"
              VerticalAlignment="Stretch"
              IsVisible="{Binding IsAggMode}">
              <shad:BusyArea IsBusy="{Binding IsAggSectionPending}">
                <controls:EmptyStatePanel
                  MinHeight="0"
                  VerticalAlignment="Stretch"
                  EmptyHint="{Binding AggEmptyHint}"
                  EmptyText="{Binding AggEmptyText}"
                  Icon="{Binding SectionEmptyIcon}"
                  IsEmpty="{Binding IsAggEmpty}"
                  IsPending="{Binding IsAggSectionPending}"
                  SlotMinHeight="{DynamicResource DgH10Rows}"
                  SlotMode="PendingOnly">
                  <controls:DeferredGridSlot
                    x:Name="AggGridSlot"
                    PagerPageIndex="{Binding PageIndex}"
                    SlotMinHeight="{DynamicResource DgH10Rows}"
                    SlotName="AggGrid">
                    <controls:DeferredGridSlot.GridTemplate>
                      <DataTemplate x:DataType="vm:InventoryOverview">
                        <DataGrid
                          MinHeight="0"
                          HorizontalAlignment="Stretch"
                          behaviors:DataGridSortReset.ClearFilterCommand="{Binding ClearSearchCommand}"
                          behaviors:DataGridSortReset.FilterActive="{Binding HasActiveKeyword}"
                          Classes="SectionGrid IndexedGrid StickyIndexRowNo"
                          HorizontalScrollBarVisibility="Disabled"
                          ItemsSource="{Binding DrugSpecRows}"
                          VerticalScrollBarVisibility="Auto">
                          <DataGrid.Columns>
                            <DataGridTextColumn
                              Width="1.6*"
                              Binding="{Binding DrugId}"
                              Header="药品名" />
                            <DataGridTextColumn
                              Width="2*"
                              Binding="{Binding Spec}"
                              Header="规格" />
                            <DataGridTextColumn
                              Width="{StaticResource DgWRightSmall}"
                              Binding="{Binding CodeCount}"
                              Header="追溯码数" />
                            <DataGridTextColumn
                              Width="{StaticResource DgWRightSmall}"
                              Binding="{Binding QtySum}"
                              Header="总数量" />
                            <DataGridTextColumn
                              Width="{StaticResource DgWRightSmall}"
                              Binding="{Binding RemainSum}"
                              Header="剩余" />
                            <DataGridTextColumn
                              Width="{StaticResource DgWRightSmall}"
                              Binding="{Binding WeekUsed}"
                              Header="周用量" />
                            <DataGridTextColumn
                              Width="{StaticResource DgWRightSmall}"
                              Binding="{Binding Threshold, StringFormat={}{0:0}}"
                              Header="阈值"
                              IsVisible="False" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DataTemplate>
                    </controls:DeferredGridSlot.GridTemplate>
                  </controls:DeferredGridSlot>
                </controls:EmptyStatePanel>
              </shad:BusyArea>
            </Grid>


            <Grid
              MinHeight="0"
              VerticalAlignment="Stretch"
              IsVisible="{Binding IsLowMode}">
              <shad:BusyArea IsBusy="{Binding IsLowSectionPending}">
                <controls:EmptyStatePanel
                  MinHeight="0"
                  VerticalAlignment="Stretch"
                  EmptyHint="{Binding LowEmptyHint}"
                  EmptyText="{Binding LowEmptyText}"
                  Icon="{Binding SectionEmptyIcon}"
                  IsEmpty="{Binding IsLowEmpty}"
                  IsPending="{Binding IsLowSectionPending}"
                  SlotMinHeight="{DynamicResource DgH10Rows}"
                  SlotMode="PendingOnly">
                  <controls:DeferredGridSlot
                    x:Name="LowStockGridSlot"
                    PagerPageIndex="{Binding PageIndex}"
                    SlotMinHeight="{DynamicResource DgH10Rows}"
                    SlotName="LowStockGrid">
                    <controls:DeferredGridSlot.GridTemplate>
                      <DataTemplate x:DataType="vm:InventoryOverview">
                        <DataGrid
                          MinHeight="0"
                          HorizontalAlignment="Stretch"
                          behaviors:DataGridSortReset.ClearFilterCommand="{Binding ClearSearchCommand}"
                          behaviors:DataGridSortReset.FilterActive="{Binding HasActiveKeyword}"
                          Classes="SectionGrid IndexedGrid StickyIndexRowNo"
                          HorizontalScrollBarVisibility="Disabled"
                          ItemsSource="{Binding LowStockRows}"
                          VerticalScrollBarVisibility="Auto">
                          <DataGrid.Columns>
                            <DataGridTextColumn
                              Width="1.2*"
                              Binding="{Binding DrugId}"
                              Header="药品名" />
                            <DataGridTextColumn
                              Width="1.4*"
                              Binding="{Binding Spec}"
                              Header="规格" />
                            <DataGridTextColumn
                              Width="{StaticResource DgWRightSmall}"
                              Binding="{Binding RemainSum}"
                              Header="剩余" />
                            <DataGridTextColumn
                              Width="{StaticResource DgWRightSmall}"
                              Binding="{Binding Threshold, StringFormat={}{0:0}}"
                              Header="用量" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DataTemplate>
                    </controls:DeferredGridSlot.GridTemplate>
                  </controls:DeferredGridSlot>
                </controls:EmptyStatePanel>
              </shad:BusyArea>
            </Grid>

            <Grid
              MinHeight="0"
              VerticalAlignment="Stretch"
              IsVisible="{Binding IsMissingMode}">
              <shad:BusyArea IsBusy="{Binding IsMissingSectionPending}">
                <controls:EmptyStatePanel
                  MinHeight="0"
                  VerticalAlignment="Stretch"
                  EmptyHint="{Binding MissingEmptyHint}"
                  EmptyText="{Binding MissingEmptyText}"
                  Icon="{Binding SectionEmptyIcon}"
                  IsEmpty="{Binding IsMissingEmpty}"
                  IsPending="{Binding IsMissingSectionPending}"
                  SlotMinHeight="{DynamicResource DgH10Rows}"
                  SlotMode="PendingOnly">
                  <controls:DeferredGridSlot
                    x:Name="MissingGridSlot"
                    PagerPageIndex="{Binding PageIndex}"
                    SlotMinHeight="{DynamicResource DgH10Rows}"
                    SlotName="MissingGrid">
                    <controls:DeferredGridSlot.GridTemplate>
                      <DataTemplate x:DataType="vm:InventoryOverview">
                        <DataGrid
                          MinHeight="0"
                          HorizontalAlignment="Stretch"
                          behaviors:DataGridSortReset.ClearFilterCommand="{Binding ClearSearchCommand}"
                          behaviors:DataGridSortReset.FilterActive="{Binding HasActiveKeyword}"
                          Classes="SectionGrid IndexedGrid StickyIndexRowNo"
                          HorizontalScrollBarVisibility="Disabled"
                          ItemsSource="{Binding MissingStockRows}"
                          VerticalScrollBarVisibility="Auto">
                          <DataGrid.Columns>
                            <DataGridTextColumn
                              Width="1.3*"
                              Binding="{Binding DrugId}"
                              Header="药品名" />
                            <DataGridTextColumn
                              Width="1.4*"
                              Binding="{Binding Spec}"
                              Header="规格" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DataTemplate>
                    </controls:DeferredGridSlot.GridTemplate>
                  </controls:DeferredGridSlot>
                </controls:EmptyStatePanel>
              </shad:BusyArea>
            </Grid>
          </Grid>

          <controls:DataGridPager
            Grid.Row="1"
            Classes="CardPanelBodyInset"
            FirstPageCommand="{Binding FirstPageCommand}"
            IsActive="{Binding IsPagedMode}"
            IsContentEmpty="{Binding IsStockEmpty}"
            LastPageCommand="{Binding LastPageCommand}"
            NextPageCommand="{Binding NextPageCommand}"
            PageSizeOptions="{Binding PageSizeOptions}"
            PrevPageCommand="{Binding PrevPageCommand}"
            SelectedCount="{Binding StockPagerSelectedCount}"
            SelectedPageSize="{Binding PageSize, Mode=TwoWay}"
            TotalCount="{Binding TotalCount}"
            TotalPages="{Binding TotalPages}"
            PageIndex="{Binding PageIndex}" />
        </Grid>
      </controls:CardPanel>
    </Grid>
  </controls:PageDataShell>
</UserControl>
