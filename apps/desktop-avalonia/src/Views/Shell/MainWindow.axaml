<shad:Window
  x:Class="PacToolkits.Desktop.Avalonia.Views.MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:PacToolkits.Desktop.Avalonia.Behaviors"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:conv="clr-namespace:PacToolkits.Desktop.Avalonia.Converters"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:pageVm="using:PacToolkits.Desktop.Avalonia.ViewModels.Pages"
  xmlns:pages="clr-namespace:PacToolkits.Desktop.Avalonia.Views.Pages"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:views="clr-namespace:PacToolkits.Desktop.Avalonia.Views"
  xmlns:vm="using:PacToolkits.Desktop.Avalonia.ViewModels"
  x:Name="Root"
  Title="PacToolkits"
  Width="1460"
  Height="900"
  MinWidth="1350"
  MinHeight="800"
  behaviors:FocusClear.Enable="True"
  x:DataType="vm:MainWindowViewModel"
  Icon="avares://PacToolkits.Desktop/Assets/app.ico"
  RootCornerRadius="{DynamicResource XlCornerRadius}"
  ShowBottomBorder="False"
  TitleBarAnimationEnabled="False"
  WindowStartupLocation="CenterScreen">
  <shad:Window.Resources>
    <conv:SidebarNavToolTipConverter x:Key="SidebarNavToolTip" />
    <DataTemplate x:Key="WindowsTitleBarMarkTemplate" x:DataType="vm:MainWindowViewModel">
      <StackPanel
        Classes="TitleBarMark"
        Orientation="Horizontal"
        Spacing="8">
        <Image
          RenderOptions.BitmapInterpolationMode="HighQuality"
          Source="avares://PacToolkits.Desktop/Assets/app.ico"
          UseLayoutRounding="True" />
        <Button
          Classes="TitleBarBrandMenu"
          Command="{Binding ShowAppInfoCommand}"
          ToolTip.Tip="关于 PacToolkits">
          <icons:AppIcon
            Width="18"
            Height="18"
            Kind="QrCode" />
        </Button>
      </StackPanel>
    </DataTemplate>
  </shad:Window.Resources>

  <shad:Window.Hosts>
    <shad:ToastHost Manager="{Binding ToastManager}" />
    <shad:DialogHost Manager="{Binding DialogManager}" />
  </shad:Window.Hosts>

  <shad:Window.LogoContent>
    <Grid Classes="TitleBarNav" ColumnDefinitions="Auto,Auto,Auto,Auto">
      <Button
        Classes="TitleBarNavBtn"
        Command="{Binding NavigateBackCommand}"
        ToolTip.Tip="{Binding NavigateBackToolTip}">
        <icons:AppIcon Kind="ArrowLeft" />
      </Button>
      <Button
        Grid.Column="1"
        Classes="TitleBarNavBtn"
        Command="{Binding NavigateForwardCommand}"
        ToolTip.Tip="{Binding NavigateForwardToolTip}">
        <icons:AppIcon Kind="ArrowRight" />
      </Button>
      <Border
        x:Name="TitleBarCenterAnchor"
        Grid.Column="2"
        Classes="TitleBarPath">
        <Grid
          Margin="12,0,10,0"
          VerticalAlignment="Center"
          ColumnDefinitions="*,Auto,Auto">
          <StackPanel
            Classes="TitleBarCrumbs"
            Orientation="Horizontal"
            Spacing="7">
            <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="{Binding SelectedFunctionArea.Icon}" />
            <TextBlock Classes="Caption Muted" Text="{Binding SelectedFunctionArea.Name}" />
            <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="ChevronRight" />
            <icons:AppIcon IsVisible="{Binding !ShowActiveTab}" Kind="{Binding ActivePageIcon}" />
            <TextBlock
              MaxWidth="180"
              Classes="Caption"
              IsVisible="{Binding !ShowActiveTab}"
              Text="{Binding ActivePageText}"
              TextTrimming="CharacterEllipsis" />
            <icons:AppIcon
              Foreground="{DynamicResource MutedColor}"
              IsVisible="{Binding ShowActiveTab}"
              Kind="{Binding ActivePageIcon}" />
            <TextBlock
              MaxWidth="180"
              Classes="Caption Muted"
              IsVisible="{Binding ShowActiveTab}"
              Text="{Binding ActivePageText}"
              TextTrimming="CharacterEllipsis" />
            <icons:AppIcon
              Foreground="{DynamicResource MutedColor}"
              IsVisible="{Binding ShowActiveTab}"
              Kind="ChevronRight" />
            <icons:AppIcon IsVisible="{Binding ShowActiveTab}" Kind="{Binding ActiveTabIcon}" />
            <TextBlock
              MaxWidth="120"
              Classes="Caption"
              IsVisible="{Binding ShowActiveTab}"
              Text="{Binding ActiveTabText}"
              TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Rectangle Grid.Column="1" Classes="TitleBarPathDivider" />
          <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            Spacing="0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse
                Width="8"
                Height="8"
                Fill="{DynamicResource MutedColor}" />
              <TextBlock Classes="Caption" Text="0" />
            </StackPanel>
            <Rectangle Classes="TitleBarPathDivider" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <icons:AppIcon
                Width="14"
                Height="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Kind="MessageSquareDot" />
              <icons:AppIcon Kind="ChevronDown" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Button
        Grid.Column="3"
        shad:ButtonAssist.ShowProgress="{Binding IsUpdateApplying}"
        Classes="TitleBarUpdateBtn"
        Command="{Binding OpenUpdateCenterCommand}"
        IsVisible="{Binding HasUpdateAvailable}">
        <shad:ButtonAssist.Icon>
          <icons:AppIcon Kind="CloudDownload" />
        </shad:ButtonAssist.Icon>
        <TextBlock
          VerticalAlignment="Center"
          Classes="Caption"
          Text="{Binding UpdateActionText}" />
      </Button>
    </Grid>
  </shad:Window.LogoContent>

  <shad:Window.RightWindowTitleBarContent>
    <views:MainWindowTitleBarCapsule x:Name="TitleCapsule" VerticalAlignment="Center" />
  </shad:Window.RightWindowTitleBarContent>

  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
      <shad:Sidebar
        x:Name="MainSidebar"
        Width="255"
        MinWidth="56"
        BorderThickness="0,0,1,0"
        CurrentRoute="{Binding ActivePageRoute}"
        Expanded="{Binding IsSidebarExpanded, Mode=TwoWay}"
        ItemIconContentSpacing="12">
        <shad:Sidebar.Header>
          <Border Classes="SidebarFuncHost">
            <Menu Classes="Single">
              <MenuItem
                shad:MenuItemAssist.PopupHorizontalOffset="4"
                shad:MenuItemAssist.PopupPlacement="RightEdgeAlignedTop"
                shad:MenuItemAssist.PopupVerticalOffset="0"
                Classes="NoPressedAnimation SidebarFuncMenuItem"
                CornerRadius="{DynamicResource LgCornerRadius}">
                <MenuItem.Header>
                  <Panel>
                    <Border
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Classes="SidebarFuncBadge"
                      CornerRadius="{DynamicResource SpecCornerRadius}"
                      IsVisible="{Binding !IsSidebarExpanded}">
                      <Viewbox Width="{DynamicResource IconSizeHeader}" Height="{DynamicResource IconSizeHeader}">
                        <icons:AppIcon Kind="{Binding SelectedFunctionArea.Icon}" />
                      </Viewbox>
                    </Border>
                    <Grid
                      Margin="0"
                      HorizontalAlignment="Stretch"
                      ColumnDefinitions="Auto,*,Auto"
                      IsVisible="{Binding IsSidebarExpanded}">
                      <Border
                        Width="36"
                        Height="36"
                        Margin="0,0,8,0"
                        Classes="SidebarFuncBadge"
                        CornerRadius="{DynamicResource XlCornerRadius}">
                        <Viewbox Width="{DynamicResource IconSizeHeader}" Height="{DynamicResource IconSizeHeader}">
                          <icons:AppIcon Kind="{Binding SelectedFunctionArea.Icon}" />
                        </Viewbox>
                      </Border>
                      <StackPanel Grid.Column="1" Classes="SidebarFuncText">
                        <TextBlock Classes="Small" Text="{Binding SelectedFunctionArea.Name}" />
                        <TextBlock
                          Classes="Caption Muted"
                          Text="{Binding SelectedFunctionArea.Subtitle}"
                          TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Viewbox
                        Grid.Column="2"
                        Width="16"
                        Height="16">
                        <icons:AppIcon Foreground="{DynamicResource ForegroundColor}" Kind="ChevronsUpDown" />
                      </Viewbox>
                    </Grid>
                  </Panel>
                </MenuItem.Header>
                <shad:MenuItemAssist.Label>
                  <TextBlock
                    Width="220"
                    Classes="Caption Muted"
                    Text="功能区" />
                </shad:MenuItemAssist.Label>
                <MenuItem
                  Command="{Binding SelectFunctionAreaCommand}"
                  CommandParameter="{x:Static vm:ShellFunctionAreas.Traceability}"
                  Header="{x:Static vm:ShellFunctionAreas.TraceabilityName}">
                  <MenuItem.Icon>
                    <Border
                      Width="26"
                      Height="26"
                      Padding="4"
                      BorderBrush="{DynamicResource BorderColor}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource LgCornerRadius}">
                      <Viewbox>
                        <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="{x:Static vm:ShellFunctionAreas.TraceabilityIcon}" />
                      </Viewbox>
                    </Border>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                  Command="{Binding SelectFunctionAreaCommand}"
                  CommandParameter="{x:Static vm:ShellFunctionAreas.Integration}"
                  Header="{x:Static vm:ShellFunctionAreas.IntegrationName}">
                  <MenuItem.Icon>
                    <Border
                      Width="24"
                      Height="24"
                      Padding="4"
                      BorderBrush="{DynamicResource BorderColor}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource LgCornerRadius}">
                      <Viewbox>
                        <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="{x:Static vm:ShellFunctionAreas.IntegrationIcon}" />
                      </Viewbox>
                    </Border>
                  </MenuItem.Icon>
                </MenuItem>
              </MenuItem>
            </Menu>
          </Border>
        </shad:Sidebar.Header>

        <StackPanel Classes="SidebarNavHost" Spacing="4">
          <shad:SidebarItemLabel
            AsSeparator="True"
            Classes="SidebarSectionLabel"
            Text="页面" />

          <ItemsControl ItemsSource="{Binding FilteredSidebarPages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="{DynamicResource SidebarNavItemSpacing}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AppPageBase">
                <shad:SidebarItem
                  Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).NavigateSidebarPageCommand}"
                  CommandParameter="{Binding}"
                  Content="{Binding DisplayName}"
                  IsEnabled="{Binding IsEnabled}"
                  Route="{Binding SidebarRoute}">
                  <ToolTip.Tip>
                    <MultiBinding Converter="{StaticResource SidebarNavToolTip}">
                      <Binding Path="$parent[shad:Sidebar].Expanded" />
                      <Binding Path="DisplayName" />
                    </MultiBinding>
                  </ToolTip.Tip>
                  <shad:SidebarItem.Icon>
                    <Viewbox>
                      <icons:AppIcon Kind="{Binding Icon}" />
                    </Viewbox>
                  </shad:SidebarItem.Icon>
                </shad:SidebarItem>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <shad:Sidebar.Footer>
          <Menu Classes="Single">
            <MenuItem
              Padding="8,0"
              HorizontalAlignment="Stretch"
              shad:MenuItemAssist.PopupHorizontalOffset="4"
              shad:MenuItemAssist.PopupPlacement="RightEdgeAlignedBottom"
              shad:MenuItemAssist.PopupVerticalOffset="4"
              Classes="SidebarFooterMenuItem"
              CornerRadius="{DynamicResource LgCornerRadius}">
              <MenuItem.Header>
                <Panel>
                  <Border
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding !IsSidebarExpanded}">
                    <icons:AppIcon
                      Width="{DynamicResource IconBadgeSize}"
                      Height="{DynamicResource IconBadgeSize}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Kind="Command" />
                  </Border>
                  <Grid
                    Margin="0,4"
                    ClipToBounds="True"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="8"
                    IsVisible="{Binding IsSidebarExpanded}">
                    <Grid Width="36" Height="36">
                      <icons:AppIcon
                        Width="{DynamicResource IconBadgeSize}"
                        Height="{DynamicResource IconBadgeSize}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Kind="Command" />
                    </Grid>
                    <StackPanel
                      Grid.Column="1"
                      Classes="SidebarAccountText"
                      ClipToBounds="True">
                      <TextBlock
                        Classes="Small"
                        Text="PacToolkits"
                        TextTrimming="CharacterEllipsis" />
                      <TextBlock
                        Classes="Caption Muted"
                        Text="{Binding VersionText}"
                        TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Viewbox
                      Grid.Column="2"
                      Width="18"
                      Height="18">
                      <icons:AppIcon Foreground="{DynamicResource ForegroundColor}" Kind="ChevronsUpDown" />
                    </Viewbox>
                  </Grid>
                </Panel>
              </MenuItem.Header>
              <shad:MenuItemAssist.Label>
                <Grid
                  Width="220"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="12">
                  <Image Classes="SidebarBrandIcon" Source="avares://PacToolkits.Desktop/Assets/app.ico" />
                  <StackPanel Grid.Column="1" Classes="SidebarAccountText">
                    <TextBlock Classes="Small" Text="PacToolkits" />
                    <TextBlock
                      Classes="Caption Muted"
                      LineHeight="16"
                      Text="{Binding VersionText}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </shad:MenuItemAssist.Label>
              <MenuItem Command="{Binding OpenSettingsCommand}" Header="设置">
                <MenuItem.Icon>
                  <Panel Classes="ShellMenuUpdateIcon">
                    <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="Settings" />
                    <Border Classes="UpdateDot" IsVisible="{Binding HasUpdateAvailable}" />
                  </Panel>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Command="{Binding ShowAppInfoCommand}" Header="关于">
                <MenuItem.Icon>
                  <Viewbox Width="16" Height="16">
                    <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="Info" />
                  </Viewbox>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem
                Command="{Binding CheckAppUpdateCommand}"
                Header="检查更新"
                IsEnabled="{Binding !IsUpdateChecking}">
                <MenuItem.Icon>
                  <Viewbox Width="16" Height="16">
                    <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="Download" />
                  </Viewbox>
                </MenuItem.Icon>
              </MenuItem>
            </MenuItem>
          </Menu>
        </shad:Sidebar.Footer>
      </shad:Sidebar>

      <DockPanel
        Grid.Column="1"
        Background="{DynamicResource CardBackgroundColor}"
        LastChildFill="True">
        <Border
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="0,0,0,1"
          Classes="PageHeader"
          DockPanel.Dock="Top">
          <Grid
            MinHeight="{DynamicResource ChromeRowHeight}"
            Margin="{DynamicResource HeaderPadding}"
            VerticalAlignment="Center"
            ColumnDefinitions="Auto,*,Auto,Auto">
            <StackPanel
              Grid.Column="0"
              Orientation="Horizontal"
              Spacing="4">
              <Button
                Classes="Icon ghost-states"
                Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="{Binding SidebarToggleToolTip}">
                <icons:AppIcon Kind="{Binding SidebarToggleIconKind}" />
              </Button>
            </StackPanel>
            <ContentControl
              Grid.Column="1"
              HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Center"
              Content="{Binding ActivePage}">
              <ContentControl.DataTemplates>
                <DataTemplate x:DataType="pageVm:Dashboard">
                  <pages:DashboardHeader />
                </DataTemplate>
                <DataTemplate x:DataType="pageVm:ScanCode">
                  <pages:ScanCodeHeader />
                </DataTemplate>
                <DataTemplate x:DataType="pageVm:MsfxLink">
                  <pages:MsfxLinkHeader />
                </DataTemplate>
                <DataTemplate x:DataType="pageVm:InventoryOverview">
                  <pages:InventoryOverviewHeader />
                </DataTemplate>
                <DataTemplate x:DataType="pageVm:DrugIndex">
                  <pages:DrugIndexHeader />
                </DataTemplate>
                <DataTemplate x:DataType="pageVm:Settings">
                  <pages:SettingsHeader />
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
            <Rectangle Grid.Column="2" Classes="HeaderDivider" />
            <Menu
              Grid.Column="3"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Classes="HeaderMenu">
              <MenuItem
                Command="{Binding RefreshActivePageCommand}"
                IsEnabled="{Binding CanTopRefresh}"
                IsVisible="{Binding ShowTopRefresh}">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="RotateCcw" />
                    <TextBlock Text="刷新" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem IsEnabled="False">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="Eye" />
                    <TextBlock Text="视图" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem
                Command="{Binding TopImport}"
                IsEnabled="{Binding CanTopImport}"
                IsVisible="{Binding ShowTopImport}">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="Upload" />
                    <TextBlock Text="导入" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem
                Command="{Binding TopExport}"
                IsEnabled="{Binding CanTopExport}"
                IsVisible="{Binding ShowTopExport}">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="Download" />
                    <TextBlock Text="导出" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
            </Menu>
          </Grid>
        </Border>

        <Border
          Padding="12,8"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="0,0,0,1"
          Classes="ConnectivityBanner"
          Classes.error="{Binding ConnectivityBannerIsError}"
          Classes.info="{Binding ConnectivityBannerIsInfo}"
          Classes.warning="{Binding ConnectivityBannerIsWarning}"
          DockPanel.Dock="Top"
          IsVisible="{Binding ShowConnectivityBanner}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <icons:AppIcon
              Grid.Column="0"
              Width="16"
              Height="16"
              VerticalAlignment="Center"
              Kind="AlertTriangle" />
            <StackPanel
              Grid.Column="1"
              VerticalAlignment="Center"
              Spacing="2">
              <TextBlock Classes="Small" Text="{Binding ConnectivityBannerTitle}" />
              <TextBlock
                Classes="Caption Muted"
                Text="{Binding ConnectivityBannerMessage}"
                TextWrapping="Wrap" />
            </StackPanel>
            <Button
              Grid.Column="2"
              VerticalAlignment="Center"
              Classes="Outline"
              Command="{Binding OpenConnectivitySettingsCommand}"
              Content="前往设置"
              IsVisible="{Binding ShowConnectivityBannerAction}" />
          </Grid>
        </Border>

        <Border Classes="ContentWorkspace">
          <controls:PageNavigationHost Page="{Binding ActivePage}" Pages="{Binding WorkspacePages}" />
        </Border>
      </DockPanel>
    </Grid>

    <views:MainWindowShellStatusBar Grid.Row="1" />
  </Grid>
</shad:Window>
