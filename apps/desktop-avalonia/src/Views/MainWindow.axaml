<shad:Window
  x:Class="PacToolkits.Desktop.Avalonia.Views.MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:PacToolkits.Desktop.Avalonia.Behaviors"
  xmlns:conv="clr-namespace:PacToolkits.Desktop.Avalonia.Converters"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:vm="using:PacToolkits.Desktop.Avalonia.ViewModels"
  x:Name="Root"
  Title="PacToolkits - 自动化套件"
  Width="1460"
  Height="900"
  MinWidth="1350"
  MinHeight="800"
  behaviors:FocusClearBehavior.Enable="True"
  x:DataType="vm:MainWindowViewModel"
  Icon="avares://pactoolkits-desktop/Assets/app.ico"
  ShowBottomBorder="False"
  WindowStartupLocation="CenterScreen">
  <shad:Window.Hosts>
    <shad:ToastHost Manager="{Binding ToastManager}" />
    <shad:DialogHost Manager="{Binding DialogManager}" />
  </shad:Window.Hosts>

  <shad:Window.RightWindowTitleBarContent>
    <StackPanel
      Margin="0"
      Orientation="Horizontal"
      Spacing="{DynamicResource SpacingInlineSm}">
      <Button
        Margin="{DynamicResource ShellNavItemMargin}"
        Classes="WindowControlsButton"
        Command="{Binding OpenUpdateCenterCommand}"
        IsVisible="{Binding HasUpdateAvailable}">
        <icons:AppIcon
          Width="{DynamicResource ShellNavIconSize}"
          Height="{DynamicResource ShellNavIconSize}"
          Foreground="{DynamicResource BrushWarning}"
          Kind="Upload" />
      </Button>

      <Border
        Classes="ShellTitleBarCapsule"
        VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="0">
          <Button
            Classes="WindowControlsButton"
            Command="{Binding SwitchThemeCommand}"
            ToolTip.Tip="切换主题">
            <icons:AppIcon
              Width="{DynamicResource ShellTitleBarCapsuleIconSize}"
              Height="{DynamicResource ShellTitleBarCapsuleIconSize}"
              Kind="{Binding CurrentTheme, Converter={x:Static conv:ThemeModeConverters.ToIconKind}}" />
          </Button>

          <Border
            Width="1"
            Height="{DynamicResource ShellTitleBarCapsuleIconSize}"
            Margin="{DynamicResource ShellTitleBarCapsuleDividerMargin}"
            VerticalAlignment="Center"
            Background="{DynamicResource BorderColor}" />

          <Button
            Classes="WindowControlsButton"
            ToolTip.Tip="全屏"
            x:Name="FullscreenButton">
            <Panel>
              <icons:AppIcon
                Width="{DynamicResource ShellTitleBarCapsuleIconSize}"
                Height="{DynamicResource ShellTitleBarCapsuleIconSize}"
                IsVisible="{Binding #Root.WindowState, Converter={x:Static conv:WindowStateConverters.IsNotFullScreen}}"
                Kind="Maximize" />
              <icons:AppIcon
                Width="{DynamicResource ShellTitleBarCapsuleIconSize}"
                Height="{DynamicResource ShellTitleBarCapsuleIconSize}"
                IsVisible="{Binding #Root.WindowState, Converter={x:Static conv:WindowStateConverters.IsFullScreen}}"
                Kind="Minimize" />
            </Panel>
          </Button>

          <Border
            Width="1"
            Height="{DynamicResource ShellTitleBarCapsuleIconSize}"
            Margin="{DynamicResource ShellTitleBarCapsuleDividerMargin}"
            VerticalAlignment="Center"
            Background="{DynamicResource BorderColor}" />

          <Button Classes="WindowControlsButton" Command="{Binding TryReconnectDbCommand}">
            <Panel>
              <controls:BusyCircle
                Width="{DynamicResource ShellTitleBarCapsuleIconSize}"
                Height="{DynamicResource ShellTitleBarCapsuleIconSize}"
                DotBrush="{DynamicResource ForegroundColor}"
                IsVisible="{Binding ShowDbBusyIcon}" />
              <icons:AppIcon
                Width="{DynamicResource ShellTitleBarCapsuleIconSize}"
                Height="{DynamicResource ShellTitleBarCapsuleIconSize}"
                Foreground="{DynamicResource BrushDone}"
                IsVisible="{Binding ShowDbConnectedIcon}"
                Kind="Link" />
              <icons:AppIcon
                Width="{DynamicResource ShellTitleBarCapsuleIconSize}"
                Height="{DynamicResource ShellTitleBarCapsuleIconSize}"
                Foreground="{DynamicResource BrushDanger}"
                IsVisible="{Binding ShowDbDisconnectedIcon}"
                Kind="Unlink" />
            </Panel>
          </Button>

          <Button Classes="WindowControlsButton" Command="{Binding StartOrRestartAhkCommand}">
            <Panel>
              <icons:AppIcon
                Width="{DynamicResource ShellTitleBarCapsuleIconSize}"
                Height="{DynamicResource ShellTitleBarCapsuleIconSize}"
                Foreground="{DynamicResource BrushDone}"
                IsVisible="{Binding IsAhkRunning}"
                Kind="Syringe" />
              <icons:AppIcon
                Width="{DynamicResource ShellTitleBarCapsuleIconSize}"
                Height="{DynamicResource ShellTitleBarCapsuleIconSize}"
                Foreground="{DynamicResource BrushDanger}"
                IsVisible="{Binding !IsAhkRunning}"
                Kind="Syringe" />
            </Panel>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </shad:Window.RightWindowTitleBarContent>

  <shad:Window.LogoContent>
    <Grid Classes="ShellTitleBarNavChrome" ColumnDefinitions="Auto,Auto,*">
      <Button Classes="ShellTitleBarNavButton">
        <icons:AppIcon Kind="ChevronLeft" />
      </Button>
      <Button Grid.Column="1" Classes="ShellTitleBarNavButton">
        <icons:AppIcon Kind="ChevronRight" />
      </Button>
      <Border Grid.Column="2" Classes="ShellTitleBarPathBar">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock
            Margin="12,0,8,0"
            Classes="ShellTitleBarPathText"
            Text="pactoolkits" />
          <StackPanel
            Grid.Column="1"
            Classes="ShellTitleBarPathTrailing"
            Orientation="Horizontal"
            Spacing="8"
            Margin="0,0,10,0"
            VerticalAlignment="Center">
            <Border Classes="ShellTitleBarPathDot" />
            <TextBlock Classes="ShellTitleBarPathText" Text="3" />
            <icons:AppIcon Kind="MessageSquarePlus" />
            <icons:AppIcon Kind="ChevronDown" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </shad:Window.LogoContent>

  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
    <shad:Sidebar
      x:Name="MainSidebar"
      BorderThickness="0,0,1,0"
      CurrentRoute="{Binding ActivePageRoute}"
      Expanded="{Binding IsSidebarExpanded, Mode=TwoWay}"
      IsEnabled="{Binding !IsDbProbeRunning}"
      ItemIconContentSpacing="12"
      MinWidth="56"
      Width="255">
      <shad:Sidebar.Header>
        <Menu Classes="Single">
          <MenuItem
            Classes="NoPressedAnimation SidebarFunctionAreaMenuItem"
            CornerRadius="{DynamicResource LgCornerRadius}"
            HorizontalAlignment="Stretch"
            shad:MenuItemAssist.PopupHorizontalOffset="4"
            shad:MenuItemAssist.PopupPlacement="RightEdgeAlignedTop"
            shad:MenuItemAssist.PopupVerticalOffset="0">
            <MenuItem.Header>
              <Panel>
                <Border
                  Classes="SidebarFunctionAreaBadge"
                  CornerRadius="{DynamicResource LgCornerRadius}"
                  Height="36"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding !$parent[shad:Sidebar].Expanded}"
                  VerticalAlignment="Center"
                  Width="38">
                  <Viewbox Height="16" Width="16">
                    <icons:AppIcon Kind="{Binding SelectedFunctionArea.Icon}" />
                  </Viewbox>
                </Border>
                <Grid
                  ColumnDefinitions="Auto,*,Auto"
                  HorizontalAlignment="Stretch"
                  IsVisible="{Binding $parent[shad:Sidebar].Expanded}"
                  Margin="0">
                  <Border
                    Classes="SidebarFunctionAreaBadge"
                    CornerRadius="{DynamicResource XlCornerRadius}"
                    Height="36"
                    Margin="0,0,8,0"
                    Width="36">
                    <Viewbox Height="16" Width="16">
                      <icons:AppIcon Kind="{Binding SelectedFunctionArea.Icon}" />
                    </Viewbox>
                  </Border>
                  <StackPanel Grid.Column="1" Classes="SidebarFunctionAreaText">
                    <TextBlock Classes="Small" Text="{Binding SelectedFunctionArea.Name}" />
                    <TextBlock
                      Classes="Caption Muted"
                      Text="{Binding SelectedFunctionArea.Subtitle}"
                      TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Viewbox
                    Grid.Column="2"
                    Height="16"
                    Width="16">
                    <icons:AppIcon Foreground="{DynamicResource ForegroundColor}" Kind="ChevronsUpDown" />
                  </Viewbox>
                </Grid>
              </Panel>
            </MenuItem.Header>
            <shad:MenuItemAssist.Label>
              <TextBlock
                Classes="Caption Muted"
                Text="功能区"
                Width="220" />
            </shad:MenuItemAssist.Label>
            <MenuItem
              Command="{Binding SelectFunctionAreaCommand}"
              CommandParameter="{x:Static vm:ShellFunctionAreas.Traceability}"
              Header="{x:Static vm:ShellFunctionAreas.TraceabilityName}">
              <MenuItem.Icon>
                <Border
                  BorderBrush="{DynamicResource BorderColor}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource LgCornerRadius}"
                  Height="24"
                  Padding="4"
                  Width="24">
                  <Viewbox>
                    <icons:AppIcon
                      Foreground="{DynamicResource MutedColor}"
                      Kind="{x:Static vm:ShellFunctionAreas.TraceabilityIcon}" />
                  </Viewbox>
                </Border>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem
              Command="{Binding SelectFunctionAreaCommand}"
              CommandParameter="{x:Static vm:ShellFunctionAreas.Automation}"
              Header="{x:Static vm:ShellFunctionAreas.AutomationName}">
              <MenuItem.Icon>
                <Border
                  BorderBrush="{DynamicResource BorderColor}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource LgCornerRadius}"
                  Height="24"
                  Padding="4"
                  Width="24">
                  <Viewbox>
                    <icons:AppIcon
                      Foreground="{DynamicResource MutedColor}"
                      Kind="{x:Static vm:ShellFunctionAreas.AutomationIcon}" />
                  </Viewbox>
                </Border>
              </MenuItem.Icon>
            </MenuItem>
          </MenuItem>
        </Menu>
      </shad:Sidebar.Header>

      <StackPanel Classes="SidebarNavHost" Spacing="4">
        <shad:SidebarItemLabel
          AsSeparator="True"
          Classes="SidebarNavSectionLabel"
          Text="页面" />

        <ItemsControl ItemsSource="{Binding FilteredSidebarPages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="{DynamicResource SidebarNavItemSpacing}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AppPageBase">
              <shad:SidebarItem
                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).NavigateSidebarPageCommand}"
                CommandParameter="{Binding}"
                Content="{Binding DisplayName}"
                IsEnabled="{Binding IsEnabled}"
                Route="{Binding SidebarRoute}"
                ToolTip.Tip="{Binding DisplayName}">
                <shad:SidebarItem.Icon>
                  <Viewbox>
                    <icons:AppIcon Kind="{Binding Icon}" />
                  </Viewbox>
                </shad:SidebarItem.Icon>
              </shad:SidebarItem>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <shad:Sidebar.Footer>
        <Menu Classes="Single">
          <MenuItem
            Classes="NoPressedAnimation SidebarFooterMenuItem"
            CornerRadius="{DynamicResource LgCornerRadius}"
            HorizontalAlignment="Stretch"
            Padding="8,0"
            shad:MenuItemAssist.PopupHorizontalOffset="4"
            shad:MenuItemAssist.PopupPlacement="RightEdgeAlignedBottom"
            shad:MenuItemAssist.PopupVerticalOffset="4">
            <MenuItem.Header>
              <Panel>
                <Image
                  Classes="SidebarBrandIcon"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding !$parent[shad:Sidebar].Expanded}"
                  Source="avares://pactoolkits-desktop/Assets/app.ico" />
                <Grid
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8"
                  IsVisible="{Binding $parent[shad:Sidebar].Expanded}"
                  Margin="0,4">
                  <Image
                    Classes="SidebarBrandIcon"
                    Source="avares://pactoolkits-desktop/Assets/app.ico" />
                  <StackPanel Grid.Column="1" Classes="SidebarAccountText">
                    <TextBlock Classes="Small" Text="PacToolkits" />
                    <TextBlock
                      Classes="Caption Muted"
                      Text="{Binding ShellVersionText}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <Viewbox
                    Grid.Column="2"
                    Height="18"
                    Width="18">
                    <icons:AppIcon Foreground="{DynamicResource ForegroundColor}" Kind="ChevronsUpDown" />
                  </Viewbox>
                </Grid>
              </Panel>
            </MenuItem.Header>
            <shad:MenuItemAssist.Label>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Width="220">
                <Image
                  Classes="SidebarBrandIcon"
                  Source="avares://pactoolkits-desktop/Assets/app.ico" />
                <StackPanel Grid.Column="1" Classes="SidebarAccountText">
                  <TextBlock Classes="Small" Text="PacToolkits" />
                  <TextBlock
                    Classes="Caption Muted"
                    LineHeight="16"
                    Text="{Binding ShellVersionText}"
                    TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </shad:MenuItemAssist.Label>
            <MenuItem Command="{Binding OpenSettingsCommand}" Header="设置">
              <MenuItem.Icon>
                <Viewbox Height="16" Width="16">
                  <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="Settings" />
                </Viewbox>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding OpenAboutCommand}" Header="关于">
              <MenuItem.Icon>
                <Viewbox Height="16" Width="16">
                  <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="Info" />
                </Viewbox>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem
              Command="{Binding CheckAppUpdateCommand}"
              Header="检查更新"
              IsEnabled="{Binding !IsUpdateChecking}">
              <MenuItem.Icon>
                <Viewbox Height="16" Width="16">
                  <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="Download" />
                </Viewbox>
              </MenuItem.Icon>
            </MenuItem>
          </MenuItem>
        </Menu>
      </shad:Sidebar.Footer>
    </shad:Sidebar>

    <DockPanel Grid.Column="1" Background="{DynamicResource CardBackgroundColor}" LastChildFill="True">
      <Border
        Classes="ShellContentHeader"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="0,0,0,1"
        DockPanel.Dock="Top">
        <Grid
          Margin="{DynamicResource ShellContentHeaderPadding}"
          MinHeight="{DynamicResource ContentChromeHeight}"
          VerticalAlignment="Center"
          ColumnDefinitions="Auto, Auto, Auto, *, Auto">
          <StackPanel
            Grid.Column="0"
            Orientation="Horizontal"
            Spacing="4">
            <ToggleButton
              Classes="ShellChromeToggle"
              Height="28"
              IsChecked="{Binding IsSidebarExpanded, Mode=TwoWay}"
              ToolTip.Tip="展开或折叠侧边栏"
              Width="28">
              <Viewbox Height="18" Width="18">
                <icons:AppIcon Kind="PanelLeft" />
              </Viewbox>
            </ToggleButton>
            <ToggleButton
              Classes="ShellChromeToggle"
              Height="28"
              IsChecked="{Binding IsDashboardFilterBarVisible, Mode=TwoWay}"
              IsVisible="{Binding IsDashboardPageActive}"
              ToolTip.Tip="显示或隐藏筛选栏"
              Width="28">
              <Viewbox Height="18" Width="18">
                <icons:AppIcon Kind="ListFilter" />
              </Viewbox>
            </ToggleButton>
          </StackPanel>
          <Rectangle Grid.Column="1" Classes="ShellContentHeaderDivider" />
          <TextBlock
            Grid.Column="2"
            Classes="SectionTitle"
            Text="{Binding ShellActivePageText}"
            VerticalAlignment="Center" />
          <Menu
            Grid.Column="4"
            Classes="ShellContentHeaderMenu"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <MenuItem
              Command="{Binding RefreshActivePageCommand}"
              IsEnabled="{Binding CanTopRefresh}"
              IsVisible="{Binding ShowTopRefresh}">
              <MenuItem.Header>
                <StackPanel Classes="ShellContentHeaderMenuItemHeader">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeCompact}"
                    Height="{DynamicResource IconSizeCompact}"
                    Kind="RotateCcw" />
                  <TextBlock Text="刷新" />
                </StackPanel>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem IsEnabled="False">
              <MenuItem.Header>
                <StackPanel Classes="ShellContentHeaderMenuItemHeader">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeCompact}"
                    Height="{DynamicResource IconSizeCompact}"
                    Kind="Eye" />
                  <TextBlock Text="视图" />
                </StackPanel>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem
              Command="{Binding TopImportCommand}"
              IsEnabled="{Binding CanTopImport}"
              IsVisible="{Binding ShowTopImport}">
              <MenuItem.Header>
                <StackPanel Classes="ShellContentHeaderMenuItemHeader">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeCompact}"
                    Height="{DynamicResource IconSizeCompact}"
                    Kind="Upload" />
                  <TextBlock Text="导入" />
                </StackPanel>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem
              Command="{Binding TopExportCommand}"
              IsEnabled="{Binding CanTopExport}"
              IsVisible="{Binding ShowTopExport}">
              <MenuItem.Header>
                <StackPanel Classes="ShellContentHeaderMenuItemHeader">
                  <icons:AppIcon
                    Width="{DynamicResource IconSizeCompact}"
                    Height="{DynamicResource IconSizeCompact}"
                    Kind="Download" />
                  <TextBlock Text="导出" />
                </StackPanel>
              </MenuItem.Header>
            </MenuItem>
          </Menu>
        </Grid>
      </Border>

      <Border
        Padding="12,8"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="0,0,0,1"
        Classes="ShellConnectivityBanner"
        Classes.error="{Binding ShellConnectivityBannerIsError}"
        Classes.info="{Binding ShellConnectivityBannerIsInfo}"
        Classes.warning="{Binding ShellConnectivityBannerIsWarning}"
        DockPanel.Dock="Top"
        IsVisible="{Binding ShowShellConnectivityBanner}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <icons:AppIcon
            Grid.Column="0"
            Width="16"
            Height="16"
            VerticalAlignment="Center"
            Kind="AlertTriangle" />
          <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock Classes="Small" Text="{Binding ShellConnectivityBannerTitle}" />
            <TextBlock
              Classes="Caption Muted"
              Text="{Binding ShellConnectivityBannerMessage}"
              TextWrapping="Wrap" />
          </StackPanel>
          <Button
            Grid.Column="2"
            VerticalAlignment="Center"
            Classes="Secondary"
            Command="{Binding OpenSettingsCommand}"
            Content="前往设置"
            IsVisible="{Binding ShowShellConnectivityBannerAction}" />
        </Grid>
      </Border>

      <Border Classes="ShellWorkspace">
        <controls:PageNavigationHost
          Page="{Binding ActivePage}"
          Pages="{Binding WorkspacePages}" />
      </Border>
    </DockPanel>
    </Grid>

    <Border
      Grid.Row="1"
      MinHeight="{DynamicResource ShellStatusBarHeight}"
      Padding="0"
      HorizontalAlignment="Stretch"
      BorderBrush="{DynamicResource BorderColor}"
      BorderThickness="0,1,0,0"
      Classes="ShellStatusBar">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer
          Grid.Column="0"
          HorizontalAlignment="Stretch"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="0">
            <Button Classes="ShellStatusItem ShellStatusDbItem" Command="{Binding TryReconnectDbCommand}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <Panel
                  Width="{DynamicResource IconSizeSmall}"
                  Height="{DynamicResource IconSizeSmall}"
                  VerticalAlignment="Center">
                  <controls:BusyCircle
                    Width="{DynamicResource IconSizeSmall}"
                    Height="{DynamicResource IconSizeSmall}"
                    DotBrush="{DynamicResource ForegroundColor}"
                    IsVisible="{Binding ShowDbBusyIcon}" />
                  <icons:AppIcon
                    Foreground="{DynamicResource BrushDone}"
                    IsVisible="{Binding ShowDbConnectedIcon}"
                    Kind="Database" />
                  <icons:AppIcon
                    Foreground="{DynamicResource BrushDanger}"
                    IsVisible="{Binding ShowDbDisconnectedIcon}"
                    Kind="Database" />
                </Panel>
                <TextBlock Classes="Caption Muted" Text="{Binding ShellDatabaseItemText}" />
              </StackPanel>
            </Button>

            <Border Classes="ShellStatusDivider" />

            <Button Classes="ShellStatusItem ShellStatusAgentItem" Command="{Binding StartOrRestartAhkCommand}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon Foreground="{Binding IsAhkRunning, Converter={StaticResource BoolToDoneDangerBrush}}" Kind="Syringe" />
                <TextBlock Classes="Caption Muted" Text="{Binding ShellAgentItemText}" />
              </StackPanel>
            </Button>

            <Border Classes="ShellStatusDivider" />

            <Button Classes="ShellStatusItem" IsEnabled="False">
              <TextBlock Classes="Caption Muted" Text="{Binding ShellActivePageText}" />
            </Button>

            <Border Classes="ShellStatusDivider" IsVisible="{Binding ShowShellAccessGuardItem}" />

            <Button
              Classes="ShellStatusItem"
              Command="{Binding OpenSettingsCommand}"
              IsVisible="{Binding ShowShellAccessGuardItem}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon Kind="ShieldAlert" />
                <TextBlock
                  MaxWidth="220"
                  Classes="Caption Muted"
                  Text="{Binding ShellAccessGuardItemText}"
                  TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <StackPanel
          Grid.Column="1"
          VerticalAlignment="Stretch"
          Orientation="Horizontal"
          Spacing="0">
          <Button
            Classes="ShellStatusItem ShellStatusUpdateItem"
            Command="{Binding OpenUpdateCenterCommand}"
            IsVisible="{Binding HasUpdateAvailable}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
              <icons:AppIcon Kind="Upload" />
              <TextBlock Classes="Caption Muted" Text="{Binding LatestProductVersion, StringFormat=更新 {0}}" />
            </StackPanel>
          </Button>

          <Border Classes="ShellStatusDivider" IsVisible="{Binding HasUpdateAvailable}" />

          <Button Classes="ShellStatusItem" IsEnabled="False">
            <Panel>
              <StackPanel
                IsVisible="{Binding !IsUpdateChecking}"
                Orientation="Horizontal"
                Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeMini}"
                  Height="{DynamicResource IconSizeMini}"
                  Kind="Tag" />
                <TextBlock Classes="Caption Muted" Text="{Binding ShellVersionText}" />
              </StackPanel>
              <StackPanel
                IsVisible="{Binding IsUpdateChecking}"
                Orientation="Horizontal"
                Spacing="{DynamicResource SpacingInlineSm}">
                <controls:BusyCircle
                  Width="{DynamicResource IconSizeSmall}"
                  Height="{DynamicResource IconSizeSmall}"
                  DotBrush="{DynamicResource ForegroundColor}" />
                <TextBlock Classes="Caption Muted" Text="检查更新…" />
              </StackPanel>
            </Panel>
          </Button>

          <Border Classes="ShellStatusDivider" />

          <Button
            Classes="ShellStatusItem ShellStatusIconItem"
            Classes.active="{Binding IsSettingsPageActive}"
            Command="{Binding OpenSettingsCommand}">
            <Panel>
              <icons:AppIcon Kind="Settings" />
              <Border
                Width="6"
                Height="6"
                Margin="0,-2,-2,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{DynamicResource BrushWarning}"
                CornerRadius="999"
                IsVisible="{Binding HasUpdateAvailable}" />
            </Panel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</shad:Window>
