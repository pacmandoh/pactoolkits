<shad:Window
  x:Class="PacToolkits.Desktop.Avalonia.Views.MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:PacToolkits.Desktop.Avalonia.Behaviors"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:conv="clr-namespace:PacToolkits.Desktop.Avalonia.Converters"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:vm="using:PacToolkits.Desktop.Avalonia.ViewModels"
  x:Name="Root"
  Title="PacToolkits - 自动化套件"
  Width="1460"
  Height="900"
  MinWidth="1350"
  MinHeight="800"
  behaviors:FocusClear.Enable="True"
  x:DataType="vm:MainWindowViewModel"
  Icon="avares://pactoolkits-desktop/Assets/app.ico"
  ShowBottomBorder="False"
  TitleBarAnimationEnabled="False"
  WindowStartupLocation="CenterScreen">
  <shad:Window.Resources>
    <conv:SidebarNavToolTipConverter x:Key="SidebarNavToolTip" />
  </shad:Window.Resources>

  <shad:Window.Hosts>
    <shad:ToastHost Manager="{Binding ToastManager}" />
    <shad:DialogHost Manager="{Binding DialogManager}" />
  </shad:Window.Hosts>

  <shad:Window.LogoContent>
    <Grid Classes="TitleBarNav" ColumnDefinitions="Auto,Auto,Auto,Auto">
      <Button
        Classes="TitleBarNavBtn"
        Command="{Binding NavigateBackCommand}"
        ToolTip.Tip="{Binding NavigateBackToolTip}">
        <icons:AppIcon Kind="ArrowLeft" />
      </Button>
      <Button
        Grid.Column="1"
        Classes="TitleBarNavBtn"
        Command="{Binding NavigateForwardCommand}"
        ToolTip.Tip="{Binding NavigateForwardToolTip}">
        <icons:AppIcon Kind="ArrowRight" />
      </Button>
      <Border Grid.Column="2" Classes="TitleBarPath">
        <Grid
          Margin="12,0,10,0"
          VerticalAlignment="Center"
          ColumnDefinitions="*,Auto,Auto">
          <StackPanel
            Classes="TitleBarCrumbs"
            Orientation="Horizontal"
            Spacing="7">
            <icons:AppIcon Kind="{Binding SelectedFunctionArea.Icon}" />
            <TextBlock Classes="Caption Muted" Text="{Binding SelectedFunctionArea.Name}" />
            <icons:AppIcon Kind="ChevronRight" />
            <icons:AppIcon Kind="{Binding ActivePageIcon}" />
            <TextBlock
              MaxWidth="180"
              Classes="Caption"
              Text="{Binding ActivePageText}"
              TextTrimming="CharacterEllipsis" />
            <icons:AppIcon IsVisible="{Binding ShowActiveTab}" Kind="ChevronRight" />
            <icons:AppIcon IsVisible="{Binding ShowActiveTab}" Kind="{Binding ActiveTabIcon}" />
            <TextBlock
              MaxWidth="120"
              Classes="Caption"
              IsVisible="{Binding ShowActiveTab}"
              Text="{Binding ActiveTabText}"
              TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Rectangle Grid.Column="1" Classes="TitleBarPathDivider" />
          <StackPanel
            Grid.Column="2"
            Classes="TitleBarBrand"
            Orientation="Horizontal"
            Spacing="6">
            <Image
              Width="{DynamicResource IconSizeSmall}"
              Height="{DynamicResource IconSizeSmall}"
              Source="avares://pactoolkits-desktop/Assets/app.ico" />
            <TextBlock Classes="Caption Muted" Text="PacToolkits" />
          </StackPanel>
        </Grid>
      </Border>
      <Button
        Grid.Column="3"
        shad:ButtonAssist.ShowProgress="{Binding IsUpdateApplying}"
        Classes="TitleBarUpdateBtn"
        Command="{Binding OpenUpdateCenterCommand}"
        IsVisible="{Binding HasUpdateAvailable}">
        <StackPanel
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="6">
          <icons:AppIcon Kind="Download" />
          <TextBlock
            VerticalAlignment="Center"
            Classes="Caption"
            Text="{Binding UpdateActionText}" />
        </StackPanel>
      </Button>
    </Grid>
  </shad:Window.LogoContent>

  <shad:Window.RightWindowTitleBarContent>
    <Border VerticalAlignment="Center" Classes="TitleBarCapsule">
      <StackPanel Orientation="Horizontal" Spacing="0">
        <Button
          Classes="WindowControlsButton"
          Command="{Binding SwitchThemeCommand}"
          ToolTip.Tip="切换主题">
          <icons:AppIcon
            Width="{DynamicResource TitleBarCapsuleIconSize}"
            Height="{DynamicResource TitleBarCapsuleIconSize}"
            Kind="{Binding CurrentTheme, Converter={x:Static conv:Theme.ToIconKind}}" />
        </Button>

        <Border
          Width="1"
          Height="{DynamicResource TitleBarCapsuleIconSize}"
          Margin="{DynamicResource TitleBarCapsuleDividerMargin}"
          VerticalAlignment="Center"
          Background="{DynamicResource BorderColor}" />

        <Button
          x:Name="FullscreenButton"
          Classes="WindowControlsButton"
          ToolTip.Tip="全屏">
          <Panel>
            <icons:AppIcon
              Width="{DynamicResource TitleBarCapsuleIconSize}"
              Height="{DynamicResource TitleBarCapsuleIconSize}"
              IsVisible="{Binding #Root.WindowState, Converter={x:Static conv:WindowStateConverters.IsNotFullScreen}}"
              Kind="Maximize" />
            <icons:AppIcon
              Width="{DynamicResource TitleBarCapsuleIconSize}"
              Height="{DynamicResource TitleBarCapsuleIconSize}"
              IsVisible="{Binding #Root.WindowState, Converter={x:Static conv:WindowStateConverters.IsFullScreen}}"
              Kind="Minimize" />
          </Panel>
        </Button>

        <Border
          Width="1"
          Height="{DynamicResource TitleBarCapsuleIconSize}"
          Margin="{DynamicResource TitleBarCapsuleDividerMargin}"
          VerticalAlignment="Center"
          Background="{DynamicResource BorderColor}" />

        <Button
          shad:ButtonAssist.ShowProgress="{Binding IsDbProbeRunning}"
          Classes="WindowControlsButton"
          Command="{Binding TryReconnectDbCommand}"
          ToolTip.Tip="{Binding DbItemText}">
          <Panel>
            <icons:AppIcon
              Width="{DynamicResource TitleBarCapsuleIconSize}"
              Height="{DynamicResource TitleBarCapsuleIconSize}"
              Foreground="{DynamicResource SuccessColor}"
              IsVisible="{Binding IsDbConnected}"
              Kind="Link" />
            <icons:AppIcon
              Width="{DynamicResource TitleBarCapsuleIconSize}"
              Height="{DynamicResource TitleBarCapsuleIconSize}"
              Foreground="{DynamicResource ErrorColor}"
              IsVisible="{Binding !IsDbConnected}"
              Kind="Unlink" />
          </Panel>
        </Button>

        <Button
          shad:ButtonAssist.ShowProgress="{Binding IsAhkActionRunning}"
          Classes="WindowControlsButton"
          Command="{Binding StartOrRestartAhkCommand}"
          ToolTip.Tip="{Binding AgentItemText}">
          <Panel>
            <icons:AppIcon
              Width="{DynamicResource TitleBarCapsuleIconSize}"
              Height="{DynamicResource TitleBarCapsuleIconSize}"
              Foreground="{DynamicResource SuccessColor}"
              IsVisible="{Binding IsAhkRunning}"
              Kind="Syringe" />
            <icons:AppIcon
              Width="{DynamicResource TitleBarCapsuleIconSize}"
              Height="{DynamicResource TitleBarCapsuleIconSize}"
              Foreground="{DynamicResource ErrorColor}"
              IsVisible="{Binding !IsAhkRunning}"
              Kind="Syringe" />
          </Panel>
        </Button>
      </StackPanel>
    </Border>
  </shad:Window.RightWindowTitleBarContent>

  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
      <shad:Sidebar
        x:Name="MainSidebar"
        Width="255"
        MinWidth="56"
        BorderThickness="0,0,1,0"
        CurrentRoute="{Binding ActivePageRoute}"
        Expanded="{Binding IsSidebarExpanded, Mode=TwoWay}"
        ItemIconContentSpacing="12">
        <shad:Sidebar.Header>
          <Border Classes="SidebarFuncHost">
            <Menu Classes="Single">
              <MenuItem
                HorizontalAlignment="Stretch"
                shad:MenuItemAssist.PopupHorizontalOffset="4"
                shad:MenuItemAssist.PopupPlacement="RightEdgeAlignedTop"
                shad:MenuItemAssist.PopupVerticalOffset="0"
                Classes="NoPressedAnimation SidebarFuncMenuItem"
                CornerRadius="{DynamicResource LgCornerRadius}">
                <MenuItem.Header>
                  <Panel>
                    <Border
                      Width="38"
                      Height="36"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Classes="SidebarFuncBadge"
                      CornerRadius="{DynamicResource LgCornerRadius}"
                      IsVisible="{Binding !IsSidebarExpanded}">
                      <Viewbox Width="16" Height="16">
                        <icons:AppIcon Kind="{Binding SelectedFunctionArea.Icon}" />
                      </Viewbox>
                    </Border>
                    <Grid
                      Margin="0"
                      HorizontalAlignment="Stretch"
                      ColumnDefinitions="Auto,*,Auto"
                      IsVisible="{Binding IsSidebarExpanded}">
                      <Border
                        Width="36"
                        Height="36"
                        Margin="0,0,8,0"
                        Classes="SidebarFuncBadge"
                        CornerRadius="{DynamicResource XlCornerRadius}">
                        <Viewbox Width="16" Height="16">
                          <icons:AppIcon Kind="{Binding SelectedFunctionArea.Icon}" />
                        </Viewbox>
                      </Border>
                      <StackPanel Grid.Column="1" Classes="SidebarFuncText">
                        <TextBlock Classes="Small" Text="{Binding SelectedFunctionArea.Name}" />
                        <TextBlock
                          Classes="Caption Muted"
                          Text="{Binding SelectedFunctionArea.Subtitle}"
                          TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Viewbox
                        Grid.Column="2"
                        Width="16"
                        Height="16">
                        <icons:AppIcon Foreground="{DynamicResource ForegroundColor}" Kind="ChevronsUpDown" />
                      </Viewbox>
                    </Grid>
                  </Panel>
                </MenuItem.Header>
                <shad:MenuItemAssist.Label>
                  <TextBlock
                    Width="220"
                    Classes="Caption Muted"
                    Text="功能区" />
                </shad:MenuItemAssist.Label>
                <MenuItem
                  Command="{Binding SelectFunctionAreaCommand}"
                  CommandParameter="{x:Static vm:ShellFunctionAreas.Traceability}"
                  Header="{x:Static vm:ShellFunctionAreas.TraceabilityName}">
                  <MenuItem.Icon>
                    <Border
                      Width="24"
                      Height="24"
                      Padding="4"
                      BorderBrush="{DynamicResource BorderColor}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource LgCornerRadius}">
                      <Viewbox>
                        <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="{x:Static vm:ShellFunctionAreas.TraceabilityIcon}" />
                      </Viewbox>
                    </Border>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                  Command="{Binding SelectFunctionAreaCommand}"
                  CommandParameter="{x:Static vm:ShellFunctionAreas.Automation}"
                  Header="{x:Static vm:ShellFunctionAreas.AutomationName}">
                  <MenuItem.Icon>
                    <Border
                      Width="24"
                      Height="24"
                      Padding="4"
                      BorderBrush="{DynamicResource BorderColor}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource LgCornerRadius}">
                      <Viewbox>
                        <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="{x:Static vm:ShellFunctionAreas.AutomationIcon}" />
                      </Viewbox>
                    </Border>
                  </MenuItem.Icon>
                </MenuItem>
              </MenuItem>
            </Menu>
          </Border>
        </shad:Sidebar.Header>

        <StackPanel Classes="SidebarNavHost" Spacing="4">
          <shad:SidebarItemLabel
            AsSeparator="True"
            Classes="SidebarSectionLabel"
            Text="页面" />

          <ItemsControl ItemsSource="{Binding FilteredSidebarPages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="{DynamicResource SidebarNavItemSpacing}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AppPageBase">
                <shad:SidebarItem
                  Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).NavigateSidebarPageCommand}"
                  CommandParameter="{Binding}"
                  Content="{Binding DisplayName}"
                  IsEnabled="{Binding IsEnabled}"
                  Route="{Binding SidebarRoute}">
                  <ToolTip.Tip>
                    <MultiBinding Converter="{StaticResource SidebarNavToolTip}">
                      <Binding Path="$parent[shad:Sidebar].Expanded" />
                      <Binding Path="DisplayName" />
                    </MultiBinding>
                  </ToolTip.Tip>
                  <shad:SidebarItem.Icon>
                    <Viewbox>
                      <icons:AppIcon Kind="{Binding Icon}" />
                    </Viewbox>
                  </shad:SidebarItem.Icon>
                </shad:SidebarItem>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <shad:Sidebar.Footer>
          <Menu Classes="Single">
            <MenuItem
              Padding="8,0"
              HorizontalAlignment="Stretch"
              shad:MenuItemAssist.PopupHorizontalOffset="4"
              shad:MenuItemAssist.PopupPlacement="RightEdgeAlignedBottom"
              shad:MenuItemAssist.PopupVerticalOffset="4"
              Classes="NoPressedAnimation SidebarFooterMenuItem"
              CornerRadius="{DynamicResource LgCornerRadius}">
              <MenuItem.Header>
                <Panel>
                  <Image
                    HorizontalAlignment="Center"
                    Classes="SidebarBrandIcon"
                    IsVisible="{Binding !IsSidebarExpanded}"
                    Source="avares://pactoolkits-desktop/Assets/app.ico" />
                  <Grid
                    Margin="0,4"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="8"
                    IsVisible="{Binding IsSidebarExpanded}">
                    <Image Classes="SidebarBrandIcon" Source="avares://pactoolkits-desktop/Assets/app.ico" />
                    <StackPanel Grid.Column="1" Classes="SidebarAccountText">
                      <TextBlock Classes="Small" Text="PacToolkits" />
                      <TextBlock
                        Classes="Caption Muted"
                        Text="{Binding VersionText}"
                        TextWrapping="Wrap" />
                    </StackPanel>
                    <Viewbox
                      Grid.Column="2"
                      Width="18"
                      Height="18">
                      <icons:AppIcon Foreground="{DynamicResource ForegroundColor}" Kind="ChevronsUpDown" />
                    </Viewbox>
                  </Grid>
                </Panel>
              </MenuItem.Header>
              <shad:MenuItemAssist.Label>
                <Grid
                  Width="220"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="12">
                  <Image Classes="SidebarBrandIcon" Source="avares://pactoolkits-desktop/Assets/app.ico" />
                  <StackPanel Grid.Column="1" Classes="SidebarAccountText">
                    <TextBlock Classes="Small" Text="PacToolkits" />
                    <TextBlock
                      Classes="Caption Muted"
                      LineHeight="16"
                      Text="{Binding VersionText}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </shad:MenuItemAssist.Label>
              <MenuItem Command="{Binding OpenSettingsCommand}" Header="设置">
                <MenuItem.Icon>
                  <Panel Classes="ShellMenuUpdateIcon">
                    <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="Settings" />
                    <Border Classes="UpdateDot" IsVisible="{Binding HasUpdateAvailable}" />
                  </Panel>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Command="{Binding OpenAboutCommand}" Header="关于">
                <MenuItem.Icon>
                  <Viewbox Width="16" Height="16">
                    <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="Info" />
                  </Viewbox>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem
                Command="{Binding CheckAppUpdateCommand}"
                Header="检查更新"
                IsEnabled="{Binding !IsUpdateChecking}">
                <MenuItem.Icon>
                  <Viewbox Width="16" Height="16">
                    <icons:AppIcon Foreground="{DynamicResource MutedColor}" Kind="Download" />
                  </Viewbox>
                </MenuItem.Icon>
              </MenuItem>
            </MenuItem>
          </Menu>
        </shad:Sidebar.Footer>
      </shad:Sidebar>

      <DockPanel
        Grid.Column="1"
        Background="{DynamicResource CardBackgroundColor}"
        LastChildFill="True">
        <Border
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="0,0,0,1"
          Classes="PageHeader"
          DockPanel.Dock="Top">
          <Grid
            MinHeight="{DynamicResource ChromeRowHeight}"
            Margin="{DynamicResource HeaderPadding}"
            VerticalAlignment="Center"
            ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto">
            <StackPanel
              Grid.Column="0"
              Orientation="Horizontal"
              Spacing="4">
              <Button
                Classes="Icon ghost-states"
                Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="{Binding SidebarToggleToolTip}">
                <icons:AppIcon Kind="{Binding SidebarToggleIconKind}" />
              </Button>
              <Button
                Classes="Icon ghost-states"
                Classes.active="{Binding IsDashboardFilterBarVisible}"
                Command="{Binding ToggleDashboardFilterBarCommand}"
                IsVisible="{Binding IsDashboardPageActive}"
                ToolTip.Tip="{Binding FilterBarToggleToolTip}">
                <icons:AppIcon Kind="{Binding FilterBarToggleIconKind}" />
              </Button>
              <Button
                Classes="Icon ghost-states"
                Command="{Binding Unlock}"
                IsEnabled="{Binding CanUnlock}"
                IsVisible="{Binding ShowUnlock}"
                ToolTip.Tip="解锁">
                <icons:AppIcon Foreground="{DynamicResource WarningColor}" Kind="LockKeyhole" />
              </Button>
              <Button
                Classes="Icon ghost-states"
                Command="{Binding Lock}"
                IsEnabled="{Binding CanLock}"
                IsVisible="{Binding ShowLock}"
                ToolTip.Tip="锁定">
                <icons:AppIcon Foreground="{DynamicResource ErrorColor}" Kind="LockKeyholeOpen" />
              </Button>
            </StackPanel>
            <Rectangle Grid.Column="1" Classes="HeaderDivider" />
            <StackPanel
              Grid.Column="2"
              VerticalAlignment="Center"
              Classes="HeaderTitleRail"
              Orientation="Horizontal">
              <TextBlock Classes="Small Muted" Text="{Binding ActivePageText}" />
              <icons:AppIcon
                Classes="HeaderTitleChevron"
                IsVisible="{Binding IsDashboardPageActive}"
                Kind="ChevronRight" />
              <TabControl
                shad:TabControlBehaviors.UseSlidingPill="True"
                Classes="DashboardTabHeaders"
                IsVisible="{Binding IsDashboardPageActive}"
                ItemsSource="{Binding DashboardTabs}"
                SelectedIndex="{Binding DashboardSelectedTabIndex, Mode=TwoWay}">
                <TabControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PageTab">
                    <StackPanel Classes="TabItemHeader">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeCompact}"
                        Height="{DynamicResource IconSizeCompact}"
                        Kind="{Binding Icon}" />
                      <TextBlock Text="{Binding Text}" />
                    </StackPanel>
                  </DataTemplate>
                </TabControl.ItemTemplate>
              </TabControl>
              <icons:AppIcon
                Classes="HeaderTitleChevron"
                IsVisible="{Binding IsScanCodePageActive}"
                Kind="ChevronRight" />
              <TabControl
                shad:TabControlBehaviors.UseSlidingPill="True"
                Classes="DashboardTabHeaders"
                IsVisible="{Binding IsScanCodePageActive}"
                ItemsSource="{Binding ScanCodeTabs}"
                SelectedIndex="{Binding ScanCodeSelectedTabIndex, Mode=TwoWay}">
                <TabControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PageTab">
                    <StackPanel Classes="TabItemHeader">
                      <icons:AppIcon
                        Width="{DynamicResource IconSizeCompact}"
                        Height="{DynamicResource IconSizeCompact}"
                        Kind="{Binding Icon}" />
                      <TextBlock Text="{Binding Text}" />
                    </StackPanel>
                  </DataTemplate>
                </TabControl.ItemTemplate>
              </TabControl>
            </StackPanel>
            <Menu
              Grid.Column="4"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Classes="HeaderMenu"
              IsVisible="{Binding IsDrugIndexPageActive}">
              <MenuItem Command="{Binding Import}" IsEnabled="{Binding CanImport}">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="Clipboard" />
                    <TextBlock Text="剪贴板导入" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem Command="{Binding NewItem}" IsEnabled="{Binding CanNewItem}">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="Plus" />
                    <TextBlock Text="新建" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
            </Menu>
            <Menu
              Grid.Column="4"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Classes="HeaderMenu"
              IsVisible="{Binding IsInventoryPageActive}">
              <MenuItem
                Command="{Binding ToggleStockEdit}"
                IsEnabled="{Binding CanToggleStockEdit}"
                IsVisible="{Binding ShowEnableStockEdit}">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="SquarePen" />
                    <TextBlock Text="编辑" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem
                Command="{Binding ToggleStockEdit}"
                IsEnabled="{Binding CanToggleStockEdit}"
                IsVisible="{Binding ShowDisableStockEdit}">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="Check" />
                    <TextBlock Text="完成编辑" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem
                Command="{Binding ToggleReassign}"
                IsEnabled="{Binding CanToggleReassign}"
                IsVisible="{Binding ShowOpenReassign}">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="FilePenLine" />
                    <TextBlock Text="药品纠错" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem
                Command="{Binding ToggleReassign}"
                IsEnabled="{Binding CanToggleReassign}"
                IsVisible="{Binding ShowCloseReassign}">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="X" />
                    <TextBlock Text="关闭纠错" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
            </Menu>
            <Border
              Grid.Column="4"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Classes="DashboardTabContext"
              IsHitTestVisible="False"
              IsVisible="{Binding IsDashboardPageActive}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon
                  Width="{DynamicResource IconSizeSmall}"
                  Height="{DynamicResource IconSizeSmall}"
                  Kind="CalendarRange" />
                <TextBlock
                  MaxWidth="360"
                  VerticalAlignment="Center"
                  Classes="Caption Muted"
                  Text="{Binding DashboardSectionHint}"
                  TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <StackPanel
              Grid.Column="4"
              VerticalAlignment="Center"
              IsVisible="{Binding ShowAutoFetchActions}"
              Orientation="Horizontal"
              Spacing="{DynamicResource SpacingInlineSm}">
              <Grid
                VerticalAlignment="Center"
                ColumnDefinitions="Auto,Auto"
                ColumnSpacing="7">
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="Caption Muted"
                  Text="启用调度" />
                <ToggleSwitch
                  Grid.Column="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsChecked="{Binding AutoFetchEnabled, Mode=TwoWay}" />
              </Grid>
              <Button Classes="Action" Command="{Binding StartAutoFetch}">
                <StackPanel Classes="HeaderMenuItem">
                  <icons:AppIcon Kind="Play" />
                  <TextBlock Text="启动" />
                </StackPanel>
              </Button>
              <Button Classes="Action" Command="{Binding StopAutoFetch}">
                <StackPanel Classes="HeaderMenuItem">
                  <icons:AppIcon Kind="Square" />
                  <TextBlock Text="停止" />
                </StackPanel>
              </Button>
              <Button Classes="Action" Command="{Binding OpenAutoFetchSettings}">
                <StackPanel Classes="HeaderMenuItem">
                  <icons:AppIcon Kind="SlidersHorizontal" />
                  <TextBlock Text="拉取策略" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Rectangle Grid.Column="5" Classes="HeaderDivider" />
            <Menu
              Grid.Column="6"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Classes="HeaderMenu">
              <MenuItem
                Command="{Binding RefreshActivePageCommand}"
                IsEnabled="{Binding CanTopRefresh}"
                IsVisible="{Binding ShowTopRefresh}">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="RotateCcw" />
                    <TextBlock Text="刷新" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem IsEnabled="False">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="Eye" />
                    <TextBlock Text="视图" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem
                Command="{Binding TopImport}"
                IsEnabled="{Binding CanTopImport}"
                IsVisible="{Binding ShowTopImport}">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="Upload" />
                    <TextBlock Text="导入" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem
                Command="{Binding TopExport}"
                IsEnabled="{Binding CanTopExport}"
                IsVisible="{Binding ShowTopExport}">
                <MenuItem.Header>
                  <StackPanel Classes="HeaderMenuItem">
                    <icons:AppIcon
                      Width="{DynamicResource IconSizeCompact}"
                      Height="{DynamicResource IconSizeCompact}"
                      Kind="Download" />
                    <TextBlock Text="导出" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
            </Menu>
          </Grid>
        </Border>

        <Border
          Padding="12,8"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="0,0,0,1"
          Classes="ConnectivityBanner"
          Classes.error="{Binding ConnectivityBannerIsError}"
          Classes.info="{Binding ConnectivityBannerIsInfo}"
          Classes.warning="{Binding ConnectivityBannerIsWarning}"
          DockPanel.Dock="Top"
          IsVisible="{Binding ShowConnectivityBanner}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <icons:AppIcon
              Grid.Column="0"
              Width="16"
              Height="16"
              VerticalAlignment="Center"
              Kind="AlertTriangle" />
            <StackPanel
              Grid.Column="1"
              VerticalAlignment="Center"
              Spacing="2">
              <TextBlock Classes="Small" Text="{Binding ConnectivityBannerTitle}" />
              <TextBlock
                Classes="Caption Muted"
                Text="{Binding ConnectivityBannerMessage}"
                TextWrapping="Wrap" />
            </StackPanel>
            <Button
              Grid.Column="2"
              VerticalAlignment="Center"
              Classes="Outline"
              Command="{Binding OpenSettingsCommand}"
              Content="前往设置"
              IsVisible="{Binding ShowConnectivityBannerAction}" />
          </Grid>
        </Border>

        <Border Classes="ContentWorkspace">
          <controls:PageNavigationHost Page="{Binding ActivePage}" Pages="{Binding WorkspacePages}" />
        </Border>
      </DockPanel>
    </Grid>

    <Border
      Grid.Row="1"
      MinHeight="{DynamicResource StatusBarHeight}"
      Padding="0"
      HorizontalAlignment="Stretch"
      BorderBrush="{DynamicResource BorderColor}"
      BorderThickness="0,1,0,0"
      Classes="StatusBar">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer
          Grid.Column="0"
          HorizontalAlignment="Stretch"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="0">
            <Button
              shad:ButtonAssist.ShowProgress="{Binding IsDbProbeRunning}"
              Classes="StatusBarItem StatusBarDbItem"
              Command="{Binding TryReconnectDbCommand}">
              <shad:ButtonAssist.Icon>
                <Panel
                  Width="{DynamicResource IconSizeSmall}"
                  Height="{DynamicResource IconSizeSmall}"
                  VerticalAlignment="Center">
                  <icons:AppIcon
                    Foreground="{DynamicResource SuccessColor}"
                    IsVisible="{Binding IsDbConnected}"
                    Kind="Database" />
                  <icons:AppIcon
                    Foreground="{DynamicResource ErrorColor}"
                    IsVisible="{Binding !IsDbConnected}"
                    Kind="Database" />
                </Panel>
              </shad:ButtonAssist.Icon>
              <TextBlock Classes="Caption Muted" Text="{Binding DbItemText}" />
            </Button>

            <Border Classes="StatusBarDivider" />

            <Button
              shad:ButtonAssist.ShowProgress="{Binding IsAhkActionRunning}"
              Classes="StatusBarItem StatusBarAgentItem"
              Command="{Binding StartOrRestartAhkCommand}">
              <shad:ButtonAssist.Icon>
                <icons:AppIcon Foreground="{Binding IsAhkRunning, Converter={StaticResource BoolToDoneDangerBrush}}" Kind="Syringe" />
              </shad:ButtonAssist.Icon>
              <TextBlock Classes="Caption Muted" Text="{Binding AgentItemText}" />
            </Button>

            <Border Classes="StatusBarDivider" IsVisible="{Binding ShowAccessGuardItem}" />

            <Button
              Classes="StatusBarItem"
              Command="{Binding OpenSettingsCommand}"
              IsVisible="{Binding ShowAccessGuardItem}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
                <icons:AppIcon Kind="ShieldAlert" />
                <TextBlock
                  MaxWidth="220"
                  Classes="Caption Muted"
                  Text="{Binding AccessGuardItemText}"
                  TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <StackPanel
          Grid.Column="1"
          VerticalAlignment="Stretch"
          Orientation="Horizontal"
          Spacing="0">
          <Button
            Classes="StatusBarItem"
            Command="{Binding OpenUpdateCenterCommand}"
            IsVisible="{Binding HasUpdateAvailable}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
              <icons:AppIcon Foreground="{DynamicResource WarningColor}" Kind="Upload" />
              <TextBlock
                Classes="Caption"
                Foreground="{DynamicResource WarningColor}"
                Text="{Binding LatestProductVersion, StringFormat=更新 {0}}" />
            </StackPanel>
          </Button>

          <Border Classes="StatusBarDivider" IsVisible="{Binding HasUpdateAvailable}" />

          <Button Classes="StatusBarItem" IsEnabled="False">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
              <icons:AppIcon
                Width="{DynamicResource IconSizeMini}"
                Height="{DynamicResource IconSizeMini}"
                IsVisible="{Binding !IsUpdateChecking}"
                Kind="Tag" />
              <TextBlock Classes="Caption Muted" Text="{Binding VersionBarText}" />
            </StackPanel>
          </Button>

          <Border Classes="StatusBarDivider" />

          <Button
            Classes="StatusBarItem StatusBarIconItem"
            Classes.active="{Binding IsSettingsPageActive}"
            Command="{Binding OpenSettingsCommand}">
            <Panel>
              <icons:AppIcon Kind="Settings" />
              <Border
                Margin="0,-2,-2,0"
                Classes="UpdateDot"
                IsVisible="{Binding HasUpdateAvailable}" />
            </Panel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</shad:Window>
