<suki:SukiWindow xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vm="using:PacToolkits.Desktop.Avalonia.ViewModels"
         xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
         xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
         xmlns:behaviors="clr-namespace:PacToolkits.Desktop.Avalonia.Behaviors"
         xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
         x:Class="PacToolkits.Desktop.Avalonia.Views.MainWindow"
         x:DataType="vm:MainWindowViewModel"
         Title="PacToolkits - 自动化套件"
         Icon="avares://pactoolkits-desktop/Assets/app.ico"
         BackgroundStyle="Flat"
         IsMenuVisible="True"
         Width="1450"
         Height="900"
         MinWidth="1350"
         MinHeight="800"
         behaviors:FocusClearBehavior.Enable="True"
         WindowStartupLocation="CenterScreen">
  <suki:SukiWindow.Hosts>

    <suki:SukiToastHost Manager="{Binding ToastManager}" />


    <suki:SukiDialogHost Manager="{Binding DialogManager}" />
  </suki:SukiWindow.Hosts>

  <suki:SukiWindow.RightWindowTitleBarControls>
    <Button
      Classes="WindowControlsButton"
      Command="{Binding OpenUpdateCenterCommand}"
      ToolTip.Tip="{Binding UpdateStatusTip}"
      IsVisible="{Binding HasUpdateAvailable}"
      Margin="{DynamicResource ShellNavItemMargin}">
      <icons:AppIcon Kind="Upload"
                Width="{DynamicResource ShellNavIconSize}"
                Height="{DynamicResource ShellNavIconSize}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource BrushWarning}" />
    </Button>

    <Border BorderBrush="{DynamicResource SukiControlBorderBrush}"
        BorderThickness="1"
        CornerRadius="999"
        Padding="2,0"
        VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="0">
        <Button
          Classes="WindowControlsButton"
          Command="{Binding ToggleBaseThemeCommand}">
          <Panel>
            <icons:AppIcon IsVisible="{Binding IsNightMode}" Kind="SunMedium" Width="{DynamicResource IconSizeDefault}" Height="{DynamicResource IconSizeDefault}" Foreground="{DynamicResource SukiText}" />
            <icons:AppIcon IsVisible="{Binding !IsNightMode}" Kind="MoonStar" Width="{DynamicResource IconSizeDefault}" Height="{DynamicResource IconSizeDefault}" Foreground="{DynamicResource SukiText}" />
          </Panel>
        </Button>

        <Button
          Classes="WindowControlsButton"
          Command="{Binding CycleThemeColorCommand}">
          <icons:AppIcon Kind="Palette"
                 Width="{DynamicResource IconSizeDefault}"
                 Height="{DynamicResource IconSizeDefault}"
                 Foreground="{DynamicResource SukiText}" />
        </Button>

        <Border Width="1"
            Height="{DynamicResource IconSizeDefault}"
            Margin="{DynamicResource ShellNavButtonMargin}"
            VerticalAlignment="Center"
            Background="{DynamicResource SukiControlBorderBrush}" />

        <Button
          Classes="WindowControlsButton"
          Command="{Binding TryReconnectDbCommand}">
          <Panel>
            <controls:BusyCircle
              IsVisible="{Binding ShowDbBusyIcon}"
              Width="{DynamicResource IconSizeDefault}"
              Height="{DynamicResource IconSizeDefault}"
              DotBrush="{DynamicResource SukiText}" />

            <icons:AppIcon
              IsVisible="{Binding ShowDbConnectedIcon}"
              Kind="Link"
              Width="{DynamicResource IconSizeDefault}"
              Height="{DynamicResource IconSizeDefault}"
              Foreground="{DynamicResource BrushDone}" />

            <icons:AppIcon
              IsVisible="{Binding ShowDbDisconnectedIcon}"
              Kind="Unlink"
              Width="{DynamicResource IconSizeDefault}"
              Height="{DynamicResource IconSizeDefault}"
              Foreground="{DynamicResource BrushDanger}" />
          </Panel>
        </Button>

        <Button
          Classes="WindowControlsButton"
          Command="{Binding StartOrRestartAhkCommand}">
          <Panel>
            <icons:AppIcon
              IsVisible="{Binding IsAhkRunning}"
              Kind="Syringe"
              Width="{DynamicResource IconSizeDefault}"
              Height="{DynamicResource IconSizeDefault}"
              Foreground="{DynamicResource BrushDone}" />
            <icons:AppIcon
              IsVisible="{Binding !IsAhkRunning}"
              Kind="Syringe"
              Width="{DynamicResource IconSizeDefault}"
              Height="{DynamicResource IconSizeDefault}"
              Foreground="{DynamicResource BrushDanger}" />
          </Panel>
        </Button>
      </StackPanel>
    </Border>
  </suki:SukiWindow.RightWindowTitleBarControls>

  <suki:SukiWindow.LogoContent>
    <Image Source="avares://pactoolkits-desktop/Assets/icon-32.png"
       Height="20"
       Stretch="Uniform"
       VerticalAlignment="Center" />
  </suki:SukiWindow.LogoContent>

  <suki:SukiWindow.MenuItems>
    <MenuItem Header="刷新"
         Command="{Binding RefreshActivePageCommand}"
         IsEnabled="{Binding CanTopRefresh}" />

    <MenuItem Header="导入"
         Command="{Binding TopImportCommand}"
         IsEnabled="{Binding CanTopImport}" />

    <MenuItem Header="导出"
         Command="{Binding TopExportCommand}"
         IsEnabled="{Binding CanTopExport}" />

    <MenuItem Header="设置"
         Command="{Binding OpenSettingsCommand}" />

    <MenuItem Header="关于">
      <MenuItem Header="关于 PacToolkits"
           Command="{Binding OpenAboutCommand}">
        <MenuItem.Icon>
          <icons:AppIcon Kind="IdCard" Width="{DynamicResource IconSizeSmall}" Height="{DynamicResource IconSizeSmall}" />
        </MenuItem.Icon>
      </MenuItem>

      <MenuItem Header="检查更新"
           Command="{Binding CheckAppUpdateCommand}"
           IsEnabled="{Binding !IsUpdateChecking}">
        <MenuItem.Icon>
          <Panel>
            <controls:BusyCircle IsVisible="{Binding IsUpdateChecking}"
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      DotBrush="{DynamicResource SukiText}" />
            <Panel IsVisible="{Binding !IsUpdateChecking}">
              <icons:AppIcon Kind="Download"
                        IsVisible="{Binding !HasUpdateAvailable}"
                        Width="{DynamicResource IconSizeSmall}"
                        Height="{DynamicResource IconSizeSmall}" />
              <icons:AppIcon Kind="Upload"
                        IsVisible="{Binding HasUpdateAvailable}"
                        Width="{DynamicResource IconSizeSmall}"
                        Height="{DynamicResource IconSizeSmall}"
                        Foreground="{DynamicResource BrushWarning}" />
            </Panel>
          </Panel>
        </MenuItem.Icon>
      </MenuItem>
    </MenuItem>
  </suki:SukiWindow.MenuItems>

  <Grid RowDefinitions="Auto,*,Auto">
  <Border Grid.Row="0"
          Classes="ShellConnectivityBanner"
          Classes.error="{Binding ShellConnectivityBannerIsError}"
          Classes.warning="{Binding ShellConnectivityBannerIsWarning}"
          Classes.info="{Binding ShellConnectivityBannerIsInfo}"
          IsVisible="{Binding ShowShellConnectivityBanner}"
          BorderBrush="{DynamicResource SukiControlBorderBrush}"
          BorderThickness="0,0,0,1"
          Padding="12,8">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource PageColumnSpacing}">
      <icons:AppIcon Grid.Column="0"
                     Kind="AlertTriangle"
                     Width="{DynamicResource IconSizeDefault}"
                     Height="{DynamicResource IconSizeDefault}"
                     VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding ShellConnectivityBannerTitle}" Classes="ShellTitle" />
        <TextBlock Text="{Binding ShellConnectivityBannerMessage}" Classes="SectionHint" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="2"
              Classes="Secondary"
              Content="前往设置"
              Command="{Binding OpenSettingsCommand}"
              IsVisible="{Binding ShowShellConnectivityBannerAction}"
              VerticalAlignment="Center" />
    </Grid>
  </Border>

  <suki:SukiSideMenu
    Grid.Row="1"
    x:Name="MainSideMenu"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    ItemsSource="{Binding SidebarPages}"
    SelectedItem="{Binding ActivePage}"
    IsMenuExpanded="False"
    IsSelectedItemContentMovable="False"
    IsEnabled="{Binding !IsDbProbeRunning}">
    <suki:SukiSideMenu.HeaderContent>
      <Grid Margin="{DynamicResource ShellTrayMargin}" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
        <suki:GlassCard Classes="SectionCard" Grid.Row="0" Padding="12,11" Opacity="0.96">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource PageColumnSpacing}">
            <Border Width="40" Height="40" CornerRadius="11">
              <Border.Background>
                <SolidColorBrush Color="{DynamicResource SukiPrimaryColor}" Opacity="0.22" />
              </Border.Background>
              <Viewbox Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                <icons:AppIcon Kind="Workflow" Foreground="{DynamicResource SukiPrimaryColor}" />
              </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}" VerticalAlignment="Center">
                <TextBlock Text="PacToolkits" Classes="ShellTitle" VerticalAlignment="Center" />
                <controls:StatusPill Icon="ShieldCheck"
                          Text="PRO"
                          IconSize="11"
                          TextSize="9"
                          PillPadding="7,2"
                          VerticalAlignment="Center"
                          Classes="TonePrimary" />
              </StackPanel>
              <TextBlock Text="自动化套件控制台" Classes="SectionHint" />
            </StackPanel>
          </Grid>
        </suki:GlassCard>

        <suki:GlassCard Grid.Row="1" Classes="SectionCard" Padding="8,8" Opacity="0.92">
          <Grid>
            <TextBox Height="{StaticResource ControlHeightCompact}"
                VerticalContentAlignment="Center"
                Padding="31,0,10,0"
                PlaceholderText="搜索页面 / 命令"
                UseFloatingPlaceholder="False"
                Text="{Binding #MainSideMenu.SearchText, Mode=TwoWay}" />
            <icons:AppIcon Kind="Search"
                      Width="{DynamicResource IconSizeSmall}"
                      Height="{DynamicResource IconSizeSmall}"
                      Margin="{DynamicResource ShellStatusLabelMargin}"
                      IsHitTestVisible="False"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Opacity="0.74" />
          </Grid>
        </suki:GlassCard>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource SpacingInlineMd}">
          <suki:GlassCard Classes="SectionCard" Grid.Column="0" Padding="{StaticResource CompactPadding}" Height="50" VerticalAlignment="Center" Opacity="0.92">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SpacingInlineMd}" VerticalAlignment="Center">
              <icons:AppIcon Kind="Database"
                        Width="{DynamicResource IconSizeCompact}"
                        Height="{DynamicResource IconSizeCompact}"
                        Foreground="{Binding IsDbConnected, Converter={StaticResource BoolToDoneDangerBrush}}"
                        VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="数据库" Classes="ShellCaption" />
                <TextBlock Text="{Binding DbStatusText}" FontSize="{DynamicResource SectionHintSize}" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
          </suki:GlassCard>

          <suki:GlassCard Classes="SectionCard" Grid.Column="1" Padding="{StaticResource CompactPadding}" Height="50" VerticalAlignment="Center" Opacity="0.92">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SpacingInlineMd}" VerticalAlignment="Center">
              <icons:AppIcon Kind="Syringe"
                        Width="{DynamicResource IconSizeCompact}"
                        Height="{DynamicResource IconSizeCompact}"
                        Foreground="{Binding IsAhkRunning, Converter={StaticResource BoolToDoneDangerBrush}}"
                        VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="Agent" Classes="ShellCaption" />
                <TextBlock Text="{Binding AhkStatusText}" FontSize="{DynamicResource SectionHintSize}" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
          </suki:GlassCard>
        </Grid>
      </Grid>
    </suki:SukiSideMenu.HeaderContent>

    <suki:SukiSideMenu.ItemTemplate>
      <DataTemplate x:DataType="vm:AppPageBase">
        <suki:SukiSideMenuItem
          Header="{Binding DisplayName}"
          IsEnabled="{Binding IsEnabled}">
          <suki:SukiSideMenuItem.Icon>
            <icons:AppIcon Kind="{Binding Icon}"
                           Width="{DynamicResource SidebarMenuIconSize}"
                           Height="{DynamicResource SidebarMenuIconSize}"
                           StrokeWidth="{DynamicResource SidebarMenuIconStroke}" />
          </suki:SukiSideMenuItem.Icon>
        </suki:SukiSideMenuItem>
      </DataTemplate>
    </suki:SukiSideMenu.ItemTemplate>

    <suki:SukiSideMenu.FooterContent>
      <Grid Margin="{DynamicResource ShellTrayFooterMargin}"
            VerticalAlignment="Stretch">
        <StackPanel VerticalAlignment="Bottom"
                    Spacing="0">
          <Border Height="1"
                  Margin="{DynamicResource ShellTrayFooterDividerMargin}"
                  Background="{DynamicResource SukiControlBorderBrush}" />

          <StackPanel IsVisible="{Binding !#MainSideMenu.IsMenuExpanded}"
                      Spacing="0"
                      HorizontalAlignment="Center">
            <Button Classes="SidebarFooterAction"
                    Classes.active="{Binding IsSettingsPageActive}"
                    Command="{Binding OpenSettingsCommand}">
              <icons:AppIcon Kind="Settings" />
            </Button>
            <Button Classes="SidebarFooterAction"
                    Classes.active="{Binding IsAboutPageActive}"
                    Command="{Binding OpenAboutCommand}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="关于 PacToolkits" Command="{Binding OpenAboutCommand}">
                    <MenuItem.Icon>
                      <icons:AppIcon Kind="Info" Width="{DynamicResource IconSizeSmall}" Height="{DynamicResource IconSizeSmall}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="检查更新"
                            Command="{Binding CheckAppUpdateCommand}"
                            IsEnabled="{Binding !IsUpdateChecking}">
                    <MenuItem.Icon>
                      <icons:AppIcon Kind="Download" Width="{DynamicResource IconSizeSmall}" Height="{DynamicResource IconSizeSmall}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="打开设置" Command="{Binding OpenSettingsCommand}">
                    <MenuItem.Icon>
                      <icons:AppIcon Kind="Settings" Width="{DynamicResource IconSizeSmall}" Height="{DynamicResource IconSizeSmall}" />
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Button.ContextMenu>
              <icons:AppIcon Kind="Info" />
            </Button>
          </StackPanel>

          <StackPanel IsVisible="{Binding #MainSideMenu.IsMenuExpanded}"
                      Spacing="0">
            <Button Classes="SidebarFooterAction"
                    Classes.active="{Binding IsSettingsPageActive}"
                    Command="{Binding OpenSettingsCommand}">
              <StackPanel Orientation="Horizontal"
                          Spacing="{DynamicResource SpacingInlineMd}"
                          HorizontalAlignment="Center">
                <icons:AppIcon Kind="Settings" />
                <TextBlock Text="设置"
                           Classes="SidebarFooterLabel" />
              </StackPanel>
            </Button>
            <Button Classes="SidebarFooterAction"
                    Classes.active="{Binding IsAboutPageActive}"
                    Command="{Binding OpenAboutCommand}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="关于 PacToolkits" Command="{Binding OpenAboutCommand}">
                    <MenuItem.Icon>
                      <icons:AppIcon Kind="Info" Width="{DynamicResource IconSizeSmall}" Height="{DynamicResource IconSizeSmall}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="检查更新"
                            Command="{Binding CheckAppUpdateCommand}"
                            IsEnabled="{Binding !IsUpdateChecking}">
                    <MenuItem.Icon>
                      <icons:AppIcon Kind="Download" Width="{DynamicResource IconSizeSmall}" Height="{DynamicResource IconSizeSmall}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="打开设置" Command="{Binding OpenSettingsCommand}">
                    <MenuItem.Icon>
                      <icons:AppIcon Kind="Settings" Width="{DynamicResource IconSizeSmall}" Height="{DynamicResource IconSizeSmall}" />
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Button.ContextMenu>
              <StackPanel Orientation="Horizontal"
                          Spacing="{DynamicResource SpacingInlineMd}"
                          HorizontalAlignment="Center">
                <icons:AppIcon Kind="Info" />
                <TextBlock Text="关于"
                           Classes="SidebarFooterLabel" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </suki:SukiSideMenu.FooterContent>
  </suki:SukiSideMenu>

  <Border Grid.Row="2"
          Classes="ShellStatusBar"
          MinHeight="{DynamicResource ShellStatusBarHeight}"
          HorizontalAlignment="Stretch"
          BorderBrush="{DynamicResource SukiControlBorderBrush}"
          BorderThickness="0,1,0,0"
          Padding="0">
    <Grid ColumnDefinitions="*,Auto">
      <ScrollViewer Grid.Column="0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalAlignment="Stretch">
        <StackPanel Orientation="Horizontal" Spacing="0">
          <Button Classes="ShellStatusItem ShellStatusDbItem"
                  Command="{Binding TryReconnectDbCommand}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
              <Panel Width="{DynamicResource IconSizeSmall}" Height="{DynamicResource IconSizeSmall}" VerticalAlignment="Center">
                <controls:BusyCircle IsVisible="{Binding ShowDbBusyIcon}"
                                     Width="{DynamicResource IconSizeSmall}"
                                     Height="{DynamicResource IconSizeSmall}"
                                     DotBrush="{DynamicResource SukiText}" />
                <icons:AppIcon IsVisible="{Binding ShowDbConnectedIcon}"
                               Kind="Database"
                               Foreground="{DynamicResource BrushDone}" />
                <icons:AppIcon IsVisible="{Binding ShowDbDisconnectedIcon}"
                               Kind="Database"
                               Foreground="{DynamicResource BrushDanger}" />
              </Panel>
              <TextBlock Text="{Binding ShellDatabaseItemText}" Classes="ShellStatusLabel" />
            </StackPanel>
          </Button>

          <Border Classes="ShellStatusDivider" />

          <Button Classes="ShellStatusItem ShellStatusAgentItem"
                  Command="{Binding StartOrRestartAhkCommand}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
              <icons:AppIcon Kind="Syringe"
                             Foreground="{Binding IsAhkRunning, Converter={StaticResource BoolToDoneDangerBrush}}" />
              <TextBlock Text="{Binding ShellAgentItemText}" Classes="ShellStatusLabel" />
            </StackPanel>
          </Button>

          <Border Classes="ShellStatusDivider" />

          <Button Classes="ShellStatusItem"
                  IsEnabled="False">
            <TextBlock Text="{Binding ShellActivePageText}" Classes="ShellStatusLabel" />
          </Button>

          <Border Classes="ShellStatusDivider"
                  IsVisible="{Binding ShowShellAccessGuardItem}" />

          <Button Classes="ShellStatusItem"
                  IsVisible="{Binding ShowShellAccessGuardItem}"
                  Command="{Binding OpenSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
              <icons:AppIcon Kind="ShieldAlert" />
              <TextBlock Text="{Binding ShellAccessGuardItemText}"
                         Classes="ShellStatusLabel"
                         MaxWidth="220"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="0"
                  VerticalAlignment="Stretch">
        <Button Classes="ShellStatusItem ShellStatusUpdateItem"
                IsVisible="{Binding HasUpdateAvailable}"
                Command="{Binding OpenUpdateCenterCommand}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
            <icons:AppIcon Kind="Upload" />
            <TextBlock Text="{Binding LatestProductVersion, StringFormat=更新 {0}}"
                       Classes="ShellStatusLabel" />
          </StackPanel>
        </Button>

        <Border Classes="ShellStatusDivider"
                IsVisible="{Binding HasUpdateAvailable}" />

        <Button Classes="ShellStatusItem"
                IsEnabled="False">
          <Panel>
            <StackPanel Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingInlineSm}"
                        IsVisible="{Binding !IsUpdateChecking}">
              <icons:AppIcon Kind="Tag"
                             Width="{DynamicResource IconSizeMini}"
                             Height="{DynamicResource IconSizeMini}" />
              <TextBlock Text="{Binding ShellVersionText}" Classes="ShellStatusLabel" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingInlineSm}"
                        IsVisible="{Binding IsUpdateChecking}">
              <controls:BusyCircle Width="{DynamicResource IconSizeSmall}"
                                   Height="{DynamicResource IconSizeSmall}"
                                   DotBrush="{DynamicResource SukiText}" />
              <TextBlock Text="检查更新…" Classes="ShellStatusLabel" />
            </StackPanel>
          </Panel>
        </Button>

        <Border Classes="ShellStatusDivider" />

        <Button Classes="ShellStatusItem ShellStatusIconItem"
                Classes.active="{Binding IsSettingsPageActive}"
                Command="{Binding OpenSettingsCommand}">
          <Panel>
            <icons:AppIcon Kind="Settings" />
            <Border Width="6"
                    Height="6"
                    CornerRadius="999"
                    Background="{DynamicResource BrushWarning}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-2,-2,0"
                    IsVisible="{Binding HasUpdateAvailable}" />
          </Panel>
        </Button>

        <Button Classes="ShellStatusItem ShellStatusIconItem"
                Classes.active="{Binding IsAboutPageActive}"
                Command="{Binding OpenAboutCommand}">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="关于 PacToolkits" Command="{Binding OpenAboutCommand}">
                <MenuItem.Icon>
                  <icons:AppIcon Kind="Info" Width="{DynamicResource IconSizeSmall}" Height="{DynamicResource IconSizeSmall}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="检查更新"
                        Command="{Binding CheckAppUpdateCommand}"
                        IsEnabled="{Binding !IsUpdateChecking}">
                <MenuItem.Icon>
                  <icons:AppIcon Kind="Download" Width="{DynamicResource IconSizeSmall}" Height="{DynamicResource IconSizeSmall}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="打开设置" Command="{Binding OpenSettingsCommand}">
                <MenuItem.Icon>
                  <icons:AppIcon Kind="Settings" Width="{DynamicResource IconSizeSmall}" Height="{DynamicResource IconSizeSmall}" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </Button.ContextMenu>
          <Border Width="{DynamicResource ShellBrandIconSize}"
                  Height="{DynamicResource ShellBrandIconSize}"
                  CornerRadius="4"
                  ClipToBounds="True">
            <Image Source="avares://pactoolkits-desktop/Assets/app.ico" Stretch="Uniform" />
          </Border>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
  </Grid>
</suki:SukiWindow>
