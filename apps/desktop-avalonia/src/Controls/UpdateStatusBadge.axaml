<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Controls.UpdateStatusBadge"
  xmlns="https://github.com/avaloniaui"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Name="Root">
  <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
    <shad:Badge
      Background="{DynamicResource InfoColor10}"
      BorderBrush="{DynamicResource InfoColor20}"
      Classes="Outline"
      IsVisible="{Binding IsUnknown, ElementName=Root}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
        <icons:AppIcon
          Width="{DynamicResource IconSizeSmall}"
          Height="{DynamicResource IconSizeSmall}"
          Foreground="{DynamicResource InfoColor}"
          Kind="BadgeQuestionMark" />
        <TextBlock Foreground="{DynamicResource InfoColor}" Text="{Binding Label, ElementName=Root}" />
      </StackPanel>
    </shad:Badge>

    <shad:Badge
      Background="{DynamicResource SuccessColor20}"
      BorderBrush="{DynamicResource SuccessColor60}"
      Classes="Outline"
      IsVisible="{Binding IsUpToDate, ElementName=Root}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
        <icons:AppIcon
          Width="{DynamicResource IconSizeSmall}"
          Height="{DynamicResource IconSizeSmall}"
          Foreground="{DynamicResource SuccessColor}"
          Kind="CircleCheck" />
        <TextBlock Foreground="{DynamicResource SuccessColor}" Text="{Binding Label, ElementName=Root}" />
      </StackPanel>
    </shad:Badge>

    <shad:Badge
      Background="{DynamicResource WarningColor20}"
      BorderBrush="{DynamicResource WarningColor60}"
      Classes="Outline"
      IsVisible="{Binding IsUpdateAvailable, ElementName=Root}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
        <icons:AppIcon
          Width="{DynamicResource IconSizeSmall}"
          Height="{DynamicResource IconSizeSmall}"
          Foreground="{DynamicResource WarningColor}"
          Kind="CloudDownload" />
        <TextBlock Foreground="{DynamicResource WarningColor}" Text="{Binding Label, ElementName=Root}" />
        <StackPanel
          IsVisible="{Binding ShowLatestVersion, ElementName=Root}"
          Orientation="Horizontal"
          Spacing="{DynamicResource SpacingInlineSm}">
          <icons:AppIcon
            Width="{DynamicResource IconSizeSmall}"
            Height="{DynamicResource IconSizeSmall}"
            Foreground="{DynamicResource WarningColor}"
            Kind="ArrowRight" />
          <TextBlock Foreground="{DynamicResource WarningColor}" Text="{Binding LatestVersion, ElementName=Root}" />
        </StackPanel>
      </StackPanel>
    </shad:Badge>
  </Grid>
</UserControl>
