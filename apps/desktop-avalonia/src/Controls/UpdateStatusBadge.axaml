<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Controls.UpdateStatusBadge"
  xmlns="https://github.com/avaloniaui"
  xmlns:icons="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Name="Root">
  <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
    <shad:Badge
      Background="{DynamicResource BrushInfoBg15}"
      BorderBrush="{DynamicResource BrushInfoBg35}"
      Classes="Outline"
      IsVisible="{Binding IsUnknown, ElementName=Root}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
        <icons:AppIcon
          Width="{DynamicResource IconSizeSmall}"
          Height="{DynamicResource IconSizeSmall}"
          Foreground="{DynamicResource BrushInfo}"
          Kind="BadgeQuestionMark" />
        <TextBlock Foreground="{DynamicResource BrushInfo}" Text="{Binding Label, ElementName=Root}" />
      </StackPanel>
    </shad:Badge>

    <shad:Badge
      Background="{DynamicResource BrushDoneBg25}"
      BorderBrush="{DynamicResource BrushDoneBg50}"
      Classes="Outline"
      IsVisible="{Binding IsUpToDate, ElementName=Root}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
        <icons:AppIcon
          Width="{DynamicResource IconSizeSmall}"
          Height="{DynamicResource IconSizeSmall}"
          Foreground="{DynamicResource BrushDone}"
          Kind="CircleCheck" />
        <TextBlock Foreground="{DynamicResource BrushDone}" Text="{Binding Label, ElementName=Root}" />
      </StackPanel>
    </shad:Badge>

    <shad:Badge
      Background="{DynamicResource BrushWarningBg25}"
      BorderBrush="{DynamicResource BrushWarningBg50}"
      Classes="Outline"
      IsVisible="{Binding IsUpdateAvailable, ElementName=Root}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}">
        <icons:AppIcon
          Width="{DynamicResource IconSizeSmall}"
          Height="{DynamicResource IconSizeSmall}"
          Foreground="{DynamicResource BrushWarning}"
          Kind="CloudDownload" />
        <TextBlock Foreground="{DynamicResource BrushWarning}" Text="{Binding Label, ElementName=Root}" />
        <StackPanel
          IsVisible="{Binding ShowLatestVersion, ElementName=Root}"
          Orientation="Horizontal"
          Spacing="{DynamicResource SpacingInlineSm}">
          <icons:AppIcon
            Width="{DynamicResource IconSizeSmall}"
            Height="{DynamicResource IconSizeSmall}"
            Foreground="{DynamicResource BrushWarning}"
            Kind="ArrowRight" />
          <TextBlock Foreground="{DynamicResource BrushWarning}" Text="{Binding LatestVersion, ElementName=Root}" />
        </StackPanel>
      </StackPanel>
    </shad:Badge>
  </Grid>
</UserControl>
