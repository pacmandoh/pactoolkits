<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Controls.PacHostedDialogView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:PacToolkits.Desktop.Avalonia.Controls"
  x:DataType="controls:PacHostedDialogContext">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource FormRowSpacing}">
    <TextBlock
      Grid.Row="0"
      Classes="DialogTitle"
      Text="{Binding Title}"
      TextWrapping="Wrap" />

    <ContentControl Grid.Row="1" Content="{Binding Body}" />

    <StackPanel
      Grid.Row="2"
      HorizontalAlignment="Right"
      Orientation="Horizontal"
      Spacing="{DynamicResource SpacingInlineSm}">
      <ItemsControl ItemsSource="{Binding Actions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingInlineSm}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="controls:PacHostedDialogAction">
            <controls:PacHostedDialogActionButton Action="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</UserControl>
