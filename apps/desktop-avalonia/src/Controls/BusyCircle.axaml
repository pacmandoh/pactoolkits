<UserControl
  x:Class="PacToolkits.Desktop.Avalonia.Controls.BusyCircle"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Name="Root"
  Width="{DynamicResource IconSizeDefault}"
  Height="{DynamicResource IconSizeDefault}"
  HorizontalAlignment="Center"
  VerticalAlignment="Center">
  <Canvas
    Width="{Binding Width, ElementName=Root}"
    Height="{Binding Height, ElementName=Root}"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">
    <Border
      x:Name="Dot0"
      Canvas.Left="6.5"
      Canvas.Top="0.5"
      Width="3"
      Height="3"
      Background="{Binding DotBrush, ElementName=Root}"
      CornerRadius="999"
      Opacity="0.2" />
    <Border
      x:Name="Dot1"
      Canvas.Left="10.7"
      Canvas.Top="2.3"
      Width="3"
      Height="3"
      Background="{Binding DotBrush, ElementName=Root}"
      CornerRadius="999"
      Opacity="0.2" />
    <Border
      x:Name="Dot2"
      Canvas.Left="12.5"
      Canvas.Top="6.5"
      Width="3"
      Height="3"
      Background="{Binding DotBrush, ElementName=Root}"
      CornerRadius="999"
      Opacity="0.2" />
    <Border
      x:Name="Dot3"
      Canvas.Left="10.7"
      Canvas.Top="10.7"
      Width="3"
      Height="3"
      Background="{Binding DotBrush, ElementName=Root}"
      CornerRadius="999"
      Opacity="0.2" />
    <Border
      x:Name="Dot4"
      Canvas.Left="6.5"
      Canvas.Top="12.5"
      Width="3"
      Height="3"
      Background="{Binding DotBrush, ElementName=Root}"
      CornerRadius="999"
      Opacity="0.2" />
    <Border
      x:Name="Dot5"
      Canvas.Left="2.3"
      Canvas.Top="10.7"
      Width="3"
      Height="3"
      Background="{Binding DotBrush, ElementName=Root}"
      CornerRadius="999"
      Opacity="0.2" />
    <Border
      x:Name="Dot6"
      Canvas.Left="0.5"
      Canvas.Top="6.5"
      Width="3"
      Height="3"
      Background="{Binding DotBrush, ElementName=Root}"
      CornerRadius="999"
      Opacity="0.2" />
    <Border
      x:Name="Dot7"
      Canvas.Left="2.3"
      Canvas.Top="2.3"
      Width="3"
      Height="3"
      Background="{Binding DotBrush, ElementName=Root}"
      CornerRadius="999"
      Opacity="0.2" />
  </Canvas>
</UserControl>
