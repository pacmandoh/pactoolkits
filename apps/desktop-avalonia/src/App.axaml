<Application
  x:Class="PacToolkits.Desktop.Avalonia.App"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
  RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://pactoolkits-desktop/Styles/PacTheme.axaml" />
        <ResourceInclude Source="avares://pactoolkits-desktop/Resources/Converters/CommonConverters.axaml" />
        <ResourceInclude Source="avares://pactoolkits-desktop/Resources/Converters/TraceConverters.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <NativeMenu x:Key="TrayMenu">
        <NativeMenuItem Header="显示主窗口" />
        <NativeMenuItem Header="关闭行为：后台" />
        <NativeMenuItem Header="关于" />
        <NativeMenuItemSeparator />
        <NativeMenuItem Header="退出" />
      </NativeMenu>
    </ResourceDictionary>
  </Application.Resources>


  <Application.Styles>
    <shad:ShadTheme />
    <StyleInclude Source="avares://pactoolkits-desktop/Styles/PacTheme.Styles.axaml" />
  </Application.Styles>
</Application>
