# ------------------------------
# Local agent config
# ------------------------------
.cursor/*
!.cursor/rules/

# ------------------------------
# OS / editor noise
# ------------------------------
.DS_Store
.tmp/
Thumbs.db
*.swp
*.swo
*~

# ------------------------------
# IDE / tooling (JetBrains, VS, VSCode)
# ------------------------------
.idea/
*.iml
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
_ReSharper*/
*.[Rr]e[Ss]harper

# ------------------------------
# .NET / Avalonia build artifacts
# ------------------------------
**/bin/
**/obj/
**/TestResults/
**/out/

# UI local packaging artifacts
apps/desktop-avalonia/src/Publish/
apps/desktop-avalonia/src/Releases/
apps/desktop-avalonia/src/Postgres/

# ------------------------------
# Agent local packaging artifacts
# ------------------------------
runtime/agents/modules/**/Releases/
artifacts/agents/**/*
!artifacts/agents/**/.gitkeep
artifacts/desktop/**/*
!artifacts/desktop/**/.gitkeep

# ------------------------------
# Runtime logs / temp
# ------------------------------
*.log
*.tmp
*.temp

# ------------------------------
# Local secrets / machine-specific configs
# ------------------------------
.env
.env.local
.env.*.local

# Keep template files
!.env.example

# api-asp local secrets (.env.asp) and wire-local runtime (pid/log)
apps/api-asp/.env.*
apps/api-asp/.run/

# DB local deploy config (contains environment-specific values)
database/postgres/scripts/config.json

# ------------------------------
# Local dotnet tool installs (prefer dotnet-tools.json + tool restore)
# ------------------------------
.tools/

# ------------------------------
# Node (if any tooling uses npm)
# ------------------------------
**/node_modules/

# skill local Python scratch
.agents/skills/**/.venv/
.agents/skills/**/__pycache__/

# ------------------------------
# Optional local release scratch files
# ------------------------------
*.zip
